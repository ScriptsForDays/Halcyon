function Tab:paint(selected, dimmed)
if not self.button then
return
end
local textRole = if selected then "text" else "textMuted"
Theme.bind(self.buttonIcon, "ImageColor3", if selected then "accent" else "textMuted")
Theme.bind(self.buttonLabel, "TextColor3", textRole)
self.buttonLabel.FontFace = Create.font(if selected then "bold" else "medium")
self.buttonLabel.TextTransparency = if dimmed then 0.5 else 0
self.buttonIcon.ImageTransparency = if dimmed then 0.5 else 0
local look = self.look or {}
if selected and look.text then
Theme.bind(self.buttonLabel, "TextColor3", look.text)
end
if selected and (look.icon or look.text) then
Theme.bind(self.buttonIcon, "ImageColor3", look.icon or (if look.text == "onAccent" then "onAccent" else "accent"))
end
Theme.bind(self.button, "BackgroundColor3", if selected and look.fill then look.fill else "raised")
Motion.tween(self.button, "fast", { BackgroundTransparency = if selected and look.fill then look.fillTransparency or 0 else 1 })
if self.bar then
self.bar.Visible = selected
end
if self.glow then
Motion.tween(self.glow, "fast", { Transparency = if selected then 0.35 else 1 })
end
if self.lock then
self.lock.Visible = not self.window:allows(self.tier)
end
end
function Tab:SetBadge(value)
self.badge = value
self.window:buildNav()
end
function Tab:Select()
self.window:SelectTab(self)
end
function Tab:SetTitle(title)
self.Title = title
if self.buttonLabel then
self.buttonLabel.Text = title
end
end
local function looseSection(tab)
local loose = tab.loose
if not loose or tab.last ~= loose or loose.scope.cleaned then
loose = tab:Section({ Style = "Flat" })
tab.loose = loose
end
return loose
end
for _, kind in Registry.Kinds do
Tab[kind] = function(self, options)
local section = looseSection(self)
return section[kind](section, options)
end
end
return Tab
end
modules["Components/Tooltip"] = function()
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Mount = import("Core/Mount")
local Styles = import("Core/Styles")
local DELAY, LONG_PRESS, TOUCH_TIME = 0.45, 0.5, 2.5
local GAP, MARGIN, WIDTH = 8, 8, 240
Styles.register("Tooltip", "Card", { card = true })
Styles.register("Tooltip", "Plain", { inverted = true })
Styles.register("Tooltip", "Follow", { card = true, follow = true })
local Tooltip = {}
local function build(library, spec, look)
local overlay = Mount.overlay(library)
local inverted = look.inverted == true
local frame = Create.new("Frame", {
Name = "Tooltip",
Size = UDim2.fromOffset(0, 0),
AutomaticSize = Enum.AutomaticSize.XY,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = if inverted then "text" else "surface" },
Parent = overlay.popups,
})
Create.new("UIScale", { Scale = library.scale, Parent = frame })
Create.new("UISizeConstraint", { MaxSize = Vector2.new(WIDTH, math.huge), Parent = frame })
Create.corner(if inverted then 6 else 8, frame)
local edge = Create.stroke("stroke", frame)
edge.Transparency = if inverted then 1 else 0
Create.padding(frame, if inverted then 8 else 10, if inverted then 5 else 8)
Create.list(frame, "Vertical", 3)
if spec.Title or spec.Key then
local head = Create.new("Frame", { Name = "Head", Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X, Parent = frame })
Create.list(head, "Horizontal", 6)
if spec.Title then
Create.new("TextLabel", {
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(spec.Title),
TextSize = 13,
Weight = "bold",
Theme = { TextColor3 = if inverted then "background" else "text" },
Parent = head,
})
end
if spec.Key then
local key = Create.new("TextLabel", {
Size = UDim2.fromOffset(0, 16),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(spec.Key),
TextSize = 12,
Weight = "bold",
LayoutOrder = 1,
Theme = { BackgroundColor3 = "raised", TextColor3 = "textMuted" },
Parent = head,
})
Create.corner(4, key)
Create.padding(key, 5, 0)
end
end
if spec.Text then
Create.new("TextLabel", {
Name = "Text",
Size = UDim2.fromOffset(0, 0),
AutomaticSize = Enum.AutomaticSize.XY,
TextWrapped = true,
RichText = true,
TextSize = 12,
LayoutOrder = 1,
Text = tostring(spec.Text),
Theme = { TextColor3 = if inverted then "background" else "textMuted" },
Parent = frame,
}, { Create.new("UISizeConstraint", { MaxSize = Vector2.new(WIDTH - 20, math.huge) }) })
end
return frame, overlay
end
local function place(frame, overlay, anchor)
local view, origin = overlay.gui.AbsoluteSize, overlay.gui.AbsolutePosition
local size = frame.AbsoluteSize
local x, top, bottom
if typeof(anchor) == "Vector2" then
local point = anchor - origin
x, top, bottom = point.X + 14, point.Y, point.Y + 18
else
local corner = anchor.AbsolutePosition - origin
x, top, bottom = corner.X + 12, corner.Y, corner.Y + anchor.AbsoluteSize.Y
end
local y = if bottom + GAP + size.Y <= view.Y - MARGIN then bottom + GAP else top - GAP - size.Y
x = math.clamp(x, MARGIN, math.max(view.X - size.X - MARGIN, MARGIN))
y = math.clamp(y, MARGIN, math.max(view.Y - size.Y - MARGIN, MARGIN))
frame.Position = UDim2.fromOffset(math.round(x), math.round(y))
end
function Tooltip.attach(row, spec)
if type(spec) ~= "table" then
spec = { Text = tostring(spec) }
end
local library, scope = row.library, row.scope
local look = Styles.pick("Tooltip", spec.Style, row.window)
local target = row.frame
local shown, overlay
local generation = 0
local function hide()
generation += 1
if shown then
shown:Destroy()
shown = nil
end
end
local function show(at)
hide()
local mine = generation
local frame
frame, overlay = build(library, spec, look)
shown = frame
place(frame, overlay, if look.follow and at then at else target)
task.defer(function()
if mine == generation and shown == frame then
place(frame, overlay, if look.follow and at then at else target)
Motion.tween(frame, "fast", { BackgroundTransparency = 0 })
end
end)
end
scope:connect(target.MouseEnter, function()
generation += 1
local mine = generation
task.delay(DELAY, function()
if mine == generation and not scope.cleaned and target.Visible ~= false then
show(UserInputService:GetMouseLocation())
end
end)
end)
scope:connect(target.MouseLeave, hide)
if look.follow then
scope:connect(UserInputService.InputChanged, function(input)
if shown and input.UserInputType == Enum.UserInputType.MouseMovement then
place(shown, overlay, Vector2.new(input.Position.X, input.Position.Y))
end
end)
end
scope:connect(target.InputBegan, function(input)
if input.UserInputType ~= Enum.UserInputType.Touch then
return
end
generation += 1
local mine = generation
task.delay(LONG_PRESS, function()
if mine == generation and not scope.cleaned then
show(Vector2.new(input.Position.X, input.Position.Y))
local current = generation
task.delay(TOUCH_TIME, function()
if current == generation then
hide()
end
end)
end
end)
end)
scope:connect(target.InputEnded, function(input)
if input.UserInputType == Enum.UserInputType.Touch and not shown then
generation += 1
end
end)
scope:add(hide)
return { show = show, hide = hide }
end
return Tooltip
end
modules["Components/UpdateLog"] = function()
local Create = import("Core/Create")
local Panels = import("Components/Panels")
local Row = import("Elements/Row")
local Styles = import("Core/Styles")
local KINDS = { "New", "Improved", "Fixed", "Removed", "Security" }
local ROLES = { New = "accent", Improved = "info", Fixed = "success", Removed = "danger", Security = "warning" }
local ICONS = { New = "sparkles", Improved = "zap", Fixed = "wrench", Removed = "trash-2", Security = "shield-check" }
Styles.register("UpdateLog", "Timeline", { section = "Accent" })
Styles.register("UpdateLog", "Cards", { section = "Card" })
Styles.register("UpdateLog", "Compact", { section = "Outlined", compact = true })
local UpdateLog = {}
function UpdateLog.settings(value)
if value == true then
return {}
elseif type(value) == "table" then
return value
end
return nil
end
local function newer(a, b)
local left, right = {}, {}
for number in string.gmatch(tostring(a.Version or ""), "%d+") do
table.insert(left, tonumber(number))
end
for number in string.gmatch(tostring(b.Version or ""), "%d+") do
table.insert(right, tonumber(number))
end
for index = 1, math.max(#left, #right) do
local x, y = left[index] or 0, right[index] or 0
if x ~= y then
return x > y
end
end
return (a.order or 0) > (b.order or 0)
end
local function entriesOf(update)
local list = {}
for _, entry in update.Entries or {} do
if type(entry) == "string" then
table.insert(list, { Kind = "New", Text = entry })
elseif type(entry) == "table" and entry.Text then
table.insert(list, { Kind = if ROLES[entry.Kind] then entry.Kind else "New", Text = tostring(entry.Text) })
end
end
return list
end
local function group(section, kind, items, compact)
local row = Row.new(section, { Title = "" }, { bare = true, compact = true })
local handle = row.handle
local body = Create.new("Frame", { Name = "Group", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row.content })
Create.list(body, "Vertical", 6)
local role = ROLES[kind]
if not compact then
local head = Create.new("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, 20), Parent = body })
Create.list(head, "Horizontal", 6)
Create.icon(ICONS[kind], 14, role, head)
Create.new("TextLabel", {
Name = "Kind",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = string.upper(kind),
TextSize = 12,
Weight = "bold",
LayoutOrder = 1,
Theme = { TextColor3 = role },
Parent = head,
})
local count = Create.new("TextLabel", {
Name = "Count",
Size = UDim2.fromOffset(0, 18),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(#items),
TextSize = 12,
Weight = "bold",
LayoutOrder = 2,
BackgroundTransparency = 0.85,
Theme = { BackgroundColor3 = role, TextColor3 = role },
Parent = head,
})
Create.corner(-1, count)
Create.padding(count, 6, 0)
end
local words = {}
for index, text in items do
local line = Create.new("Frame", { Name = "Change", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = index + 1, Parent = body })
Create.list(line, "Horizontal", 8, { VerticalAlignment = Enum.VerticalAlignment.Top })
if compact then
local tag = Create.new("TextLabel", {
Name = "Tag",
Size = UDim2.fromOffset(78, 18),
Text = string.upper(kind),
TextSize = 12,
Weight = "bold",
TextXAlignment = Enum.TextXAlignment.Center,
BackgroundTransparency = 0.85,
Theme = { BackgroundColor3 = role, TextColor3 = role },
Parent = line,
})
Create.corner(4, tag)
else
local dot = Create.new("Frame", { Name = "Dot", Size = UDim2.fromOffset(5, 5), Position = UDim2.fromOffset(0, 7), Theme = { BackgroundColor3 = "textMuted" } })
local holder = Create.new("Frame", { Name = "Bullet", Size = UDim2.fromOffset(12, 18), Parent = line })
dot.Parent = holder
dot.Position = UDim2.fromOffset(4, 7)
Create.corner(-1, dot)
end
Create.new("TextLabel", {
Name = "Text",
Size = UDim2.fromScale(0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
RichText = true,
TextSize = 13,
LayoutOrder = 1,
Text = text,
Theme = { TextColor3 = "text" },
Parent = line,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
table.insert(words, text)
end
handle.SearchExtra = kind .. " " .. table.concat(words, " ")
handle.SearchText = string.lower(handle.SearchExtra)
handle.Kind = "UpdateGroup"
handle.UpdateKind = kind
local entry = { handle = handle, section = section }
table.insert(section.entries, entry)
handle.scope:add(function()
local index = table.find(section.entries, entry)
if index then
table.remove(section.entries, index)
end
end)
return handle
end
function UpdateLog.build(window, settings)
local look = Styles.pick("UpdateLog", settings.Style, window)
local tab = window:Tab({
Title = settings.Title or "Updates",
Icon = settings.Icon or "clock",
Group = settings.Group,
Description = settings.Description,
})
local log = { tab = tab, updates = {}, sections = {}, filter = "All", query = "", order = 0 }
window.updateLog = log
local tools = tab:Section({ Title = nil })
local chips
local function apply()
for _, section in log.sections do
local shown = 0
for _, entry in section.entries do
local handle = entry.handle
if handle.UpdateKind and entry.section == section then
local visible = (log.filter == "All" or handle.UpdateKind == log.filter)
and (log.query == "" or string.find(handle.SearchText, log.query, 1, true) ~= nil or string.find(section.searchTitle or "", log.query, 1, true) ~= nil)
handle:SetVisible(visible)
if visible then
shown += 1
end
end
end
section:SetVisible(shown > 0)
if shown > 0 and (log.query ~= "" or log.filter ~= "All") then
section:SetCollapsed(false)
end
end
end
if settings.Search ~= false then
tools:Input({
Title = "Search updates",
Placeholder = "Search updates",
LeadingIcon = "search",
Clearable = true,
Live = true,
Callback = function(text)
log.query = string.lower(text or "")
apply()
end,
})
end
if settings.Filters ~= false then
local values = { "All" }
for _, kind in KINDS do
table.insert(values, kind)
end
chips = tools:Chips({
Title = "Show",
Values = values,
Default = "All",
Callback = function(kind)
log.filter = kind or "All"
apply()
end,
})
end
log.tools, log.chips = tools, chips
function log.redraw()
for _, section in log.sections do
section:Destroy()
end
table.clear(log.sections)
table.sort(log.updates, function(a, b)
if (a.Pinned == true) ~= (b.Pinned == true) then
return a.Pinned == true
end
return newer(a, b)
end)
for index, update in log.updates do
local latest = index == 1
local title = tostring(update.Version or "")
if update.Title then
title = if title ~= "" then `{title}  \u{00B7}  {update.Title}` else tostring(update.Title)
end
local subtitle = {}
if update.Date then
table.insert(subtitle, tostring(update.Date))
end
if update.Summary then
table.insert(subtitle, tostring(update.Summary))
end
local section = tab:Section({
Title = title,
Icon = if latest then "sparkles" else "clock",
IconColor = if latest then "accent" else nil,
Style = look.section,
Description = if #subtitle > 0 then table.concat(subtitle, "  \u{2014}  ") else nil,
Badge = if latest then "Latest" elseif update.Pinned then "Pinned" else nil,
Collapsed = not latest and settings.ExpandAll ~= true,
})
if update.Image then
section:Image({ Image = update.Image, Height = 120, Crop = true })
end
local byKind = {}
for _, entry in entriesOf(update) do
byKind[entry.Kind] = byKind[entry.Kind] or {}
table.insert(byKind[entry.Kind], entry.Text)
end
for _, kind in KINDS do
if byKind[kind] then
group(section, kind, byKind[kind], look.compact)
end
end
table.insert(log.sections, section)
end
apply()
log.markUnseen()
end
function log.markUnseen()
local newest = log.updates[1]
local version = newest and tostring(newest.Version or "")
if version and version ~= "" and window.updateSeen ~= version and window.selected ~= tab then
tab:SetBadge("New")
else
tab:SetBadge(nil)
end
end
tab.scope:add(window.TabChanged:Connect(function(selected)
local newest = log.updates[1]
if selected == tab and newest and newest.Version then
window.updateSeen = tostring(newest.Version)
window:savePreferences()
tab:SetBadge(nil)
end
end))
function log.add(update)
if type(update) ~= "table" then
error("AddUpdate expects a table: { Version, Title, Date, Entries }", 3)
end
log.order += 1
local copy = table.clone(update)
copy.order = log.order
table.insert(log.updates, copy)
log.redraw()
end
for _, update in settings.Updates or {} do
log.order += 1
local copy = table.clone(update)
copy.order = log.order
table.insert(log.updates, copy)
end
log.redraw()
if settings.Popup and log.updates[1] then
local newest = log.updates[1]
task.defer(function()
if not window.scope.cleaned then
local entries = {}
for _, entry in entriesOf(newest) do
table.insert(entries, entry)
end
pcall(Panels.changelog, window, { Version = newest.Version, Title = newest.Title and `What's new: {newest.Title}`, Entries = entries })
end
end)
end
return log
end
return UpdateLog
end
