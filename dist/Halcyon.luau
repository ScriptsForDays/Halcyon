})
end
local meta = line(text, Profile.meta(settings), 2, 12, "regular", "textMuted")
if discord then
DiscordButton.new(scope, tierLine, { Link = discord.Link, Icon = discord.Icon, Size = 24, LayoutOrder = 3 }, function(copied, link)
window:Notify({
