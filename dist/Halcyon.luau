Position = UDim2.new(0.5, 0, 0, 10),
Visible = false,
Theme = { BackgroundColor3 = "surface" },
Parent = self.gui,
})
Create.corner(-1, self.openButton)
Create.stroke("stroke", self.openButton)
centred(Create.icon(self.Icon or "menu", 22, "accent", self.openButton))
