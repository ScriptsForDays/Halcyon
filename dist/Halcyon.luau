Size = UDim2.new(1, -32, 0, 40),
TextWrapped = true,
TextXAlignment = Enum.TextXAlignment.Center,
Visible = false,
Theme = { TextColor3 = "textMuted" },
Parent = self.pages,
}))
self.openButton = Create.new("TextButton", {
