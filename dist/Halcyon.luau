for key, value in preset do
if key == "Styles" then
local styles = if type(options.Styles) == "table" then table.clone(options.Styles) else {}
for kind, name in value do
if styles[kind] == nil then
styles[kind] = name
end
end
merged.Styles = styles
elseif merged[key] == nil then
merged[key] = value
end
end
return merged
end
return Presets
end
