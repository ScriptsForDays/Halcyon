modules["Components/Popup"] = function()
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Mount = import("Core/Mount")
local MARGIN, GAP = 8, 6
local Popup = {}
local function contains(instance, position)
local origin, size = instance.AbsolutePosition, instance.AbsoluteSize
return position.X >= origin.X and position.X <= origin.X + size.X and position.Y >= origin.Y and position.Y <= origin.Y + size.Y
end
function Popup.close(library)
if library.popup then
library.popup.close()
end
end
function Popup.toggle(library, anchor, options)
local open = library.popup
Popup.close(library)
if open and open.anchor == anchor then
return nil
end
local overlay = Mount.overlay(library)
local scope = library.scope:child()
local width = options.Width or math.max(anchor.AbsoluteSize.X / library.scale, 180)
local holder = Create.new("Frame", { Name = "Popup", Parent = overlay.popups })
local panel = Create.new("Frame", {
Name = "Panel",
Size = UDim2.fromOffset(width, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Active = true,
Theme = { BackgroundColor3 = "surface" },
Parent = holder,
})
Create.corner(10, panel)
Create.stroke("stroke", panel)
Create.padding(panel, 6)
Create.list(panel, "Vertical", 4)
Create.new("UIScale", { Scale = library.scale, Parent = panel })
scope:add(holder)
local popup = { anchor = anchor, frame = panel, scope = scope }
local function place()
local view, origin = overlay.gui.AbsoluteSize, overlay.gui.AbsolutePosition
local size = panel.AbsoluteSize
local corner, extent = anchor.AbsolutePosition - origin, anchor.AbsoluteSize
local x = corner.X + extent.X - size.X
local y = corner.Y + extent.Y + GAP
if y + size.Y > view.Y - MARGIN then
y = corner.Y - size.Y - GAP
end
holder.Position = UDim2.fromOffset(
math.clamp(x, MARGIN, math.max(view.X - size.X - MARGIN, MARGIN)),
math.clamp(y, MARGIN, math.max(view.Y - size.Y - MARGIN, MARGIN))
)
end
function popup.close()
if library.popup ~= popup then
return
end
library.popup = nil
library.scope:release(scope)
if options.OnClose then
options.OnClose()
end
end
scope:connect(panel:GetPropertyChangedSignal("AbsoluteSize"), place)
scope:connect(anchor:GetPropertyChangedSignal("AbsolutePosition"), popup.close)
local view = overlay.gui.AbsoluteSize
scope:connect(overlay.gui:GetPropertyChangedSignal("AbsoluteSize"), function()
local size = overlay.gui.AbsoluteSize
if view.X > 0 and size ~= view then
popup.close()
else
view = size
place()
end
end)
scope:connect(anchor.Destroying, popup.close)
scope:connect(UserInputService.InputBegan, function(input)
local kind = input.UserInputType
if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
return
end
if not contains(panel, input.Position) and not contains(anchor, input.Position) then
popup.close()
end
end)
library.popup = popup
place()
panel.Position = UDim2.fromOffset(0, -6)
Motion.tween(panel, "base", { Position = UDim2.fromOffset(0, 0) })
return popup
end
return Popup
end
modules["Components/Profile"] = function()
local Players = game:GetService("Players")
local Create = import("Core/Create")
local DiscordButton = import("Components/DiscordButton")
local Env = import("Core/Env")
local Popup = import("Components/Popup")
local DEFAULTS = {
Enabled = true,
Avatar = "Headshot",
Anonymous = false,
ShowUsername = true,
ShowTier = true,
ShowExecutor = true,
ShowClock = true,
ShowDate = false,
ClockFormat = "%H:%M",
DateFormat = "%d %b %Y",
}
local Profile = {}
function Profile.settings(options)
local settings = table.clone(DEFAULTS)
if options == false then
settings.Enabled = false
elseif type(options) == "table" then
for key, value in options do
settings[key] = value
end
end
return settings
end
local function formatted(pattern)
local ok, text = pcall(os.date, pattern)
return if ok and type(text) == "string" then text else ""
end
function Profile.meta(settings)
local parts = {}
if settings.ShowExecutor then
table.insert(parts, (Env.executor()))
end
if settings.ShowDate then
table.insert(parts, formatted(settings.DateFormat))
end
if settings.ShowClock then
table.insert(parts, formatted(settings.ClockFormat))
end
return table.concat(parts, " · ")
end
function Profile.names(settings)
if settings.Anonymous then
return "Anonymous", "Identity hidden"
end
local player = Players.LocalPlayer
return settings.Name or player.DisplayName, settings.Subtitle or ("@" .. player.Name)
end
local function stage(view)
local character = Players.LocalPlayer.Character
local head = character and character:FindFirstChild("Head")
if not head then
return false
end
local archivable = character.Archivable
character.Archivable = true
local ok, copy = pcall(character.Clone, character)
character.Archivable = archivable
if not ok or not copy then
return false
end
for _, descendant in copy:GetDescendants() do
if descendant:IsA("BaseScript") or descendant:IsA("Sound") then
descendant:Destroy()
end
end
local world = Instance.new("WorldModel")
copy.Parent = world
world.Parent = view
local focus = head.Position
local camera = Instance.new("Camera")
camera.FieldOfView = 40
camera.CFrame = CFrame.lookAt(focus + head.CFrame.LookVector * 2.4 + Vector3.new(0, 0.15, 0), focus)
camera.Parent = view
view.CurrentCamera = camera
return true
end
local function avatar(window, scope, parent, size)
local settings = window.profile
local holder = Create.new("Frame", {
Name = "Avatar",
Size = UDim2.fromOffset(size, size),
Theme = { BackgroundColor3 = "raised" },
Parent = parent,
})
