modules["Locales/Locales"] = function()
local LocalizationService = game:GetService("LocalizationService")
local Locales = {
packs = {
["pt-br"] = import("Locales/Portuguese"),
es = import("Locales/Spanish"),
vi = import("Locales/Vietnamese"),
id = import("Locales/Indonesian"),
ru = import("Locales/Russian"),
tr = import("Locales/Turkish"),
fr = import("Locales/French"),
de = import("Locales/German"),
},
names = {
en = "English",
["pt-br"] = "Português (Brasil)",
es = "Español",
vi = "Tiếng Việt",
id = "Bahasa Indonesia",
ru = "Русский",
tr = "Türkçe",
fr = "Français",
de = "Deutsch",
},
}
local ORDER = { "en", "pt-br", "es", "vi", "id", "ru", "tr", "fr", "de" }
function Locales.resolve(code)
if code == nil or code == "auto" then
local ok, locale = pcall(function()
return LocalizationService.RobloxLocaleId
end)
code = if ok and type(locale) == "string" then locale else "en"
end
code = string.gsub(string.lower(tostring(code)), "_", "-")
if code == "en" or Locales.packs[code] then
return code
end
local base = string.match(code, "^%a+") or "en"
if base == "pt" then
return "pt-br"
end
return if Locales.packs[base] then base else "en"
end
function Locales.codes()
local list = {}
for _, code in ORDER do
table.insert(list, { Code = code, Name = Locales.names[code] })
end
return list
end
return Locales
end
