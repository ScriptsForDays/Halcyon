UpdateLog = "boolean | { [string]: any }",
}
function Schema.accepts(kind, key)
local entry = Schema.elements[kind]
return Schema.shared[key] ~= nil or (entry ~= nil and entry.options[key] ~= nil)
end
local function distance(a, b)
a, b = string.lower(a), string.lower(b)
local rows = {}
for i = 0, #a do
rows[i] = { [0] = i }
end
for j = 1, #b do
rows[0][j] = j
end
for i = 1, #a do
for j = 1, #b do
local here, there = string.sub(a, i, i), string.sub(b, j, j)
local cost = if here == there then 0 else 1
local best = math.min(rows[i - 1][j] + 1, rows[i][j - 1] + 1, rows[i - 1][j - 1] + cost)
if i > 1 and j > 1 and here == string.sub(b, j - 1, j - 1) and string.sub(a, i - 1, i - 1) == there then
best = math.min(best, rows[i - 2][j - 2] + 1)
end
rows[i][j] = best
end
end
return rows[#a][#b]
end
function Schema.closest(name, known)
local best, bestScore = nil, math.huge
for candidate in known do
local score = distance(name, candidate)
if score < bestScore or (score == bestScore and best ~= nil and candidate < best) then
best, bestScore = candidate, score
end
end
return if bestScore <= math.max(2, #name // 4) then best else nil
end
local warned = {}
Schema.enabled = false
function Schema.warn(message)
if not Schema.enabled or warned[message] then
return
end
warned[message] = true
warn("[Halcyon debug] " .. message)
end
function Schema.check(what, options, known, shared)
if not Schema.enabled or type(options) ~= "table" then
return
end
for key in options do
if type(key) == "string" and known[key] == nil and (shared == nil or shared[key] == nil) then
local pool = table.clone(known)
for name in shared or {} do
pool[name] = true
end
local guess = Schema.closest(key, pool)
Schema.warn(`{what}: unknown option "{key}"{if guess then `, did you mean "{guess}"?` else "; Halcyon ignores it."}`)
end
end
end
return Schema
end
modules["Core/Scope"] = function()
local Scope = {}
Scope.__index = Scope
local function release(item)
local kind = typeof(item)
if kind == "function" then
item()
elseif kind == "thread" then
if coroutine.running() ~= item then
pcall(task.cancel, item)
end
elseif kind == "RBXScriptConnection" then
item:Disconnect()
elseif kind == "Instance" then
item:Destroy()
elseif kind == "table" then
if item.clean then
item:clean()
elseif item.Destroy then
item:Destroy()
elseif item.Disconnect then
item.Disconnect()
end
end
end
function Scope.new()
return setmetatable({ items = {}, cleaned = false }, Scope)
end
function Scope:add(item)
if self.cleaned then
release(item)
else
table.insert(self.items, item)
end
return item
end
function Scope:connect(signal, handler)
return self:add(signal:Connect(handler))
end
function Scope:child()
return self:add(Scope.new())
end
function Scope:release(item)
local index = table.find(self.items, item)
if index then
table.remove(self.items, index)
end
release(item)
end
function Scope:clean()
if self.cleaned then
return
end
self.cleaned = true
local items = self.items
for index = #items, 1, -1 do
local item = items[index]
items[index] = nil
release(item)
end
end
return Scope
end
end
]]></ProtectedString>
</Properties>

</Item>
<Item class="ModuleScript" referent="RBX3">
<Properties>
<string name="Name">Part03</string>
<ProtectedString name="Source"><![CDATA[return function(modules, import)
modules["Core/Signal"] = function()
local Signal = {}
Signal.__index = Signal
function Signal.new()
return setmetatable({ list = {} }, Signal)
end
function Signal:Connect(handler)
local list = self.list
local connection = { Connected = true, handler = handler }
function connection.Disconnect()
if not connection.Connected then
return
end
connection.Connected = false
local index = table.find(list, connection)
if index then
table.remove(list, index)
end
end
table.insert(list, connection)
return connection
end
function Signal:Once(handler)
local connection
connection = self:Connect(function(...)
connection.Disconnect()
handler(...)
end)
return connection
end
function Signal:Fire(...)
for _, connection in table.clone(self.list) do
if connection.Connected then
task.spawn(connection.handler, ...)
end
end
end
function Signal:Destroy()
for _, connection in self.list do
connection.Connected = false
end
table.clear(self.list)
end
return Signal
end
modules["Core/Strings"] = function()
local Locales = import("Locales/Locales")
local Strings = {
language = "en",
}
local overrides = {}
local pack = {}
local seen = {}
local function fill(text, values)
if not values then
return text
end
return (string.gsub(text, "{(%w+)}", function(name)
local value = values[name]
return if value ~= nil then tostring(value) else nil
end))
end
function Strings.get(key, values)
seen[key] = true
return fill(overrides[key] or pack[key] or key, values)
end
function Strings.setLanguage(code)
local chosen = Locales.resolve(code)
Strings.language = chosen
pack = Locales.packs[chosen] or {}
return chosen
end
function Strings.set(map)
for key, value in map do
if type(key) == "string" then
overrides[key] = if type(value) == "string" then value else nil
end
end
end
function Strings.list()
local list = {}
for key in seen do
list[key] = Strings.get(key)
end
return list
end
function Strings.languages()
return Locales.codes()
end
return Strings
end
modules["Core/Styles"] = function()
local Schema = import("Core/Schema")
local Styles = { kinds = {} }
local function entry(kind)
local found = Styles.kinds[kind]
if not found then
found = { order = {}, specs = {} }
Styles.kinds[kind] = found
end
return found
end
function Styles.register(kind, name, spec)
if type(kind) ~= "string" or type(name) ~= "string" or name == "" then
return false, "AddStyle expects a kind and a name"
end
if type(spec) ~= "table" then
return false, "AddStyle expects a table describing the look"
end
local found = entry(kind)
if not found.specs[name] then
table.insert(found.order, name)
end
found.specs[name] = spec
return true, nil
end
function Styles.extend(kind, base, name, changes)
local parent = Styles.get(kind, base)
if not parent then
return false, string.format("%s has no look called %q", kind, tostring(base))
end
local spec = table.clone(parent)
for key, value in changes do
spec[key] = value
end
return Styles.register(kind, name, spec)
end
function Styles.get(kind, name)
local found = Styles.kinds[kind]
return if found and type(name) == "string" then found.specs[name] else nil
end
function Styles.has(kind, name)
return Styles.get(kind, name) ~= nil
end
function Styles.names(kind)
local found = Styles.kinds[kind]
return if found then table.clone(found.order) else {}
end
function Styles.pick(kind, explicit, window)
local found = Styles.kinds[kind]
if not found then
return nil, nil
end
if found.specs[explicit] then
return found.specs[explicit], explicit
end
if type(explicit) == "string" then
local guess = Schema.closest(explicit, found.specs)
Schema.warn(`{kind} look "{explicit}" doesn't exist{if guess then `; did you mean "{guess}"?` else "."} Looks: {table.concat(found.order, ", ")}.`)
end
local preferred = window and window.styles and window.styles[kind]
if found.specs[preferred] then
return found.specs[preferred], preferred
end
local first = found.order[1]
return found.specs[first], first
end
local LEGACY = {
ToggleThumb = "Thumb",
SliderTooltipStyle = "SliderTooltip",
SectionStyle = "Section",
ButtonEffect = "ButtonEffect",
TabStyle = "Navigation",
MinimizeStyle = "Minimize",
WindowStyle = "Window",
OpenAnimation = "Open",
PageTransition = "PageTransition",
TopbarControls = "Controls",
TopbarImageStyle = "TopbarImage",
HeaderStyle = "Header",
TabIndicator = "TabIndicator",
}
function Styles.defaults(options)
local chosen = {}
for option, kind in LEGACY do
if type(options[option]) == "string" then
chosen[kind] = options[option]
end
end
if type(options.Styles) == "table" then
for kind, name in options.Styles do
if type(kind) == "string" and type(name) == "string" then
chosen[kind] = name
end
end
end
return chosen
end
return Styles
end
modules["Core/Theme"] = function()
local Signal = import("Core/Signal")
local Schema = import("Core/Schema")
local ROLES = {
"background",
"surface",
"card",
"raised",
"hover",
"stroke",
"text",
"textMuted",
"accent",
"accentHover",
"onAccent",
"focus",
"success",
"warning",
"danger",
"info",
}
local TEXT_SURFACES = { "background", "surface", "card", "raised" }
local READABLE, UNREADABLE = 4.5, 3
local Theme = {
Roles = ROLES,
Changed = Signal.new(),
GradientChanged = Signal.new(),
palettes = {},
order = {},
current = nil,
accent = nil,
generation = 0,
bindings = {},
}
local function channel(value)
return if value <= 0.03928 then value / 12.92 else ((value + 0.055) / 1.055) ^ 2.4
end
local function luminance(color)
return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end
function Theme.contrast(first, second)
local a, b = luminance(first), luminance(second)
return (math.max(a, b) + 0.05) / (math.min(a, b) + 0.05)
end
function Theme.worstContrast(palette)
local worst, pair = math.huge, ""
local function consider(text, surface)
local ratio = Theme.contrast(palette[text], palette[surface])
if ratio < worst then
worst, pair = ratio, text .. " on " .. surface
end
end
for _, surface in TEXT_SURFACES do
consider("text", surface)
consider("textMuted", surface)
end
consider("onAccent", "accent")
return worst, pair
end
function Theme.add(definition)
if type(definition) ~= "table" or type(definition.Name) ~= "string" or definition.Name == "" then
return false, "A theme needs a Name."
end
local base = if definition.Base then Theme.palettes[definition.Base] else nil
if definition.Base and not base then
return false, `Base theme "{definition.Base}" does not exist.`
end
local palette = { Name = definition.Name }
for _, role in ROLES do
local color = definition[role] or (base and base[role])
if typeof(color) ~= "Color3" then
return false, `Theme "{definition.Name}" is missing the "{role}" colour.`
end
palette[role] = color
end
local worst, pair = Theme.worstContrast(palette)
if worst < UNREADABLE then
return false, string.format('Theme "%s" is unreadable: %s has a contrast of %.1f.', definition.Name, pair, worst)
end
if not Theme.palettes[palette.Name] then
table.insert(Theme.order, palette.Name)
end
Theme.palettes[palette.Name] = palette
if Theme.current and Theme.current.Name == palette.Name then
Theme.set(palette.Name)
end
if worst < READABLE then
return true, string.format("%s has a contrast of %.1f; 4.5 or more is easier to read.", pair, worst)
end
return true, nil
end
function Theme.names()
return table.clone(Theme.order)
end
function Theme.color(role)
return Theme.current[role]
end
local function withAccent(palette, color)
local hue, saturation, value = color:ToHSV()
local tinted = table.clone(palette)
tinted.accent = color
tinted.accentHover = Color3.fromHSV(hue, saturation * 0.85, math.min(value * 1.12, 1))
tinted.focus = tinted.accentHover
tinted.onAccent = if luminance(color) > 0.35 then Color3.fromRGB(12, 14, 18) else Color3.new(1, 1, 1)
return tinted
end
local SAFE_STATUS = {
success = Color3.fromHex("56B4E9"),
warning = Color3.fromHex("F0E442"),
danger = Color3.fromHex("E66100"),
info = Color3.fromHex("CC79A7"),
}
local SAFE_STATUS_LIGHT = {
success = Color3.fromHex("0072B2"),
warning = Color3.fromHex("8A6D00"),
danger = Color3.fromHex("B34700"),
info = Color3.fromHex("8E3E73"),
}
function Theme.set(name)
local palette = Theme.palettes[name]
if not palette then
Schema.warn(`Theme "{name}" does not exist; the theme stays {Theme.current and Theme.current.Name or "as it was"}.`)
return false, `Theme "{name}" does not exist.`
end
if Theme.accent then
palette = withAccent(palette, Theme.accent)
end
if Theme.safeStatus then
palette = table.clone(palette)
local light = luminance(palette.background) > 0.5
for role, color in if light then SAFE_STATUS_LIGHT else SAFE_STATUS do
palette[role] = color
end
end
Theme.current = palette
local function apply()
for instance, properties in Theme.bindings do
for property, role in properties do
instance[property] = Theme.current[role]
end
end
end
apply()
Theme.generation += 1
local generation = Theme.generation
task.delay(0.4, function()
if Theme.generation == generation then
apply()
end
end)
Theme.Changed:Fire(name)
return true, nil
end
function Theme.setSafeStatus(enabled)
Theme.safeStatus = enabled == true
return Theme.set(Theme.current.Name)
end
function Theme.setGradient(color)
if color == true then
Theme.gradientAuto, Theme.gradient = true, nil
else
Theme.gradientAuto = false
Theme.gradient = if typeof(color) == "Color3" then color else nil
end
Theme.GradientChanged:Fire()
end
function Theme.gradientEnd()
if Theme.gradient then
return Theme.gradient
elseif Theme.gradientAuto then
local hue, saturation, value = Theme.current.accent:ToHSV()
return Color3.fromHSV((hue + 0.11) % 1, saturation, value)
end
return nil
end
function Theme.setAccent(color)
Theme.accent = if typeof(color) == "Color3" then color else nil
return Theme.set(Theme.current.Name)
end
function Theme.bind(instance, property, role, deferred)
local properties = Theme.bindings[instance]
if not properties then
properties = {}
Theme.bindings[instance] = properties
instance.Destroying:Once(function()
Theme.bindings[instance] = nil
end)
end
properties[property] = role
if not deferred then
instance[property] = Theme.current[role]
end
end
function Theme.unbind(instance, property)
local properties = Theme.bindings[instance]
if properties then
properties[property] = nil
end
end
function Theme.paint(instance, property, value)
if typeof(value) == "Color3" then
Theme.unbind(instance, property)
instance[property] = value
elseif type(value) == "string" and Theme.current[value] ~= nil then
Theme.bind(instance, property, value)
end
end
return Theme
end
modules["Core/Tokens"] = function()
local RADIUS = {
Sharp = { scale = 0.25, pill = 3 },
Soft = { scale = 0.6, pill = nil },
Default = { scale = 1, pill = nil },
Round = { scale = 1.4, pill = nil },
}
local DENSITY = {
Compact = { rowHeight = 36, rowPadding = 5, gap = 4, sectionPadding = 8 },
Default = { rowHeight = 44, rowPadding = 8, gap = 6, sectionPadding = 10 },
Spacious = { rowHeight = 52, rowPadding = 12, gap = 8, sectionPadding = 14 },
}
local TEXT = { Default = 1, Large = 1.15, Larger = 1.3 }
local Tokens = {
Radius = { "Sharp", "Soft", "Default", "Round" },
Density = { "Compact", "Default", "Spacious" },
TextSize = { "Default", "Large", "Larger" },
radius = RADIUS.Default,
density = DENSITY.Default,
textScale = 1,
touch = false,
names = { radius = "Default", density = "Default", text = "Default" },
}
function Tokens.set(settings)
if type(settings) ~= "table" then
return
end
if RADIUS[settings.Radius] then
Tokens.radius, Tokens.names.radius = RADIUS[settings.Radius], settings.Radius
end
if DENSITY[settings.Density] then
Tokens.density, Tokens.names.density = DENSITY[settings.Density], settings.Density
end
if TEXT[settings.TextSize] then
Tokens.textScale, Tokens.names.text = TEXT[settings.TextSize], settings.TextSize
end
end
function Tokens.reset()
Tokens.radius, Tokens.density, Tokens.textScale = RADIUS.Default, DENSITY.Default, 1
Tokens.names = { radius = "Default", density = "Default", text = "Default" }
end
function Tokens.corner(radius)
if radius < 0 then
return Tokens.radius.pill or -1
end
return math.round(radius * Tokens.radius.scale)
end
function Tokens.text(size)
return math.round(size * Tokens.textScale)
end
function Tokens.rowHeight()
local height = Tokens.density.rowHeight
return if Tokens.touch then math.max(height, 44) else height
end
return Tokens
end
modules["Elements/Accordion"] = function()
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local Accordion = {}
function Accordion.new(container, options)
local row = Row.new(container, { Title = options.Title, Icon = options.Icon }, { button = true })
local handle, scope = row.handle, row.scope
local open = options.Open == true
local holder = Create.new("Frame", { Name = "Arrow", Size = UDim2.fromOffset(16, 16), Parent = row.slot })
local chevron = Create.icon("chevron-down", 16, "textMuted", holder)
local body = row.belowTitle()
local text = Create.new("TextLabel", {
Name = "Content",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
RichText = true,
TextSize = 13,
Text = tostring(options.Content or ""),
Theme = { TextColor3 = "textMuted" },
Parent = body,
})
local function draw(timing)
body.Visible = open
Motion.tween(chevron, timing, { Rotation = if open then 180 else 0 })
end
function handle:Get()
return open
end
function handle:SetOpen(wanted)
open = wanted == true
draw("fast")
self.Changed:Fire(open)
end
function handle:Set(content)
text.Text = tostring(content)
self.SearchExtra = text.Text
self.SearchText = string.lower(self.Title .. " " .. text.Text)
end
scope:connect(row.frame.Activated, function()
handle:SetOpen(not open)
end)
row.onHover(function(active)
Theme.bind(chevron, "ImageColor3", if active then "text" else "textMuted")
end)
draw(nil)
handle.SearchExtra = text.Text
handle.SearchText = string.lower(handle.Title .. " " .. text.Text)
return handle
end
return Accordion
end
modules["Elements/Banner"] = function()
local Create = import("Core/Create")
local Env = import("Core/Env")
local Icons = import("Core/Icons")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local Banner = {}
function Banner.new(container, options)
local row = Row.new(container, options, { bare = true, compact = true })
local handle, scope = row.handle, row.scope
local height = math.clamp(tonumber(options.Height) or 132, 72, 320)
local card = Create.new("Frame", {
Name = "Banner",
Size = UDim2.new(1, 0, 0, height),
ClipsDescendants = true,
Theme = { BackgroundColor3 = "raised" },
Parent = row.content,
})
Create.corner(10, card)
local picture
if options.Image then
picture = Create.new("ImageLabel", { Name = "Picture", Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Crop, Parent = card })
Create.corner(10, picture)
Icons.apply(picture, options.Image)
else
local tint = Create.new("Frame", { Name = "Tint", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.82, Theme = { BackgroundColor3 = "accent" }, Parent = card })
Create.corner(10, tint)
Create.new("UIGradient", {
Rotation = 20,
Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.7) }),
Parent = tint,
})
end
local shade = Create.new("Frame", { Name = "Shade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = if picture then 0.15 else 1, ZIndex = 2, Parent = card })
Create.corner(10, shade)
Create.new("UIGradient", {
Rotation = 90,
Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 0.75), NumberSequenceKeypoint.new(1, 0) }),
Parent = shade,
})
local words = Create.new("Frame", {
Name = "Words",
Size = UDim2.new(1, -32, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
AnchorPoint = Vector2.new(0, 1),
Position = UDim2.new(0, 16, 1, -14),
ZIndex = 3,
Parent = card,
})
Create.list(words, "Vertical", 2)
local onPicture = picture ~= nil
local title = Create.new("TextLabel", {
Name = "Title",
Size = UDim2.new(1, -120, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
Text = options.Title or "",
TextSize = 17,
Weight = "bold",
ZIndex = 3,
Parent = words,
})
local text = Create.new("TextLabel", {
Name = "Text",
Size = UDim2.new(1, -120, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
Text = options.Text or "",
TextSize = 13,
LayoutOrder = 1,
Visible = (options.Text or "") ~= "",
ZIndex = 3,
Parent = words,
})
if onPicture then
title.TextColor3 = Color3.new(1, 1, 1)
text.TextColor3 = Color3.fromRGB(225, 228, 234)
else
Theme.bind(title, "TextColor3", "text")
Theme.bind(text, "TextColor3", "textMuted")
end
local button
if type(options.Button) == "table" then
local settings = options.Button
button = Create.new("TextButton", {
Name = "Button",
Size = UDim2.fromOffset(0, row.reach + 4),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(1, 1),
Position = UDim2.new(1, -16, 1, -14),
Text = settings.Title or "Open",
TextSize = 13,
Weight = "medium",
ZIndex = 4,
Theme = { BackgroundColor3 = "accent", TextColor3 = "onAccent" },
Parent = card,
})
Create.corner(8, button)
Create.padding(button, 14, 0)
scope:connect(button.Activated, function()
row.fire(settings.Title)
Env.call(settings.Title or "Banner", settings.Callback)
end)
end
local function fit()
local scale = row.library.scale
local width = card.AbsoluteSize.X / scale
if width <= 0 then
return
end
local buttonWidth = if button then button.AbsoluteSize.X / scale else 0
local beside = width - 32 - buttonWidth - 12
local stacked = button ~= nil and beside < 180
local room = if button and not stacked then beside else width - 32
title.Size = UDim2.new(0, room, 0, 0)
text.Size = UDim2.new(0, room, 0, 0)
local below = if stacked then button.AbsoluteSize.Y / scale + 10 else 0
words.Position = UDim2.new(0, 16, 1, -14 - below)
if button then
button.AnchorPoint = if stacked then Vector2.new(0, 1) else Vector2.new(1, 1)
button.Position = if stacked then UDim2.new(0, 16, 1, -14) else UDim2.new(1, -16, 1, -14)
end
local needed = math.ceil(16 + words.AbsoluteSize.Y / scale + 14 + below)
card.Size = UDim2.new(1, 0, 0, math.max(height, needed))
end
scope:connect(card:GetPropertyChangedSignal("AbsoluteSize"), fit)
scope:connect(words:GetPropertyChangedSignal("AbsoluteSize"), fit)
if button then
scope:connect(button:GetPropertyChangedSignal("AbsoluteSize"), fit)
end
fit()
function handle:SetTitle(value)
self.Title = tostring(value)
title.Text = self.Title
end
function handle:SetText(value)
text.Text = tostring(value or "")
text.Visible = text.Text ~= ""
end
function handle:SetImage(source)
if picture then
Icons.apply(picture, source)
end
end
handle.SearchExtra = options.Text or ""
return handle
end
return Banner
end
modules["Elements/Button"] = function()
local Create = import("Core/Create")
local Effects = import("Core/Effects")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
local Keybind = import("Elements/Keybind")
local CONFIRM_WINDOW = 3
local FLASH = 1.2
Styles.register("Button", "Row", { row = true })
Styles.register("Button", "Filled", { fill = "accent", hover = "accentHover", text = "onAccent" })
Styles.register("Button", "Outline", { fill = "raised", hover = "hover", text = "text", stroke = "stroke" })
Styles.register("Button", "Danger", { fill = "danger", hover = "danger", text = "onAccent" })
Styles.register("Button", "Soft", { fill = "accent", fillTransparency = 0.82, hover = "accent", hoverTransparency = 0.72, text = "accent" })
Styles.register("Button", "Ghost", { fill = "hover", fillTransparency = 1, hover = "hover", hoverTransparency = 0, text = "text" })
Styles.register("Button", "Gradient", { fill = "accent", hover = "accentHover", text = "onAccent", gradient = true })
Styles.register("Button", "Success", { fill = "success", hover = "success", text = "onAccent" })
local Button = {}
function Button.new(container, options)
local look = Styles.pick("Button", options.Variant or options.Style, container.window)
local row, handle, target, label, indicator
local title = options.Title or ""
if look.row then
row = Row.new(container, options, { button = true })
handle, target, label = row.handle, row.frame, row.title
indicator = Create.icon(options.TrailingIcon or "chevron-right", 16, "textMuted", row.slot)
row.onHover(function(active)
Theme.bind(indicator, "ImageColor3", if active then "accent" else "textMuted")
end)
else
row = Row.new(container, options, { bare = true })
handle = row.handle
target = Create.new("TextButton", {
Name = "Button",
Size = UDim2.new(1, 0, 0, 36),
BackgroundTransparency = look.fillTransparency or 0,
Theme = { BackgroundColor3 = look.fill },
Parent = row.content,
})
Create.corner(8, target)
if look.stroke then
Create.stroke(look.stroke, target)
end
if look.gradient then
local gradient = Create.new("UIGradient", { Rotation = 20, Parent = target })
local function tint()
gradient.Color = ColorSequence.new(Theme.color("accent"), Theme.color("accentHover"))
end
tint()
row.scope:connect(Theme.Changed, tint)
end
local inner = Create.new("Frame", {
Name = "Inner",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(0.5, 0),
Position = UDim2.fromScale(0.5, 0),
ZIndex = 3,
Parent = target,
})
Create.list(inner, "Horizontal", 8)
indicator = Create.icon(options.Icon or "check", 16, look.text, inner)
indicator.Visible = options.Icon ~= nil
label = Create.new("TextLabel", {
Name = "Label",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = title,
Weight = "medium",
LayoutOrder = 2,
Theme = { TextColor3 = look.text },
Parent = inner,
})
local function paint(hovered)
local role = if hovered then look.hover else look.fill
Theme.bind(target, "BackgroundColor3", role, true)
Motion.tween(target, "fast", {
BackgroundColor3 = Theme.color(role),
BackgroundTransparency = if hovered then look.hoverTransparency or look.fillTransparency or 0 else look.fillTransparency or 0,
})
end
row.scope:connect(target.MouseEnter, function()
paint(true)
end)
row.scope:connect(target.MouseLeave, function()
paint(false)
end)
Effects.apply(row.scope, target, options.Effect or row.window.styles.ButtonEffect or row.window.buttonEffect, 8)
end
local spinner = Effects.spinner(row.scope, indicator.Parent, 14, if look.row then "accent" else look.text)
spinner.frame.LayoutOrder = indicator.LayoutOrder
local busy, armed, flashing = false, false, 0
local resting = { icon = if look.row then options.TrailingIcon or "chevron-right" else options.Icon, visible = indicator.Visible }
local function setText(text)
if label then
label.Text = text
end
end
local function flash(ok)
flashing += 1
local mine = flashing
Icons.apply(indicator, if ok then "check" else "x")
Theme.bind(indicator, "ImageColor3", if ok then "success" else "danger")
indicator.Visible = true
task.delay(FLASH, function()
if mine ~= flashing or row.scope.cleaned then
return
end
indicator.Visible = resting.visible
if resting.icon then
Icons.apply(indicator, resting.icon)
end
Theme.bind(indicator, "ImageColor3", if look.row then "textMuted" else look.text)
end)
end
local function run()
if busy then
return
end
if options.ShowDone then
handle.Changed:Fire()
row.run(options.Callback, flash)
else
row.fire()
end
end
local confirmText = if type(options.Confirm) == "string" then options.Confirm else Strings.get("Press again to confirm")
local function activate()
if busy then
return
end
if options.Confirm and not armed then
armed = true
setText(confirmText)
task.delay(CONFIRM_WINDOW, function()
if armed and not row.scope.cleaned then
armed = false
setText(handle.Title)
end
end)
return
end
if armed then
armed = false
setText(handle.Title)
end
run()
end
local hold = if options.Hold == true then 1 elseif type(options.Hold) == "number" then options.Hold else nil
if hold then
local bar = Create.new("Frame", {
Name = "Hold",
Size = UDim2.fromScale(0, 1),
BackgroundTransparency = 0.7,
Theme = { BackgroundColor3 = if look.row then "accent" else "text" },
Parent = Effects.layer(target, 8),
})
local holding = 0
local function release()
holding += 1
Motion.tween(bar, "fast", { Size = UDim2.fromScale(0, 1) })
end
row.scope:connect(target.InputBegan, function(input)
local kind = input.UserInputType
if busy or (kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch) then
return
end
holding += 1
local mine = holding
bar.Size = UDim2.fromScale(0, 1)
Motion.tween(bar, TweenInfo.new(hold, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) })
task.delay(hold, function()
if mine == holding and not row.scope.cleaned then
release()
run()
end
end)
end)
row.scope:connect(target.InputEnded, function(input)
local kind = input.UserInputType
if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
release()
end
end)
row.scope:connect(target.MouseLeave, release)
else
row.scope:connect(target.Activated, activate)
end
function handle:SetTitle(text)
self.Title = text
armed = false
setText(text)
self.SearchText = string.lower(text)
end
function handle:SetLoading(loading, text)
busy = loading == true
if busy then
spinner.start()
indicator.Visible = false
if text then
setText(text)
end
else
spinner.stop()
indicator.Visible = resting.visible
setText(self.Title)
end
end
function handle:IsLoading()
return busy
end
local ownLoading = false
function row.busy(on)
if on and not busy then
ownLoading = true
handle:SetLoading(true)
elseif not on and ownLoading then
ownLoading = false
handle:SetLoading(false)
end
end
function handle:Press()
run()
end
if options.Keybind then
local settings = if typeof(options.Keybind) == "EnumItem" then { Default = options.Keybind } else options.Keybind
local problem = row.window:checkFlag(settings.Flag)
if problem then
handle:Destroy()
error(problem, 4)
end
handle.Keybind = Keybind.control(row, { Default = settings.Default, Mode = "Press", Modifiers = settings.Modifiers }, function(pressed)
if pressed then
activate()
end
end)
row.window:claimFlag(settings.Flag, handle.Keybind, row.scope)
end
return handle
end
return Button
end
modules["Elements/Buttons"] = function()
local Create = import("Core/Create")
local Effects = import("Core/Effects")
local Env = import("Core/Env")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
local Buttons = {}
function Buttons.new(container, options)
local row = Row.new(container, options, { bare = options.Title == nil })
local handle, scope = row.handle, row.scope
local holder = Create.new("Frame", {
Name = "Buttons",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 3,
Parent = row.content,
})
Create.list(holder, "Horizontal", 8, { Wraps = true })
handle.Buttons = {}
for index, spec in options.Buttons or {} do
local look = Styles.get("Button", spec.Variant or spec.Style)
if not look or look.row then
look = Styles.get("Button", if index == 1 then "Filled" else "Outline")
end
local button = Create.new("TextButton", {
Name = "Button",
Size = UDim2.fromOffset(0, 36),
LayoutOrder = index,
BackgroundTransparency = look.fillTransparency or 0,
Theme = { BackgroundColor3 = look.fill },
Parent = holder,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Grow }) })
Create.corner(8, button)
if look.stroke then
Create.stroke(look.stroke, button)
end
local inner = Create.new("Frame", {
Name = "Inner",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(0.5, 0),
Position = UDim2.fromScale(0.5, 0),
ZIndex = 3,
Parent = button,
})
Create.list(inner, "Horizontal", 6)
if spec.Icon then
Create.icon(spec.Icon, 15, look.text, inner)
end
Create.new("TextLabel", {
Name = "Label",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(spec.Title or ""),
Weight = "medium",
TextSize = 13,
LayoutOrder = 1,
Theme = { TextColor3 = look.text },
Parent = inner,
})
local function fit()
button.Size = UDim2.fromOffset(inner.AbsoluteSize.X + 28, 36)
end
scope:connect(inner:GetPropertyChangedSignal("AbsoluteSize"), fit)
fit()
local function paint(hovered)
local role = if hovered then look.hover else look.fill
Theme.bind(button, "BackgroundColor3", role, true)
Motion.tween(button, "fast", {
BackgroundColor3 = Theme.color(role),
BackgroundTransparency = if hovered then look.hoverTransparency or look.fillTransparency or 0 else look.fillTransparency or 0,
})
end
scope:connect(button.MouseEnter, function()
paint(true)
end)
scope:connect(button.MouseLeave, function()
paint(false)
end)
scope:connect(button.Activated, function()
handle.Changed:Fire(spec.Title)
Env.call(tostring(spec.Title), spec.Callback)
end)
Effects.apply(scope, button, spec.Effect or row.window.styles.ButtonEffect or row.window.buttonEffect, 8)
handle.Buttons[index] = button
end
local words = {}
for _, spec in options.Buttons or {} do
table.insert(words, tostring(spec.Title or ""))
end
handle.SearchExtra = table.concat(words, " ")
handle.SearchText = string.lower((options.Title or "") .. " " .. handle.SearchExtra)
return handle
end
return Buttons
end
modules["Elements/Chart"] = function()
local Arc = import("Core/Arc")
local Create = import("Core/Create")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local Chart = {}
local ROLES = { "accent", "info", "success", "warning", "danger", "textMuted" }
local TYPES = { Donut = true, Pie = true, Line = true, Bars = true }
local INSET = 10
local function format(options, value)
if type(options.Format) == "function" then
local ok, text = pcall(options.Format, value)
if ok then
return tostring(text)
end
end
local rounded = if math.abs(value) >= 100 then math.round(value) else math.round(value * 10) / 10
return tostring(rounded) .. (options.Suffix or "")
end
local function colourOf(entry, index)
return entry.Role or ROLES[(index - 1) % #ROLES + 1]
end
function Chart.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local kind = if TYPES[options.Type] then options.Type else "Line"
local round = kind == "Donut" or kind == "Pie"
local height = math.clamp(tonumber(options.Height) or (if round then 132 else 140), 60, 320)
local items = options.Items or {}
local series = options.Series or {}
local labels = options.Labels or {}
local below = row.belowTitle()
if not round then
Create.list(below, "Vertical", 6)
end
local body = Create.new("Frame", { Name = "Chart", Size = UDim2.new(1, 0, 0, height), LayoutOrder = 1, Parent = below })
local legend = Create.new("Frame", {
Name = "Legend",
Size = if round then UDim2.new(1, -height - 16, 1, 0) else UDim2.new(1, 0, 0, 0),
Position = if round then UDim2.fromOffset(height + 16, 0) else UDim2.new(),
AutomaticSize = if round then Enum.AutomaticSize.None else Enum.AutomaticSize.Y,
Parent = if round then body else below,
})
Create.list(legend, if round then "Vertical" else "Horizontal", if round then 6 else 12, {
VerticalAlignment = Enum.VerticalAlignment.Center,
Wraps = not round,
})
local legendRows = {}
local function drawLegend(entries, withValues)
legend:ClearAllChildren()
Create.list(legend, if round then "Vertical" else "Horizontal", if round then 6 else 12, {
VerticalAlignment = Enum.VerticalAlignment.Center,
Wraps = not round,
})
table.clear(legendRows)
local total = 0
for _, entry in entries do
total += tonumber(entry.Value) or 0
end
for index, entry in entries do
local line = Create.new("Frame", { Name = "Entry", Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = index, Parent = legend })
Create.list(line, "Horizontal", 6, { VerticalAlignment = Enum.VerticalAlignment.Center })
local dot = Create.new("Frame", { Name = "Swatch", Size = UDim2.fromOffset(8, 8), Theme = { BackgroundColor3 = colourOf(entry, index) }, Parent = line })
Create.corner(-1, dot)
local share = if total > 0 then math.round((tonumber(entry.Value) or 0) / total * 100) else 0
local text = Create.new("TextLabel", {
Name = "Name",
Size = UDim2.fromOffset(0, 18),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
LayoutOrder = 1,
Text = if withValues then `{entry.Name or ""}  <font transparency="0.4">{format(options, tonumber(entry.Value) or 0)} · {share}%</font>` else tostring(entry.Name or ""),
RichText = true,
Theme = { TextColor3 = "text" },
Parent = line,
})
legendRows[index] = text
end
end
local ring, centre, arcs = nil, nil, {}
if round then
ring = Create.new("Frame", { Name = "Ring", Size = UDim2.fromOffset(height, height), Parent = body })
centre = Create.new("TextLabel", {
Name = "Centre",
Size = UDim2.fromScale(1, 1),
TextSize = 13,
Weight = "bold",
TextWrapped = true,
TextXAlignment = Enum.TextXAlignment.Center,
Visible = kind == "Donut",
Theme = { TextColor3 = "text" },
ZIndex = 3,
Parent = ring,
})
end
local thickness = if kind == "Pie" then math.floor(height / 2) - 1 else math.max(math.round(height / 9), 8)
local function total()
local sum = 0
for _, item in items do
sum += math.max(tonumber(item.Value) or 0, 0)
end
return sum
end
local function drawRound()
for _, arc in arcs do
arc:Destroy()
end
table.clear(arcs)
local sum = total()
local reach = {}
local running = 0
for index, item in items do
running += math.max(tonumber(item.Value) or 0, 0)
reach[index] = if sum > 0 then running / sum else 0
end
if sum <= 0 then
local empty = Arc.new(ring, { Thickness = thickness, Role = "raised", Radius = -1, Even = false })
table.insert(arcs, empty)
end
for index = #items, 1, -1 do
local arc = Arc.new(ring, { Thickness = thickness, Role = colourOf(items[index], index), Radius = -1, Even = false, ZIndex = 2 })
arc:Set(reach[index])
table.insert(arcs, arc)
end
if centre then
centre.Text = format(options, sum)
end
drawLegend(items, true)
end
if round then
scope:connect(ring.MouseMoved, function(x, y)
local sum = total()
if sum <= 0 or not centre then
return
end
local middle = ring.AbsolutePosition + ring.AbsoluteSize / 2
local angle = math.deg(math.atan2(x - middle.X, -(y - middle.Y)))
if angle < 0 then
angle += 360
end
local running = 0
for index, item in items do
running += math.max(tonumber(item.Value) or 0, 0)
if angle / 360 <= running / sum then
centre.Text = `{item.Name or ""}\n{format(options, tonumber(item.Value) or 0)}`
for other, label in legendRows do
label.TextTransparency = if other == index then 0 else 0.5
end
return
end
end
end)
scope:connect(ring.MouseLeave, function()
if centre then
centre.Text = format(options, total())
end
for _, label in legendRows do
label.TextTransparency = 0
end
end)
end
local plot, marks, guide, readout
if not round then
plot = Create.new("Frame", {
Name = "Plot",
Size = UDim2.fromScale(1, 1),
ClipsDescendants = true,
Theme = { BackgroundColor3 = row.controlRole },
Parent = body,
})
Create.corner(8, plot)
marks = Create.new("Frame", { Name = "Marks", Size = UDim2.fromScale(1, 1), Parent = plot })
guide = Create.new("Frame", {
Name = "Guide",
Size = UDim2.new(0, 1, 1, -INSET * 2),
Position = UDim2.fromOffset(0, INSET),
Visible = false,
ZIndex = 4,
Theme = { BackgroundColor3 = "textMuted" },
Parent = plot,
})
readout = Create.new("TextLabel", {
Name = "Readout",
Size = UDim2.fromOffset(0, 20),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
RichText = true,
Visible = false,
ZIndex = 5,
Theme = { BackgroundColor3 = "surface", TextColor3 = "text" },
Parent = plot,
})
Create.corner(6, readout)
Create.padding(readout, 8, 0)
Create.stroke("stroke", readout)
end
local function longest()
local count = #labels
for _, entry in series do
count = math.max(count, #(entry.Values or {}))
end
return count
end
local function range()
local low, high = math.huge, -math.huge
for _, entry in series do
for _, value in entry.Values or {} do
if type(value) == "number" then
low, high = math.min(low, value), math.max(high, value)
end
end
end
if kind == "Bars" or low == math.huge then
low = math.min(if low == math.huge then 0 else low, 0)
end
if type(options.Min) == "number" then
low = options.Min
end
if type(options.Max) == "number" then
high = options.Max
end
if high == -math.huge or high - low < 1e-6 then
high = low + 1
end
return low, high
end
local function drawPlot()
marks:ClearAllChildren()
local size = plot.AbsoluteSize / row.library.scale
local count = longest()
drawLegend(series, false)
if size.X <= 0 or count == 0 then
return
end
local low, high = range()
local width, tall = size.X - INSET * 2, size.Y - INSET * 2
local function y(value)
return INSET + tall - (value - low) / (high - low) * tall
end
if kind == "Line" then
local step = if count > 1 then width / (count - 1) else 0
for index, entry in series do
local role = colourOf(entry, index)
local values = entry.Values or {}
for point = 2, #values do
local a, b = values[point - 1], values[point]
if type(a) == "number" and type(b) == "number" then
local x1, y1 = INSET + (point - 2) * step, y(a)
local x2, y2 = INSET + (point - 1) * step, y(b)
local dx, dy = x2 - x1, y2 - y1
local segment = Create.new("Frame", {
Name = "Segment",
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 1, 2),
Rotation = math.deg(math.atan2(dy, dx)),
ZIndex = 3,
Theme = { BackgroundColor3 = role },
Parent = marks,
})
Create.corner(-1, segment)
end
end
end
else
local group = width / count
local per = math.max((group - 6) / math.max(#series, 1), 2)
local base = y(math.max(low, 0))
for slot = 1, count do
for index, entry in series do
local value = (entry.Values or {})[slot]
if type(value) == "number" then
local top = y(value)
local bar = Create.new("Frame", {
Name = "Bar",
Position = UDim2.fromOffset(INSET + (slot - 1) * group + 3 + (index - 1) * per, math.min(top, base)),
Size = UDim2.fromOffset(math.max(per - 2, 1), math.max(math.abs(base - top), 1)),
ZIndex = 2,
Theme = { BackgroundColor3 = colourOf(entry, index) },
Parent = marks,
})
Create.corner(3, bar)
end
end
end
end
end
if plot then
scope:connect(plot.MouseMoved, function(x)
local count = longest()
local size = plot.AbsoluteSize
if count == 0 or size.X <= 0 then
return
end
local pointerX = (x - plot.AbsolutePosition.X) / row.library.scale
local width = size.X / row.library.scale - INSET * 2
local slot
if kind == "Line" then
slot = if count > 1 then math.clamp(math.round((pointerX - INSET) / width * (count - 1)) + 1, 1, count) else 1
else
slot = math.clamp(math.floor((pointerX - INSET) / width * count) + 1, 1, count)
end
local parts = { `<b>{labels[slot] or slot}</b>` }
for index, entry in series do
local value = (entry.Values or {})[slot]
if type(value) == "number" then
local colour = Theme.color(colourOf(entry, index)):ToHex()
table.insert(parts, `<font color="#{colour}">{entry.Name or ""}</font> {format(options, value)}`)
end
end
local guideX = if kind == "Line" then INSET + (if count > 1 then (slot - 1) * width / (count - 1) else 0) else INSET + (slot - 0.5) * width / count
guide.Position = UDim2.fromOffset(guideX, INSET)
guide.Visible = true
readout.Text = table.concat(parts, "  ")
readout.Visible = true
local plotWidth = size.X / row.library.scale
local readoutWidth = readout.AbsoluteSize.X / row.library.scale
if guideX + 6 + readoutWidth <= plotWidth - 4 then
readout.AnchorPoint = Vector2.new(0, 0)
readout.Position = UDim2.fromOffset(guideX + 6, 4)
else
readout.AnchorPoint = Vector2.new(1, 0)
readout.Position = UDim2.fromOffset(math.min(math.max(guideX - 6, readoutWidth + 4), plotWidth - 4), 4)
end
end)
scope:connect(plot.MouseLeave, function()
guide.Visible = false
readout.Visible = false
end)
scope:connect(plot:GetPropertyChangedSignal("AbsoluteSize"), drawPlot)
end
local function draw()
if round then
drawRound()
else
drawPlot()
end
end
scope:connect(Theme.Changed, function()
if not round then
drawPlot()
end
end)
function handle:Get()
return if round then items else series
end
function handle:Set(data)
if type(data) ~= "table" then
return
end
if round then
items = data
else
series = data
end
draw()
row.fire(data)
end
handle.SetItems = handle.Set
handle.SetSeries = handle.Set
function handle:SetLabels(list)
labels = list or {}
draw()
end
function handle:Push(values, label, keep)
if round or type(values) ~= "table" then
return
end
for index, entry in series do
entry.Values = entry.Values or {}
table.insert(entry.Values, values[index] or values[entry.Name])
if keep then
while #entry.Values > keep do
table.remove(entry.Values, 1)
end
end
end
if label ~= nil then
table.insert(labels, label)
if keep then
while #labels > keep do
table.remove(labels, 1)
end
end
end
draw()
end
draw()
return handle
end
return Chart
end
modules["Elements/Choices"] = function()
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Options = import("Elements/Options")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local Choices = {}
local function build(container, options, mode)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local multi = mode == "checklist" or (mode == "chips" and options.Multi == true)
local entries, values = Options.entries(options.Values)
local picked = {}
local items = {}
local chips = mode == "chips"
local area = row.belowTitle()
if chips or options.Inline then
Create.list(area, "Horizontal", if chips then 6 else 14, { Wraps = true, VerticalAlignment = Enum.VerticalAlignment.Top })
else
Create.list(area, "Vertical", 2)
end
local height = if row.library.touch then 40 else (if chips then 28 else 30)
local function draw(timing)
for _, item in items do
local on = if item.all then #Options.ordered(values, picked) == #values else picked[item.value] == true
local some = item.all and not on and next(picked) ~= nil
if chips then
Theme.bind(item.button, "BackgroundColor3", if on then "accent" else row.controlRole)
Theme.bind(item.label, "TextColor3", if on then "onAccent" else "text")
Theme.bind(item.edge, "Color", if on then "accent" else "stroke")
else
Theme.bind(item.edge, "Color", if on or some then "accent" else "stroke")
Theme.bind(item.mark, "BackgroundColor3", "accent")
Motion.tween(item.mark, timing, { BackgroundTransparency = if multi and (on or some) then 0 else 1 })
local size = if multi then (if on then 12 else 0) else (if on then 8 else 0)
Motion.tween(item.glyph, if timing and on then "spring" else timing, { Size = UDim2.fromOffset(size, size) })
if item.bar then
item.bar.Visible = some
end
item.label.FontFace = Create.font(if on then "medium" else "regular")
end
end
end
local function store(value)
Options.pick(values, picked, value, multi)
draw("fast")
end
function handle:Get()
local list = Options.ordered(values, picked)
return if multi then list else list[1]
end
function handle:Set(value)
store(value)
row.fire(self:Get())
end
local function press(item)
if item.disabled then
return
end
if item.all then
local everything = #Options.ordered(values, picked) == #values
handle:Set(if everything then {} else table.clone(values))
elseif multi then
local chosen = Options.ordered(values, picked)
local found = table.find(chosen, item.value)
if found then
table.remove(chosen, found)
else
table.insert(chosen, item.value)
end
handle:Set(chosen)
else
handle:Set(if picked[item.value] and options.AllowNone then nil else item.value)
end
end
local function addItem(entry, order, all)
local button = Create.new("TextButton", {
Name = "Option",
Size = if chips then UDim2.fromOffset(0, height) elseif options.Inline then UDim2.fromOffset(0, height) else UDim2.new(1, 0, 0, height),
AutomaticSize = if chips or options.Inline then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
LayoutOrder = order,
BackgroundTransparency = if chips then 0 else 1,
Theme = { BackgroundColor3 = if chips then row.controlRole else "hover" },
Parent = area,
})
local item = { button = button, value = entry.value, all = all, disabled = entry.disabled }
if chips then
Create.corner(-1, button)
item.edge = Create.stroke("stroke", button)
Create.padding(button, 12, 0)
Create.list(button, "Horizontal", 6)
if entry.icon then
Create.icon(entry.icon, 14, "textMuted", button)
end
else
Create.corner(6, button)
Create.padding(button, if options.Inline then 0 else 6, 0)
Create.list(button, "Horizontal", 10)
local mark = Create.new("Frame", { Name = "Mark", Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Parent = button })
Create.corner(if multi then 5 else -1, mark)
item.mark = mark
item.edge = Create.stroke("stroke", mark, 1.5)
if multi then
local check = Create.icon("check", 12, "onAccent", mark)
check.AnchorPoint, check.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
item.glyph = check
if all then
item.bar = Create.new("Frame", {
Name = "Some",
Size = UDim2.fromOffset(10, 2),
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.5),
Visible = false,
Theme = { BackgroundColor3 = "onAccent" },
Parent = mark,
})
end
else
local dot = Create.new("Frame", { Name = "Dot", Size = UDim2.fromOffset(0, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Theme = { BackgroundColor3 = "accent" }, Parent = mark })
Create.corner(-1, dot)
item.glyph = dot
end
end
item.label = Create.new("TextLabel", {
Name = "Text",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = entry.text,
TextSize = 13,
LayoutOrder = 2,
Theme = { TextColor3 = if entry.disabled then "textMuted" else "text" },
Parent = button,
})
if entry.description and not chips then
item.label.Text = `{entry.text}  <font transparency="0.4" size="12">{entry.description}</font>`
item.label.RichText = true
end
if not chips then
scope:connect(button.MouseEnter, function()
if not item.disabled then
Motion.tween(button, "fast", { BackgroundTransparency = if options.Inline then 1 else 0.4 })
Theme.bind(item.edge, "Color", "textMuted")
end
end)
scope:connect(button.MouseLeave, function()
Motion.tween(button, "fast", { BackgroundTransparency = 1 })
draw("fast")
end)
end
scope:connect(button.Activated, function()
press(item)
end)
table.insert(items, item)
end
if mode == "checklist" and options.SelectAll then
addItem({ text = if type(options.SelectAll) == "string" then options.SelectAll else Strings.get("Select all") }, 0, true)
end
for index, entry in entries do
if entry.heading == nil then
addItem(entry, index, false)
end
end
local default = options.Default
if default == nil and not multi and not options.AllowNone then
default = values[1]
end
Options.pick(values, picked, default, multi)
draw(nil)
return handle
end
function Choices.radio(container, options)
return build(container, options, "radio")
end
function Choices.checklist(container, options)
return build(container, options, "checklist")
end
function Choices.chips(container, options)
return build(container, options, "chips")
end
return Choices
end
modules["Elements/Code"] = function()
local Create = import("Core/Create")
local Env = import("Core/Env")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local MONOSPACE = Font.new("rbxasset://fonts/families/RobotoMono.json")
local Code = {}
function Code.new(container, options)
local row = Row.new(container, { Title = options.Title or "Code" }, { bare = true })
local handle, scope, library = row.handle, row.scope, row.library
local code = options.Code or ""
local block = Create.new("Frame", {
Name = "Code",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Theme = { BackgroundColor3 = row.controlRole },
Parent = row.content,
})
Create.corner(8, block)
Create.stroke("stroke", block)
Create.list(block, "Vertical", 0)
local header = Create.new("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 36), Parent = block })
local caption = Create.new("TextLabel", {
Size = UDim2.new(1, -60, 1, 0),
Position = UDim2.fromOffset(12, 0),
Text = handle.Title,
TextSize = 12,
Weight = "medium",
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = "textMuted" },
Parent = header,
})
local copy = Create.new("TextButton", {
Name = "Copy",
Size = UDim2.fromOffset(44, 36),
AnchorPoint = Vector2.new(1, 0),
Position = UDim2.fromScale(1, 0),
Parent = header,
})
local glyph = Create.icon("copy", 14, "textMuted", copy)
glyph.AnchorPoint = Vector2.new(0.5, 0.5)
glyph.Position = UDim2.fromScale(0.5, 0.5)
local scroller = Create.new("ScrollingFrame", {
Name = "Lines",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
AutomaticCanvasSize = Enum.AutomaticSize.X,
ScrollingDirection = Enum.ScrollingDirection.X,
LayoutOrder = 1,
Parent = block,
})
Create.padding(scroller, 12, 0, 12, 12)
local text = Create.new("TextLabel", {
AutomaticSize = Enum.AutomaticSize.XY,
FontFace = MONOSPACE,
TextSize = 13,
TextYAlignment = Enum.TextYAlignment.Top,
Text = code,
Theme = { TextColor3 = "text" },
Parent = scroller,
})
function handle:Get()
return code
end
function handle:Set(newCode)
code = tostring(newCode)
text.Text = code
end
function handle:SetTitle(newTitle)
self.Title = newTitle
caption.Text = newTitle
self.SearchText = string.lower(newTitle)
end
scope:connect(copy.Activated, function()
if Env.copy(code) then
library.notify({ Title = Strings.get("Copied"), Kind = "success", Duration = 2 })
else
library.notify({ Title = Strings.get("Can't copy"), Content = Strings.get("This executor has no clipboard."), Kind = "warning" })
end
end)
return handle
end
return Code
end
modules["Elements/ColorPicker"] = function()
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Env = import("Core/Env")
local Icons = import("Core/Icons")
local Popup = import("Components/Popup")
local Row = import("Elements/Row")
local Signal = import("Core/Signal")
local WHITE, BLACK = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
local HUES = {}
for index = 0, 6 do
table.insert(HUES, ColorSequenceKeypoint.new(index / 6, Color3.fromHSV(index / 6, 1, 1)))
end
local FADE_IN = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
local FADE_OUT = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
local PALETTE = {
Color3.fromHex("F0616D"),
Color3.fromHex("F08C3A"),
Color3.fromHex("F5B74F"),
Color3.fromHex("3FCF8E"),
Color3.fromHex("22D3EE"),
Color3.fromHex("5B8DEF"),
Color3.fromHex("9D7BF5"),
Color3.fromHex("F0527F"),
Color3.fromHex("FFFFFF"),
Color3.fromHex("9BA3B2"),
Color3.fromHex("2A2F3A"),
Color3.fromHex("000000"),
}
local RECENT = 8
local ColorPicker = {}
local function parseHex(text)
local hex = string.gsub(text, "[#%s]", "")
if (#hex ~= 6 and #hex ~= 8) or string.find(hex, "%X") then
return nil
end
local color = Color3.fromRGB(tonumber(string.sub(hex, 1, 2), 16), tonumber(string.sub(hex, 3, 4), 16), tonumber(string.sub(hex, 5, 6), 16))
return color, if #hex == 8 then 1 - tonumber(string.sub(hex, 7, 8), 16) / 255 else nil
end
function ColorPicker.control(row, options, onCommit)
local scope, library = row.scope, row.library
local color = options.Default or WHITE
local transparency = if options.Alpha then options.Transparency or 0 else 0
local hue, saturation, value = color:ToHSV()
local control = { Changed = Signal.new() }
local redraw
scope:add(control.Changed)
local swatch = Create.new("TextButton", {
Name = "Swatch",
Size = UDim2.fromOffset(32, math.max(row.reach - 6, 20)),
BackgroundColor3 = color,
Parent = row.slot,
})
Create.corner(6, swatch)
Create.stroke("stroke", swatch)
local function hexText()
local text = color:ToHex()
return if options.Alpha then text .. string.format("%02x", math.round((1 - transparency) * 255)) else text
end
local function commit()
library.recentColors = library.recentColors or {}
local recent = library.recentColors
for index = #recent, 1, -1 do
if recent[index]:ToHex() == color:ToHex() then
table.remove(recent, index)
end
end
table.insert(recent, 1, color)
recent[RECENT + 1] = nil
control.Changed:Fire(color, transparency)
onCommit(color, transparency)
end
local function update(newHue, newSaturation, newValue, newTransparency, exact)
hue, saturation, value = newHue, newSaturation, newValue
transparency = newTransparency or transparency
color = exact or Color3.fromHSV(hue, saturation, value)
swatch.BackgroundColor3 = color
if redraw then
redraw()
end
end
function control:Get()
return color, transparency
end
function control:Set(newColor, newTransparency)
if type(newColor) == "string" then
newColor, newTransparency = parseHex(newColor)
end
if typeof(newColor) ~= "Color3" then
return
end
local newHue, newSaturation, newValue = newColor:ToHSV()
update(newHue, newSaturation, newValue, if options.Alpha then newTransparency else nil, newColor)
commit()
end
function control:Encode()
return hexText()
end
local function bar(parent, order)
local track = Create.new("TextButton", {
Size = UDim2.new(1, 0, 0, if library.touch then 22 else 14),
BackgroundColor3 = WHITE,
LayoutOrder = order,
Parent = parent,
})
Create.corner(-1, track)
local cursor = Create.new("Frame", {
Size = UDim2.new(0, 4, 1, 4),
AnchorPoint = Vector2.new(0.5, 0.5),
BackgroundColor3 = WHITE,
Parent = track,
})
Create.corner(-1, cursor)
Create.new("UIStroke", { Color = BLACK, Transparency = 0.5, Parent = cursor })
return track, cursor
end
scope:connect(swatch.Activated, function()
local popup = Popup.toggle(library, swatch, {
Width = 224,
OnClose = function()
redraw = nil
end,
})
if not popup then
return
end
local panel, session = popup.frame, popup.scope
local area = Create.new("TextButton", { Name = "Shade", Size = UDim2.new(1, 0, 0, 132), Parent = panel })
Create.corner(6, area)
local white = Create.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = area }, {
Create.new("UIGradient", { Transparency = FADE_OUT }),
})
Create.corner(6, white)
local black = Create.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, Parent = area }, {
Create.new("UIGradient", { Transparency = FADE_IN, Rotation = 90 }),
})
Create.corner(6, black)
local ring = Create.new("Frame", {
Size = UDim2.fromOffset(12, 12),
AnchorPoint = Vector2.new(0.5, 0.5),
ZIndex = 2,
BackgroundTransparency = 1,
Parent = area,
})
Create.corner(-1, ring)
Create.new("UIStroke", { Color = WHITE, Thickness = 2, Parent = ring })
local hueTrack, hueCursor = bar(panel, 1)
Create.new("UIGradient", { Color = ColorSequence.new(HUES), Parent = hueTrack })
local alphaTrack, alphaCursor, alphaGradient
if options.Alpha then
alphaTrack, alphaCursor = bar(panel, 2)
alphaGradient = Create.new("UIGradient", { Transparency = FADE_OUT, Parent = alphaTrack })
end
local fieldHeight = if library.touch then 40 else 28
local hexLine = Create.new("Frame", { Name = "HexLine", Size = UDim2.new(1, 0, 0, fieldHeight), LayoutOrder = 3, Parent = panel })
Create.list(hexLine, "Horizontal", 6)
local box = Create.new("TextBox", {
Name = "Hex",
Size = UDim2.fromScale(0, 1),
TextSize = 13,
TextXAlignment = Enum.TextXAlignment.Center,
Theme = { BackgroundColor3 = "raised", TextColor3 = "text" },
Parent = hexLine,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
Create.corner(6, box)
if Env.setclipboard then
local copy = Create.new("TextButton", {
Name = "Copy",
Size = UDim2.fromOffset(fieldHeight, fieldHeight),
LayoutOrder = 1,
Theme = { BackgroundColor3 = "raised" },
Parent = hexLine,
})
Create.corner(6, copy)
local glyph = Create.icon("copy", 14, "textMuted", copy)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
session:connect(copy.Activated, function()
Env.copy("#" .. string.upper(hexText()))
Icons.apply(glyph, "check")
task.delay(1, function()
if glyph.Parent then
Icons.apply(glyph, "copy")
end
end)
end)
end
local function swatchRow(name, colors, order)
if #colors == 0 then
return
end
local line = Create.new("Frame", { Name = name, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = panel })
Create.list(line, "Horizontal", 6, { Wraps = true })
for index, swatchColor in colors do
local chip = Create.new("TextButton", {
Name = "Swatch",
Size = UDim2.fromOffset(20, 20),
LayoutOrder = index,
BackgroundColor3 = swatchColor,
Parent = line,
})
Create.corner(-1, chip)
Create.new("UIStroke", { Transparency = 0.6, Theme = { Color = "text" }, Parent = chip })
session:connect(chip.Activated, function()
control:Set(swatchColor, transparency)
end)
end
end
local palette = if options.Palette == true then PALETTE elseif type(options.Palette) == "table" then options.Palette else {}
swatchRow("Palette", palette, 4)
if options.Recent ~= false then
swatchRow("Recent", library.recentColors or {}, 5)
end
function redraw()
area.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
ring.Position = UDim2.fromScale(saturation, 1 - value)
hueCursor.Position = UDim2.fromScale(hue, 0.5)
if alphaTrack then
alphaTrack.BackgroundColor3 = color
alphaGradient.Color = ColorSequence.new(color)
alphaCursor.Position = UDim2.fromScale(transparency, 0.5)
end
if not box:IsFocused() then
box.Text = "#" .. string.upper(hexText())
end
end
Drag.area(session, area, function(x, y)
update(hue, x, 1 - y)
end, commit)
Drag.area(session, hueTrack, function(x)
update(x, saturation, value)
end, commit)
if alphaTrack then
Drag.area(session, alphaTrack, function(x)
update(hue, saturation, value, x)
end, commit)
end
session:connect(box.FocusLost, function()
local typed, typedTransparency = parseHex(box.Text)
if typed then
control:Set(typed, typedTransparency)
end
redraw()
end)
redraw()
end)
return control
end
function ColorPicker.new(container, options)
local row = Row.new(container, options)
local handle = row.handle
local control = ColorPicker.control(row, options, function(color, transparency)
handle.Changed:Fire(color, transparency)
Env.call(handle.Title, options.Callback, color, transparency)
end)
function handle:Get()
return control:Get()
end
function handle:Set(color, transparency)
control:Set(color, transparency)
end
function handle:Encode()
return control:Encode()
end
return handle
end
return ColorPicker
end
modules["Elements/Countdown"] = function()
local Create = import("Core/Create")
local Env = import("Core/Env")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local Countdown = {}
local function clock(seconds)
seconds = math.max(0, math.floor(seconds))
local hours, minutes = seconds // 3600, (seconds // 60) % 60
if hours > 0 then
return string.format("%d:%02d:%02d", hours, minutes, seconds % 60)
end
return string.format("%d:%02d", minutes, seconds % 60)
end
function Countdown.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local remaining
local generation = 0
local readout = Create.new("TextLabel", {
Name = "Time",
Size = UDim2.fromOffset(0, 20),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 14,
Weight = "bold",
Theme = { TextColor3 = "text" },
Parent = row.slot,
})
local function text(left)
if left <= 0 and options.Done then
return tostring(options.Done)
end
if type(options.Format) == "function" then
local ok, shown = pcall(options.Format, left)
if ok and shown ~= nil then
return tostring(shown)
end
end
return clock(left)
end
local function run()
generation += 1
local mine = generation
task.spawn(function()
while mine == generation and not scope.cleaned do
local left = math.max(math.ceil(remaining or 0), 0)
readout.Text = text(left)
Theme.bind(readout, "TextColor3", if remaining and left <= 10 and left > 0 then "warning" else "text")
if not remaining or left <= 0 then
if remaining then
remaining = nil
Env.call(handle.Title, options.Callback)
handle.Changed:Fire(0)
end
return
end
local waited = task.wait(math.min(1, remaining))
if mine == generation and remaining then
remaining -= waited
end
end
end)
end
function handle:Get()
return if remaining then math.max(0, math.ceil(remaining)) else 0
end
function handle:Set(seconds)
seconds = tonumber(seconds)
remaining = if seconds and seconds > 0 then seconds else nil
run()
end
function handle:SetEnd(timestamp)
timestamp = tonumber(timestamp)
remaining = if timestamp and timestamp > os.time() then timestamp - os.time() else nil
run()
end
if options.Ends then
handle:SetEnd(options.Ends)
else
handle:Set(options.Seconds)
end
return handle
end
return Countdown
end
modules["Elements/DatePicker"] = function()
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Popup = import("Components/Popup")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local MONTHS = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" }
local DatePicker = {}
local function daysIn(year, month)
return os.date("*t", os.time({ year = year, month = month + 1, day = 0, hour = 12 })).day
end
local function firstColumn(year, month, mondayFirst)
local weekday = os.date("*t", os.time({ year = year, month = month, day = 1, hour = 12 })).wday
return if mondayFirst then (weekday + 5) % 7 + 1 else weekday
end
local function copy(date)
return { Year = date.Year, Month = date.Month, Day = date.Day, Hour = date.Hour, Minute = date.Minute }
end
function DatePicker.new(container, options)
local row = Row.new(container, options, { button = true })
local handle, scope, library = row.handle, row.scope, row.library
local now = os.date("*t")
local default = options.Default or {}
local value = {
Year = tonumber(default.Year) or now.year,
Month = math.clamp(tonumber(default.Month) or now.month, 1, 12),
Day = tonumber(default.Day) or now.day,
Hour = math.clamp(tonumber(default.Hour) or 12, 0, 23),
Minute = math.clamp(tonumber(default.Minute) or 0, 0, 59),
}
value.Day = math.clamp(value.Day, 1, daysIn(value.Year, value.Month))
local mondayFirst = options.WeekStart ~= "Sunday"
local withTime = options.Time == true
local chip = Create.new("Frame", { Name = "Value", Theme = { BackgroundColor3 = row.controlRole } })
row.placeControl(chip, options.Width or (if withTime then 170 else 140), math.max(row.reach, 30))
Create.corner(6, chip)
Create.stroke("stroke", chip)
Create.padding(chip, 10, 0)
Create.list(chip, "Horizontal", 8)
Create.icon("calendar", 14, "textMuted", chip)
local label = Create.new("TextLabel", {
Size = UDim2.fromScale(0, 1),
TextSize = 13,
LayoutOrder = 1,
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = "text" },
Parent = chip,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
row.onHover(function(active)
local role = if active then "hover" else row.controlRole
Theme.bind(chip, "BackgroundColor3", role, true)
Motion.tween(chip, "fast", { BackgroundColor3 = Theme.color(role) })
end, chip)
local function draw()
local text = string.format("%d %s %d", value.Day, string.sub(Strings.get(MONTHS[value.Month]), 1, 3), value.Year)
if withTime then
text ..= string.format("  %02d:%02d", value.Hour, value.Minute)
end
label.Text = text
end
function handle:Get()
return copy(value)
end
function handle:Set(date)
if type(date) ~= "table" then
return
end
value.Year = tonumber(date.Year) or value.Year
value.Month = math.clamp(tonumber(date.Month) or value.Month, 1, 12)
value.Day = math.clamp(tonumber(date.Day) or value.Day, 1, daysIn(value.Year, value.Month))
value.Hour = math.clamp(tonumber(date.Hour) or value.Hour, 0, 23)
value.Minute = math.clamp(tonumber(date.Minute) or value.Minute, 0, 59)
draw()
row.fire(self:Get())
end
function handle:GetTimestamp()
return os.time({ year = value.Year, month = value.Month, day = value.Day, hour = value.Hour, min = value.Minute })
end
scope:connect(row.frame.Activated, function()
local popup = Popup.toggle(library, chip, { Width = 252 })
if not popup then
return
end
local session = popup.scope
local shown = { Year = value.Year, Month = value.Month }
local cell = if library.touch then 34 else 30
local header = Create.new("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 28), Parent = popup.frame })
local title = Create.new("TextLabel", {
Size = UDim2.new(1, -64, 1, 0),
Position = UDim2.fromOffset(32, 0),
TextSize = 13,
Weight = "bold",
TextXAlignment = Enum.TextXAlignment.Center,
Theme = { TextColor3 = "text" },
Parent = header,
})
local function arrow(icon, side)
local button = Create.new("ImageButton", {
Name = icon,
Size = UDim2.fromOffset(28, 28),
AnchorPoint = Vector2.new(side, 0),
Position = UDim2.fromScale(side, 0),
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "hover" },
Parent = header,
})
Create.corner(6, button)
local glyph = Create.icon(icon, 14, "text", button)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
session:connect(button.MouseEnter, function()
button.BackgroundTransparency = 0
end)
session:connect(button.MouseLeave, function()
button.BackgroundTransparency = 1
end)
return button
end
local previous, following = arrow("chevron-left", 0), arrow("chevron-right", 1)
local grid = Create.new("Frame", { Name = "Days", Size = UDim2.new(1, 0, 0, cell * 7), LayoutOrder = 1, Parent = popup.frame })
Create.new("UIGridLayout", {
CellSize = UDim2.new(1 / 7, 0, 0, cell),
CellPadding = UDim2.fromOffset(0, 0),
SortOrder = Enum.SortOrder.LayoutOrder,
Parent = grid,
})
local names = if mondayFirst then { "Mo", "Tu", "We", "Th", "Fr", "Sa", "Su" } else { "Su", "Mo", "Tu", "We", "Th", "Fr", "Sa" }
for index, name in names do
Create.new("TextLabel", {
Text = Strings.get(name),
TextSize = 12,
Weight = "bold",
TextXAlignment = Enum.TextXAlignment.Center,
LayoutOrder = index,
Theme = { TextColor3 = "textMuted" },
Parent = grid,
})
end
local days = {}
for index = 1, 42 do
local button = Create.new("TextButton", {
Name = "Day",
TextSize = 13,
LayoutOrder = 7 + index,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "accent", TextColor3 = "text" },
Parent = grid,
})
Create.corner(-1, button)
days[index] = button
end
local function fill()
title.Text = Strings.get(MONTHS[shown.Month]) .. " " .. shown.Year
local offset = firstColumn(shown.Year, shown.Month, mondayFirst) - 1
local count = daysIn(shown.Year, shown.Month)
for index, button in days do
local day = index - offset
local inMonth = day >= 1 and day <= count
button.Visible = inMonth
button.Text = if inMonth then tostring(day) else ""
local picked = inMonth and day == value.Day and shown.Month == value.Month and shown.Year == value.Year
local today = inMonth and day == now.day and shown.Month == now.month and shown.Year == now.year
button.BackgroundTransparency = if picked then 0 else 1
Theme.bind(button, "TextColor3", if picked then "onAccent" elseif today then "accent" else "text")
button.FontFace = Create.font(if picked or today then "bold" else "regular")
end
end
for index, button in days do
session:connect(button.Activated, function()
local day = index - (firstColumn(shown.Year, shown.Month, mondayFirst) - 1)
local picked = copy(value)
picked.Year, picked.Month, picked.Day = shown.Year, shown.Month, day
handle:Set(picked)
if withTime then
fill()
else
popup.close()
end
end)
end
session:connect(previous.Activated, function()
shown.Month -= 1
if shown.Month < 1 then
shown.Month, shown.Year = 12, shown.Year - 1
end
fill()
end)
session:connect(following.Activated, function()
shown.Month += 1
if shown.Month > 12 then
shown.Month, shown.Year = 1, shown.Year + 1
end
fill()
end)
fill()
if withTime then
local line = Create.new("Frame", { Name = "Time", Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 2, Parent = popup.frame })
Create.list(line, "Horizontal", 6, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
local function field(key, limit, order)
local box = Create.new("TextBox", {
Name = key,
Size = UDim2.fromOffset(52, 30),
Text = string.format("%02d", value[key]),
TextSize = 14,
TextXAlignment = Enum.TextXAlignment.Center,
LayoutOrder = order,
Theme = { BackgroundColor3 = "raised", TextColor3 = "text" },
Parent = line,
})
Create.corner(6, box)
Create.stroke("stroke", box)
session:connect(box.FocusLost, function()
local typed = tonumber(box.Text)
local picked = copy(value)
if typed then
picked[key] = math.clamp(math.floor(typed), 0, limit)
end
handle:Set(picked)
box.Text = string.format("%02d", value[key])
end)
end
field("Hour", 23, 1)
Create.new("TextLabel", { Size = UDim2.fromOffset(6, 30), Text = ":", TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, Theme = { TextColor3 = "text" }, Parent = line })
field("Minute", 59, 3)
end
end)
draw()
return handle
end
return DatePicker
end
modules["Elements/Divider"] = function()
local Create = import("Core/Create")
local Hairline = import("Core/Hairline")
local Row = import("Elements/Row")
local Divider = {}
function Divider.new(container, options)
local row = Row.new(container, { Title = options.Title or "" }, { bare = true, compact = true })
local line = Create.new("Frame", { Name = "Divider", Size = UDim2.new(1, 0, 0, 16), Parent = row.content })
Create.list(line, "Horizontal", 8)
if options.Title then
Create.new("TextLabel", {
Size = UDim2.fromOffset(0, 16),
AutomaticSize = Enum.AutomaticSize.X,
Text = options.Title,
TextSize = 12,
Weight = "medium",
Theme = { TextColor3 = "textMuted" },
Parent = line,
})
end
local rule = Hairline.new("X", "stroke", { Size = UDim2.new(0, 0, 0, 0), LayoutOrder = 1, Parent = line })
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = rule })
return row.handle
end
return Divider
end
modules["Elements/Dropdown"] = function()
local Players = game:GetService("Players")
local Create = import("Core/Create")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Options = import("Elements/Options")
local Popup = import("Components/Popup")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
local SEARCHABLE_FROM = 8
local LIST_HEIGHT = 216
Styles.register("Dropdown", "Box", { box = true })
Styles.register("Dropdown", "Minimal", {})
Styles.register("Dropdown", "Chips", { box = true, chips = true })
Styles.register("Dropdown", "Inline", { box = true, inline = true })
local Dropdown = {}
local entriesFrom = Options.entries
local function playerOptions(excludeSelf)
local list = {}
for _, player in Players:GetPlayers() do
if not (excludeSelf and player == Players.LocalPlayer) then
table.insert(list, {
Value = player.Name,
Text = if player.DisplayName ~= player.Name then `{player.DisplayName} (@{player.Name})` else player.Name,
Image = `rbxthumb://type=AvatarHeadShot&id={player.UserId}&w=48&h=48`,
})
end
end
table.sort(list, function(a, b)
return string.lower(a.Value) < string.lower(b.Value)
end)
return list
end
function Dropdown.new(container, options)
local row = Row.new(container, options, { button = true })
local handle, scope, library = row.handle, row.scope, row.library
local multi = options.Multi == true
local look = Styles.pick("Dropdown", options.Style, row.window)
local source = if options.Players then playerOptions(options.ExcludeSelf) else options.Values or {}
local entries, values = entriesFrom(source)
local picked = {}
local repaint, inlineList
local chip = Create.new("Frame", {
Name = "Value",
BackgroundTransparency = if look.box then 0 else 1,
Theme = { BackgroundColor3 = row.controlRole },
})
row.placeControl(chip, options.Width or (if look.box then 150 else 120), math.max(row.reach, 30))
if look.box then
Create.corner(6, chip)
Create.stroke("stroke", chip)
end
local label = Create.new("TextLabel", {
Size = UDim2.new(1, if look.box then -34 else -22, 1, 0),
Position = UDim2.fromOffset(if look.box then 10 else 0, 0),
TextSize = 13,
TextTruncate = Enum.TextTruncate.AtEnd,
TextXAlignment = if look.box then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right,
Theme = { TextColor3 = if look.box then "text" else "textMuted" },
Parent = chip,
})
local chevron = Create.icon("chevron-down", 14, "textMuted", chip)
chevron.AnchorPoint = Vector2.new(1, 0.5)
chevron.Position = UDim2.new(1, if look.box then -8 else 0, 0.5, 0)
row.onHover(function(active)
if look.box then
local role = if active then "hover" else row.controlRole
Theme.bind(chip, "BackgroundColor3", role, true)
Motion.tween(chip, "fast", { BackgroundColor3 = Theme.color(role) })
else
Theme.bind(label, "TextColor3", if active then "text" else "textMuted")
end
end, chip)
local chipArea
if look.chips and multi then
chipArea = row.belowTitle()
Create.list(chipArea, "Horizontal", 6, { Wraps = true, VerticalAlignment = Enum.VerticalAlignment.Top })
local layout = chipArea:FindFirstChildOfClass("UIListLayout")
layout.Padding = UDim.new(0, 6)
end
local function textOf(value)
for _, entry in entries do
if entry.value == value then
return entry.text
end
end
return tostring(value)
end
local function selection()
local list = {}
for _, value in values do
if picked[value] then
table.insert(list, value)
end
end
return list
end
local drawChips
local function draw()
local list = selection()
local text = options.Placeholder or "None"
if #list == 1 or (#list == 2 and multi) then
local names = {}
for index, value in list do
names[index] = textOf(value)
end
text = table.concat(names, ", ")
elseif #list > 2 then
text = #list .. " selected"
end
label.Text = text
if drawChips then
drawChips(list)
end
if repaint then
repaint()
end
end
local function store(value)
table.clear(picked)
local wanted = if multi and type(value) == "table" then value else { value }
for _, item in wanted do
if table.find(values, item) then
picked[item] = true
if not multi then
break
end
end
end
draw()
end
function handle:Get()
local list = selection()
return if multi then list else list[1]
end
function handle:Set(value)
store(value)
row.fire(self:Get())
end
if chipArea then
local chipScope
function drawChips(list)
if chipScope then
scope:release(chipScope)
end
chipScope = scope:child()
chipArea.Visible = #list > 0
for index, value in list do
local pill = Create.new("Frame", {
Name = "Chip",
Size = UDim2.fromOffset(0, 24),
AutomaticSize = Enum.AutomaticSize.X,
LayoutOrder = index,
BackgroundTransparency = 0.85,
Theme = { BackgroundColor3 = "accent" },
Parent = chipArea,
})
chipScope:add(pill)
Create.corner(-1, pill)
Create.padding(pill, 10, 0, 4, 0)
Create.list(pill, "Horizontal", 4)
Create.new("TextLabel", {
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = textOf(value),
TextSize = 12,
Weight = "medium",
Theme = { TextColor3 = "accent" },
Parent = pill,
})
local remove = Create.new("ImageButton", { Name = "Remove", Size = UDim2.fromOffset(18, 18), LayoutOrder = 1, Parent = pill })
local glyph = Create.icon("x", 12, "accent", remove)
glyph.AnchorPoint = Vector2.new(0.5, 0.5)
glyph.Position = UDim2.fromScale(0.5, 0.5)
chipScope:connect(remove.Activated, function()
local chosen = selection()
local found = table.find(chosen, value)
if found then
table.remove(chosen, found)
handle:Set(chosen)
end
end)
end
end
end
local function buildList(parent, session, close)
local height = if library.touch then 40 else 32
local items = {}
local search
if options.Searchable or (options.Searchable == nil and #values > SEARCHABLE_FROM) then
search = Create.new("TextBox", {
Name = "Search",
Size = UDim2.new(1, 0, 0, height),
PlaceholderText = Strings.get("Search"),
TextSize = 13,
Theme = { BackgroundColor3 = "raised", TextColor3 = "text" },
Parent = parent,
})
session:add(search)
Create.corner(6, search)
Create.padding(search, 10, 0)
end
local total = 0
for _, entry in entries do
total += if entry.heading then 24 elseif entry.description then height + 14 else height
total += 2
end
local list = Create.new("ScrollingFrame", {
Name = "Options",
Size = UDim2.new(1, 0, 0, math.min(total, LIST_HEIGHT)),
LayoutOrder = 1,
Parent = parent,
})
session:add(list)
Create.list(list, "Vertical", 2)
for index, entry in entries do
if entry.heading then
local heading = Create.new("TextLabel", {
Name = "Heading",
Size = UDim2.new(1, 0, 0, 24),
LayoutOrder = index,
Text = string.upper(entry.heading),
TextSize = 12,
Weight = "bold",
Theme = { TextColor3 = "textMuted" },
Parent = list,
})
Create.padding(heading, 10, 6, 10, 0)
items[index] = { heading = heading, entry = entry }
continue
end
local value = entry.value
local item = Create.new("TextButton", {
Name = "Option",
Size = UDim2.new(1, 0, 0, if entry.description then height + 14 else height),
LayoutOrder = index,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "hover" },
Parent = list,
})
Create.corner(6, item)
local lead = 10
if entry.icon or entry.image then
local picture = Create.new("ImageLabel", {
Name = "Icon",
Size = UDim2.fromOffset(if entry.image then 22 else 16, if entry.image then 22 else 16),
AnchorPoint = Vector2.new(0, 0.5),
Position = UDim2.new(0, 10, 0.5, 0),
Icon = entry.icon,
Theme = if entry.icon then { ImageColor3 = "textMuted" } else nil,
Parent = item,
})
if entry.image then
Icons.apply(picture, entry.image)
Create.corner(-1, picture)
end
lead = 10 + picture.Size.X.Offset + 8
end
local text = Create.new("TextLabel", {
Size = UDim2.new(1, -(lead + 34), 0, 16),
AnchorPoint = Vector2.new(0, 0.5),
Position = UDim2.new(0, lead, 0.5, if entry.description then -8 else 0),
Text = entry.text,
TextSize = 13,
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = if entry.disabled then "textMuted" else "text" },
Parent = item,
})
if entry.description then
Create.new("TextLabel", {
Name = "Description",
Size = UDim2.new(1, -(lead + 34), 0, 14),
AnchorPoint = Vector2.new(0, 0.5),
Position = UDim2.new(0, lead, 0.5, 9),
Text = tostring(entry.description),
TextSize = 12,
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = "textMuted" },
Parent = item,
})
end
local mark = Create.new("Frame", {
Name = "Mark",
Size = UDim2.fromOffset(18, 18),
AnchorPoint = Vector2.new(1, 0.5),
Position = UDim2.new(1, -10, 0.5, 0),
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "accent" },
Parent = item,
})
Create.corner(if multi then 5 else -1, mark)
local edge = Create.stroke("stroke", mark, 1.5)
local glyph
if multi then
glyph = Create.icon("check", 12, "onAccent", mark)
else
glyph = Create.new("Frame", {
Name = "Dot",
Size = UDim2.fromOffset(8, 8),
Theme = { BackgroundColor3 = "accent" },
Parent = mark,
})
Create.corner(-1, glyph)
end
glyph.AnchorPoint = Vector2.new(0.5, 0.5)
glyph.Position = UDim2.fromScale(0.5, 0.5)
if entry.disabled then
mark.Visible = false
item.AutoButtonColor = false
items[index] = { entry = entry, button = item, disabled = true }
continue
end
local slot = { button = item, text = text, mark = mark, edge = edge, glyph = glyph, value = value, entry = entry, on = false }
items[index] = slot
session:connect(item.MouseEnter, function()
Motion.tween(item, "fast", { BackgroundTransparency = if slot.on then 0.8 else 0 })
end)
session:connect(item.MouseLeave, function()
Motion.tween(item, "fast", { BackgroundTransparency = if slot.on then 0.88 else 1 })
end)
session:connect(item.Activated, function()
if multi then
local chosen = selection()
local found = table.find(chosen, value)
if found then
table.remove(chosen, found)
else
table.insert(chosen, value)
end
handle:Set(chosen)
else
handle:Set(if picked[value] and options.AllowNone then nil else value)
close()
end
end)
end
function repaint()
for _, item in items do
if item.value == nil then
continue
end
local on = picked[item.value] == true
item.on = on
item.glyph.Visible = on
item.text.FontFace = Create.font(if on then "bold" else "regular")
Theme.bind(item.button, "BackgroundColor3", if on then "accent" else "hover")
item.button.BackgroundTransparency = if on then 0.88 else 1
Theme.bind(item.edge, "Color", if on then "accent" else "stroke")
if multi then
item.mark.BackgroundTransparency = if on then 0 else 1
end
end
end
repaint()
if search then
session:connect(search:GetPropertyChangedSignal("Text"), function()
local query = string.lower(search.Text)
for _, item in items do
if item.heading then
item.heading.Visible = query == ""
else
local words = string.lower(item.entry.text .. " " .. tostring(item.entry.description or ""))
item.button.Visible = query == "" or string.find(words, query, 1, true) ~= nil
end
end
end)
end
end
local function closeInline()
if inlineList then
scope:release(inlineList.scope)
inlineList.holder.Visible = false
inlineList = nil
repaint = nil
Motion.tween(chevron, "fast", { Rotation = 0 })
end
end
function handle:Refresh(newValues)
local kept = selection()
entries, values = entriesFrom(newValues)
Popup.close(library)
closeInline()
store(if multi then kept else kept[1])
end
local inlineHolder
scope:connect(row.frame.Activated, function()
if look.inline then
if inlineList then
closeInline()
return
end
inlineHolder = inlineHolder or row.belowTitle()
inlineHolder.Visible = true
Create.list(inlineHolder, "Vertical", 4)
local session = scope:child()
inlineList = { scope = session, holder = inlineHolder }
Motion.tween(chevron, "fast", { Rotation = 180 })
buildList(inlineHolder, session, closeInline)
session:add(inlineHolder:FindFirstChildOfClass("UIListLayout"))
return
end
local popup = Popup.toggle(library, chip, {
Width = math.max(chip.AbsoluteSize.X / library.scale, 190),
OnClose = function()
repaint = nil
Motion.tween(chevron, "fast", { Rotation = 0 })
end,
})
if not popup then
return
end
Motion.tween(chevron, "fast", { Rotation = 180 })
buildList(popup.frame, popup.scope, popup.close)
end)
if options.Players then
local function follow()
handle:Refresh(playerOptions(options.ExcludeSelf))
end
scope:connect(Players.PlayerAdded, follow)
scope:connect(Players.PlayerRemoving, function()
task.defer(follow)
end)
end
local default = options.Default
if default == nil and not multi and not options.AllowNone and options.Placeholder == nil then
default = values[1]
end
store(default)
return handle
end
return Dropdown
end
modules["Elements/Gauge"] = function()
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Arc = import("Core/Arc")
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local Gauge = {}
local KNOB_TRAVEL = 220
local function format(options, value)
if type(options.Format) == "function" then
local ok, text = pcall(options.Format, value)
if ok then
return tostring(text)
end
end
local rounded = if math.abs(value - math.round(value)) < 1e-6 then tostring(math.round(value)) else string.format("%.1f", value)
return rounded .. (options.Suffix or "")
end
function Gauge.ring(row, options)
local size = options.Size or 72
local thickness = options.Thickness or math.max(math.round(size / 12), 4)
local holder = Create.new("Frame", {
Name = "Ring",
Size = UDim2.fromOffset(size, size),
Parent = row.slot,
})
local track = Arc.new(holder, { Thickness = thickness, Role = "raised", Radius = -1, Even = false })
local fill = Arc.new(holder, { Thickness = thickness, Role = options.Role or "accent", Radius = -1, Even = false })
local label = Create.new("TextLabel", {
Name = "Value",
Size = UDim2.fromScale(1, 1),
TextSize = math.max(math.round(size / 5), 11),
Weight = "bold",
TextXAlignment = Enum.TextXAlignment.Center,
Theme = { TextColor3 = "text" },
Parent = holder,
})
track:Set(1)
return { holder = holder, track = track, fill = fill, label = label }
end
function Gauge.new(container, options)
local row = Row.new(container, options)
local handle = row.handle
local min, max = options.Min or 0, options.Max or 100
local ring = Gauge.ring(row, options)
local value = min
local animation
local shown = Instance.new("NumberValue")
row.scope:add(shown)
row.scope:connect(shown:GetPropertyChangedSignal("Value"), function()
ring.fill:Set(shown.Value)
end)
local function roleFor(share)
local chosen = options.Role or "accent"
if type(options.Thresholds) == "table" then
local best = math.huge
for _, threshold in options.Thresholds do
if type(threshold.At) == "number" and share <= threshold.At and threshold.At < best then
best, chosen = threshold.At, threshold.Role or chosen
end
end
end
return chosen
end
function handle:Get()
return value
end
function handle:Set(newValue)
value = math.clamp(tonumber(newValue) or min, min, max)
local share = if max > min then (value - min) / (max - min) else 0
ring.label.Text = format(options, value)
ring.fill:SetRole(roleFor(share))
if animation then
animation:Cancel()
end
animation = Motion.tween(shown, "base", { Value = share })
ring.fill:Set(shown.Value)
self.Changed:Fire(value)
end
handle:Set(options.Value or min)
return handle
end
function Gauge.knob(container, options)
local row = Row.new(container, options)
local handle = row.handle
local min, max, step = options.Min or 0, options.Max or 100, options.Step or 1
local ring = Gauge.ring(row, { Size = options.Size or 64, Role = options.Role, Thickness = options.Thickness })
local value = min
local hovered = false
local button = Create.new("TextButton", { Name = "Knob", Size = UDim2.fromScale(1, 1), Text = "", Parent = ring.holder })
Create.corner(-1, button)
local function snap(raw)
return math.clamp(min + math.round((raw - min) / step) * step, min, max)
end
local function draw()
local share = if max > min then (value - min) / (max - min) else 0
ring.fill:Set(share)
ring.label.Text = format(options, value)
end
local function change(newValue, call)
newValue = snap(newValue)
if newValue == value then
return
end
value = newValue
draw()
if call then
row.fire(value)
else
handle.Changed:Fire(value)
end
end
local live = options.Live ~= false
local start = value
Drag.track(row.scope, button, function()
start = value
return not handle:IsLocked()
end, function(position, origin)
local travel = (position.X - origin.X) - (position.Y - origin.Y)
change(start + travel / KNOB_TRAVEL * (max - min), live)
end, function(moved)
if moved and not live then
row.fire(value)
end
end)
row.scope:connect(button.MouseEnter, function()
hovered = true
Theme.bind(ring.label, "TextColor3", "accent")
end)
row.scope:connect(button.MouseLeave, function()
hovered = false
Theme.bind(ring.label, "TextColor3", "text")
end)
row.scope:connect(UserInputService.InputChanged, function(input)
if hovered and input.UserInputType == Enum.UserInputType.MouseWheel and not handle:IsLocked() then
change(value + math.sign(input.Position.Z) * step, true)
end
end)
row.scope:connect(UserInputService.InputBegan, function(input)
if GuiService.SelectedObject == button then
if input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.Up then
change(value + step, true)
elseif input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.Down then
change(value - step, true)
end
end
end)
function handle:Get()
return value
end
function handle:Set(newValue)
value = snap(tonumber(newValue) or min)
draw()
row.fire(value)
end
value = snap(options.Default or min)
draw()
return handle
end
return Gauge
end
modules["Elements/Graph"] = function()
local Create = import("Core/Create")
local Row = import("Elements/Row")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
Styles.register("Graph", "Line", { line = true })
Styles.register("Graph", "Area", { line = true, fill = true })
Styles.register("Graph", "Bars", { bars = true })
local Graph = {}
local function format(value, options)
if type(options.Format) == "function" then
local ok, text = pcall(options.Format, value)
if ok then
return tostring(text)
end
end
local rounded = if math.abs(value) >= 100 then math.round(value) else math.round(value * 10) / 10
return tostring(rounded) .. (options.Suffix or "")
end
function Graph.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local look = Styles.pick("Graph", options.Style, row.window)
local keep = math.clamp(math.floor(tonumber(options.Max) or 40), 2, 200)
local height = math.clamp(tonumber(options.Height) or 80, 40, 240)
local role = options.Role or "accent"
local values = {}
for _, value in options.Values or {} do
if type(value) == "number" then
table.insert(values, value)
end
end
local latest = Create.new("TextLabel", {
Name = "Latest",
Size = UDim2.fromOffset(0, 20),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 13,
Weight = "bold",
Theme = { TextColor3 = "text" },
Parent = row.slot,
})
local below = row.belowTitle()
local plot = Create.new("Frame", {
Name = "Plot",
Size = UDim2.new(1, 0, 0, height),
ClipsDescendants = true,
Theme = { BackgroundColor3 = row.controlRole },
Parent = below,
})
Create.corner(8, plot)
local marks = Create.new("Frame", { Name = "Marks", Size = UDim2.fromScale(1, 1), Parent = plot })
Create.new("Frame", {
Name = "Guide",
Size = UDim2.new(1, -16, 0, 1),
Position = UDim2.new(0, 8, 0.5, 0),
BackgroundTransparency = 0.5,
Theme = { BackgroundColor3 = "stroke" },
Parent = plot,
})
local pieces = {}
local function piece(index)
local found = pieces[index]
if not found then
found = {
segment = Create.new("Frame", { Name = "Segment", AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3, Theme = { BackgroundColor3 = role }, Parent = marks }),
column = Create.new("Frame", { Name = "Column", AnchorPoint = Vector2.new(0, 1), ZIndex = 2, Theme = { BackgroundColor3 = role }, Parent = marks }),
}
Create.corner(-1, found.segment)
pieces[index] = found
end
return found
end
local function draw()
local size = plot.AbsoluteSize / row.library.scale
local count = #values
latest.Text = if count > 0 then format(values[count], options) else ""
for index = count + 1, #pieces do
pieces[index].segment.Visible = false
pieces[index].column.Visible = false
end
if size.X <= 0 or count == 0 then
return
end
local low, high = math.huge, -math.huge
for _, value in values do
low, high = math.min(low, value), math.max(high, value)
end
low = if type(options.Min) == "number" then options.Min else low
high = if type(options.Ceiling) == "number" then options.Ceiling else high
if high - low < 1e-6 then
high, low = high + 1, low - 1
end
local inset = 8
local width, tall = size.X - inset * 2, size.Y - inset * 2
local step = if count > 1 then width / (keep - 1) else 0
local function point(index)
local x = inset + width - (count - index) * step
local y = inset + tall - (values[index] - low) / (high - low) * tall
return x, y
end
for index = 1, count do
local mark = piece(index)
local x, y = point(index)
if look.bars then
local barWidth = math.max(step - 3, 2)
mark.segment.Visible = false
mark.column.Visible = true
mark.column.BackgroundTransparency = 0
mark.column.Position = UDim2.fromOffset(x - barWidth / 2, size.Y - inset)
mark.column.Size = UDim2.fromOffset(barWidth, math.max(size.Y - inset - y, 1))
else
if index > 1 then
local px, py = point(index - 1)
local dx, dy = x - px, y - py
mark.segment.Visible = true
mark.segment.Position = UDim2.fromOffset((x + px) / 2, (y + py) / 2)
mark.segment.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 1, 2)
mark.segment.Rotation = math.deg(math.atan2(dy, dx))
else
mark.segment.Visible = false
end
mark.column.Visible = look.fill == true
if look.fill then
mark.column.BackgroundTransparency = 0.88
mark.column.Position = UDim2.fromOffset(x - step / 2, size.Y - inset)
mark.column.Size = UDim2.fromOffset(math.max(step, 1), math.max(size.Y - inset - y, 0))
end
end
end
end
scope:connect(plot:GetPropertyChangedSignal("AbsoluteSize"), draw)
function handle:Push(value)
if type(value) ~= "number" then
return
end
table.insert(values, value)
while #values > keep do
table.remove(values, 1)
end
draw()
row.fire(value)
end
function handle:Set(list)
table.clear(values)
for _, value in list or {} do
if type(value) == "number" then
table.insert(values, value)
end
end
while #values > keep do
table.remove(values, 1)
end
draw()
end
function handle:Get()
return table.clone(values)
end
function handle:Clear()
handle:Set({})
end
draw()
return handle
end
return Graph
end
modules["Elements/Image"] = function()
local Create = import("Core/Create")
local Icons = import("Core/Icons")
local Row = import("Elements/Row")
local Image = {}
function Image.new(container, options)
local row = Row.new(container, { Title = options.Title or "" }, { bare = true })
local handle = row.handle
local picture = Create.new("ImageLabel", {
Name = "Image",
Size = UDim2.new(1, 0, 0, options.Height or 140),
ScaleType = if options.Crop then Enum.ScaleType.Crop else Enum.ScaleType.Fit,
Theme = { BackgroundColor3 = row.controlRole },
Parent = row.content,
})
Create.corner(8, picture)
function handle:Set(image)
Icons.apply(picture, image)
end
handle:Set(options.Image)
return handle
end
return Image
end
modules["Elements/Input"] = function()
local Create = import("Core/Create")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
local Strings = import("Core/Strings")
Styles.register("Input", "Boxed", { fill = "control", stroke = true, corner = 6 })
Styles.register("Input", "Underline", { underline = true, corner = 0 })
Styles.register("Input", "Filled", { fill = "hover", corner = 6 })
Styles.register("Input", "Pill", { fill = "control", stroke = true, corner = -1 })
local MASK = "\u{2022}"
local Input = {}
function Input.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local numeric = options.Numeric == true
local multiLine = options.MultiLine == true and not numeric
local password = options.Password == true and not multiLine
local value = if numeric then tonumber(options.Default) or 0 else tostring(options.Default or "")
local writing, focused, revealed = false, false, false
local look = Styles.pick("Input", options.Style, row.window)
local fillRole = if look.fill == "control" then row.controlRole else look.fill
local lines = math.clamp(tonumber(options.Lines) or 4, 2, 12)
local height = if multiLine then lines * 17 + 14 else math.max(row.reach, 30)
local field = Create.new("Frame", {
Name = "Field",
BackgroundTransparency = if fillRole then 0 else 1,
Theme = { BackgroundColor3 = fillRole or "raised" },
})
if look.corner ~= 0 then
Create.corner(look.corner or 6, field)
end
local outline = if look.stroke then Create.stroke("stroke", field) else nil
local underline
if look.underline then
underline = Create.new("Frame", {
Name = "Underline",
Size = UDim2.new(1, 0, 0, 1),
AnchorPoint = Vector2.new(0, 1),
Position = UDim2.fromScale(0, 1),
ZIndex = 2,
Theme = { BackgroundColor3 = "stroke" },
Parent = field,
})
end
local inner = Create.new("Frame", { Name = "Inner", Size = UDim2.fromScale(1, 1), Parent = field })
Create.padding(inner, if look.underline then 2 else 10, 0)
Create.list(inner, "Horizontal", 6, { VerticalAlignment = if multiLine then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Center })
if options.LeadingIcon then
local icon = Create.icon(options.LeadingIcon, 14, "textMuted", inner)
icon.LayoutOrder = 0
end
local box = Create.new("TextBox", {
Name = "Input",
Size = UDim2.fromScale(0, 1),
PlaceholderText = options.Placeholder or "",
TextSize = 13,
ClipsDescendants = true,
MultiLine = multiLine,
TextWrapped = multiLine,
TextYAlignment = if multiLine then Enum.TextYAlignment.Top else Enum.TextYAlignment.Center,
LayoutOrder = 1,
Theme = { TextColor3 = "text" },
Parent = inner,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
if multiLine then
Create.padding(box, 0, 7)
end
local counter
if options.Counter and options.MaxLength and not numeric then
counter = Create.new("TextLabel", {
Name = "Counter",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
LayoutOrder = 4,
Theme = { TextColor3 = "textMuted" },
Parent = inner,
})
if multiLine then
counter.Size = UDim2.fromOffset(0, 30)
end
end
local function fieldButton(icon, order)
local button = Create.new("ImageButton", { Name = "Action", Size = UDim2.fromOffset(18, 18), LayoutOrder = order, Parent = inner })
local glyph = Create.icon(icon, 14, "textMuted", button)
glyph.AnchorPoint = Vector2.new(0.5, 0.5)
glyph.Position = UDim2.fromScale(0.5, 0.5)
scope:connect(button.MouseEnter, function()
Theme.bind(glyph, "ImageColor3", "text")
end)
scope:connect(button.MouseLeave, function()
Theme.bind(glyph, "ImageColor3", "textMuted")
end)
return button, glyph
end
local clear = if options.Clearable then fieldButton("x", 2) else nil
local eye, eyeGlyph
if password then
eye, eyeGlyph = fieldButton("eye", 3)
end
row.placeControl(field, options.Width or 150, height, multiLine)
local function decorate()
local text = tostring(value)
if clear then
clear.Visible = text ~= "" and not (numeric and value == 0 and options.Default == nil)
end
if counter then
counter.Text = #box.Text .. "/" .. options.MaxLength
end
end
local function show()
writing = true
local text = if numeric and options.Default == nil and value == 0 then "" else tostring(value)
box.Text = if password and not focused and not revealed then string.rep(MASK, utf8.len(text) or #text) else text
writing = false
decorate()
end
local errorLabel
local function showError(message)
if message == nil then
if errorLabel then
errorLabel.Visible = false
end
if outline then
Theme.bind(outline, "Color", if focused then "accent" else "stroke")
end
return
end
if not errorLabel then
errorLabel = Create.new("TextLabel", {
Name = "InputError",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 12,
TextXAlignment = Enum.TextXAlignment.Left,
LayoutOrder = 8,
Theme = { TextColor3 = "danger" },
Parent = row.content,
})
end
errorLabel.Text = message
errorLabel.Visible = true
if outline then
Theme.bind(outline, "Color", "danger")
end
end
local function store(text)
local candidate
if numeric then
local number = tonumber(text)
if not number then
return false
end
candidate = math.clamp(number, options.Min or -math.huge, options.Max or math.huge)
else
text = tostring(text)
candidate = if options.MaxLength then string.sub(text, 1, options.MaxLength) else text
end
if type(options.Validate) == "function" then
local ran, accepted, reason = pcall(options.Validate, candidate)
if not ran or accepted == false then
showError(if ran and type(reason) == "string" then reason else Strings.get("That value isn't allowed."))
return false
end
end
showError(nil)
value = candidate
return true
end
local function focusLook(active)
if outline then
Theme.bind(outline, "Color", if active then "accent" else "stroke")
end
if underline then
Theme.bind(underline, "BackgroundColor3", if active then "accent" else "stroke")
Motion.tween(underline, "fast", { Size = UDim2.new(1, 0, 0, if active then 2 else 1) })
end
end
function handle:Get()
return value
end
function handle:SetError(message)
showError(if message == nil then nil else tostring(message))
end
function handle:Set(newValue)
if store(newValue) then
show()
row.fire(value)
end
end
scope:connect(box.Focused, function()
focused = true
focusLook(true)
if password then
show()
end
end)
scope:connect(box.FocusLost, function()
focused = false
focusLook(false)
local previous = value
local accepted = store(box.Text)
show()
if accepted and (value ~= previous or not options.Live) then
row.fire(value)
end
end)
scope:connect(box:GetPropertyChangedSignal("Text"), function()
if writing then
return
end
if options.MaxLength and not numeric and #box.Text > options.MaxLength then
writing = true
box.Text = string.sub(box.Text, 1, options.MaxLength)
writing = false
end
if options.Live and not numeric and store(box.Text) then
row.fire(value)
end
decorate()
end)
if clear then
scope:connect(clear.Activated, function()
handle:Set(if numeric then options.Min or 0 else "")
end)
end
if eye then
scope:connect(eye.Activated, function()
revealed = not revealed
Icons.apply(eyeGlyph, if revealed then "eye-off" else "eye")
show()
end)
end
show()
return handle
end
return Input
end
modules["Elements/ItemGrid"] = function()
local Create = import("Core/Create")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local ItemGrid = {}
local RARITIES = {
{ Name = "Common", Role = "textMuted" },
{ Name = "Uncommon", Role = "success" },
{ Name = "Rare", Role = "info" },
{ Name = "Epic", Color = Color3.fromRGB(168, 102, 255) },
{ Name = "Legendary", Role = "warning" },
{ Name = "Mythic", Role = "danger" },
}
local GAP = 8
local CARD_WIDTH = 84
function ItemGrid.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local multi = options.Multi == true
local rarities = if type(options.Rarities) == "table" then options.Rarities else RARITIES
local rank, rarityOf = {}, {}
for index, rarity in rarities do
rank[rarity.Name] = index
rarityOf[rarity.Name] = rarity
end
local items = options.Items or {}
local picked = {}
local query = ""
local cards = {}
local area = row.belowTitle()
Create.list(area, "Vertical", 8)
local searchBox
if options.Search == true or (options.Search ~= false and #items > 8) then
searchBox = Create.new("TextBox", {
Name = "Search",
Size = UDim2.new(1, 0, 0, row.reach),
PlaceholderText = Strings.get("Search"),
Text = "",
TextSize = 13,
ClearTextOnFocus = false,
TextXAlignment = Enum.TextXAlignment.Left,
Theme = { BackgroundColor3 = row.controlRole, TextColor3 = "text", PlaceholderColor3 = "textMuted" },
Parent = area,
})
Create.corner(8, searchBox)
Create.padding(searchBox, 10, 0)
Create.stroke("stroke", searchBox)
end
local scroller = Create.new("ScrollingFrame", {
Name = "Items",
Size = UDim2.new(1, 0, 0, 0),
AutomaticCanvasSize = Enum.AutomaticSize.Y,
CanvasSize = UDim2.new(),
ScrollBarThickness = 3,
ScrollingDirection = Enum.ScrollingDirection.Y,
LayoutOrder = 1,
Theme = { ScrollBarImageColor3 = "textMuted" },
Parent = area,
})
local grid = Create.new("UIGridLayout", {
CellPadding = UDim2.fromOffset(GAP, GAP),
SortOrder = Enum.SortOrder.LayoutOrder,
Parent = scroller,
})
Create.padding(scroller, 1, 1, 6, 1)
local maxHeight = tonumber(options.Height) or 260
local function fit()
local width = scroller.AbsoluteSize.X / row.library.scale - 8
if width <= 0 then
return
end
local columns = tonumber(options.Columns) or math.max(math.floor((width + GAP) / (CARD_WIDTH + GAP)), 2)
local cell = (width - GAP * (columns - 1)) / columns
grid.CellSize = UDim2.fromOffset(math.floor(cell), math.floor(cell + 34))
local content = grid.AbsoluteContentSize.Y / row.library.scale
scroller.Size = UDim2.new(1, 0, 0, math.min(content + 2, maxHeight))
end
scope:connect(scroller:GetPropertyChangedSignal("AbsoluteSize"), fit)
scope:connect(grid:GetPropertyChangedSignal("AbsoluteContentSize"), fit)
local function roleOf(item)
local rarity = rarityOf[item.Rarity]
return rarity, if rarity then rarity.Role else nil
end
local function paint(card)
local on = picked[card.value] == true
local rarity, role = roleOf(card.item)
local edgeRole = if on then "accent" elseif card.hovered then "textMuted" else "stroke"
if rarity and not on and not card.hovered then
edgeRole = role
end
if rarity and rarity.Color and not on and not card.hovered then
Theme.unbind(card.edge, "Color")
card.edge.Color = rarity.Color
else
Theme.bind(card.edge, "Color", edgeRole or "stroke")
end
card.edge.Transparency = if on or card.hovered then 0 else 0.4
Motion.tween(card.edge, "fast", { Thickness = if on then 2 else 1 })
card.tick.Visible = on
end
local function valueOf(item)
if item.Value ~= nil then
return item.Value
end
return item.Title or item.Name
end
local function order()
local list = table.clone(items)
if options.Sort == "Name" then
table.sort(list, function(a, b)
return string.lower(tostring(a.Title or a.Name or "")) < string.lower(tostring(b.Title or b.Name or ""))
end)
elseif options.Sort == "Count" then
table.sort(list, function(a, b)
return (tonumber(a.Count) or 0) > (tonumber(b.Count) or 0)
end)
elseif options.Sort == "Rarity" then
table.sort(list, function(a, b)
return (rank[a.Rarity] or 0) > (rank[b.Rarity] or 0)
end)
end
return list
end
local function filter()
for _, card in cards do
local name = string.lower(tostring(card.item.Title or card.item.Name or ""))
card.frame.Visible = query == "" or string.find(name, query, 1, true) ~= nil
end
end
local function build()
for _, card in cards do
card.frame:Destroy()
end
table.clear(cards)
for index, item in order() do
local value = valueOf(item)
local rarity, role = roleOf(item)
local frame = Create.new("TextButton", {
Name = "Item",
Text = "",
LayoutOrder = index,
AutoButtonColor = false,
Theme = { BackgroundColor3 = row.controlRole },
Parent = scroller,
})
Create.corner(10, frame)
local edge = Create.stroke("stroke", frame)
if rarity then
local wash = Create.new("Frame", {
Name = "Rarity",
Size = UDim2.fromScale(1, 1),
BackgroundTransparency = 0.2,
Parent = frame,
}, {
Create.new("UIGradient", {
Rotation = 270,
Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.82), NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1) }),
}),
})
Create.corner(10, wash)
if rarity.Color then
wash.BackgroundColor3 = rarity.Color
else
Theme.bind(wash, "BackgroundColor3", role)
end
end
local picture = Create.new("ImageLabel", {
Name = "Picture",
Size = UDim2.new(1, -28, 1, -58),
AnchorPoint = Vector2.new(0.5, 0),
Position = UDim2.new(0.5, 0, 0, 12),
ScaleType = Enum.ScaleType.Fit,
Theme = { ImageColor3 = if item.Image then nil else "textMuted" },
Parent = frame,
})
Icons.apply(picture, item.Image or item.Icon or "package")
Create.new("TextLabel", {
Name = "Name",
Size = UDim2.new(1, -12, 0, 16),
Position = UDim2.new(0, 6, 1, -36),
TextSize = 12,
Weight = "medium",
TextTruncate = Enum.TextTruncate.AtEnd,
Text = tostring(item.Title or item.Name or ""),
Theme = { TextColor3 = "text" },
Parent = frame,
})
local rarityLabel = Create.new("TextLabel", {
Name = "RarityName",
Size = UDim2.new(1, -12, 0, 14),
Position = UDim2.new(0, 6, 1, -19),
TextSize = 11,
TextTruncate = Enum.TextTruncate.AtEnd,
Text = if item.Rarity then Strings.get(tostring(item.Rarity)) else "",
Theme = { TextColor3 = role or "textMuted" },
Parent = frame,
})
if rarity and rarity.Color then
Theme.unbind(rarityLabel, "TextColor3")
rarityLabel.TextColor3 = rarity.Color
end
if item.Count ~= nil then
local count = Create.new("TextLabel", {
Name = "Count",
Size = UDim2.fromOffset(0, 18),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(1, 0),
Position = UDim2.new(1, -6, 0, 6),
TextSize = 11,
Weight = "bold",
Text = "x" .. tostring(item.Count),
Theme = { BackgroundColor3 = "surface", TextColor3 = "text" },
Parent = frame,
})
Create.corner(-1, count)
Create.padding(count, 6, 0)
end
local tick = Create.new("Frame", {
Name = "Picked",
Size = UDim2.fromOffset(18, 18),
Position = UDim2.fromOffset(6, 6),
Visible = false,
Theme = { BackgroundColor3 = "accent" },
Parent = frame,
})
Create.corner(-1, tick)
local check = Create.icon("check", 12, "onAccent", tick)
check.AnchorPoint, check.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
if item.Disabled then
frame.Active = false
picture.ImageTransparency = 0.6
end
local card = { frame = frame, edge = edge, tick = tick, item = item, value = value, hovered = false }
table.insert(cards, card)
scope:connect(frame.MouseEnter, function()
card.hovered = true
paint(card)
end)
scope:connect(frame.MouseLeave, function()
card.hovered = false
paint(card)
end)
scope:connect(frame.Activated, function()
if item.Disabled or handle:IsLocked() then
return
end
if multi then
picked[value] = not picked[value] or nil
elseif picked[value] then
if options.AllowNone then
picked[value] = nil
end
else
table.clear(picked)
picked[value] = true
end
for _, other in cards do
paint(other)
end
row.fire(handle:Get())
end)
paint(card)
end
filter()
fit()
end
if searchBox then
scope:connect(searchBox:GetPropertyChangedSignal("Text"), function()
query = string.lower(searchBox.Text)
filter()
end)
end
function handle:Get()
local list = {}
for _, item in items do
local value = valueOf(item)
if picked[value] then
table.insert(list, value)
end
end
if multi then
return list
end
return list[1]
end
function handle:Set(value)
table.clear(picked)
if multi and type(value) == "table" then
for _, one in value do
picked[one] = true
end
elseif value ~= nil then
picked[value] = true
end
for _, card in cards do
paint(card)
end
row.fire(self:Get())
end
function handle:Refresh(newItems)
items = newItems or {}
local still = {}
for _, item in items do
local value = valueOf(item)
if picked[value] then
still[value] = true
end
end
picked = still
build()
end
function handle:SetCount(value, count)
for _, card in cards do
if card.value == value then
card.item.Count = count
local label = card.frame:FindFirstChild("Count")
if label then
label.Text = "x" .. tostring(count)
end
end
end
end
local default = options.Default
if multi and type(default) == "table" then
for _, one in default do
picked[one] = true
end
elseif default ~= nil then
picked[default] = true
end
build()
return handle
end
return ItemGrid
end
modules["Elements/Keybind"] = function()
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Env = import("Core/Env")
local Popup = import("Components/Popup")
local Row = import("Elements/Row")
local Signal = import("Core/Signal")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
Styles.register("Keybind", "Chip", { box = true })
Styles.register("Keybind", "Keycap", { box = true, keycap = true })
Styles.register("Keybind", "Brackets", { brackets = true })
local MODES = { "Press", "Toggle", "Hold" }
local LONG_PRESS = 0.5
local SHORT = {
LeftShift = "LShift",
RightShift = "RShift",
LeftControl = "LCtrl",
RightControl = "RCtrl",
LeftAlt = "LAlt",
RightAlt = "RAlt",
}
local MODIFIERS = {
Ctrl = { Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl },
Shift = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift },
Alt = { Enum.KeyCode.LeftAlt, Enum.KeyCode.RightAlt },
}
local MODIFIER_ORDER = { "Ctrl", "Shift", "Alt" }
local function isModifier(keyCode)
for _, keys in MODIFIERS do
if table.find(keys, keyCode) then
return true
end
end
return false
end
local function heldModifiers()
local held = {}
for name, keys in MODIFIERS do
held[name] = UserInputService:IsKeyDown(keys[1]) or UserInputService:IsKeyDown(keys[2])
end
return held
end
local function keyFromName(name)
local ok, item = pcall(function()
return Enum.KeyCode[name]
end)
return if ok then item else nil
end
local Keybind = {}
function Keybind.control(row, options, onInput)
local scope, library, window = row.scope, row.library, row.window
local key = if typeof(options.Default) == "EnumItem" then options.Default else nil
local withModifiers = options.Modifiers == true
local combo = { Ctrl = false, Shift = false, Alt = false }
local listening, held = false, false
local control = { Changed = Signal.new(), Active = false, Mode = options.Mode or "Press" }
scope:add(control.Changed)
local look = Styles.pick("Keybind", options.Style, window)
local chip = Create.new("TextButton", {
Name = "Key",
Size = UDim2.fromOffset(0, if look.keycap then row.reach - 2 else row.reach),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
Weight = if look.keycap then "bold" else "medium",
BackgroundTransparency = if look.box then 0 else 1,
Theme = { BackgroundColor3 = if look.keycap then "raised" else row.controlRole, TextColor3 = if look.keycap then "text" else "textMuted" },
Parent = row.slot,
})
Create.padding(chip, if look.box then 8 else 2, 0)
if look.box then
Create.corner(6, chip)
Create.stroke("stroke", chip)
end
if look.keycap then
local lip = Create.new("Frame", {
Name = "Lip",
Size = UDim2.new(1, 16, 0, 4),
AnchorPoint = Vector2.new(0.5, 1),
Position = UDim2.new(0.5, 0, 1, 2),
ZIndex = 0,
Theme = { BackgroundColor3 = "stroke" },
Parent = chip,
})
Create.corner(6, lip)
end
function control.Label()
if not key then
return nil
end
local parts = {}
if withModifiers then
for _, name in MODIFIER_ORDER do
if combo[name] then
table.insert(parts, name)
end
end
end
table.insert(parts, SHORT[key.Name] or key.Name)
return table.concat(parts, " + ")
end
local function draw()
local name = if listening then Strings.get("Press a key") elseif key then control.Label() else Strings.get("None")
chip.Text = if look.brackets then "[ " .. name .. " ]" else name
if listening then
Theme.bind(chip, "TextColor3", "accent")
else
Theme.bind(chip, "TextColor3", if look.keycap then "text" else "textMuted")
end
end
local function stopListening()
listening = false
draw()
task.defer(function()
library.listeningForKey = false
end)
end
function control:Get()
if withModifiers and key then
return { Key = key, Ctrl = combo.Ctrl, Shift = combo.Shift, Alt = combo.Alt }
end
return key
end
function control:Set(value)
combo = { Ctrl = false, Shift = false, Alt = false }
if type(value) == "string" then
value = self:Decode(value)
end
if type(value) == "table" and typeof(value) ~= "EnumItem" then
for _, name in MODIFIER_ORDER do
combo[name] = withModifiers and value[name] == true
end
value = value.Key
end
key = if typeof(value) == "EnumItem" then value else nil
draw()
local current = self:Get()
self.Changed:Fire(current)
window.KeybindsChanged:Fire()
Env.call(row.handle.Title, options.ChangedCallback, current)
end
function control:Encode()
if not key then
return ""
end
if not withModifiers then
return key.Name
end
local parts = {}
for _, name in MODIFIER_ORDER do
if combo[name] then
table.insert(parts, name)
end
end
table.insert(parts, key.Name)
return table.concat(parts, "+")
end
function control:Decode(text)
if type(text) ~= "string" or text == "" then
return nil
end
if not withModifiers then
return keyFromName(text)
end
local parts = string.split(text, "+")
local found = keyFromName(table.remove(parts))
if not found then
return nil
end
local value = { Key = found }
for _, name in parts do
if MODIFIERS[name] then
value[name] = true
end
end
return value
end
scope:connect(chip.Activated, function()
if control.longPressed then
control.longPressed = false
return
end
if listening then
stopListening()
else
listening, library.listeningForKey = true, true
draw()
end
end)
control.chip = chip
scope:connect(UserInputService.InputBegan, function(input, processed)
if input.UserInputType ~= Enum.UserInputType.Keyboard then
return
end
if listening then
if withModifiers and isModifier(input.KeyCode) then
return
end
stopListening()
if input.KeyCode == Enum.KeyCode.Backspace then
control:Set(nil)
elseif input.KeyCode ~= Enum.KeyCode.Escape then
local value = if withModifiers then heldModifiers() else {}
value.Key = input.KeyCode
control:Set(value)
end
elseif not processed and not library.listeningForKey and key and input.KeyCode == key and not row.handle:IsLocked() then
if withModifiers then
local now = heldModifiers()
for _, name in MODIFIER_ORDER do
if now[name] ~= combo[name] then
return
end
end
end
held = true
onInput(true)
end
end)
scope:connect(UserInputService.InputEnded, function(input)
if held and input.KeyCode == key then
held = false
onInput(false)
end
end)
local listing = { handle = row.handle, control = control }
table.insert(window.keybinds, listing)
scope:add(function()
if listening then
library.listeningForKey = false
end
table.remove(window.keybinds, table.find(window.keybinds, listing))
window.KeybindsChanged:Fire()
end)
local default = options.Default
if type(default) == "string" then
default = control:Decode(default)
end
if type(default) == "table" and typeof(default) ~= "EnumItem" then
for _, name in MODIFIER_ORDER do
combo[name] = withModifiers and default[name] == true
end
key = if typeof(default.Key) == "EnumItem" then default.Key else nil
end
draw()
return control
end
function Keybind.new(container, options)
local row = Row.new(container, options)
local handle = row.handle
local mode = if table.find(MODES, options.Mode) then options.Mode else "Press"
local control
control = Keybind.control(row, {
Default = options.Default,
Mode = mode,
Style = options.Style,
Modifiers = options.Modifiers,
ChangedCallback = options.ChangedCallback,
}, function(pressed)
if mode == "Hold" then
control.Active = pressed
Env.call(handle.Title, options.Callback, pressed)
elseif pressed then
if mode == "Toggle" then
control.Active = not control.Active
end
Env.call(handle.Title, options.Callback, if mode == "Toggle" then control.Active else nil)
end
row.window.KeybindsChanged:Fire()
end)
row.scope:add(control.Changed:Connect(function(key)
handle.Changed:Fire(key)
end))
function handle:GetMode()
return mode
end
function handle:SetMode(newMode)
if table.find(MODES, newMode) and newMode ~= mode then
mode = newMode
control.Mode = mode
control.Active = false
row.window.KeybindsChanged:Fire()
Env.call(handle.Title .. " mode", options.ModeChangedCallback, mode)
end
end
if options.ModePicker then
local chip = control.chip
local function pick()
local popup = Popup.toggle(row.library, chip, { Width = 150 })
if not popup then
return
end
for index, name in MODES do
local item = Create.new("TextButton", {
Name = name,
Size = UDim2.new(1, 0, 0, if row.library.touch then 40 else 30),
Text = name,
TextSize = 13,
Weight = if name == mode then "bold" else "regular",
LayoutOrder = index,
BackgroundTransparency = if name == mode then 0.86 else 1,
Theme = { BackgroundColor3 = "accent", TextColor3 = if name == mode then "accent" else "text" },
Parent = popup.frame,
})
Create.corner(6, item)
popup.scope:connect(item.Activated, function()
handle:SetMode(name)
popup.close()
end)
end
end
row.scope:connect(chip.MouseButton2Click, pick)
row.scope:connect(chip.InputBegan, function(input)
if input.UserInputType ~= Enum.UserInputType.Touch then
return
end
local started = os.clock()
control.pressStarted = started
task.delay(LONG_PRESS, function()
if control.pressStarted == started then
control.longPressed = true
pick()
end
end)
end)
row.scope:connect(chip.InputEnded, function()
control.pressStarted = nil
end)
end
function handle:Get()
return control:Get()
end
function handle:Set(key)
control:Set(key)
end
function handle:Encode()
return control:Encode()
end
function handle:Decode(name)
return control:Decode(name)
end
return handle
end
return Keybind
end
modules["Elements/Label"] = function()
local Create = import("Core/Create")
local Icons = import("Core/Icons")
local Row = import("Elements/Row")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
Styles.register("Label", "Plain", {})
Styles.register("Label", "Info", { role = "info", icon = "info" })
Styles.register("Label", "Success", { role = "success", icon = "circle-check" })
Styles.register("Label", "Warning", { role = "warning", icon = "triangle-alert" })
Styles.register("Label", "Danger", { role = "danger", icon = "circle-x" })
Styles.register("Label", "Note", { role = "accent", icon = "pin" })
local Label = {}
function Label.new(container, options)
local row = Row.new(container, options, { bare = true, compact = true })
local handle = row.handle
local look = Styles.pick("Label", options.Style, row.window)
local parent = row.content
if look.role then
local box = Create.new("Frame", {
Name = "Callout",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
BackgroundTransparency = 0.88,
Theme = { BackgroundColor3 = look.role },
Parent = row.content,
})
Create.corner(8, box)
local edge = Create.stroke(look.role, box)
edge.Transparency = 0.6
Create.padding(box, 10, 8)
Create.list(box, "Horizontal", 8, { VerticalAlignment = Enum.VerticalAlignment.Top })
Create.icon(options.Icon or look.icon, 16, look.role, box)
parent = box
end
local text = Create.new("TextLabel", {
Name = "Label",
Size = UDim2.new(if look.role then 0 else 1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
RichText = true,
TextSize = 13,
LayoutOrder = 1,
Text = options.Title,
Theme = { TextColor3 = if look.role then "text" else "textMuted" },
Parent = parent,
})
if look.role then
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = text })
end
function handle:SetTitle(newText)
self.Title = newText
text.Text = newText
self.SearchText = string.lower(newText)
end
function handle:SetKind(name)
local chosen = Styles.get("Label", name)
if chosen and chosen.role and look.role then
Theme.bind(parent, "BackgroundColor3", chosen.role)
Theme.bind(parent:FindFirstChildOfClass("UIStroke"), "Color", chosen.role)
local icon = parent:FindFirstChild("Icon")
if icon then
Theme.bind(icon, "ImageColor3", chosen.role)
Icons.apply(icon, options.Icon or chosen.icon)
end
look = chosen
end
end
handle.Set = handle.SetTitle
return handle
end
return Label
end
modules["Elements/Link"] = function()
local Create = import("Core/Create")
local Env = import("Core/Env")
local Icons = import("Core/Icons")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local Link = {}
local function domain(url)
return string.match(url, "^%a[%w+.-]*://([^/?#]+)") or url
end
function Link.new(container, options)
if type(options.Description) ~= "string" then
options.Description = domain(tostring(options.Url or ""))
end
local row = Row.new(container, options, { button = true })
local handle, scope = row.handle, row.scope
local url = tostring(options.Url or "")
local mark = Create.new("Frame", { Name = "Mark", Size = UDim2.fromOffset(row.reach, row.reach), Theme = { BackgroundColor3 = row.controlRole }, Parent = row.slot })
Create.corner(8, mark)
local glyph = Create.icon("copy", 15, "textMuted", mark)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
local box
local function fallback()
if box then
box.Visible = true
return
end
local below = row.belowTitle()
box = Create.new("TextBox", {
Name = "Address",
Size = UDim2.new(1, 0, 0, 30),
Text = url,
TextSize = 12,
TextEditable = false,
ClearTextOnFocus = false,
Theme = { BackgroundColor3 = row.controlRole, TextColor3 = "text" },
Parent = below,
})
Create.corner(6, box)
Create.padding(box, 10, 0)
end
local resetting
scope:connect(row.frame.Activated, function()
if Env.copy(url) then
Icons.apply(glyph, "check")
Theme.bind(glyph, "ImageColor3", "success")
if resetting then
task.cancel(resetting)
end
resetting = task.delay(1.5, function()
resetting = nil
if not scope.cleaned then
Icons.apply(glyph, "copy")
Theme.bind(glyph, "ImageColor3", "textMuted")
end
end)
row.fire(url)
else
fallback()
end
end)
row.onHover(function(on)
Theme.bind(mark, "BackgroundColor3", if on then "hover" else row.controlRole)
end)
function handle:Get()
return url
end
function handle:Set(value)
url = tostring(value or "")
handle:SetDescription(domain(url))
if box then
box.Text = url
end
end
handle.SearchExtra = url
return handle
end
return Link
end
modules["Elements/List"] = function()
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Motion = import("Core/Motion")
local Options = import("Elements/Options")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local List = {}
function List.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local reorder = options.Reorder == true
local multi = options.Multi == true and not reorder
local entries, plain = Options.entries(options.Values)
local values = {}
for _, entry in entries do
if not entry.heading then
table.insert(values, entry)
end
end
local itemHeight = if row.library.touch then 40 else 34
local picked = {}
if multi and type(options.Default) == "table" then
for _, value in options.Default do
picked[value] = true
end
elseif not multi and not reorder and options.Default ~= nil then
picked[options.Default] = true
end
local below = row.belowTitle()
Create.list(below, "Vertical", 6)
local search
if options.Search then
search = Create.new("TextBox", {
Name = "Search",
Size = UDim2.new(1, 0, 0, 30),
PlaceholderText = Strings.get("Filter"),
TextSize = 13,
ClearTextOnFocus = false,
Theme = { BackgroundColor3 = row.controlRole, TextColor3 = "text" },
Parent = below,
})
Create.corner(8, search)
Create.padding(search, 10, 0)
end
local box = Create.new("ScrollingFrame", {
Name = "Items",
Size = UDim2.new(1, 0, 0, 0),
LayoutOrder = 1,
ScrollBarThickness = 3,
Theme = { BackgroundColor3 = row.controlRole },
Parent = below,
})
Create.corner(8, box)
local inner = Create.new("Frame", { Name = "Inner", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = box })
Create.padding(inner, 4)
Create.fitHeight(box, inner, math.clamp(tonumber(options.Height) or 200, 80, 480), row.library, scope)
Create.list(inner, "Vertical", 2)
local items = {}
local function current()
if reorder then
local ordered = {}
for _, item in items do
table.insert(ordered, item.value)
end
return ordered
elseif multi then
return Options.ordered(plain, picked)
end
return (next(picked))
end
local function paint()
for index, item in items do
item.button.LayoutOrder = index
if not reorder then
local on = picked[item.value] == true
Theme.bind(item.button, "BackgroundColor3", if on then "accent" else "hover")
item.button.BackgroundTransparency = if on then 0.86 else 1
item.mark.Visible = on
end
end
end
local function changed()
paint()
row.fire(current())
end
local function filter()
local query = if search then string.lower(search.Text) else ""
for _, item in items do
item.button.Visible = query == "" or string.find(string.lower(item.text), query, 1, true) ~= nil
end
end
for index, entry in values do
local button = Create.new("TextButton", {
Name = "Item",
Size = UDim2.new(1, 0, 0, itemHeight),
LayoutOrder = index,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "hover" },
Parent = inner,
})
Create.corner(6, button)
Create.padding(button, 10, 0, 8, 0)
Create.list(button, "Horizontal", 10, { VerticalAlignment = Enum.VerticalAlignment.Center })
local grip
if reorder then
grip = Create.new("Frame", { Name = "Grip", Size = UDim2.fromOffset(18, itemHeight), Parent = button })
local glyph = Create.icon("grip-vertical", 14, "textMuted", grip)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
end
if entry.icon then
Create.icon(entry.icon, 15, "textMuted", button).LayoutOrder = 1
end
local text = Create.new("TextLabel", {
Name = "Text",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 13,
LayoutOrder = 2,
Text = entry.text .. (if entry.description then `  <font transparency="0.45" size="12">{entry.description}</font>` else ""),
RichText = entry.description ~= nil,
Theme = { TextColor3 = "text" },
Parent = button,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
text.TextTruncate = Enum.TextTruncate.AtEnd
local mark = Create.icon("check", 14, "accent", button)
mark.LayoutOrder = 3
mark.Visible = false
if reorder then
mark:Destroy()
end
local item = { button = button, value = entry.value, text = entry.text, mark = mark }
table.insert(items, item)
if reorder then
Drag.track(scope, grip, function()
Motion.tween(button, "fast", { BackgroundTransparency = 0.6 })
return true
end, function(position)
local top = inner.AbsolutePosition.Y
local slot = math.clamp(math.floor((position.Y - top) / ((itemHeight + 2) * row.library.scale)) + 1, 1, #items)
local from = table.find(items, item)
if from and slot ~= from then
table.remove(items, from)
table.insert(items, slot, item)
paint()
end
end, function()
Motion.tween(button, "fast", { BackgroundTransparency = 1 })
changed()
end)
else
scope:connect(button.Activated, function()
if multi then
picked[entry.value] = if picked[entry.value] then nil else true
else
local was = picked[entry.value]
table.clear(picked)
if not (was and options.AllowNone) then
picked[entry.value] = true
end
end
changed()
end)
row.onHover(function(on)
if not picked[entry.value] then
button.BackgroundTransparency = if on then 0.5 else 1
end
end, button)
end
end
if search then
scope:connect(search:GetPropertyChangedSignal("Text"), filter)
end
function handle:Get()
return current()
end
function handle:Set(value)
if reorder then
local ordered = {}
for _, wanted in if type(value) == "table" then value else {} do
for _, item in items do
if item.value == wanted and not table.find(ordered, item) then
table.insert(ordered, item)
end
end
end
for _, item in items do
if not table.find(ordered, item) then
table.insert(ordered, item)
end
end
items = ordered
else
table.clear(picked)
if multi then
for _, wanted in if type(value) == "table" then value else {} do
picked[wanted] = true
end
elseif value ~= nil then
picked[value] = true
end
end
changed()
end
local words = {}
for _, entry in values do
table.insert(words, entry.text)
end
handle.SearchExtra = table.concat(words, " ")
paint()
return handle
end
return List
end
modules["Elements/Log"] = function()
local Create = import("Core/Create")
local Env = import("Core/Env")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local Log = {}
local MONOSPACE = Font.new("rbxasset://fonts/families/RobotoMono.json")
local LEVELS = { info = "textMuted", success = "success", warn = "warning", error = "danger" }
local FILTERS = { "All", "Info", "Warn", "Error" }
function Log.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local keep = math.clamp(math.floor(tonumber(options.MaxLines) or 200), 10, 2000)
local stamps = options.Timestamps ~= false
local lines = {}
local filter = "All"
local order = 0
local function tool(icon, label, orderIndex)
local button = Create.new("TextButton", {
Name = label,
Size = UDim2.fromOffset(row.reach, row.reach),
LayoutOrder = orderIndex,
Theme = { BackgroundColor3 = row.controlRole },
Parent = row.slot,
})
Create.corner(8, button)
local glyph = Create.icon(icon, 14, "textMuted", button)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
row.onHover(function(on)
Theme.bind(glyph, "ImageColor3", if on then "text" else "textMuted")
end, button)
return button, glyph
end
local copyButton, copyGlyph = tool("copy", "Copy", 1)
local clearButton = tool("trash-2", "Clear", 2)
local below = row.belowTitle()
Create.list(below, "Vertical", 6)
local chips = Create.new("Frame", { Name = "Levels", Size = UDim2.new(1, 0, 0, 24), Parent = below })
Create.list(chips, "Horizontal", 4)
local chipButtons = {}
local box = Create.new("ScrollingFrame", {
Name = "Lines",
Size = UDim2.new(1, 0, 0, math.clamp(tonumber(options.Height) or 180, 80, 480)),
LayoutOrder = 1,
ScrollBarThickness = 3,
Theme = { BackgroundColor3 = row.controlRole },
Parent = below,
})
Create.corner(8, box)
local inner = Create.new("Frame", { Name = "Inner", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = box })
Create.padding(inner, 10, 8)
Create.list(inner, "Vertical", 2)
local empty = Create.new("TextLabel", {
Name = "Empty",
Size = UDim2.new(1, 0, 0, 20),
Text = options.EmptyText or Strings.get("Nothing yet"),
TextSize = 12,
LayoutOrder = 0,
Theme = { TextColor3 = "textMuted" },
Parent = inner,
})
local function shows(line)
return filter == "All" or string.lower(filter) == line.level or (filter == "Error" and line.level == "error")
end
local function paintChips()
for name, chip in chipButtons do
local on = name == filter
Theme.bind(chip, "BackgroundColor3", if on then "accent" else row.controlRole)
Theme.bind(chip, "TextColor3", if on then "onAccent" else "textMuted")
end
end
local function refresh()
local visible = 0
for _, line in lines do
line.label.Visible = shows(line)
if line.label.Visible then
visible += 1
end
end
empty.Visible = visible == 0
end
for index, name in FILTERS do
local chip = Create.new("TextButton", {
Name = name,
Size = UDim2.fromOffset(0, 24),
AutomaticSize = Enum.AutomaticSize.X,
Text = Strings.get(name),
TextSize = 12,
Weight = "medium",
LayoutOrder = index,
Theme = { BackgroundColor3 = row.controlRole, TextColor3 = "textMuted" },
Parent = chips,
})
Create.corner(-1, chip)
Create.padding(chip, 10, 0)
chipButtons[name] = chip
scope:connect(chip.Activated, function()
filter = name
paintChips()
refresh()
end)
end
paintChips()
local function atBottom()
local canvas, shown = box.AbsoluteCanvasSize, box.AbsoluteWindowSize
if not canvas or not shown then
return true
end
return box.CanvasPosition.Y >= canvas.Y - shown.Y - 24
end
function handle:Add(text, level)
level = if LEVELS[level] then level else "info"
local follow = atBottom()
order += 1
local stamp = if stamps then os.date("%H:%M:%S") .. "  " else ""
local label = Create.new("TextLabel", {
Name = "Line",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 12,
FontFace = MONOSPACE,
LayoutOrder = order,
Text = stamp .. tostring(text),
Theme = { TextColor3 = LEVELS[level] },
Parent = inner,
})
local line = { label = label, level = level, text = stamp .. tostring(text) }
table.insert(lines, line)
while #lines > keep do
table.remove(lines, 1).label:Destroy()
end
refresh()
if follow then
task.defer(function()
local canvas, shown = box.AbsoluteCanvasSize, box.AbsoluteWindowSize
if not scope.cleaned and canvas and shown then
box.CanvasPosition = Vector2.new(0, math.max(canvas.Y - shown.Y, 0))
end
end)
end
row.fire(text, level)
end
function handle:Info(text)
handle:Add(text, "info")
end
function handle:Success(text)
handle:Add(text, "success")
end
function handle:Warn(text)
handle:Add(text, "warn")
end
function handle:Error(text)
handle:Add(text, "error")
end
function handle:Clear()
for _, line in lines do
line.label:Destroy()
end
table.clear(lines)
refresh()
end
function handle:Get()
local out = {}
for _, line in lines do
table.insert(out, line.text)
end
return table.concat(out, "\n")
end
scope:connect(clearButton.Activated, function()
handle:Clear()
end)
scope:connect(copyButton.Activated, function()
if Env.copy(handle:Get()) then
Theme.bind(copyGlyph, "ImageColor3", "success")
task.delay(1.2, function()
if not scope.cleaned then
Theme.bind(copyGlyph, "ImageColor3", "textMuted")
end
end)
end
end)
refresh()
return handle
end
return Log
end
modules["Elements/MenuButton"] = function()
local Create = import("Core/Create")
local Menu = import("Components/Menu")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local MenuButton = {}
function MenuButton.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local items = options.Items or {}
local button = Create.new("TextButton", {
Name = "Menu",
Size = UDim2.fromOffset(0, row.reach),
AutomaticSize = Enum.AutomaticSize.X,
Theme = { BackgroundColor3 = row.controlRole },
Parent = row.slot,
})
Create.corner(8, button)
Create.stroke("stroke", button)
Create.padding(button, 12, 0, 10, 0)
Create.list(button, "Horizontal", 6, { VerticalAlignment = Enum.VerticalAlignment.Center })
Create.new("TextLabel", {
Name = "Label",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = options.Text or Strings.get("Actions"),
TextSize = 13,
Weight = "medium",
Theme = { TextColor3 = "text" },
Parent = button,
})
local chevron = Create.icon("chevron-down", 14, "textMuted", button)
chevron.LayoutOrder = 1
row.onHover(function(on)
Theme.bind(button, "BackgroundColor3", if on then "hover" else row.controlRole)
end, button)
scope:connect(button.Activated, function()
local popup = Menu.open(row.library, button, items, options.Width)
Motion.tween(chevron, "fast", { Rotation = if popup then 180 else 0 })
if popup then
popup.scope:add(function()
if not scope.cleaned then
Motion.tween(chevron, "fast", { Rotation = 0 })
end
end)
end
end)
function handle:SetItems(list)
items = list or {}
end
return handle
end
return MenuButton
end
modules["Elements/Options"] = function()
local Options = {}
function Options.entries(list)
local entries, values = {}, {}
for _, raw in list or {} do
if type(raw) == "table" then
if raw.Heading ~= nil then
table.insert(entries, { heading = tostring(raw.Heading) })
else
local value = if raw.Value ~= nil then raw.Value else (raw.Text or raw.Title)
if value ~= nil then
table.insert(entries, {
value = value,
text = tostring(raw.Text or raw.Title or value),
icon = raw.Icon,
image = raw.Image,
description = raw.Description,
disabled = raw.Disabled == true,
})
table.insert(values, value)
end
end
else
table.insert(entries, { value = raw, text = tostring(raw) })
table.insert(values, raw)
end
end
return entries, values
end
function Options.ordered(values, picked)
local list = {}
for _, value in values do
if picked[value] then
table.insert(list, value)
end
end
return list
end
function Options.pick(values, picked, wanted, multi)
table.clear(picked)
wanted = if multi and type(wanted) == "table" then wanted else { wanted }
for _, item in wanted do
if table.find(values, item) then
picked[item] = true
if not multi then
break
end
end
end
end
return Options
end
modules["Elements/PageLink"] = function()
local Create = import("Core/Create")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local PageLink = {}
function PageLink.new(container, options)
local row = Row.new(container, options, { button = true })
local handle = row.handle
local arrow = Create.icon("chevron-right", 16, "textMuted", row.slot)
row.onHover(function(active)
Theme.bind(arrow, "ImageColor3", if active then "accent" else "textMuted")
Theme.bind(row.frame, "BackgroundColor3", if active then "hover" else container.rowRole or "raised")
row.frame.BackgroundTransparency = if active then 0 elseif container.rowFill then 0 else 1
end)
row.scope:connect(row.frame.Activated, function()
if not handle:IsLocked() and options.Page then
row.window:SelectTab(options.Page)
row.fire(options.Page)
end
end)
function handle:Get()
return options.Page
end
return handle
end
return PageLink
end
modules["Elements/Paragraph"] = function()
local Create = import("Core/Create")
local Env = import("Core/Env")
local Icons = import("Core/Icons")
local Row = import("Elements/Row")
local Styles = import("Core/Styles")
local Paragraph = {}
function Paragraph.new(container, options)
local row = Row.new(container, { Title = options.Title, Description = options.Content, Icon = options.Icon })
local handle = row.handle
local description = row.titleBlock and row.titleBlock:FindFirstChild("Description")
if description then
description.RichText = true
end
if options.Image then
local size = tonumber(options.ImageSize) or 48
local picture = Create.new("ImageLabel", {
Name = "Picture",
Size = UDim2.fromOffset(size, size),
ScaleType = Enum.ScaleType.Crop,
LayoutOrder = -1,
Parent = row.titleBlock.Parent,
})
Create.corner(8, picture)
Icons.apply(picture, options.Image)
end
if type(options.Buttons) == "table" then
local line = row.belowTitle()
Create.list(line, "Horizontal", 8)
for index, spec in options.Buttons do
local look = Styles.get("Button", spec.Variant or "Soft") or Styles.get("Button", "Soft")
if look.row then
look = Styles.get("Button", "Soft")
end
local button = Create.new("TextButton", {
Name = "Button",
Size = UDim2.fromOffset(0, 28),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(spec.Title or ""),
TextSize = 13,
Weight = "medium",
LayoutOrder = index,
BackgroundTransparency = look.fillTransparency or 0,
Theme = { BackgroundColor3 = look.fill, TextColor3 = look.text },
Parent = line,
})
Create.corner(6, button)
Create.padding(button, 12, 0)
if look.stroke then
Create.stroke(look.stroke, button)
end
row.scope:connect(button.Activated, function()
Env.call(tostring(spec.Title), spec.Callback)
end)
end
end
function handle:Set(value)
if type(value) == "table" then
if value.Title then
self:SetTitle(value.Title)
end
self:SetDescription(value.Content)
else
self:SetDescription(tostring(value))
end
end
return handle
end
return Paragraph
end
modules["Elements/PlayerList"] = function()
local Players = game:GetService("Players")
local Create = import("Core/Create")
local Env = import("Core/Env")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local PlayerList = {}
function PlayerList.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local localPlayer = Players.LocalPlayer
local selected
local rows = {}
local itemHeight = if row.library.touch then 48 else 42
local count = Create.new("TextLabel", {
Name = "Count",
Size = UDim2.fromOffset(0, 20),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
Theme = { TextColor3 = "textMuted" },
Parent = row.slot,
})
local below = row.belowTitle()
Create.list(below, "Vertical", 6)
local search
if options.Search ~= false then
search = Create.new("TextBox", {
Name = "Search",
Size = UDim2.new(1, 0, 0, 30),
PlaceholderText = Strings.get("Find a player"),
TextSize = 13,
ClearTextOnFocus = false,
Theme = { BackgroundColor3 = row.controlRole, TextColor3 = "text" },
Parent = below,
})
Create.corner(8, search)
Create.padding(search, 10, 0)
end
local box = Create.new("ScrollingFrame", {
Name = "Players",
Size = UDim2.new(1, 0, 0, 0),
LayoutOrder = 1,
ScrollBarThickness = 3,
Theme = { BackgroundColor3 = row.controlRole },
Parent = below,
})
Create.corner(8, box)
local inner = Create.new("Frame", { Name = "Inner", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = box })
Create.padding(inner, 4)
Create.list(inner, "Vertical", 2)
Create.fitHeight(box, inner, math.clamp(tonumber(options.Height) or 240, 90, 520), row.library, scope)
local empty = Create.new("TextLabel", {
Name = "Empty",
Size = UDim2.new(1, 0, 0, 36),
Text = Strings.get("No one else is here"),
TextSize = 12,
TextXAlignment = Enum.TextXAlignment.Center,
Theme = { TextColor3 = "textMuted" },
Parent = inner,
})
local function paint()
local query = if search then string.lower(search.Text) else ""
local shown = 0
for player, entry in rows do
local match = query == "" or string.find(string.lower(player.Name), query, 1, true) or string.find(string.lower(player.DisplayName), query, 1, true)
entry.button.Visible = match ~= nil and match ~= false
if entry.button.Visible then
shown += 1
end
local on = selected == player
Theme.bind(entry.button, "BackgroundColor3", if on then "accent" else "hover")
entry.button.BackgroundTransparency = if on then 0.86 else 1
end
empty.Visible = shown == 0
local total = 0
for _ in rows do
total += 1
end
count.Text = if total == 1 then Strings.get("1 player") else Strings.get("{count} players", { count = total })
count.Visible = total > 0
end
local function add(player)
if rows[player] or (player == localPlayer and not options.ShowSelf) then
return
end
local button = Create.new("TextButton", {
Name = player.Name,
Size = UDim2.new(1, 0, 0, itemHeight),
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "hover" },
Parent = inner,
})
Create.corner(6, button)
Create.padding(button, 8, 0)
Create.list(button, "Horizontal", 10, { VerticalAlignment = Enum.VerticalAlignment.Center })
local picture = Create.new("ImageLabel", {
Name = "Avatar",
Size = UDim2.fromOffset(itemHeight - 12, itemHeight - 12),
Image = `rbxthumb://type=AvatarHeadShot&id={player.UserId}&w=60&h=60`,
Theme = { BackgroundColor3 = "raised" },
Parent = button,
})
Create.corner(-1, picture)
local names = Create.new("Frame", { Name = "Names", Size = UDim2.fromScale(0, 1), LayoutOrder = 1, Parent = button }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.list(names, "Vertical", 0, { VerticalAlignment = Enum.VerticalAlignment.Center })
Create.new("TextLabel", {
Name = "Display",
Size = UDim2.new(1, 0, 0, 16),
Text = player.DisplayName,
TextSize = 13,
Weight = "medium",
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = "text" },
Parent = names,
})
Create.new("TextLabel", {
Name = "User",
Size = UDim2.new(1, 0, 0, 14),
Text = "@" .. player.Name,
TextSize = 11,
LayoutOrder = 1,
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = "textMuted" },
Parent = names,
})
for order, settings in options.Actions or {} do
local action = Create.new("TextButton", {
Name = settings.Title or "Action",
Size = UDim2.fromOffset(row.reach, row.reach),
LayoutOrder = 1 + order,
Theme = { BackgroundColor3 = row.controlRole },
Parent = button,
})
Create.corner(8, action)
local glyph = Create.icon(settings.Icon or "arrow-right", 14, "textMuted", action)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
row.onHover(function(on)
Theme.bind(glyph, "ImageColor3", if on then "accent" else "textMuted")
end, action)
scope:connect(action.Activated, function()
Env.call(settings.Title or "Player action", settings.Callback, player)
end)
end
if options.Selectable then
scope:connect(button.Activated, function()
selected = if selected == player then nil else player
paint()
row.fire(if selected then selected.Name else nil)
end)
end
rows[player] = { button = button }
paint()
end
local function drop(player)
local entry = rows[player]
if entry then
entry.button:Destroy()
rows[player] = nil
if selected == player then
selected = nil
row.fire(nil)
end
paint()
end
end
for _, player in Players:GetPlayers() do
add(player)
end
scope:connect(Players.PlayerAdded, add)
scope:connect(Players.PlayerRemoving, drop)
if search then
scope:connect(search:GetPropertyChangedSignal("Text"), paint)
end
function handle:Get()
return if selected then selected.Name else nil
end
function handle:Set(name)
selected = if type(name) == "string" then Players:FindFirstChild(name) else nil
paint()
row.fire(if selected then selected.Name else nil)
end
paint()
return handle
end
return PlayerList
end
modules["Elements/Progress"] = function()
local Create = import("Core/Create")
local Effects = import("Core/Effects")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Progress = {}
function Progress.new(container, options)
local row = Row.new(container, options)
local handle = row.handle
local max = options.Max or 100
local value = 0
local readout = Create.new("TextLabel", {
Name = "Value",
Size = UDim2.fromOffset(0, 20),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 13,
Theme = { TextColor3 = "textMuted" },
Parent = row.slot,
})
local rail = Create.new("Frame", {
Name = "Rail",
Size = UDim2.new(1, 0, 0, 6),
Theme = { BackgroundColor3 = "stroke" },
Parent = row.belowTitle(),
})
Create.corner(-1, rail)
local fill = Create.new("Frame", {
Name = "Fill",
Size = UDim2.fromScale(0, 1),
Theme = { BackgroundColor3 = "accent" },
Parent = rail,
})
Create.corner(-1, fill)
Effects.accentFill(row.scope, fill)
function handle:Get()
return value
end
function handle:Set(newValue)
value = math.clamp(tonumber(newValue) or 0, 0, max)
local fraction = if max > 0 then value / max else 0
readout.Text = if options.Suffix then tostring(value) .. options.Suffix else math.round(fraction * 100) .. "%"
Motion.tween(fill, "base", { Size = UDim2.fromScale(fraction, 1) })
self.Changed:Fire(value)
end
handle:Set(options.Value or 0)
return handle
end
return Progress
end
modules["Elements/Rating"] = function()
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local Rating = {}
function Rating.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local max = math.clamp(math.floor(tonumber(options.Max) or 5), 1, 10)
local value = math.clamp(math.floor(tonumber(options.Default) or 0), 0, max)
local preview
local marks = {}
local size = if row.library.touch then 30 else 22
local holder = Create.new("Frame", { Name = "Rating", Size = UDim2.fromOffset(0, size), AutomaticSize = Enum.AutomaticSize.X, Parent = row.slot })
Create.list(holder, "Horizontal", 2)
local function draw()
local shown = preview or value
for index, mark in marks do
local on = index <= shown
Theme.bind(mark.glyph, "ImageColor3", if on then "warning" else "stroke")
Motion.tween(mark.scale, "fast", { Scale = if preview and index == preview then 1.15 else 1 })
end
end
function handle:Get()
return value
end
function handle:Set(newValue)
value = math.clamp(math.floor(tonumber(newValue) or 0), 0, max)
draw()
row.fire(value)
end
for index = 1, max do
local button = Create.new("ImageButton", { Name = "Mark", Size = UDim2.fromOffset(size, size), LayoutOrder = index, Parent = holder })
local glyph = Create.icon(options.Icon or "star", size - 6, "stroke", button)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
local mark = { glyph = glyph, scale = Create.new("UIScale", { Parent = glyph }) }
marks[index] = mark
scope:connect(button.MouseEnter, function()
preview = index
draw()
end)
scope:connect(button.MouseLeave, function()
if preview == index then
preview = nil
draw()
end
end)
scope:connect(button.Activated, function()
handle:Set(if index == value and options.AllowNone then 0 else index)
end)
end
draw()
return handle
end
return Rating
end
modules["Elements/Registry"] = function()
local Choices = import("Elements/Choices")
local Env = import("Core/Env")
local Menu = import("Components/Menu")
local Spotlight = import("Components/Spotlight")
local Gauge = import("Elements/Gauge")
local Stat = import("Elements/Stat")
local Strings = import("Core/Strings")
local Tooltip = import("Components/Tooltip")
local Schema = import("Core/Schema")
local Favourites = import("Components/Favourites")
local Row = import("Elements/Row")
local MODULES = {
Button = import("Elements/Button"),
Toggle = import("Elements/Toggle"),
Slider = import("Elements/Slider"),
Dropdown = import("Elements/Dropdown"),
Input = import("Elements/Input"),
Keybind = import("Elements/Keybind"),
ColorPicker = import("Elements/ColorPicker"),
Segmented = import("Elements/Segmented"),
Stepper = import("Elements/Stepper"),
Progress = import("Elements/Progress"),
Paragraph = import("Elements/Paragraph"),
Label = import("Elements/Label"),
Divider = import("Elements/Divider"),
Code = import("Elements/Code"),
Image = import("Elements/Image"),
Radio = { new = Choices.radio },
Checklist = { new = Choices.checklist },
Chips = { new = Choices.chips },
Tiles = import("Elements/Tiles"),
Rating = import("Elements/Rating"),
Accordion = import("Elements/Accordion"),
Status = import("Elements/Status"),
Countdown = import("Elements/Countdown"),
Buttons = import("Elements/Buttons"),
Space = import("Elements/Space"),
Table = import("Elements/Table"),
DatePicker = import("Elements/DatePicker"),
List = import("Elements/List"),
Tags = import("Elements/Tags"),
PlayerList = import("Elements/PlayerList"),
MenuButton = import("Elements/MenuButton"),
Stat = Stat,
Stats = { new = Stat.group },
Graph = import("Elements/Graph"),
Log = import("Elements/Log"),
Banner = import("Elements/Banner"),
Link = import("Elements/Link"),
Viewport = import("Elements/Viewport"),
Gauge = Gauge,
Knob = { new = Gauge.knob },
Chart = import("Elements/Chart"),
ItemGrid = import("Elements/ItemGrid"),
Waypoints = import("Elements/Waypoints"),
PageLink = import("Elements/PageLink"),
}
local UNTITLED = { Divider = true, Code = true, Image = true, Buttons = true, Space = true, Table = true, Stats = true }
local Registry = { Kinds = {}, KindSet = {}, custom = {} }
for kind in MODULES do
table.insert(Registry.Kinds, kind)
Registry.KindSet[kind] = true
end
table.sort(Registry.Kinds)
local function condition(setting)
if type(setting) == "table" and not setting.Get then
local value = setting.Value
if value == nil then
value = setting[2]
end
return setting.Flag or setting[1], value
end
return setting, nil
end
Registry.condition = condition
function Registry.blocked(window, section)
return window.disabledAll == true or (section ~= nil and (section.switchedOff == true or section.disabled == true))
end
local function create(container, kind, options)
if type(options) == "string" then
options = { Title = options }
end
options = options or {}
if type(options) ~= "table" then
error(`{kind} expects a table of options`, 3)
elseif not UNTITLED[kind] and type(options.Title) ~= "string" then
error(`{kind} needs a Title`, 3)
end
local spec = Schema.elements[kind] or Registry.custom[kind]
if spec then
Schema.check(`{kind} "{options.Title or ""}"`, options, spec.options, Schema.shared)
end
local window = container.window
local problem = window:checkFlag(options.Flag)
if problem then
error(problem, 3)
end
local handle = MODULES[kind].new(container, options)
handle.Kind = kind
handle.ownerWindow = window
window:claimFlag(options.Flag, handle)
local entry = { handle = handle, section = container.section }
table.insert(container.entries, entry)
handle.scope:add(function()
local index = table.find(container.entries, entry)
if index then
table.remove(container.entries, index)
end
end)
local requirement = options.Tier or (options.PaidOnly and true) or container.tier
if requirement then
handle.LockText = options.LockText or container.lockText
handle.LockHint = options.LockHint or container.lockHint
handle.QuietLock = container.lockOverlay ~= nil and options.Tier == nil and not options.PaidOnly
window:gate(handle, requirement)
end
if type(options.Requires) == "table" then
local missing = Env.missing(options.Requires)
if #missing > 0 then
handle.MissingText = Strings.get("Needs {names}", { names = table.concat(missing, ", ") })
handle:Lock(handle.MissingText, "wrench")
end
end
if handle.SetBlocked and Registry.blocked(window, container.section) then
handle:SetBlocked(true)
end
if (type(options.Tooltip) == "string" or type(options.Tooltip) == "table") and handle.row then
Tooltip.attach(handle.row, options.Tooltip)
end
handle.Tab = container.tab or (container.section and container.section.tab)
if options.Spotlight then
Spotlight.attach(window, handle, options.Spotlight)
end
function handle.Spotlight(target, settings)
return Spotlight.attach(window, target, settings)
end
function handle.ShowWhen(target, source, expected)
Registry.follow(target, source, expected)
end
function handle.EnableWhen(target, source, expected)
Registry.enableWhen(target, source, expected)
end
function handle.SetEnabled(target, enabled)
if target.SetDisabled then
target:SetDisabled(enabled == false)
end
end
handle.Options = options
if handle.Get and handle.Set then
Registry.values(handle)
end
Registry.switches(handle, options)
local favourite = Favourites.register(window, handle, container)
local own = type(options.Menu) == "table" or type(options.Menu) == "function"
if (own or favourite) and handle.Frame then
Menu.attach(handle.scope, window.library, handle.Frame, function()
local items = {}
if favourite then
table.insert(items, Favourites.menuItem(window, handle))
end
if own then
local listed = if type(options.Menu) == "function" then options.Menu() else options.Menu
if #items > 0 and #listed > 0 then
table.insert(items, { Divider = true })
end
for _, item in listed do
table.insert(items, item)
end
end
return items
end)
end
if window.query ~= "" then
window:applySearch()
end
return handle
end
local function watch(target, source, expected, apply, name, late)
local window = target.window or target.ownerWindow
if expected == nil then
expected = true
end
local function attach(element)
local function check()
local value = element:Get()
local matches
if type(expected) == "function" then
local ok, result = pcall(expected, value)
matches = ok and result == true
elseif type(value) == "table" then
matches = table.find(value, expected) ~= nil
else
matches = value == expected
end
apply(matches)
end
target.scope:connect(element.Changed, check)
check()
end
if type(source) == "string" then
local flag = source
source = window and window.Flags[flag]
if source == nil and window and late then
task.defer(function()
if target.scope.cleaned then
return
end
local late = window.Flags[flag]
if type(late) == "table" and late.Changed and late.Get then
attach(late)
else
warn(`[Halcyon] {name} names the Flag "{flag}", but no element has it.`)
end
end)
return
end
end
if type(source) ~= "table" or not source.Changed or not source.Get then
error(`{name} needs an element, or the Flag of one`, 4)
end
attach(source)
end
function Registry.follow(target, source, expected, late)
watch(target, source, expected, function(shown)
target:SetVisible(shown)
end, "ShowWhen", late)
end
function Registry.enableWhen(target, source, expected, late)
watch(target, source, expected, function(enabled)
target:SetEnabled(enabled)
end, "EnableWhen", late)
end
function Registry.switches(target, options)
if options.Visible == false and target.SetVisible then
target:SetVisible(false)
end
if (options.Enabled == false or options.Disabled == true) and target.SetEnabled then
target:SetEnabled(false)
end
if options.ShowWhen ~= nil then
local source, expected = condition(options.ShowWhen)
Registry.follow(target, source, expected, true)
end
if options.EnableWhen ~= nil then
local source, expected = condition(options.EnableWhen)
Registry.enableWhen(target, source, expected, true)
end
end
local function copy(value)
return if type(value) == "table" then table.clone(value) else value
end
function Registry.values(handle)
local row = handle.row
local function read()
return copy(if handle.Encode then handle:Encode() else handle:Get())
end
local function write(saved)
handle:Set(if handle.Decode then handle:Decode(copy(saved)) else copy(saved))
end
local default = read()
function handle.SetSilent(target, value)
if not row then
target:Set(value)
return
end
row.silent = true
local ok, problem = pcall(target.Set, target, value)
row.silent = false
if not ok then
error(problem, 2)
end
end
function handle.GetDefault()
return if handle.Decode then handle:Decode(copy(default)) else copy(default)
end
function handle.Reset()
write(default)
end
handle.readSaved, handle.writeSaved = read, write
end
local methods = {}
function Registry.method(kind)
local method = methods[kind]
if not method then
method = function(self, options)
return create(self, kind, options)
end
methods[kind] = method
end
return method
end
function Registry.install(container)
for kind in MODULES do
container[kind] = Registry.method(kind)
end
if getmetatable(container) == nil then
setmetatable(container, {
__index = function(_, key)
return if Registry.KindSet[key] then Registry.method(key) else nil
end,
})
end
end
function Registry.register(kind, definition)
if type(kind) ~= "string" or not string.match(kind, "^%u%w*$") then
return false, "An element kind is one capitalised word, such as \"Counter\""
elseif MODULES[kind] or Registry.KindSet[kind] then
return false, `"{kind}" is already an element kind`
elseif type(definition) ~= "table" or type(definition.Build) ~= "function" then
return false, `RegisterElement("{kind}") needs a table with a Build function`
end
MODULES[kind] = {
new = function(container, options)
local row = Row.new(container, options, definition.Layout)
definition.Build(row, options, row.handle)
return row.handle
end,
}
if definition.Untitled then
UNTITLED[kind] = true
end
Registry.custom[kind] = { options = definition.Options or {}, value = definition.Value or "any" }
table.insert(Registry.Kinds, kind)
table.sort(Registry.Kinds)
Registry.KindSet[kind] = true
return true
end
return Registry
end
modules["Elements/Row"] = function()
local Create = import("Core/Create")
local Effects = import("Core/Effects")
local Icons = import("Core/Icons")
local Popup = import("Components/Popup")
local Signal = import("Core/Signal")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local Tokens = import("Core/Tokens")
local MIN_TITLE = 96
local LOCK_GIVE = 12
local BUSY_AFTER = 0.15
local Row = {}
local BADGES = { New = "accent", Beta = "info", Risky = "danger", Paid = "warning" }
function Row.badge(parent, badge)
local text, role, color
if type(badge) == "table" then
text, color = tostring(badge.Text or ""), badge.Color
else
text = tostring(badge)
role = BADGES[text] or "accent"
end
local pill = Create.new("TextLabel", {
Name = "Badge",
Size = UDim2.fromOffset(0, 16),
AutomaticSize = Enum.AutomaticSize.X,
Text = string.upper(text),
TextSize = 10,
Weight = "bold",
LayoutOrder = 2,
BackgroundTransparency = 0.82,
Parent = parent,
})
Create.corner(4, pill)
Create.padding(pill, 5, 0)
if typeof(color) == "Color3" then
pill.BackgroundColor3, pill.TextColor3 = color, color
else
Theme.bind(pill, "BackgroundColor3", role or "accent")
Theme.bind(pill, "TextColor3", role or "accent")
end
return pill
end
function Row.info(row, parent, explanation)
local button = Create.new("ImageButton", { Name = "Info", Size = UDim2.fromOffset(18, 18), LayoutOrder = 3, Parent = parent })
local glyph = Create.icon("info", 14, "textMuted", button)
glyph.AnchorPoint = Vector2.new(0.5, 0.5)
glyph.Position = UDim2.fromScale(0.5, 0.5)
local open = false
local function show(wanted)
local library = row.library
local current = library.popup
local showing = current ~= nil and current.anchor == button
if wanted == showing then
return
end
local popup = Popup.toggle(library, button, { Width = 240 })
open = popup ~= nil
if popup then
Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 13,
Text = tostring(explanation),
Theme = { TextColor3 = "text" },
Parent = popup.frame,
})
end
end
row.scope:connect(button.MouseEnter, function()
Theme.bind(glyph, "ImageColor3", "text")
show(true)
end)
row.scope:connect(button.MouseLeave, function()
Theme.bind(glyph, "ImageColor3", "textMuted")
show(false)
end)
row.scope:connect(button.Activated, function()
show(not open)
end)
return button
end
function Row.new(container, options, layout)
layout = layout or {}
local scope = container.scope:child()
local filled = container.rowFill == true
local frame = Create.new(if layout.button then "TextButton" else "Frame", {
Name = "Row",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = container:nextOrder(),
BackgroundTransparency = if filled and not layout.bare then 0 else 1,
Theme = { BackgroundColor3 = container.rowRole or "raised" },
Parent = container.frame,
})
Create.corner(8, frame)
scope:add(frame)
local content = Create.new("Frame", {
Name = "Content",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Parent = frame,
})
local padding = Create.padding(content, 12, if layout.compact then 4 else Tokens.density.rowPadding)
Create.list(content, "Vertical", 8, { VerticalAlignment = Enum.VerticalAlignment.Center })
if not layout.compact then
padding:SetAttribute("HalcyonDensity", "padding")
local minimum = Create.new("UISizeConstraint", { MinSize = Vector2.new(0, Tokens.rowHeight()), Parent = content })
minimum:SetAttribute("HalcyonDensity", "height")
end
local row = {
frame = frame,
content = content,
scope = scope,
library = container.library,
window = container.window,
options = options,
controlRole = if filled then "background" else "raised",
reach = if container.library.touch then 40 else 28,
}
local title, description, slot, head
if not layout.bare then
head = Create.new("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = content })
Create.list(head, "Horizontal", 12)
if options.Icon then
Create.icon(options.Icon, 18, "textMuted", head)
end
local text = Create.new("Frame", { Name = "Text", AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = head }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.list(text, "Vertical", 2)
title = Create.new("TextLabel", {
Name = "Title",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
Weight = "medium",
Text = options.Title or "",
Theme = { TextColor3 = "text" },
Parent = text,
})
row.titleBlock = text
description = Create.new("TextLabel", {
Name = "Description",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 12,
LayoutOrder = 1,
Theme = { TextColor3 = "textMuted" },
Parent = text,
})
slot = Create.new("Frame", { Name = "Slot", AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 2, Parent = head })
local slotLayout = Create.list(slot, "Horizontal", 8, { HorizontalAlignment = Enum.HorizontalAlignment.Right })
row.slot, row.title = slot, title
local wrapped = false
local function arrange()
local width, taken = head.AbsoluteSize.X, slot.AbsoluteSize.X
local lane = (width - taken) / row.library.scale - 12 - (if options.Icon then 30 else 0)
local wrap = width > 0 and taken > 0 and lane < MIN_TITLE
if wrap ~= wrapped then
wrapped = wrap
slotLayout.HorizontalAlignment = if wrap then Enum.HorizontalAlignment.Left else Enum.HorizontalAlignment.Right
slot.LayoutOrder = if wrap then 1 else 2
slot.Parent = if wrap then content else head
end
end
scope:connect(head:GetPropertyChangedSignal("AbsoluteSize"), arrange)
scope:connect(slot:GetPropertyChangedSignal("AbsoluteSize"), arrange)
end
local veil, lock, badge, badgePadding, badgeLayout, lockIcon, lockLabel, shimmer, headRoom
local refresh
local narrowLock = false
local labelWidth = 0
local function makeRoom()
if not headRoom or not lock then
return
end
local scale = row.library.scale
if lockLabel.Visible and lockLabel.TextBounds.X > 0 then
labelWidth = lockLabel.TextBounds.X
end
local spare = (frame.AbsoluteSize.X / scale) - (labelWidth + 13 + 6 + 20) - 24
local narrow = lock.Visible and spare < (if narrowLock then MIN_TITLE + LOCK_GIVE else MIN_TITLE)
if narrow ~= narrowLock then
narrowLock = narrow
lockLabel.Visible = not narrow
lock.AutomaticSize = if narrow then Enum.AutomaticSize.None else Enum.AutomaticSize.X
lock.Size = UDim2.fromOffset(if narrow then 24 else 0, 24)
badge.AutomaticSize = lock.AutomaticSize
badge.Size = if narrow then UDim2.fromScale(1, 1) else UDim2.fromScale(0, 1)
badgeLayout.HorizontalAlignment = if narrow then Enum.HorizontalAlignment.Center else Enum.HorizontalAlignment.Left
badgePadding.PaddingLeft = UDim.new(0, if narrow then 0 else 10)
badgePadding.PaddingRight = badgePadding.PaddingLeft
refresh()
return
end
headRoom.PaddingRight = UDim.new(0, if lock.Visible then lock.AbsoluteSize.X / scale + 12 else 0)
end
local function buildVeil()
if veil then
return
end
veil = Create.new("TextButton", {
Name = "Veil",
Text = "",
Size = UDim2.fromScale(1, 1),
ZIndex = 5,
Visible = false,
BackgroundTransparency = 0.45,
Theme = { BackgroundColor3 = if filled then container.rowRole or "raised" else container.surface },
Parent = frame,
})
Create.corner(8, veil)
lock = Create.new("Frame", {
Name = "Lock",
Size = UDim2.fromOffset(0, 24),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(1, 0.5),
Position = UDim2.new(1, -12, 0, 22),
Visible = false,
Theme = { BackgroundColor3 = "accent" },
Parent = veil,
})
Create.corner(-1, lock)
badge = Create.new("Frame", { Name = "Badge", Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Parent = lock })
badgePadding = Create.padding(badge, 10, 0)
badgeLayout = Create.list(badge, "Horizontal", 6)
lockIcon = Create.icon("lock", 13, "onAccent", badge)
lockLabel = Create.new("TextLabel", {
Name = "Reason",
Text = "",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
Weight = "bold",
LayoutOrder = 1,
Theme = { TextColor3 = "onAccent" },
Parent = badge,
})
shimmer = Effects.shimmer(scope, lock, -1)
headRoom = if head then Create.new("UIPadding", { Parent = head }) else nil
scope:connect(lock:GetPropertyChangedSignal("AbsoluteSize"), makeRoom)
scope:connect(frame:GetPropertyChangedSignal("AbsoluteSize"), makeRoom)
if head then
local function align()
lock.Position = UDim2.new(1, -12, 0, (head.AbsolutePosition.Y - frame.AbsolutePosition.Y + head.AbsoluteSize.Y / 2) / row.library.scale)
end
scope:connect(head:GetPropertyChangedSignal("AbsoluteSize"), align)
scope:connect(head:GetPropertyChangedSignal("AbsolutePosition"), align)
align()
end
end
local state = { disabled = false, locked = false, reason = nil, description = options.Description }
local handle = { Frame = frame, Title = options.Title or "", Changed = Signal.new(), Hidden = false, scope = scope }
scope:add(handle.Changed)
row.handle = handle
handle.row = row
function refresh()
local covered = state.disabled or state.locked or state.blocked == true
if covered then
buildVeil()
end
if veil then
veil.Visible = covered
lock.Visible = state.locked and not state.quiet
makeRoom()
veil.BackgroundTransparency = 0.45
if lock.Visible and row.window.lockShimmer then
shimmer.start()
else
shimmer.stop()
end
lockLabel.Text = state.reason or ""
end
if slot then
slot.Visible = not state.locked
end
if description then
local shown = if state.locked and narrowLock then state.reason else state.description
description.Text = shown or ""
description.Visible = shown ~= nil and shown ~= ""
Theme.bind(description, "TextColor3", if state.locked and narrowLock then "accent" else "textMuted")
end
handle.SearchText = string.lower(handle.Title .. " " .. (state.description or "") .. " " .. (handle.SearchExtra or ""))
end
function handle:SetTitle(text)
self.Title = text
if title then
title.Text = text
end
refresh()
end
function handle:SetDescription(text)
state.description = text
refresh()
end
function handle:SetDisabled(disabled)
state.disabled = disabled == true
refresh()
end
function handle:SetBlocked(blocked)
state.blocked = blocked == true
refresh()
end
local searchEdge, searchTint
local function markRow(matched)
if matched and not searchEdge then
searchTint = Create.new("Frame", {
Name = "SearchTint",
Size = UDim2.fromScale(1, 1),
BackgroundTransparency = 0.93,
ZIndex = 0,
Theme = { BackgroundColor3 = "accent" },
Parent = frame,
})
Create.corner(8, searchTint)
searchEdge = Create.new("Frame", {
Name = "SearchEdge",
Size = UDim2.new(0, 3, 0.56, 0),
AnchorPoint = Vector2.new(0, 0.5),
Position = UDim2.new(0, 2, 0.5, 0),
Theme = { BackgroundColor3 = "accent" },
Parent = frame,
})
Create.corner(-1, searchEdge)
end
if searchEdge then
searchEdge.Visible = matched
searchTint.Visible = matched
end
end
function handle:Highlight(query)
local searching = query ~= nil and query ~= ""
markRow(searching)
if not title then
return
end
local plain = self.Title
local from, to = nil, nil
if searching then
from, to = string.find(string.lower(plain), query, 1, true)
end
if not from then
title.RichText = false
title.Text = plain
return
end
local function escape(text)
return (string.gsub(string.gsub(string.gsub(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end
title.RichText = true
title.Text = escape(string.sub(plain, 1, from - 1))
.. `<mark color="#{Theme.color("accent"):ToHex()}" transparency="0.72"><b>`
.. escape(string.sub(plain, from, to))
.. "</b></mark>"
.. escape(string.sub(plain, to + 1))
end
function handle:Lock(reason, icon, quiet)
state.locked, state.reason, state.quiet = true, reason or Strings.get("Locked"), quiet == true
buildVeil()
Icons.apply(lockIcon, icon or "lock")
refresh()
end
function handle:Unlock()
state.locked = false
refresh()
end
function handle:IsLocked()
return state.locked or state.disabled or state.blocked == true
end
function handle:SetVisible(visible)
self.Hidden = not visible
frame.Visible = visible
row.window:applySearch()
end
function handle:Destroy()
container.scope:release(scope)
end
local errorLine
local function showError(message)
if message == nil or row.window.showErrors == false then
if errorLine then
errorLine.Visible = false
end
return
end
if not errorLine then
errorLine = Create.new("TextLabel", {
Name = "CallbackError",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 12,
TextXAlignment = Enum.TextXAlignment.Left,
LayoutOrder = 9,
Theme = { TextColor3 = "danger" },
Parent = content,
})
end
errorLine.Text = message
errorLine.Visible = true
end
function row.run(callback, after, ...)
if type(callback) ~= "function" then
if after then
after(true)
end
return
end
local finished, showedBusy = false, false
if row.busy then
task.delay(BUSY_AFTER, function()
if not finished and not scope.cleaned then
showedBusy = true
row.busy(true)
end
end)
end
task.spawn(function(...)
local trace
local ok, message = xpcall(callback, function(problem)
trace = debug.traceback(tostring(problem), 2)
return problem
end, ...)
finished = true
if scope.cleaned then
return
end
if showedBusy then
row.busy(false)
end
if ok then
showError(nil)
else
local text = tostring(message)
warn(`[Halcyon] {handle.Title} callback failed: {text}`)
showError((string.gsub(text, "^.-:%d+: ", "")))
row.window:recordError(handle.Title, text, trace)
end
if after then
after(ok)
end
end, ...)
end
function row.fire(...)
handle.Changed:Fire(...)
if not row.silent then
row.run(options.Callback, nil, ...)
end
end
function row.onNarrow(apply)
local narrow = false
local function measure()
local width = frame.AbsoluteSize.X / row.library.scale
local now = width > 0 and width < 300
if now ~= narrow then
narrow = now
apply(narrow)
end
end
scope:connect(frame:GetPropertyChangedSignal("AbsoluteSize"), measure)
measure()
end
function row.placeControl(control, width, height, always)
local under
local function place(stacked)
if stacked then
under = under or row.belowTitle()
under.Visible = true
control.Size = UDim2.new(1, 0, 0, height)
control.Parent = under
else
if under then
under.Visible = false
end
control.Size = UDim2.fromOffset(width, height)
control.Parent = slot
end
end
place(always == true)
if not always then
row.onNarrow(place)
end
end
function row.belowTitle()
return Create.new("Frame", {
Name = "Below",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 2,
Parent = content,
})
end
function row.marks(text, title)
local line = Create.new("Frame", { Name = "TitleLine", Size = UDim2.new(1, 0, 0, 18), Parent = text })
Create.list(line, "Horizontal", 6)
title.Parent = line
title.Size = UDim2.fromScale(0, 1)
title.AutomaticSize = Enum.AutomaticSize.X
title.TextWrapped = false
title.TextTruncate = Enum.TextTruncate.AtEnd
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Shrink, Parent = title })
if options.Badge then
Row.badge(line, options.Badge)
end
if options.Info then
Row.info(row, line, options.Info)
end
end
if title and (options.Badge or options.Info) then
row.marks(row.titleBlock, title)
end
function row.onHover(paint, target)
local library = row.library
local function leave()
if library.clearHover == leave then
library.clearHover = nil
end
paint(false)
end
target = target or frame
scope:connect(target.MouseEnter, function()
local previous = library.clearHover
if previous and previous ~= leave then
previous()
end
library.clearHover = leave
paint(true)
end)
scope:connect(target.MouseLeave, leave)
scope:add(function()
if library.clearHover == leave then
library.clearHover = nil
end
end)
end
refresh()
return row
end
return Row
end
modules["Elements/Segmented"] = function()
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local Segmented = {}
function Segmented.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local values = options.Values or {}
local value = if table.find(values, options.Default) then options.Default else values[1]
local segments = {}
local group = Create.new("Frame", { Name = "Segments", Theme = { BackgroundColor3 = row.controlRole } })
Create.corner(8, group)
Create.padding(group, 2)
local groupLayout = Create.list(group, "Horizontal", 2)
local function draw(timing)
for _, segment in segments do
local on = segment.value == value
Theme.bind(segment.button, "TextColor3", if on then "onAccent" else "textMuted", true)
Motion.tween(segment.button, timing, {
BackgroundTransparency = if on then 0 else 1,
TextColor3 = Theme.color(if on then "onAccent" else "textMuted"),
})
segment.button.FontFace = Create.font(if on then "bold" else "medium")
end
end
function handle:Get()
return value
end
function handle:Set(newValue)
if table.find(values, newValue) then
value = newValue
draw("fast")
row.fire(value)
end
end
for index, item in values do
local button = Create.new("TextButton", {
Name = "Segment",
Size = UDim2.fromOffset(0, row.reach),
LayoutOrder = index,
Text = tostring(item),
TextSize = 13,
Theme = { BackgroundColor3 = "accent", TextColor3 = "textMuted" },
Parent = group,
})
Create.corner(6, button)
Create.padding(button, 9, 0)
segments[index] = { button = button, value = item, flex = Create.new("UIFlexItem", { Parent = button }) }
scope:connect(button.Activated, function()
handle:Set(item)
end)
end
local below
local function place(stacked)
if stacked then
below = below or row.belowTitle()
below.Visible = true
elseif below then
below.Visible = false
end
group.Size = if stacked then UDim2.fromScale(1, 0) else UDim2.fromOffset(0, 0)
group.AutomaticSize = if stacked then Enum.AutomaticSize.Y else Enum.AutomaticSize.XY
groupLayout.Wraps = stacked
for _, segment in segments do
segment.button.AutomaticSize = Enum.AutomaticSize.X
segment.flex.FlexMode = if stacked then Enum.UIFlexMode.Grow else Enum.UIFlexMode.None
end
group.Parent = if stacked then below else row.slot
end
place(options.Stacked == true)
if not options.Stacked then
row.onNarrow(place)
end
draw(nil)
return handle
end
return Segmented
end
end
]]></ProtectedString>
