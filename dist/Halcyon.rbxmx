<roblox version="4">
<Item class="ModuleScript" referent="RBX0">
<Properties>
<string name="Name">Halcyon</string>
<ProtectedString name="Source"><![CDATA[-- Halcyon 2.3.0 | MIT License | https://github.com/ScriptsForDays/Halcyon
-- Generated by tools/bundle.mjs from src/. Edit the sources, not this file.
local modules, loaded, loading = {}, {}, {}
local function import(name)
if loaded[name] ~= nil then
return loaded[name]
end
assert(not loading[name], "Halcyon: circular require of " .. name)
loading[name] = true
local result = modules[name]()
loading[name] = nil
loaded[name] = result
return result
end
-- Each child holds some of the module definitions; it is called once with the shared table.
local children = script:GetChildren()
table.sort(children, function(a, b) return a.Name < b.Name end)
for _, child in children do
if child:IsA("ModuleScript") then
require(child)(modules, import)
end
end
return import("Halcyon")
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX1">
<Properties>
<string name="Name">Part01</string>
<ProtectedString name="Source"><![CDATA[return function(modules, import)
modules["Components/Build"] = function()
local Registry = import("Elements/Registry")
local Schema = import("Core/Schema")
local Build = {}
local STRUCTURE = { Sections = true, Elements = true, Pages = true, Kind = true, Id = true }
local function optionsOf(spec)
local options = {}
for key, value in spec do
if type(key) == "string" and not STRUCTURE[key] then
options[key] = value
end
end
return options
end
local function fail(path, message)
error(`Halcyon:Build {path}: {message}`, 0)
end
local function call(path, target, method, options)
local ok, result = pcall(target[method], target, options)
if not ok then
fail(path, tostring(result))
end
return result
end
function Build.run(Halcyon, spec)
if type(spec) ~= "table" then
error("Halcyon:Build expects a table", 3)
end
local window = Halcyon:CreateWindow(spec.Window or {})
if not window then
return nil, {}
end
local elements = {}
local function addElements(container, list, path)
if list == nil then
return
end
if type(list) ~= "table" then
fail(path, "Elements must be a list")
end
for index, item in list do
local where = `{path}.Elements[{index}]`
if type(item) ~= "table" then
fail(where, "each element is a table such as { \"Toggle\", Title = \"Fly\" }")
end
local kind = item[1] or item.Kind
if type(kind) ~= "string" or not Registry.KindSet[kind] then
local guess = if type(kind) == "string" then Schema.closest(kind, Registry.KindSet) else nil
fail(where, `unknown kind "{tostring(kind)}"{if guess then `, did you mean "{guess}"?` else ""}`)
end
local handle = call(where, container, kind, optionsOf(item))
local key = item.Id or item.Flag
if key ~= nil then
elements[key] = handle
end
end
end
local function addPages(parent, list, path)
for index, pageSpec in list or {} do
local where = `{path}.Pages[{index}]`
local page = call(where, parent, "Page", optionsOf(pageSpec))
Build.fill(page, pageSpec, where, addElements, addPages)
end
end
for index, tabSpec in spec.Tabs or {} do
local where = `Tabs[{index}]`
if type(tabSpec) ~= "table" then
fail(where, "each tab is a table with a Title")
end
local tab = call(where, window, "Tab", optionsOf(tabSpec))
Build.fill(tab, tabSpec, where, addElements, addPages)
end
if spec.SettingsTab then
window:SettingsTab(if type(spec.SettingsTab) == "table" then spec.SettingsTab else nil)
end
if spec.Autoload ~= false then
window:LoadAutoload()
end
return window, elements
end
function Build.fill(target, spec, path, addElements, addPages)
for index, sectionSpec in spec.Sections or {} do
local where = `{path}.Sections[{index}]`
local section = call(where, target, "Section", optionsOf(sectionSpec))
addElements(section, sectionSpec.Elements, where)
addPages(section, sectionSpec.Pages, where)
end
addElements(target, spec.Elements, path)
addPages(target, spec.Pages, path)
end
return Build
end
modules["Components/CommandPalette"] = function()
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Mount = import("Core/Mount")
local Strings = import("Core/Strings")
local SearchFocus = import("Components/SearchFocus")
local WIDTH, RESULTS = 460, 8
local CommandPalette = {}
local function catalogue(window)
local items = {}
local places = table.clone(window.tabs)
for _, page in window.subPages do
table.insert(places, page)
end
for _, tab in places do
if tab.Hidden or (tab.rootTab and tab.rootTab.Hidden) then
continue
end
local where = if tab.isPage then tab.parentTab.Title else "Tab"
table.insert(items, { kind = "tab", tab = tab, title = tab.Title, path = where, icon = tab.Icon or (tab.rootTab and tab.rootTab.Icon) or "layout-grid" })
for _, entry in tab.entries do
local handle = entry.handle
if not handle.Hidden and not (entry.section and entry.section.Hidden) and handle.Title and handle.Title ~= "" then
local section = entry.section and entry.section.Title
table.insert(items, {
kind = "row",
tab = tab,
handle = handle,
title = handle.Title,
path = if section then `{tab.Title}  \u{203A}  {section}` else tab.Title,
icon = tab.Icon or "circle",
words = handle.SearchText or string.lower(handle.Title),
})
end
end
end
return items
end
local function search(items, query)
query = string.lower(query)
local starts, contains = {}, {}
for _, item in items do
local title = string.lower(item.title)
if query == "" then
if item.kind == "tab" then
table.insert(starts, item)
end
elseif string.sub(title, 1, #query) == query then
table.insert(starts, item)
elseif string.find(item.words or title, query, 1, true) then
table.insert(contains, item)
end
end
for _, item in contains do
table.insert(starts, item)
end
return starts
end
local function reveal(window, item)
window:Show()
if window.minimized then
window:Minimize(false)
end
if window.query ~= "" then
window:Search("")
end
window:SelectTab(item.tab)
local handle = item.handle
if not handle then
return
end
SearchFocus.reveal(window, item.tab, handle)
end
function CommandPalette.open(window)
local library = window.library
if library.palette then
library.palette.close()
end
local overlay = Mount.overlay(library)
local scope = window.scope:child()
local palette = {}
library.palette = palette
local scrim = Create.new("TextButton", {
Name = "Palette",
Size = UDim2.fromScale(1, 1),
BackgroundColor3 = Color3.new(0, 0, 0),
BackgroundTransparency = 1,
Parent = overlay.dialogs,
})
scope:add(scrim)
Motion.tween(scrim, "fast", { BackgroundTransparency = 0.55 })
local card = Create.new("Frame", {
Name = "Card",
Size = UDim2.fromOffset(WIDTH, 0),
AutomaticSize = Enum.AutomaticSize.Y,
AnchorPoint = Vector2.new(0.5, 0),
Position = UDim2.new(0.5, 0, 0.16, 0),
Active = true,
Theme = { BackgroundColor3 = "surface" },
Parent = scrim,
})
Create.new("UIScale", { Scale = library.scale, Parent = card })
Create.new("UISizeConstraint", { MaxSize = Vector2.new(math.max(overlay.gui.AbsoluteSize.X / library.scale - 24, 240), math.huge), Parent = card })
Create.corner(12, card)
Create.stroke("stroke", card)
Create.list(card, "Vertical", 0)
local bar = Create.new("Frame", { Name = "Bar", Size = UDim2.new(1, 0, 0, 48), Parent = card })
Create.padding(bar, 16, 0)
Create.list(bar, "Horizontal", 10)
Create.icon("search", 16, "textMuted", bar)
local box = Create.new("TextBox", {
Name = "Query",
Size = UDim2.fromScale(0, 1),
PlaceholderText = Strings.get("Jump to a tab or setting"),
TextSize = 14,
LayoutOrder = 1,
Theme = { TextColor3 = "text" },
Parent = bar,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
local hint = Create.new("TextLabel", {
Size = UDim2.fromOffset(0, 20),
AutomaticSize = Enum.AutomaticSize.X,
Text = Strings.get("Esc"),
TextSize = 12,
Weight = "bold",
LayoutOrder = 2,
Theme = { BackgroundColor3 = "raised", TextColor3 = "textMuted" },
Parent = bar,
})
Create.corner(4, hint)
Create.padding(hint, 6, 0)
local list = Create.new("Frame", { Name = "Results", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
Create.padding(list, 6)
Create.list(list, "Vertical", 2)
local items = catalogue(window)
local shown, buttons, chosen = {}, {}, 1
local function paint()
for index, button in buttons do
local on = index == chosen
button.BackgroundTransparency = if on then 0 else 1
end
end
function palette.close()
if library.palette ~= palette then
return
end
library.palette = nil
window.scope:release(scope)
end
local function jump(item)
palette.close()
if item then
reveal(window, item)
end
end
local function draw()
for _, button in buttons do
button:Destroy()
end
table.clear(buttons)
shown = search(items, box.Text)
chosen = 1
for index = 1, math.min(#shown, RESULTS) do
local item = shown[index]
local button = Create.new("TextButton", {
Name = "Result",
Size = UDim2.new(1, 0, 0, if library.touch then 48 else 42),
LayoutOrder = index,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "raised" },
Parent = list,
})
Create.corner(8, button)
Create.padding(button, 10, 0)
Create.list(button, "Horizontal", 10)
Create.icon(if item.kind == "tab" then item.icon else "chevron-right", 16, if item.kind == "tab" then "accent" else "textMuted", button)
local text = Create.new("Frame", { Size = UDim2.fromScale(0, 1), LayoutOrder = 1, Parent = button }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.list(text, "Vertical", 0, { VerticalAlignment = Enum.VerticalAlignment.Center })
Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, 17),
Text = item.title,
TextSize = 14,
Weight = "medium",
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = "text" },
Parent = text,
})
Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, 14),
Text = item.path,
TextSize = 12,
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 1,
Theme = { TextColor3 = "textMuted" },
Parent = text,
})
scope:connect(button.MouseEnter, function()
chosen = index
paint()
end)
scope:connect(button.Activated, function()
jump(item)
end)
buttons[index] = button
end
if #buttons == 0 then
local empty = Create.new("TextLabel", {
Name = "Result",
Size = UDim2.new(1, 0, 0, 40),
Text = Strings.get('Nothing matches "{query}".', { query = box.Text }),
TextSize = 13,
TextXAlignment = Enum.TextXAlignment.Center,
Theme = { TextColor3 = "textMuted" },
Parent = list,
})
table.insert(buttons, empty)
end
paint()
end
scope:connect(box:GetPropertyChangedSignal("Text"), draw)
scope:connect(scrim.Activated, palette.close)
scope:connect(UserInputService.InputBegan, function(input)
local key = input.KeyCode
if key == Enum.KeyCode.Escape then
palette.close()
elseif key == Enum.KeyCode.Down then
chosen = math.min(chosen + 1, math.min(#shown, RESULTS))
paint()
elseif key == Enum.KeyCode.Up then
chosen = math.max(chosen - 1, 1)
paint()
end
end)
scope:connect(box.FocusLost, function(entered)
if entered then
jump(shown[chosen])
end
end)
draw()
task.defer(function()
if library.palette == palette then
box:CaptureFocus()
end
end)
palette.box, palette.items, palette.jump = box, items, jump
palette.results = function()
return shown
end
return palette
end
function CommandPalette.bind(window)
local key = window.options.PaletteKey or Enum.KeyCode.K
window.scope:connect(UserInputService.InputBegan, function(input, processed)
if processed or input.KeyCode ~= key or window.library.listeningForKey or window.paletteOff then
return
end
if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
CommandPalette.open(window)
end
end)
end
return CommandPalette
end
modules["Components/ConfigSection"] = function()
local Env = import("Core/Env")
local Strings = import("Core/Strings")
local ConfigSection = {}
local function report(window, done, failed, ok, message)
window:Notify({ Title = if ok then done else failed, Content = message, Kind = if ok then "success" else "warning" })
end
local function reportUndoable(window, done, failed, ok, message)
if not ok then
report(window, done, failed, ok, message)
return
end
window:Notify({
Title = done,
Content = message,
Kind = "success",
Duration = 6,
Actions = {
{
Title = Strings.get("Undo"),
Callback = function()
window:Undo()
end,
},
},
})
end
local function shareRows(window, section)
local shown
section:Button({
Title = Strings.get("Copy share code"),
Description = Strings.get("Every setting as one line of text"),
Icon = "copy",
Callback = function()
local code = window:ExportConfig()
if not code then
report(window, "", Strings.get("Code not made"), false, Strings.get("These settings could not be written as a code."))
elseif Env.copy(code) then
report(window, Strings.get("Share code copied"), "", true, Strings.get("Paste it into the box below on another device or account."))
elseif shown then
shown:Set(code)
else
shown = section:Code({ Title = Strings.get("Share code"), Code = code })
end
end,
})
section:Input({
Title = Strings.get("Paste share code"),
Placeholder = "Halcyon1:...",
Clearable = true,
Callback = function(text)
if text == "" then
return
end
reportUndoable(window, Strings.get("Settings imported"), Strings.get("Code not imported"), window:ImportConfig(text))
end,
})
end
function ConfigSection.build(window, target, options)
options = options or {}
local section = target
if type(target.Section) == "function" then
section = target:Section({ Title = options.Title or Strings.get("Configs"), Icon = options.Icon or "save", Side = options.Side })
end
if not Env.canSave then
section:Paragraph({ Title = Strings.get("Saving is off"), Content = Strings.get(Env.NO_FILES) .. " " .. Strings.get("Share codes still work."), Icon = "info" })
if options.ShareCodes ~= false then
shareRows(window, section)
end
return section
end
local name = section:Input({ Title = Strings.get("Config name"), Placeholder = Strings.get("default") })
local saved = section:Dropdown({ Title = Strings.get("Saved configs"), Values = window:ListConfigs(), AllowNone = true, Placeholder = Strings.get("None") })
local function chosen()
local typed = name:Get()
return if typed ~= "" then typed else saved:Get()
end
section.scope:add(window.ConfigChanged:Connect(function()
saved:Refresh(window:ListConfigs())
end))
local function save(configName)
report(window, Strings.get("Config saved"), Strings.get("Config not saved"), window:SaveConfig(configName))
end
section:Button({
Title = Strings.get("Save"),
Icon = "save",
Callback = function()
local configName = chosen() or "default"
if not window:ConfigExists(configName) then
save(configName)
return
end
window:Dialog({
Title = Strings.get('Overwrite "{name}"?', { name = Env.safeName(configName) }),
Content = Strings.get("Its saved settings are replaced with the current ones."),
Buttons = {
{ Title = Strings.get("Keep") },
{
Title = Strings.get("Overwrite"),
Variant = "Primary",
Callback = function()
save(configName)
end,
},
},
})
end,
})
section:Button({
Title = Strings.get("Load"),
Icon = "download",
Callback = function()
reportUndoable(window, Strings.get("Config loaded"), Strings.get("Config not loaded"), window:LoadConfig(chosen()))
end,
})
section:Button({
Title = Strings.get("Load on start"),
Description = Strings.get("Loads it when the hub starts"),
Icon = "pin",
Callback = function()
report(window, Strings.get("Loads on start"), Strings.get("Autoload not set"), window:SetAutoload(chosen()))
end,
})
section:Button({
Title = Strings.get("Delete"),
Icon = "trash-2",
Callback = function()
local configName = chosen()
if not configName then
report(window, Strings.get("Config deleted"), Strings.get("Nothing deleted"), false, Strings.get("Pick a config to delete."))
return
end
window:Dialog({
Title = Strings.get('Delete "{name}"?', { name = Env.safeName(configName) or configName }),
Content = Strings.get("This can't be undone."),
Buttons = {
{ Title = Strings.get("Keep") },
{
Title = Strings.get("Delete"),
Variant = "Danger",
Callback = function()
report(window, Strings.get("Config deleted"), Strings.get("Config not deleted"), window:DeleteConfig(configName))
end,
},
},
})
end,
})
if options.ShareCodes ~= false then
shareRows(window, section)
end
return section
end
return ConfigSection
end
modules["Components/Dialog"] = function()
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Effects = import("Core/Effects")
local Env = import("Core/Env")
local Motion = import("Core/Motion")
local Mount = import("Core/Mount")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local VARIANTS = {
Primary = { fill = "accent", hover = "accentHover", text = "onAccent" },
Danger = { fill = "danger", hover = "danger", text = "onAccent" },
Default = { fill = "raised", hover = "hover", text = "text" },
Ghost = { fill = "surface", hover = "raised", text = "textMuted" },
}
local Dialog = {}
function Dialog.button(scope, parent, options)
local roles = VARIANTS[options.Variant] or VARIANTS.Default
local button = Create.new("TextButton", {
Name = options.Name or "Button",
Size = options.Size or UDim2.fromOffset(0, 38),
AutomaticSize = if options.Size then Enum.AutomaticSize.None else Enum.AutomaticSize.X,
LayoutOrder = options.LayoutOrder or 0,
Text = options.Title or "",
Weight = "medium",
Theme = { BackgroundColor3 = roles.fill, TextColor3 = roles.text },
Parent = parent,
})
Create.corner(8, button)
Create.padding(button, 16, 0)
local function paint(role)
Theme.bind(button, "BackgroundColor3", role, true)
Motion.tween(button, "fast", { BackgroundColor3 = Theme.color(role) })
end
scope:connect(button.MouseEnter, function()
paint(roles.hover)
end)
scope:connect(button.MouseLeave, function()
paint(roles.fill)
end)
Effects.apply(scope, button, options.Effect or "Sweep", 8)
return button
end
function Dialog.shell(library, options)
local overlay = Mount.overlay(library)
local scope = library.scope:child()
local shell = { scope = scope, Closed = false }
local scrim = Create.new("TextButton", {
Name = "Dialog",
Size = UDim2.fromScale(1, 1),
BackgroundColor3 = Color3.new(0, 0, 0),
BackgroundTransparency = 1,
Parent = overlay.dialogs,
})
scope:add(scrim)
Motion.tween(scrim, "base", { BackgroundTransparency = 0.45 })
local card = Create.new("Frame", {
Name = "Card",
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.5),
Size = UDim2.new(1, -32, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Active = true,
Theme = { BackgroundColor3 = "surface" },
Parent = scrim,
})
Create.new("UISizeConstraint", { MaxSize = Vector2.new(options.Width or 380, math.huge), Parent = card })
Create.corner(12, card)
Create.stroke("stroke", card)
Create.padding(card, 18)
Create.list(card, "Vertical", 10)
shell.card = card
card.Position = UDim2.new(0.5, 0, 0.5, 14)
Motion.tween(card, "base", { Position = UDim2.fromScale(0.5, 0.5) })
function shell.Close()
if shell.Closed then
return
end
shell.Closed = true
library.scope:release(scope)
if options.OnClose then
options.OnClose()
end
end
if options.Dismissible then
scope:connect(scrim.Activated, shell.Close)
scope:connect(UserInputService.InputBegan, function(input)
if input.KeyCode == Enum.KeyCode.Escape then
shell.Close()
end
end)
end
return shell
end
function Dialog.heading(parent, title, icon)
local head = Create.new("Frame", {
Name = "Heading",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Parent = parent,
})
Create.list(head, "Horizontal", 10)
if icon then
Create.icon(icon, 20, "accent", head)
end
Create.new("TextLabel", {
Name = "Title",
AutomaticSize = Enum.AutomaticSize.Y,
TextSize = 16,
Weight = "bold",
TextWrapped = true,
LayoutOrder = 1,
Text = title or "",
Theme = { TextColor3 = "text" },
Parent = head,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
return head
end
function Dialog.text(parent, content, order)
return Create.new("TextLabel", {
Name = "Content",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 13,
LayoutOrder = order or 1,
Text = content or "",
Theme = { TextColor3 = "textMuted" },
Parent = parent,
})
end
function Dialog.open(library, options)
local shell = Dialog.shell(library, options)
Dialog.heading(shell.card, options.Title, options.Icon)
if options.Content then
Dialog.text(shell.card, options.Content, 1)
end
local actions = Create.new("Frame", { Name = "Actions", Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 2, Parent = shell.card })
Create.list(actions, "Horizontal", 8, { HorizontalAlignment = Enum.HorizontalAlignment.Right })
for index, settings in options.Buttons or { { Title = Strings.get("Close") } } do
local button = Dialog.button(shell.scope, actions, { Title = settings.Title, Variant = settings.Variant, LayoutOrder = index })
local waiting = tonumber(settings.Delay) or 0
if waiting > 0 then
button.AutoButtonColor = false
button.TextTransparency = 0.5
shell.scope:add(task.spawn(function()
for left = math.ceil(waiting), 1, -1 do
button.Text = `{settings.Title} ({left})`
task.wait(1)
end
waiting = 0
button.Text = settings.Title
button.TextTransparency = 0
end))
end
shell.scope:connect(button.Activated, function()
if waiting > 0 then
return
end
shell.Close()
Env.call(settings.Title or "Dialog", settings.Callback)
end)
end
return shell
end
return Dialog
end
modules["Components/DiscordButton"] = function()
local HttpService = game:GetService("HttpService")
local Create = import("Core/Create")
local Env = import("Core/Env")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Theme = import("Core/Theme")
local BLURPLE = Color3.fromRGB(88, 101, 242)
local BLURPLE_HOVER = Color3.fromRGB(116, 127, 247)
local LOGO = "rbxthumb://type=Asset&id=132364423955781&w=150&h=150"
local FIRST_PORT, LAST_PORT = 6463, 6472
local DiscordButton = {}
function DiscordButton.settings(value)
if type(value) == "string" and value ~= "" then
return { Link = value }
elseif type(value) == "table" and type(value.Link) == "string" then
return value
end
return nil
end
function DiscordButton.code(link)
if type(link) ~= "string" then
return nil
end
return string.match(link, "discord%.gg/([%w%-]+)")
or string.match(link, "discord%.com/invite/([%w%-]+)")
or string.match(link, "discordapp%.com/invite/([%w%-]+)")
or string.match(link, "^([%w%-]+)$")
end
function DiscordButton.open(link)
local code = DiscordButton.code(link)
if code and Env.request then
local body = HttpService:JSONEncode({
cmd = "INVITE_BROWSER",
args = { code = code },
nonce = HttpService:GenerateGUID(false),
})
for port = FIRST_PORT, LAST_PORT do
local ok, reply = Env.http({
Url = `http://127.0.0.1:{port}/rpc?v=1`,
Method = "POST",
Headers = { ["Content-Type"] = "application/json", Origin = "https://discord.com" },
Body = body,
})
if ok and not string.find(tostring(reply), '"evt":"ERROR"', 1, true) then
return "opened"
end
end
end
return if Env.copy(link) then "copied" else false
end
function DiscordButton.new(scope, parent, settings, report)
local size = settings.Size or 32
local order = settings.LayoutOrder or 10
local button = Create.new("ImageButton", {
Name = "Discord",
Size = UDim2.fromOffset(size, size),
BackgroundColor3 = BLURPLE,
LayoutOrder = order,
Parent = parent,
})
Create.corner(-1, button)
local glyph = Create.new("ImageLabel", {
Name = "Mark",
Size = UDim2.fromOffset(math.floor(size * 0.62), math.floor(size * 0.62)),
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.5),
ImageColor3 = Color3.new(1, 1, 1),
Parent = button,
})
Icons.apply(glyph, settings.Icon or LOGO)
local label
if settings.Label then
label = Create.new("TextButton", {
Name = "Label",
Size = UDim2.fromOffset(0, size),
AutomaticSize = Enum.AutomaticSize.X,
Text = settings.Label,
TextSize = 13,
Weight = "medium",
LayoutOrder = order + 1,
Theme = { TextColor3 = "textMuted" },
Parent = parent,
})
end
local scale = Create.new("UIScale", { Parent = button })
local markScale = Create.new("UIScale", { Parent = glyph })
local hovered = false
local function settle()
Motion.tween(button, "fast", { BackgroundColor3 = if hovered then BLURPLE_HOVER else BLURPLE })
Motion.tween(markScale, "spring", { Scale = if hovered then 1.12 else 1 })
Motion.tween(glyph, "spring", { Rotation = if hovered then -8 else 0 })
Motion.tween(scale, "spring", { Scale = if hovered then 1.06 else 1 })
if label then
Theme.bind(label, "TextColor3", if hovered then "text" else "textMuted")
end
end
local busy = false
local function press()
if busy then
return
end
busy = true
task.spawn(function()
local how = DiscordButton.open(settings.Link)
busy = false
report(how, settings.Link)
end)
end
for _, target in { button, label } do
scope:connect(target.MouseEnter, function()
hovered = true
settle()
end)
scope:connect(target.MouseLeave, function()
hovered = false
settle()
end)
scope:connect(target.MouseButton1Down, function()
Motion.tween(scale, "fast", { Scale = 0.92 })
end)
scope:connect(target.MouseButton1Up, settle)
scope:connect(target.Activated, press)
end
return button
end
return DiscordButton
end
modules["Components/Favourites"] = function()
local Create = import("Core/Create")
local Strings = import("Core/Strings")
local Menu = import("Components/Menu")
local Favourites = {}
local MIRRORED = {
Toggle = true,
Slider = true,
Dropdown = true,
Input = true,
ColorPicker = true,
Segmented = true,
Radio = true,
Checklist = true,
Chips = true,
Stepper = true,
Button = true,
Knob = true,
Rating = true,
Tiles = true,
DatePicker = true,
Tags = true,
ItemGrid = true,
}
local DROPPED = {
Flag = true,
Keybind = true,
Color = true,
Spotlight = true,
Menu = true,
Callback = true,
Default = true,
Value = true,
Visible = true,
ShowWhen = true,
EnableWhen = true,
Exclusive = true,
Favourite = true,
}
local refresh
function Favourites.setup(window, saved)
window.favourites = { order = {}, starred = {}, copies = {}, originals = {}, fresh = type(saved) ~= "table" }
if type(saved) == "table" then
for _, id in saved do
if type(id) == "string" and not window.favourites.starred[id] then
window.favourites.starred[id] = true
table.insert(window.favourites.order, id)
end
end
end
window.makingFavourites = true
local tab = window:Tab({ Title = Strings.get("Favourites"), Icon = "star" })
window.makingFavourites = nil
window.favourites.tab = tab
tab.isFavourites = true
refresh(window)
end
function Favourites.idOf(handle)
if handle.Flag then
return "flag:" .. handle.Flag
end
local tab = handle.Tab
return `row:{if tab then tab.Title else ""}/{handle.Title}`
end
function refresh(window)
local state = window.favourites
local tab = state.tab
local any = next(state.copies) ~= nil
if any and state.empty then
state.empty.Destroy()
state.empty = nil
elseif not any and not state.empty then
state.empty = tab:EmptyState({
Icon = "star",
Title = Strings.get("No favourites yet"),
Text = Strings.get("Right-click a row, or press and hold it, then choose Add to favourites."),
})
end
for position, id in state.order do
local copy = state.copies[id]
if copy and copy.Frame then
copy.Frame.LayoutOrder = position
end
end
end
local function save(window)
window:savePreferences()
end
function Favourites.isStarred(window, handle)
return window.favourites ~= nil and handle.favouriteId ~= nil and window.favourites.starred[handle.favouriteId] == true
end
local function makeCopy(window, original)
local state = window.favourites
local id = original.favouriteId
if state.copies[id] or original.scope.cleaned then
return
end
local options = {}
for key, value in original.Options do
if not DROPPED[key] then
options[key] = value
end
end
local where = original.Tab
options.Description = if where then where.Title else original.Options.Description
if original.Get then
options.Default = original:Get()
if original.Kind == "Progress" then
options.Value = options.Default
end
end
local syncing = false
options.Callback = function(...)
if syncing then
return
end
syncing = true
if original.Kind == "Button" then
original:Press()
elseif original.Set then
original:Set(...)
end
syncing = false
end
local holder = state.tab
local copy = holder[original.Kind](holder, options)
copy.isCopy = true
Menu.attach(copy.scope, window.library, copy.Frame, function()
return { Favourites.menuItem(window, original) }
end)
state.copies[id] = copy
if original.Get and copy.SetSilent then
copy.scope:add(original.Changed:Connect(function()
if not syncing then
syncing = true
copy:SetSilent(original:Get())
syncing = false
end
end))
end
copy.scope:add(function()
if state.copies[id] == copy then
state.copies[id] = nil
end
end)
original.scope:add(function()
copy:Destroy()
end)
refresh(window)
end
function Favourites.star(window, original, starred)
local state = window.favourites
local id = original.favouriteId
if not state or not id then
return
end
if starred and not state.starred[id] then
state.starred[id] = true
table.insert(state.order, id)
makeCopy(window, original)
elseif not starred and state.starred[id] then
state.starred[id] = nil
table.remove(state.order, table.find(state.order, id))
local copy = state.copies[id]
if copy then
copy:Destroy()
end
refresh(window)
end
if original.favouriteMark then
original.favouriteMark.Visible = state.starred[id] == true
end
save(window)
end
function Favourites.menuItem(window, original)
local starred = Favourites.isStarred(window, original)
return {
Title = if starred then Strings.get("Remove from favourites") else Strings.get("Add to favourites"),
Icon = "star",
Callback = function()
Favourites.star(window, original, not starred)
end,
}
end
function Favourites.register(window, handle, container)
local state = window.favourites
if not state or not MIRRORED[handle.Kind] or not handle.Frame or not handle.row then
return false
end
local tab = container.tab or (container.section and container.section.tab)
if tab and tab.isFavourites then
return false
end
handle.favouriteId = Favourites.idOf(handle)
state.originals[handle.favouriteId] = handle
if state.fresh and handle.Options.Favourite == true and not state.starred[handle.favouriteId] then
state.starred[handle.favouriteId] = true
table.insert(state.order, handle.favouriteId)
end
local mark = Create.icon("star", 12, "warning", handle.row.slot)
mark.Name = "Favourite"
mark.LayoutOrder = -10
mark.Visible = state.starred[handle.favouriteId] == true
handle.favouriteMark = mark
if state.starred[handle.favouriteId] then
task.defer(makeCopy, window, handle)
end
return true
end
function Favourites.saved(window)
return if window.favourites then table.clone(window.favourites.order) else nil
end
return Favourites
end
modules["Components/Header"] = function()
local Assets = import("Core/Assets")
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Hairline = import("Core/Hairline")
local Icons = import("Core/Icons")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
Styles.register("Header", "Bar", { height = 48 })
Styles.register("Header", "Tall", { height = 64, image = 44, icon = 26, title = 16, subtitle = 13 })
Styles.register("Header", "Wordmark", { height = 56, wordmark = true })
Styles.register("Header", "Sidebar", { height = 48, sidebar = true })
local STRIP = 40
local Header = { STRIP = STRIP }
function Header.logo(window)
local value = window.options.Logo
if value == false then
return nil
end
if type(value) == "string" or type(value) == "number" then
return { image = value }
end
local logo = if type(value) == "table" then value else {}
local icon = logo.Icon
if icon == nil then
icon = window.Icon
end
return {
image = logo.Image,
text = logo.Text or window.Title,
icon = icon,
height = tonumber(logo.Height),
width = tonumber(logo.Width),
}
end
function Header.drawLogo(window, logo, parent, large)
if logo.image then
local image = Create.new("ImageLabel", {
Name = "Logo",
Size = if large then UDim2.new(1, 0, 0, logo.height or 56) else UDim2.fromOffset(logo.width or 150, logo.height or 30),
ScaleType = Enum.ScaleType.Fit,
Parent = parent,
})
if Assets.kind(logo.image) == nil then
Theme.bind(image, "ImageColor3", "accent")
end
Icons.apply(image, logo.image)
return nil
end
local row = Create.new("Frame", {
Name = "Logo",
Size = if large then UDim2.new(1, 0, 0, 32) else UDim2.fromOffset(0, 28),
AutomaticSize = if large then Enum.AutomaticSize.None else Enum.AutomaticSize.X,
Parent = parent,
})
Create.list(row, "Horizontal", if large then 10 else 8)
if logo.icon then
Create.icon(logo.icon, if large then 28 else 22, "accent", row)
end
local label = Create.new("TextLabel", {
Name = "Title",
Size = UDim2.fromScale(0, 1),
AutomaticSize = if large then Enum.AutomaticSize.None else Enum.AutomaticSize.X,
Text = logo.text or window.Title,
TextSize = if large then 22 else 19,
TextTruncate = Enum.TextTruncate.AtEnd,
Weight = "bold",
LayoutOrder = 1,
Theme = { TextColor3 = "text" },
Parent = row,
})
if large then
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = label })
end
return label
end
function Header.wordmark(window, brand)
local logo = Header.logo(window) or { text = window.Title, icon = window.Icon }
local label = Header.drawLogo(window, logo, brand, false)
window.titleLabel = label or Create.new("TextLabel", { Name = "Title", Text = window.Title, Visible = false, Parent = brand })
window.subtitleLabel = Create.new("TextLabel", { Name = "Subtitle", Text = window.Subtitle or "", Visible = false, Parent = brand })
return logo
end
function Header.searchBox(window, scope, parent, size)
local search = Create.new("Frame", { Name = "Search", Size = size, Theme = { BackgroundColor3 = "raised" }, Parent = parent })
Create.corner(8, search)
local glass = Create.icon("search", 14, "textMuted", search)
glass.AnchorPoint = Vector2.new(0, 0.5)
glass.Position = UDim2.new(0, 10, 0.5, 0)
local box = Create.new("TextBox", {
Name = "Query",
Position = UDim2.fromOffset(32, 0),
Size = UDim2.new(1, -38, 1, 0),
PlaceholderText = Strings.get("Search"),
TextSize = 13,
ClipsDescendants = true,
Text = window.searchText or "",
Theme = { TextColor3 = "text" },
Parent = search,
})
local counter = Create.new("TextLabel", {
Name = "Matches",
Size = UDim2.fromOffset(0, 20),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(1, 0.5),
Position = UDim2.new(1, -8, 0.5, 0),
TextSize = 11,
Weight = "medium",
Visible = false,
Theme = { TextColor3 = "textMuted" },
Parent = search,
})
window.searchCounter = counter
local function fit()
box.Size = if counter.Visible then UDim2.new(1, -38 - counter.AbsoluteSize.X - 8, 1, 0) else UDim2.new(1, -38, 1, 0)
end
scope:connect(counter:GetPropertyChangedSignal("AbsoluteSize"), fit)
scope:connect(counter:GetPropertyChangedSignal("Visible"), fit)
scope:connect(box:GetPropertyChangedSignal("Text"), function()
window.searchText = box.Text
window.matchIndex = nil
window:applySearch(box.Text)
end)
scope:connect(box.FocusLost, function(enter)
if enter and box.Text ~= "" then
window:JumpToMatch(1)
task.defer(function()
if box.Parent then
box:CaptureFocus()
end
end)
end
end)
scope:connect(UserInputService.InputBegan, function(input)
if box:IsFocused() and box.Text ~= "" then
if input.KeyCode == Enum.KeyCode.Down then
window:JumpToMatch(1)
elseif input.KeyCode == Enum.KeyCode.Up then
window:JumpToMatch(-1)
end
end
end)
return search, box
end
function Header.sidebarTop(window, scope, column)
local logo = Header.logo(window)
if logo then
local box = Create.new("Frame", { Name = "SidebarBrand", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = -3, Parent = column })
Create.padding(box, 16, 18, 14, 14)
Create.list(box, "Vertical", 4)
local label = Header.drawLogo(window, logo, box, true)
if label then
window.titleLabel = label
end
if window.Subtitle and not logo.image then
window.subtitleLabel = Create.new("TextLabel", {
Name = "Subtitle",
Size = UDim2.new(1, 0, 0, 16),
Text = window.Subtitle,
TextSize = 12,
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 1,
Theme = { TextColor3 = "textMuted" },
Parent = box,
})
end
Drag.move(scope, box, window.root, window:dragOptions())
Hairline.new("X", "stroke", { LayoutOrder = -2, Parent = column })
end
if window.options.Search ~= false then
local area = Create.new("Frame", { Name = "SearchArea", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = -1, Parent = column })
Create.padding(area, 10, 10, 10, 2)
window.searchFrame, window.searchBox = Header.searchBox(window, scope, area, UDim2.new(1, 0, 0, 34))
end
end
function Header.apply(window, sidebar)
window.sidebarHeader = sidebar
local topbar, height = window.topbar, window.topbarHeight
if sidebar then
local lane = window:lane("Sidebar")
topbar.Position = UDim2.fromOffset(lane, 0)
topbar.Size = UDim2.new(1, -lane, 0, STRIP)
window.body.Position = UDim2.fromOffset(0, 0)
window.body.Size = UDim2.fromScale(1, 1)
else
topbar.Position = UDim2.fromOffset(0, 0)
topbar.Size = UDim2.new(1, 0, 0, height)
window.body.Position = UDim2.fromOffset(0, height)
window.body.Size = UDim2.new(1, 0, 1, -height)
window.searchFrame, window.searchBox = window.topbarSearch, window.topbarBox
window.titleLabel, window.subtitleLabel = window.topbarTitle, window.topbarSubtitle
if window.topbarBox.Text ~= (window.searchText or "") then
window.topbarBox.Text = window.searchText or ""
end
end
window.brand.Visible = not sidebar
window.topbarSearch.Visible = not sidebar and window.options.Search ~= false
window.chipHolder.Visible = not sidebar
if window.dots then
window.dots.Parent = if sidebar then window.topbarActions else window.brand
end
end
return Header
end
modules["Components/Hud"] = function()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Env = import("Core/Env")
local Profile = import("Components/Profile")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
Styles.register("Watermark", "Card", { fill = true, corner = 8, separator = "  |  " })
Styles.register("Watermark", "Pill", { fill = true, corner = -1, separator = "  \u{2022}  " })
Styles.register("Watermark", "Accent", { fill = true, corner = 6, separator = "  |  ", edge = true })
Styles.register("Watermark", "Minimal", { separator = "  /  ", outline = true })
Styles.register("KeybindList", "Card", { fill = true })
Styles.register("KeybindList", "Glass", { fill = true, transparency = 0.25 })
Styles.register("KeybindList", "Minimal", { outline = true })
local Hud = {}
local function handleFor(window, scope, frame)
local handle = { Frame = frame }
function handle:SetVisible(visible)
frame.Visible = visible
end
function handle:Destroy()
window.scope:release(scope)
end
return handle
end
function Hud.watermark(window, options)
options = options or {}
local scope = window.scope:child()
local fields = options.Fields or { "Title", "Executor", "Time" }
local frames, rate = 0, 0
local look = Styles.pick("Watermark", options.Style, window)
local pill = Create.new("Frame", {
Name = "Watermark",
AutomaticSize = Enum.AutomaticSize.XY,
Position = options.Position or UDim2.fromOffset(12, 12),
Active = true,
BackgroundTransparency = if look.fill then 0 else 1,
Theme = { BackgroundColor3 = "surface" },
Parent = window.gui,
})
scope:add(pill)
if look.fill then
Create.corner(look.corner or 8, pill)
Create.stroke("stroke", pill)
end
if look.edge then
local stroke = pill:FindFirstChildOfClass("UIStroke")
Theme.bind(stroke, "Color", "accent")
stroke.Transparency = 0.35
end
Create.padding(pill, if look.corner == -1 then 14 else 10, 7, 10, 7)
Create.list(pill, "Horizontal", 8)
if window.Icon then
Create.icon(window.Icon, 14, "accent", pill)
end
local label = Create.new("TextLabel", {
AutomaticSize = Enum.AutomaticSize.XY,
TextSize = 12,
Weight = "medium",
LayoutOrder = 1,
Theme = { TextColor3 = "text" },
Parent = pill,
})
if look.outline then
Create.new("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Transparency = 0.4, Color = Color3.new(0, 0, 0), Parent = label })
end
local function text(field)
if type(field) == "function" then
local ok, value = pcall(field)
return if ok then tostring(value) else ""
elseif field == "Title" then
return window.Title
elseif field == "User" then
return (Profile.names(window.profile))
elseif field == "Executor" then
return (Env.executor())
elseif field == "Time" then
return os.date("%H:%M:%S")
elseif field == "Date" then
return os.date("%d %b %Y")
elseif field == "FPS" then
return rate .. " fps"
elseif field == "Ping" then
return math.round(Players.LocalPlayer:GetNetworkPing() * 1000) .. " ms"
end
return tostring(field)
end
local function draw()
local parts = {}
for index, field in fields do
parts[index] = text(field)
end
label.Text = table.concat(parts, look.separator or "  |  ")
end
if table.find(fields, "FPS") then
scope:connect(RunService.Heartbeat, function()
frames += 1
end)
end
window:everySecond(scope, function()
rate, frames = frames, 0
draw()
end)
Drag.move(scope, pill, pill, {})
draw()
return handleFor(window, scope, pill)
end
function Hud.keybindList(window, options)
options = options or {}
local scope = window.scope:child()
local look = Styles.pick("KeybindList", options.Style, window)
local panel = Create.new("Frame", {
Name = "Keybinds",
Size = UDim2.fromOffset(200, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Position = options.Position or UDim2.new(0, 12, 0.4, 0),
Active = true,
BackgroundTransparency = if look.fill then look.transparency or 0 else 1,
Theme = { BackgroundColor3 = "surface" },
Parent = window.gui,
})
scope:add(panel)
if look.fill then
Create.corner(10, panel)
Create.stroke("stroke", panel)
end
Create.padding(panel, 12, 10)
Create.list(panel, "Vertical", 6)
Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, 16),
Text = options.Title or Strings.get("Keybinds"),
TextSize = 12,
Weight = "bold",
Theme = { TextColor3 = "textMuted" },
Parent = panel,
})
local rows = Create.new("Frame", {
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 1,
Parent = panel,
})
local function draw()
rows:ClearAllChildren()
Create.list(rows, "Vertical", 4)
local count = 0
for _, listing in window.keybinds do
local key = listing.control:Get()
if key then
count += 1
local active = listing.control.Active
local row = Create.new("Frame", { Size = UDim2.new(1, 0, 0, 18), LayoutOrder = count, Parent = rows })
Create.new("TextLabel", {
Size = UDim2.new(1, -70, 1, 0),
Text = listing.handle.Title,
TextSize = 12,
Weight = if active then "bold" else "regular",
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = if active then "text" else "textMuted" },
Parent = row,
})
Create.new("TextLabel", {
Size = UDim2.new(0, 66, 1, 0),
AnchorPoint = Vector2.new(1, 0),
Position = UDim2.fromScale(1, 0),
Text = if listing.control.Label then listing.control.Label() else key.Name,
TextSize = 12,
TextXAlignment = Enum.TextXAlignment.Right,
Theme = { TextColor3 = if active then "accent" else "textMuted" },
Parent = row,
})
end
end
panel.Visible = count > 0
end
scope:add(window.KeybindsChanged:Connect(draw))
scope:add(Theme.Changed:Connect(draw))
Drag.move(scope, panel, panel, {})
draw()
return handleFor(window, scope, panel)
end
return Hud
end
modules["Components/KeySystem"] = function()
local Create = import("Core/Create")
local Dialog = import("Components/Dialog")
local DiscordButton = import("Components/DiscordButton")
local Env = import("Core/Env")
local Hairline = import("Core/Hairline")
local Motion = import("Core/Motion")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local VERSION = 1
local INVALID_KEY_MESSAGE = "That key is not valid."
local KeySystem = {}
local function trim(text)
return string.match(tostring(text or ""), "^%s*(.-)%s*$")
end
function KeySystem.tiers(options)
if type(options.Tiers) == "table" and #options.Tiers > 0 then
local tiers = {}
for index, tier in options.Tiers do
if tier.Name == nil and tier.NoKey then
tier = table.clone(tier)
tier.Name = "Keyless"
end
tiers[index] = tier
end
return tiers
end
return { { Name = "Access", Keys = options.Keys, Remote = options.Remote, Link = options.Link } }
end
local function tierIndex(tiers, name)
for index, tier in tiers do
if tier.Name == name then
return index
end
end
return nil
end
local function remoteCheck(remote, key)
local url = if type(remote.Url) == "function" then remote.Url(key) else remote.Url
local method = remote.Method or "POST"
local body
if method ~= "GET" then
if type(remote.Body) == "function" then
body = remote.Body(key)
else
local _, text = Env.encode({ key = key })
body = text
end
end
local ok, response, status = Env.http({
Url = url,
Method = method,
Headers = remote.Headers or { ["Content-Type"] = "application/json" },
Body = body,
})
if type(remote.Accept) == "function" then
local valid, detail = remote.Accept(response, status)
return valid == true, detail
end
if not ok then
return false, if status == 0 then Strings.get("The key server could not be reached.") else nil
end
local decoded, reply = Env.decode(response)
if not decoded or type(reply) ~= "table" then
return false, nil
end
return reply.valid == true, if type(reply.message) == "string" then reply.message else nil
end
local function adService(tier)
return if tier and type(tier.AdService) == "table" then tier.AdService else nil
end
function KeySystem.check(options, selected, key)
local tiers = KeySystem.tiers(options)
local tier = tiers[selected]
local ad = adService(tier)
local keyed = not (ad and ad.RequiresKey == false)
key = trim(key)
if key == "" and keyed then
return nil, Strings.get("Enter your key first.")
end
if key ~= "" then
for index = #tiers, 1, -1 do
local keys = tiers[index].Keys
if type(keys) == "table" and table.find(keys, key) then
return index, nil, nil
end
end
end
local message
local function passed(valid, detail)
if not valid and type(detail) == "string" then
message = detail
end
return valid == true, detail
end
local ok, unlocked, detail = pcall(function()
if ad and type(ad.Confirm) == "function" then
local valid, extra = passed(ad.Confirm(if keyed then key else nil))
if valid then
return selected, extra
end
end
if ad and type(ad.Remote) == "table" then
local valid, extra = passed(remoteCheck(ad.Remote, key))
if valid then
return selected, extra
end
end
if key == "" then
return nil, nil
end
if tier and type(tier.Validate) == "function" then
local valid, extra = passed(tier.Validate(key))
if valid then
return selected, extra
end
end
if tier and type(tier.Remote) == "table" then
local valid, extra = passed(remoteCheck(tier.Remote, key))
if valid then
return selected, extra
end
end
if type(options.Validate) == "function" then
local answer, extra = options.Validate(key)
local index = if type(answer) == "string" then tierIndex(tiers, answer) elseif answer then selected else nil
if index then
return index, extra
end
passed(false, extra)
end
return nil, nil
end)
if not ok then
warn(`[Halcyon] Key validator failed: {unlocked}`)
return nil, Strings.get("The key could not be checked. Try again.")
elseif unlocked then
return unlocked, nil, detail
end
if not message and ad and not keyed then
message = Strings.get("The {service} step is not confirmed yet. Finish it, then try again.", { service = ad.Name or Strings.get("ad") })
end
return nil, message or Strings.get(INVALID_KEY_MESSAGE)
end
local function savedPath(folder)
return `Halcyon/{folder}/key.json`
end
local function loadSaved(options, folder)
if options.SaveKey == false then
return nil
end
local content = Env.read(savedPath(folder))
local decoded, saved = false, nil
if content then
decoded, saved = Env.decode(content)
end
if not decoded or type(saved) ~= "table" or saved.version ~= VERSION or type(saved.key) ~= "string" or type(saved.savedAt) ~= "number" then
return nil
end
local tiers = KeySystem.tiers(options)
local index = tierIndex(tiers, saved.tier)
local duration = index and tiers[index].Duration
if not index or (duration and os.time() - saved.savedAt >= duration) then
Env.remove(savedPath(folder))
return nil
end
local unlocked = KeySystem.check(options, index, saved.key)
if not unlocked then
Env.remove(savedPath(folder))
return nil
end
return unlocked, saved.key, if duration then saved.savedAt + duration else nil
end
function KeySystem.prompt(library, options, context)
local tiers = KeySystem.tiers(options)
local names = {}
for index, tier in tiers do
names[index] = tier.Name
end
local paidRank
for index, tier in tiers do
if paidRank == nil and (tier.Paid == true or (tier.Paid == nil and tier.Name == "Paid")) then
paidRank = index
end
end
local showExpiry = options.ShowExpiry ~= false
local function access(index, key, saved, detail, expiresAt)
return {
Tier = names[index],
Rank = index,
Tiers = names,
PaidRank = paidRank,
Key = key,
Saved = saved,
Data = detail,
ExpiresAt = expiresAt,
ShowExpiry = showExpiry,
Icon = tiers[index].Icon,
NoKey = tiers[index].NoKey == true,
}
end
local savedIndex, savedKey, savedExpiry = loadSaved(options, context.folder)
if savedIndex then
return access(savedIndex, savedKey, true, nil, savedExpiry)
end
local outcome, done, waiter = nil, false, nil
local shell = Dialog.shell(library, {
Width = 430,
OnClose = function()
done = true
if waiter then
task.spawn(waiter)
end
end,
})
local card, scope = shell.card, shell.scope
local selected = tierIndex(tiers, options.DefaultTier) or 1
local maxAttempts, cooldown = options.MaxAttempts or 5, options.Cooldown or 30
local attempts, busy, locked = 0, false, false
local effect = options.ButtonEffect or "Sweep"
local header = Create.new("Frame", {
Name = "Header",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Parent = card,
})
Create.list(header, "Horizontal", 12, { VerticalAlignment = Enum.VerticalAlignment.Top })
local tile = Create.new("Frame", {
Name = "Tile",
Size = UDim2.fromOffset(44, 44),
BackgroundTransparency = 0.85,
Theme = { BackgroundColor3 = "accent" },
Parent = header,
})
Create.corner(12, tile)
Create.new("UIStroke", { Transparency = 0.55, Theme = { Color = "accent" }, Parent = tile })
local glyph = Create.icon(options.Icon or "key-round", 22, "accent", tile)
glyph.AnchorPoint = Vector2.new(0.5, 0.5)
glyph.Position = UDim2.fromScale(0.5, 0.5)
local titles = Create.new("Frame", { Name = "Titles", AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = header }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.list(titles, "Vertical", 3)
Create.new("TextLabel", {
Name = "Title",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 17,
Weight = "bold",
Text = options.Title or Strings.get("{title} access", { title = context.title }),
Theme = { TextColor3 = "text" },
Parent = titles,
})
Create.new("TextLabel", {
Name = "Note",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 13,
LayoutOrder = 1,
Text = options.Note or "",
Visible = (options.Note or "") ~= "",
Theme = { TextColor3 = "textMuted" },
Parent = titles,
})
local close = Create.new("TextButton", { Name = "Close", Size = UDim2.fromOffset(32, 32), LayoutOrder = 2, Parent = header })
Create.corner(8, close)
local cross = Create.icon("x", 16, "textMuted", close)
cross.AnchorPoint = Vector2.new(0.5, 0.5)
cross.Position = UDim2.fromScale(0.5, 0.5)
scope:connect(close.Activated, shell.Close)
Hairline.new("X", "stroke", { LayoutOrder = 1, Parent = card })
local cards = {}
if #tiers > 1 then
local group = Create.new("Frame", {
Name = "Tiers",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 2,
Parent = card,
})
Create.list(group, "Horizontal", 8, { VerticalAlignment = Enum.VerticalAlignment.Top })
for index, tier in tiers do
local paid = paidRank ~= nil and index >= paidRank
local ad = adService(tier)
local tag = tier.Tag
if not tag then
tag = if tier.NoKey then Strings.get("No key needed") elseif ad then Strings.get("Via {service}", { service = ad.Name or Strings.get("an ad") }) elseif paid then Strings.get("Paid key") else Strings.get("Key required")
if tier.Duration and showExpiry then
tag ..= ` · {Env.duration(tier.Duration)}`
end
end
local button = Create.new("TextButton", {
Name = "Tier",
Size = UDim2.new(0, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = index,
Theme = { BackgroundColor3 = "raised" },
Parent = group,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
Create.corner(10, button)
Create.padding(button, 12, 10)
Create.list(button, "Vertical", 4)
local edge = Create.stroke("stroke", button, 1.5)
local top = Create.new("Frame", { Name = "Top", Size = UDim2.new(1, 0, 0, 18), Parent = button })
Create.list(top, "Horizontal", 6)
Create.icon(tier.Icon or (if paid then "crown" elseif tier.NoKey then "lock-open" else "key"), 16, if paid then "warning" else "accent", top)
Create.new("TextLabel", {
Name = "Name",
Size = UDim2.fromScale(0, 1),
Text = tier.Name,
Weight = "bold",
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 1,
Theme = { TextColor3 = "text" },
Parent = top,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
local check = Create.new("Frame", {
Name = "Check",
Size = UDim2.fromOffset(16, 16),
LayoutOrder = 2,
Theme = { BackgroundColor3 = "accent" },
Parent = top,
})
Create.corner(-1, check)
local tick = Create.icon("check", 11, "onAccent", check)
tick.AnchorPoint = Vector2.new(0.5, 0.5)
tick.Position = UDim2.fromScale(0.5, 0.5)
Create.new("TextLabel", {
Name = "Tag",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 12,
LayoutOrder = 1,
Text = tag,
Theme = { TextColor3 = "textMuted" },
Parent = button,
})
cards[index] = { button = button, edge = edge, check = check }
end
end
local description = Dialog.text(card, "", 3)
description.TextSize = 12
local field = Create.new("Frame", {
Name = "Field",
Size = UDim2.new(1, 0, 0, 46),
LayoutOrder = 4,
Theme = { BackgroundColor3 = "raised" },
Parent = card,
})
Create.corner(10, field)
local fieldEdge = Create.stroke("stroke", field, 1.5)
local keyIcon = Create.icon("key-round", 16, "textMuted", field)
keyIcon.AnchorPoint = Vector2.new(0, 0.5)
keyIcon.Position = UDim2.new(0, 14, 0.5, 0)
local input = Create.new("TextBox", {
Name = "Key",
Position = UDim2.fromOffset(40, 0),
Size = UDim2.new(1, -52, 1, 0),
PlaceholderText = Strings.get("Paste your key"),
TextSize = 14,
ClipsDescendants = true,
Theme = { TextColor3 = "text" },
Parent = field,
})
scope:connect(input.Focused, function()
Theme.bind(fieldEdge, "Color", "accent")
Theme.bind(keyIcon, "ImageColor3", "accent")
end)
scope:connect(input.FocusLost, function()
Theme.bind(fieldEdge, "Color", "stroke")
Theme.bind(keyIcon, "ImageColor3", "textMuted")
end)
local status = Dialog.text(card, "", 5)
status.TextSize = 12
local actions = Create.new("Frame", { Name = "Actions", Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 6, Parent = card })
Create.list(actions, "Horizontal", 8)
local getKey = Dialog.button(scope, actions, { Name = "GetKey", Size = UDim2.fromScale(0, 1), LayoutOrder = 1, Effect = effect })
Create.stroke("stroke", getKey)
local verify = Dialog.button(scope, actions, {
Name = "Verify",
Variant = "Primary",
Size = UDim2.fromScale(0, 1),
LayoutOrder = 2,
Effect = effect,
})
for _, button in { getKey, verify } do
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = button })
end
local linkBox = Create.new("TextBox", {
Name = "Link",
Size = UDim2.new(1, 0, 0, 34),
TextEditable = false,
TextSize = 12,
ClipsDescendants = true,
Visible = false,
LayoutOrder = 7,
Theme = { BackgroundColor3 = "raised", TextColor3 = "text" },
Parent = card,
})
Create.corner(8, linkBox)
Create.padding(linkBox, 10, 0)
local footer = Dialog.text(card, "", 8)
footer.TextSize = 12
footer.TextXAlignment = Enum.TextXAlignment.Center
local function setStatus(text, role)
status.Text = text
status.Visible = text ~= ""
Theme.bind(status, "TextColor3", role or "textMuted")
end
local discord = DiscordButton.settings(options.Discord)
if discord then
local line = Create.new("Frame", { Name = "Community", Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 9, Parent = card })
Create.list(line, "Horizontal", 10, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
local settings = { Link = discord.Link, Icon = discord.Icon, Size = 36, LayoutOrder = 1, Label = discord.Label or Strings.get("Join the Discord") }
DiscordButton.new(scope, line, settings, function(how, link)
if how == "opened" then
setStatus(Strings.get("Opened the invite in Discord."), "success")
elseif how == "copied" then
setStatus(Strings.get("Discord invite copied. Paste it into your browser."), "success")
else
linkBox.Text = link
linkBox.Visible = true
setStatus(Strings.get("Copy the invite from the box below."), "info")
end
end)
end
local function refresh()
local tier = tiers[selected]
for index, entry in cards do
local on = index == selected
Theme.bind(entry.edge, "Color", if on then "accent" else "stroke")
Theme.bind(entry.button, "BackgroundColor3", if on then "accent" else "raised")
entry.button.BackgroundTransparency = if on then 0.88 else 0
entry.check.Visible = on
end
local ad = adService(tier)
local service = if ad then ad.Name or "the ad" else nil
local keyed = not (ad and ad.RequiresKey == false)
local hint = tier.Description or (if ad then Strings.get("Finish the {service} step to unlock {tier}.", { service = service, tier = tier.Name }) else nil)
description.Text = hint or ""
description.Visible = hint ~= nil
input.Visible = not tier.NoKey and keyed
field.Visible = input.Visible
local lasts = if tier.Duration and showExpiry and input.Visible then Strings.get("Keys for {tier} last {time}.", { tier = tier.Name, time = Env.duration(tier.Duration) }) else nil
local kept = if options.SaveKey ~= false and input.Visible then Strings.get("Your key is saved on this device.") else nil
footer.Text = if lasts and kept then `{lasts} {kept}` else lasts or kept or ""
footer.Visible = footer.Text ~= ""
getKey.Visible = not tier.NoKey and (tier.Link ~= nil or tier.GetLink ~= nil or (ad ~= nil and (ad.Link ~= nil or ad.GetLink ~= nil)))
getKey.Text = tier.LinkLabel or (if ad then Strings.get("Open {service}", { service = service }) else Strings.get("Get a key"))
verify.Text = if busy then Strings.get("Checking") elseif tier.NoKey then Strings.get("Continue with {tier}", { tier = tier.Name }) elseif not keyed then Strings.get("I finished {service}", { service = service }) else Strings.get("Verify key")
linkBox.Visible = false
end
local function finish(index, key, detail)
local duration = tiers[index].Duration
outcome = access(index, key, false, detail, if duration and key then os.time() + duration else nil)
if key and key ~= "" and options.SaveKey ~= false then
local encoded, text = Env.encode({ version = VERSION, key = key, tier = names[index], savedAt = os.time() })
outcome.Saved = encoded and Env.write(savedPath(context.folder), text) == true
end
Env.call("Key system", options.OnSuccess, outcome)
shell.Close()
end
local function lockOut()
locked = true
scope:add(task.spawn(function()
for remaining = cooldown, 1, -1 do
setStatus(Strings.get("Too many attempts. Try again in {seconds} s.", { seconds = remaining }), "danger")
task.wait(1)
end
locked, attempts = false, 0
setStatus("", nil)
end))
end
local function submit()
if busy or locked then
return
end
local tier = tiers[selected]
if tier.NoKey then
finish(selected, nil)
return
end
local key = trim(input.Text)
busy = true
setStatus(Strings.get("Checking the key."), "textMuted")
refresh()
local index, message, detail = KeySystem.check(options, selected, key)
busy = false
if shell.Closed then
return
end
refresh()
if index then
finish(index, key, detail)
return
end
attempts += 1
Env.call("Key system", options.OnFail, message)
if attempts >= maxAttempts then
lockOut()
else
setStatus(message, "danger")
Motion.tween(input, "fast", { BackgroundColor3 = Theme.color("raised") })
end
end
for index, entry in cards do
scope:connect(entry.button.Activated, function()
selected = index
if not locked then
setStatus("", nil)
end
refresh()
end)
end
scope:connect(verify.Activated, submit)
scope:connect(input.FocusLost, function(entered)
if entered then
submit()
end
end)
scope:connect(getKey.Activated, function()
local tier = tiers[selected]
local ad = adService(tier)
local link = (ad and ad.Link) or tier.Link
local make = (ad and ad.GetLink) or tier.GetLink
if type(make) == "function" then
local ok, made = pcall(make)
link = if ok then made else nil
end
if type(link) ~= "string" then
setStatus(Strings.get("The key link is not available right now."), "danger")
elseif Env.copy(link) then
local sentence = if not ad
then "Link copied. Open it in your browser to get a key."
elseif ad.RequiresKey == false then "Link copied. Open it in your browser and finish the step, then confirm here."
else "Link copied. Open it in your browser and finish the step, then paste your key here."
setStatus(Strings.get(sentence), "success")
else
linkBox.Text = link
linkBox.Visible = true
setStatus(Strings.get("Copy this link and open it in your browser."), "textMuted")
end
end)
setStatus("", nil)
refresh()
if not done then
waiter = coroutine.running()
coroutine.yield()
end
return outcome
end
return KeySystem
end
modules["Components/Menu"] = function()
local Create = import("Core/Create")
local Env = import("Core/Env")
local Motion = import("Core/Motion")
local Mount = import("Core/Mount")
local Popup = import("Components/Popup")
local Theme = import("Core/Theme")
local Menu = {}
local function item(library, popup, settings, order)
if settings.Divider then
local line = Create.new("Frame", { Name = "Divider", Size = UDim2.new(1, -8, 0, 1), LayoutOrder = order, Theme = { BackgroundColor3 = "stroke" }, Parent = popup.frame })
return line
end
local role = if settings.Danger then "danger" else "text"
local button = Create.new("TextButton", {
Name = "Item",
Size = UDim2.new(1, 0, 0, if library.touch then 40 else 30),
LayoutOrder = order,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "hover" },
Parent = popup.frame,
})
Create.corner(6, button)
Create.padding(button, 10, 0)
Create.list(button, "Horizontal", 10, { VerticalAlignment = Enum.VerticalAlignment.Center })
if settings.Icon then
Create.icon(settings.Icon, 15, if settings.Danger then "danger" else "textMuted", button)
end
Create.new("TextLabel", {
Name = "Title",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = settings.Title or "",
TextSize = 13,
LayoutOrder = 1,
Theme = { TextColor3 = role },
Parent = button,
})
if settings.Disabled then
button.AutoButtonColor = false
for _, child in button:GetChildren() do
if child:IsA("TextLabel") then
child.TextTransparency = 0.5
elseif child:IsA("ImageLabel") then
child.ImageTransparency = 0.5
end
end
return button
end
popup.scope:connect(button.MouseEnter, function()
Motion.tween(button, "fast", { BackgroundTransparency = 0 })
end)
popup.scope:connect(button.MouseLeave, function()
Motion.tween(button, "fast", { BackgroundTransparency = 1 })
end)
popup.scope:connect(button.Activated, function()
popup.close()
Env.call(settings.Title or "Menu", settings.Callback)
end)
return button
end
function Menu.open(library, anchor, items, width)
local popup = Popup.toggle(library, anchor, { Width = width or 200 })
if not popup then
return nil
end
for order, settings in items do
if type(settings) == "table" then
item(library, popup, settings, order)
end
end
return popup
end
function Menu.openAt(library, position, items, width)
local overlay = Mount.overlay(library)
local origin = overlay.gui.AbsolutePosition
local anchor = Create.new("Frame", {
Name = "MenuAnchor",
Size = UDim2.fromOffset(1, 1),
Position = UDim2.fromOffset(position.X - origin.X, position.Y - origin.Y),
Parent = overlay.popups,
})
local popup = Menu.open(library, anchor, items, width)
if popup then
popup.scope:add(anchor)
else
anchor:Destroy()
end
return popup
end
function Menu.attach(scope, library, frame, items)
local UserInputService = game:GetService("UserInputService")
local function show()
local listed = if type(items) == "function" then items() else items
Menu.openAt(library, UserInputService:GetMouseLocation(), listed)
end
scope:connect(frame.InputBegan, function(input)
if input.UserInputType == Enum.UserInputType.MouseButton2 then
show()
elseif input.UserInputType == Enum.UserInputType.Touch then
local start = input.Position
local held = true
local ended
ended = input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End or (input.Position - start).Magnitude > 12 then
held = false
ended:Disconnect()
end
end)
task.delay(0.5, function()
if held and not scope.cleaned then
ended:Disconnect()
Menu.openAt(library, Vector2.new(start.X, start.Y), if type(items) == "function" then items() else items)
end
end)
end
end)
end
Menu.Theme = Theme
return Menu
end
modules["Components/NoticeCenter"] = function()
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Notifications = import("Components/Notifications")
local Popup = import("Components/Popup")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local ICONS = { info = "info", success = "circle-check", warning = "triangle-alert", danger = "circle-alert" }
local LIST_HEIGHT = 320
local NoticeCenter = {}
function NoticeCenter.ago(seconds)
if seconds < 60 then
return "now"
elseif seconds < 3600 then
return `{math.floor(seconds / 60)}m`
elseif seconds < 86400 then
return `{math.floor(seconds / 3600)}h`
end
return `{math.floor(seconds / 86400)}d`
end
local function entryRow(entry, parent, order)
local row = Create.new("Frame", { Name = "Entry", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = parent })
Create.padding(row, 8, 8)
Create.list(row, "Horizontal", 10, { VerticalAlignment = Enum.VerticalAlignment.Top })
Create.icon(ICONS[entry.kind] or "info", 16, if ICONS[entry.kind] then entry.kind else "info", row)
local text = Create.new("Frame", { Name = "Text", AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = row }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.list(text, "Vertical", 2)
Create.new("TextLabel", {
Name = "Title",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 13,
Weight = "medium",
Text = entry.title,
Theme = { TextColor3 = "text" },
Parent = text,
})
if entry.content ~= "" then
Create.new("TextLabel", {
Name = "Content",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 12,
LayoutOrder = 1,
Text = entry.content,
Theme = { TextColor3 = "textMuted" },
Parent = text,
})
end
Create.new("TextLabel", {
Name = "Time",
Size = UDim2.fromOffset(0, 16),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 11,
LayoutOrder = 2,
Text = NoticeCenter.ago(os.time() - entry.at),
Theme = { TextColor3 = "textMuted" },
Parent = row,
})
end
local function open(window, anchor, refreshBadge)
local log = Notifications.history(window.library)
local popup = Popup.toggle(window.library, anchor, { Width = 300 })
if not popup then
return
end
log.unread = 0
refreshBadge()
local head = Create.new("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, 30), Parent = popup.frame })
Create.padding(head, 8, 0, 4, 0)
Create.new("TextLabel", {
Name = "Title",
Size = UDim2.fromScale(0.6, 1),
Text = Strings.get("Notices"),
TextSize = 14,
Weight = "bold",
Theme = { TextColor3 = "text" },
Parent = head,
})
local clear = Create.new("TextButton", {
Name = "Clear",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(1, 0),
Position = UDim2.fromScale(1, 0),
Text = Strings.get("Clear all"),
TextSize = 12,
Weight = "medium",
Theme = { TextColor3 = "textMuted" },
Parent = head,
})
Create.padding(clear, 6, 0)
local list = Create.new("ScrollingFrame", {
Name = "List",
Size = UDim2.new(1, 0, 0, 0),
AutomaticCanvasSize = Enum.AutomaticSize.Y,
ScrollBarThickness = 3,
LayoutOrder = 1,
Parent = popup.frame,
})
Create.fitHeight(list, Create.list(list, "Vertical", 0), LIST_HEIGHT, window.library, popup.scope)
local function fill()
for _, child in list:GetChildren() do
if child:IsA("GuiObject") then
child:Destroy()
end
end
if #log.entries == 0 then
Create.new("TextLabel", {
Name = "Empty",
Size = UDim2.new(1, 0, 0, 56),
Text = Strings.get("No notices yet"),
TextSize = 13,
TextXAlignment = Enum.TextXAlignment.Center,
Theme = { TextColor3 = "textMuted" },
Parent = list,
})
else
for index, entry in log.entries do
entryRow(entry, list, index)
end
end
clear.Visible = #log.entries > 0
end
fill()
popup.scope:connect(clear.Activated, function()
table.clear(log.entries)
log.unread = 0
refreshBadge()
fill()
end)
popup.scope:connect(clear.MouseEnter, function()
Theme.bind(clear, "TextColor3", "text")
end)
popup.scope:connect(clear.MouseLeave, function()
Theme.bind(clear, "TextColor3", "textMuted")
end)
popup.scope:connect(log.Added, function()
log.unread = 0
refreshBadge()
fill()
end)
end
function NoticeCenter.build(window)
local log = Notifications.history(window.library)
local button
local glyph = window.topbarAction("bell", 1.2, function()
NoticeCenter.open(window, button)
end)
button = glyph.Parent
button.Name = "Notices"
local badge = Create.new("TextLabel", {
Name = "Unread",
Size = UDim2.fromOffset(0, 16),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(0, 1),
Position = UDim2.new(0.5, 5, 0.5, -4),
TextSize = 12,
TextXAlignment = Enum.TextXAlignment.Center,
Weight = "bold",
ZIndex = 3,
Visible = false,
Theme = { BackgroundColor3 = "accent", TextColor3 = "onAccent" },
Parent = button,
})
Create.corner(-1, badge)
Create.padding(badge, 5, 0)
local function refresh()
badge.Visible = log.unread > 0
badge.Text = if log.unread > 99 then "99+" else tostring(log.unread)
end
window.noticeBadge = refresh
window.scope:connect(log.Added, function()
refresh()
if not Motion.reduced and badge.Visible then
badge.Size = UDim2.fromOffset(0, 12)
Motion.tween(badge, "spring", { Size = UDim2.fromOffset(0, 16) })
end
end)
refresh()
window.noticeButton = button
return button
end
function NoticeCenter.open(window, anchor)
open(window, anchor or window.noticeButton, window.noticeBadge or function() end)
end
return NoticeCenter
end
modules["Components/Notifications"] = function()
local GuiService = game:GetService("GuiService")
local SoundService = game:GetService("SoundService")
local Arc = import("Core/Arc")
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Env = import("Core/Env")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Mount = import("Core/Mount")
local Signal = import("Core/Signal")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
local Schema = import("Core/Schema")
local WIDTH, NARROW = 320, 480
local RADIUS = 12
local EDGE = 5
local SWIPE = 70
local HISTORY = 50
local KINDS = {
info = { icon = "info", role = "info" },
success = { icon = "circle-check", role = "success" },
warning = { icon = "triangle-alert", role = "warning" },
danger = { icon = "circle-alert", role = "danger" },
}
local POSITIONS = { TopLeft = true, TopCenter = true, TopRight = true, BottomLeft = true, BottomCenter = true, BottomRight = true }
local DARK = {
fill = Color3.fromRGB(17, 18, 22),
text = Color3.fromRGB(244, 245, 247),
muted = Color3.fromRGB(150, 155, 166),
}
local STYLES = {}
for _, name in { "Default", "Timer", "Compact", "Banner", "Progress", "Accent", "Glass", "Achievement", "Snackbar", "Island" } do
STYLES[name] = true
Styles.register("Notification", name, {})
end
local CHIME = "rbxasset://sounds/electronicpingshort.wav"
local Notifications = {
Defaults = {
Duration = 4,
Position = "BottomRight",
Progress = true,
MaxVisible = 4,
Style = "Default",
Sound = false,
Countdown = "Bar",
Stack = "List",
},
}
local COUNTDOWNS = { Bar = true, Edge = true, Ring = true, Top = true, None = true }
local STACKS = { List = true, Deck = true }
function Notifications.configure(library, settings)
if type(settings) ~= "table" then
return
end
local defaults = Notifications.Defaults
if type(settings.Duration) == "number" and settings.Duration >= 0 then
defaults.Duration = settings.Duration
end
if POSITIONS[settings.Position] then
defaults.Position = settings.Position
end
if type(settings.Progress) == "boolean" then
defaults.Progress = settings.Progress
end
if type(settings.Sound) == "boolean" or type(settings.Sound) == "string" then
defaults.Sound = settings.Sound
end
if STYLES[settings.Style] then
defaults.Style = settings.Style
end
if type(settings.MaxVisible) == "number" and settings.MaxVisible >= 1 then
defaults.MaxVisible = math.floor(settings.MaxVisible)
end
if COUNTDOWNS[settings.Countdown] then
defaults.Countdown = settings.Countdown
end
if STACKS[settings.Stack] then
defaults.Stack = settings.Stack
if library.toasts then
library.toasts.fan(false)
end
end
if library.toasts then
library.toasts.place()
end
end
function Notifications.history(library)
if not library.notices then
local log = { entries = {}, unread = 0, Added = Signal.new() }
library.scope:add(log.Added)
library.notices = log
end
return library.notices
end
local function remember(library, toast)
local log = Notifications.history(library)
local entry = { title = toast.title, content = toast.content, kind = toast.kind or "info", at = os.time() }
table.insert(log.entries, 1, entry)
if #log.entries > HISTORY then
table.remove(log.entries)
end
log.unread += 1
log.Added:Fire(entry)
end
local function centred(instance)
instance.AnchorPoint = Vector2.new(0.5, 0.5)
instance.Position = UDim2.fromScale(0.5, 0.5)
return instance
end
local function toastStack(library)
if library.toasts then
return library.toasts
end
local overlay = Mount.overlay(library)
local holder = Create.new("Frame", { Name = "Holder", Parent = overlay.toasts })
local layout = Create.list(holder, "Vertical", 8)
local more = Create.new("TextLabel", {
Name = "More",
Size = UDim2.fromOffset(0, 24),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
Weight = "medium",
Visible = false,
Theme = { BackgroundColor3 = "raised", TextColor3 = "textMuted" },
Parent = holder,
})
Create.corner(-1, more)
Create.padding(more, 10, 0)
local island = Create.new("Frame", {
Name = "Island",
Size = UDim2.new(0, 360, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
AnchorPoint = Vector2.new(0.5, 0),
Position = UDim2.new(0.5, 0, 0, GuiService:GetGuiInset().Y + 8),
Parent = overlay.toasts,
})
Create.list(island, "Vertical", 6, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
local state = { holder = holder, island = island, more = more, active = {}, queue = {}, order = 0, side = 1, byId = {}, fanned = false }
library.toasts = state
local PEEK = { 10, 7 }
function state.arrange()
local deck = Notifications.Defaults.Stack == "Deck" and not state.fanned
local count = #state.active
for index, toast in state.active do
local slot, card = toast.slot, toast.card
if slot and card and toast.style ~= "Island" then
local behind = count - index
local peek = if deck and behind > 0 then PEEK[behind] else nil
slot.Visible = not deck or behind <= #PEEK
slot.ClipsDescendants = peek ~= nil
if peek then
slot.AutomaticSize = Enum.AutomaticSize.None
slot.Size = UDim2.new(1, 0, 0, peek)
else
slot.Size = UDim2.new(1, 0, 0, 0)
slot.AutomaticSize = Enum.AutomaticSize.Y
end
if toast.deckScale then
local scale = if peek then 1 - 0.04 * behind else 1
local goals = { [toast.deckScale] = { Scale = scale } }
if peek or toast.peeked then
goals[card] = { Position = UDim2.fromOffset(if peek then slot.AbsoluteSize.X * (1 - scale) / 2 else 0, 0) }
end
toast.peeked = peek ~= nil
for target, goal in goals do
if Motion.reduced then
for property, value in goal do
target[property] = value
end
else
Motion.tween(target, "fast", goal)
end
end
end
end
end
layout.Padding = UDim.new(0, if deck then 3 else 8)
end
local hovering = 0
function state.fan(open)
state.fanned = open
state.arrange()
end
function state.hover(entered)
if Notifications.Defaults.Stack ~= "Deck" then
return
end
hovering += if entered then 1 else -1
if hovering > 0 then
state.fan(true)
else
task.delay(0.35, function()
if hovering <= 0 and state.fanned then
state.fan(false)
end
end)
end
end
function state.place()
local narrow = overlay.gui.AbsoluteSize.X < NARROW
local position = if narrow then "TopCenter" else Notifications.Defaults.Position
local top = string.find(position, "Top", 1, true) ~= nil
local x = if string.find(position, "Left", 1, true) then 0 elseif string.find(position, "Center", 1, true) then 0.5 else 1
local inset = GuiService:GetGuiInset().Y + 8
state.side = x * 2 - 1
holder.AnchorPoint = Vector2.new(x, if top then 0 else 1)
holder.Position = UDim2.new(x, -16 * state.side, if top then 0 else 1, if top then inset else -16)
holder.Size = if narrow then UDim2.new(1, -24, 1, -inset - 8) else UDim2.new(0, WIDTH, 1, -inset - 24)
layout.VerticalAlignment = if top then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Bottom
layout.HorizontalAlignment = if x == 0 then Enum.HorizontalAlignment.Left elseif x == 1 then Enum.HorizontalAlignment.Right else Enum.HorizontalAlignment.Center
more.LayoutOrder = if top then 1e9 else 0
end
function state.count()
local waiting = #state.queue
more.Visible = waiting > 0
more.Text = Strings.get("+{count} more", { count = waiting })
end
library.scope:connect(overlay.gui:GetPropertyChangedSignal("AbsoluteSize"), state.place)
library.scope:add(function()
library.toasts = nil
end)
state.place()
return state
end
local function chime(options)
local sound = if options.Sound ~= nil then options.Sound else Notifications.Defaults.Sound
if not sound then
return
end
local played = Create.new("Sound", { SoundId = if type(sound) == "string" then sound else CHIME, Volume = 0.35 })
pcall(SoundService.PlayLocalSound, SoundService, played)
task.delay(3, function()
played:Destroy()
end)
end
local function tinted(scope, frames, role, amount)
for _, frame in frames do
frame.BackgroundTransparency = 0
end
local function paint()
local colour = Theme.color("surface"):Lerp(Theme.color(role), amount)
for _, frame in frames do
frame.BackgroundColor3 = colour
end
end
paint()
scope:connect(Theme.Changed, paint)
end
local function buildLead(toast, kind, parent)
local options, style = toast.options, toast.style
local picture = options.Image or (if options.Avatar then `rbxthumb://type=AvatarHeadShot&id={options.Avatar}&w=150&h=150` else nil)
if picture and style ~= "Snackbar" and style ~= "Island" and style ~= "Compact" then
local size = if style == "Achievement" then 44 else 36
local frame = Create.new("ImageLabel", {
Name = "Picture",
Size = UDim2.fromOffset(size, size),
ScaleType = Enum.ScaleType.Crop,
Theme = { BackgroundColor3 = "raised" },
Parent = parent,
})
Create.corner(if options.Avatar then -1 else 8, frame)
Icons.apply(frame, picture)
toast.picture = frame
return
end
if style == "Achievement" then
local disc = Create.new("Frame", { Name = "Disc", Size = UDim2.fromOffset(44, 44), Theme = { BackgroundColor3 = kind.role }, Parent = parent })
Create.corner(-1, disc)
toast.tile, toast.tileRole = disc, "fill"
toast.icon = centred(Create.icon(options.Icon or "trophy", 22, "onAccent", disc))
return
end
if style == "Snackbar" and not options.Icon then
return
end
local plain = style == "Compact" or style == "Island" or style == "Snackbar" or style == "Accent" or style == "Banner"
if plain then
toast.icon = Create.icon(options.Icon or kind.icon, if style == "Accent" then 18 else 16, kind.role, parent)
return
end
local tile = Create.new("Frame", {
Name = "Tile",
Size = UDim2.fromOffset(32, 32),
BackgroundTransparency = 0.86,
Theme = { BackgroundColor3 = kind.role },
Parent = parent,
})
Create.corner(8, tile)
toast.tile, toast.tileRole = tile, "tint"
toast.icon = centred(Create.icon(options.Icon or kind.icon, 16, kind.role, tile))
end
local function buildText(library, toast, kind, parent, detail)
local options, style = toast.options, toast.style
local isle, snack = style == "Island", style == "Snackbar"
local line = isle or snack or style == "Compact"
local dark = isle or snack
local scope = toast.scope
local text = Create.new("Frame", { Name = "Text", AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = parent }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.list(text, "Vertical", 2)
if isle then
text:FindFirstChildOfClass("UIFlexItem"):Destroy()
text.Size = UDim2.fromOffset(0, 0)
text.AutomaticSize = Enum.AutomaticSize.XY
end
toast.titleLabel = Create.new("TextLabel", {
Name = "Title",
Size = if isle then UDim2.fromOffset(0, 0) else UDim2.new(1, 0, 0, 0),
AutomaticSize = if isle then Enum.AutomaticSize.XY else Enum.AutomaticSize.Y,
TextWrapped = not line,
TextTruncate = if line and not isle then Enum.TextTruncate.AtEnd else Enum.TextTruncate.None,
Weight = if style == "Achievement" then "bold" else "medium",
Text = toast.title,
TextSize = if line then 13 elseif style == "Achievement" then 15 else 14,
Parent = text,
})
if dark then
toast.titleLabel.TextColor3 = DARK.text
else
Theme.bind(toast.titleLabel, "TextColor3", "text")
end
if not (snack or style == "Compact") then
toast.contentLabel = Create.new("TextLabel", {
Name = "Content",
Size = if isle then UDim2.fromOffset(0, 0) else UDim2.new(1, 0, 0, 0),
AutomaticSize = if isle then Enum.AutomaticSize.XY else Enum.AutomaticSize.Y,
TextWrapped = not isle,
TextSize = if isle then 12 else 13,
LayoutOrder = 1,
Text = toast.content,
Visible = toast.content ~= "",
Parent = detail or text,
})
if dark then
toast.contentLabel.TextColor3 = DARK.muted
else
Theme.bind(toast.contentLabel, "TextColor3", "textMuted")
end
end
if style == "Progress" then
local room = Create.new("Frame", { Name = "Room", Size = UDim2.new(1, 0, 0, 10), LayoutOrder = 3, Parent = text })
local rail = Create.new("Frame", {
Name = "Progress",
Size = UDim2.new(1, 0, 0, 4),
AnchorPoint = Vector2.new(0, 1),
Position = UDim2.fromScale(0, 1),
ClipsDescendants = true,
Theme = { BackgroundColor3 = "raised" },
Parent = room,
})
Create.corner(-1, rail)
toast.fill = Create.new("Frame", {
Name = "Fill",
Size = UDim2.fromScale(toast.value, 1),
Theme = { BackgroundColor3 = kind.role },
Parent = rail,
})
Create.corner(-1, toast.fill)
if options.Indeterminate and toast.value == 0 then
toast.fill.Size = UDim2.fromScale(0.3, 1)
toast.running = true
scope:add(task.spawn(function()
while toast.running do
toast.fill.Position = UDim2.fromScale(-0.3, 0)
Motion.tween(toast.fill, "slow", { Position = UDim2.fromScale(1, 0) })
task.wait(1.1)
end
end))
end
end
if not line and type(options.Actions) == "table" and #options.Actions > 0 then
local actions = Create.new("Frame", {
Name = "Actions",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 2,
Parent = detail or text,
})
Create.padding(actions, 0, 6, 0, 0)
Create.list(actions, "Horizontal", 6, { Wraps = true })
for index, settings in options.Actions do
local button = Create.new("TextButton", {
Name = "Action",
Size = UDim2.fromOffset(0, if library.touch then 40 else 28),
AutomaticSize = Enum.AutomaticSize.X,
LayoutOrder = index,
Text = settings.Title or "",
TextSize = 12,
Weight = "medium",
Theme = {
BackgroundColor3 = if index == 1 then "accent" else "raised",
TextColor3 = if index == 1 then "onAccent" else "text",
},
Parent = actions,
})
Create.corner(6, button)
Create.padding(button, 10, 0)
scope:connect(button.Activated, function()
toast.Dismiss()
Env.call(settings.Title or "Notification", settings.Callback)
end)
end
end
end
local function buildTrailing(library, toast, parent, card)
local options, style = toast.options, toast.style
local scope = toast.scope
if style == "Timer" and toast.duration > 0 then
local pill = Create.new("TextLabel", {
Name = "Timer",
Size = UDim2.fromOffset(0, 22),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
Weight = "bold",
LayoutOrder = 3,
Text = `{math.ceil(toast.duration)}s`,
Theme = { BackgroundColor3 = "raised", TextColor3 = "textMuted" },
Parent = parent,
})
Create.corner(-1, pill)
Create.padding(pill, 8, 0)
toast.seconds = pill
return
end
if style == "Snackbar" then
local settings = type(options.Actions) == "table" and options.Actions[1]
if settings then
local word = Create.new("TextButton", {
Name = "Action",
Size = UDim2.fromOffset(0, if library.touch then 40 else 28),
AutomaticSize = Enum.AutomaticSize.X,
Text = settings.Title or "OK",
TextSize = 13,
Weight = "bold",
LayoutOrder = 3,
Theme = { TextColor3 = "accent" },
Parent = parent,
})
Create.padding(word, 6, 0)
scope:connect(word.Activated, function()
toast.Dismiss("action")
Env.call(settings.Title or "Notification", settings.Callback)
end)
end
return
end
if style == "Compact" or style == "Island" or options.Close == false then
return
end
local close = Create.new("TextButton", { Name = "Close", Size = UDim2.fromOffset(24, 24), LayoutOrder = 3, Parent = parent })
Create.corner(6, close)
toast.close = close
local cross = centred(Create.icon("x", 14, "textMuted", close))
cross.ImageTransparency = if library.touch then 0 else 1
scope:connect(close.Activated, function()
toast.Dismiss("closed")
end)
scope:connect(close.MouseEnter, function()
Theme.bind(cross, "ImageColor3", "text")
end)
scope:connect(close.MouseLeave, function()
Theme.bind(cross, "ImageColor3", "textMuted")
end)
if not library.touch then
scope:connect(card.MouseEnter, function()
Motion.tween(cross, "fast", { ImageTransparency = 0 })
end)
scope:connect(card.MouseLeave, function()
Motion.tween(cross, "fast", { ImageTransparency = 1 })
end)
end
end
local function show(library, state, toast)
local options = toast.options
local kind = KINDS[toast.kind] or KINDS.info
local style = toast.style
local snack, isle, compact = style == "Snackbar", style == "Island", style == "Compact"
local dark = snack or isle
local line = dark or compact
local scope = library.scope:child()
toast.scope = scope
state.order += 1
chime(options)
local slot = Create.new("Frame", {
Name = "Toast",
Size = if isle then UDim2.fromOffset(0, 0) else UDim2.new(1, 0, 0, 0),
AutomaticSize = if isle then Enum.AutomaticSize.XY else Enum.AutomaticSize.Y,
LayoutOrder = state.order,
Parent = if isle then state.island else state.holder,
})
scope:add(slot)
toast.slot = slot
local card = Create.new("TextButton", {
Name = "Card",
Text = "",
Size = if isle then UDim2.fromOffset(0, 0) else UDim2.new(1, 0, 0, 0),
AutomaticSize = if isle then Enum.AutomaticSize.XY else Enum.AutomaticSize.Y,
Position = if isle then UDim2.fromOffset(0, -16) else UDim2.fromOffset(28 * state.side, 0),
BackgroundTransparency = if style == "Glass" then 0.3 else 0,
Parent = slot,
})
toast.card = card
if not isle then
toast.deckScale = Create.new("UIScale", { Parent = card })
end
if dark then
card.BackgroundColor3 = DARK.fill
else
Theme.bind(card, "BackgroundColor3", if style == "Accent" then kind.role else "surface")
end
Create.corner(if isle or compact then -1 elseif snack then 10 else RADIUS, card)
local edge = Create.stroke(if style == "Glass" then "text" else "stroke", card)
if style == "Glass" then
edge.Transparency = 0.8
elseif dark then
Theme.unbind(edge, "Color")
edge.Color = Color3.new(1, 1, 1)
edge.Transparency = 0.9
end
if isle then
Create.new("UISizeConstraint", { MaxSize = Vector2.new(360, math.huge), Parent = card })
end
if style == "Glass" then
local sheen = Create.new("Frame", {
Name = "Sheen",
Size = UDim2.new(1, 0, 0, 40),
BackgroundColor3 = Color3.new(1, 1, 1),
BackgroundTransparency = 0.88,
Parent = card,
}, {
Create.new("UIGradient", {
Rotation = 90,
Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
}),
})
Create.corner(RADIUS, sheen)
end
local panel = card
if style == "Accent" then
panel = Create.new("Frame", {
Name = "Panel",
Size = UDim2.new(1, -EDGE, 0, 0),
Position = UDim2.fromOffset(EDGE, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Theme = { BackgroundColor3 = "surface" },
Parent = card,
})
Create.corner(RADIUS, panel)
end
local band, detail
if style == "Banner" then
Create.list(card, "Vertical", 0)
band = Create.new("Frame", { Name = "Band", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = card })
Create.corner(RADIUS, band)
local square = Create.new("Frame", {
Name = "Square",
Size = UDim2.new(1, 0, 0, RADIUS),
AnchorPoint = Vector2.new(0, 1),
Position = UDim2.fromScale(0, 1),
Parent = band,
})
tinted(scope, { band, square }, kind.role, 0.24)
detail = Create.new("Frame", { Name = "Detail", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
Create.padding(detail, 40, 8, 12, 12)
Create.list(detail, "Vertical", 2)
end
local body = Create.new("Frame", {
Name = "Body",
Size = if isle then UDim2.fromOffset(0, 0) else UDim2.new(1, 0, 0, 0),
AutomaticSize = if isle then Enum.AutomaticSize.XY else Enum.AutomaticSize.Y,
ZIndex = 2,
Parent = band or panel,
})
local pad
if isle then
pad = Create.padding(body, 16, 10)
elseif line then
pad = Create.padding(body, 14, if snack then 8 else 10)
elseif style == "Banner" then
pad = Create.padding(body, 12, 10)
else
pad = Create.padding(body, 12, 12, 10, 12)
end
Create.list(body, "Horizontal", 10, { VerticalAlignment = if line or style == "Banner" then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top })
buildLead(toast, kind, body)
buildText(library, toast, kind, body, detail)
buildTrailing(library, toast, body, card)
toast.countLabel = Create.new("TextLabel", {
Name = "Count",
Size = UDim2.fromOffset(0, 20),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
Weight = "bold",
LayoutOrder = 2,
Visible = toast.repeats > 1,
Text = tostring(toast.repeats),
Theme = { BackgroundColor3 = kind.role, TextColor3 = "onAccent" },
Parent = body,
})
Create.corner(-1, toast.countLabel)
Create.padding(toast.countLabel, 7, 0)
if detail and toast.contentLabel and toast.content == "" and not detail:FindFirstChild("Actions") then
detail.Visible = false
end
if style == "Achievement" and not Motion.reduced then
local grow = Create.new("UIScale", { Scale = 0.9, Parent = card })
Motion.tween(grow, "spring", { Scale = 1 })
end
Motion.tween(card, "base", { Position = UDim2.fromOffset(0, 0) })
local hovering = false
scope:connect(card.MouseEnter, function()
hovering = true
toast.paused = true
end)
scope:connect(card.MouseLeave, function()
hovering = false
toast.paused = toast.dragging == true
end)
scope:connect(card.Activated, function()
if toast.swiped then
return
end
if Notifications.Defaults.Stack == "Deck" and not state.fanned and #state.active > 1 then
state.fan(true)
return
end
if type(options.OnClick) == "function" then
Env.call(toast.title, options.OnClick, toast)
end
toast.Dismiss("clicked")
end)
scope:connect(card.MouseEnter, function()
state.hover(true)
end)
scope:connect(card.MouseLeave, function()
state.hover(false)
end)
if not isle then
Drag.track(scope, card, function()
toast.dragging = true
toast.paused = true
return true
end, function(position, origin, moved)
if moved then
toast.swiped = true
card.Position = UDim2.fromOffset(position.X - origin.X, 0)
end
end, function(moved)
toast.dragging = false
toast.paused = hovering
task.defer(function()
toast.swiped = false
end)
if not moved then
return
end
local offset = card.Position.X.Offset
if math.abs(offset) >= SWIPE then
toast.leaving = math.sign(offset)
toast.Dismiss("swiped")
else
Motion.tween(card, "spring", { Position = UDim2.fromOffset(0, 0) })
end
end)
end
local duration = toast.duration
if duration > 0 then
local fill, arc, top
local mode = toast.countdown
if style == "Timer" or style == "Progress" then
mode = "None"
end
if mode == "Edge" and isle then
mode = "Ring"
end
if mode == "Edge" then
local layout = card:FindFirstChildOfClass("UIListLayout")
local content = if panel ~= card then panel else body
local function fit()
local wanted = if layout then layout.AbsoluteContentSize.Y else content.AbsoluteSize.Y
local shown, current = card.AbsoluteSize.Y, card.Size.Y.Offset
local height = if shown > 0 and current > 0 then current * wanted / shown else wanted
if math.abs(height - current) >= 0.5 then
card.Size = UDim2.new(1, 0, 0, math.ceil(height))
end
end
card.AutomaticSize = Enum.AutomaticSize.None
fit()
if layout then
scope:connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), fit)
else
scope:connect(content:GetPropertyChangedSignal("AbsoluteSize"), fit)
end
arc = Arc.new(card, {
Thickness = 2,
Role = kind.role,
Radius = if isle or compact then -1 elseif snack then 10 else RADIUS,
Even = true,
ZIndex = 4,
})
toast.arc = arc
elseif mode == "Ring" then
local host = toast.close
if not host then
host = Create.new("Frame", { Name = "Ring", Size = UDim2.fromOffset(16, 16), LayoutOrder = 4, Parent = body })
end
arc = Arc.new(host, { Thickness = 2, Role = kind.role, Radius = -1, ZIndex = 3 })
toast.arc = arc
elseif mode == "Top" and not line then
top = Create.new("Frame", {
Name = "Countdown",
Size = UDim2.new(1, -2 * RADIUS, 0, 2),
Position = UDim2.fromOffset(RADIUS, 0),
ZIndex = 4,
Theme = { BackgroundColor3 = kind.role },
Parent = card,
})
toast.topLine = top
end
if mode == "Bar" and not line and not Motion.reduced then
if band then
local rail = Create.new("Frame", {
Name = "Countdown",
Size = UDim2.new(1, -24, 0, 2),
AnchorPoint = Vector2.new(0, 1),
Position = UDim2.new(0, 12, 1, -1),
BackgroundTransparency = 1,
ZIndex = 3,
Parent = band,
})
fill = Create.new("Frame", { Name = "Fill", Size = UDim2.fromScale(1, 1), ZIndex = 3, Theme = { BackgroundColor3 = kind.role }, Parent = rail })
Create.corner(-1, fill)
else
pad.PaddingBottom = UDim.new(0, 22)
local rail = Create.new("Frame", {
Name = "Countdown",
Size = UDim2.new(1, -24, 0, 3),
AnchorPoint = Vector2.new(0, 1),
Position = UDim2.new(0, 12, 1, -10),
ZIndex = 2,
Theme = { BackgroundColor3 = "raised" },
Parent = panel,
})
Create.corner(-1, rail)
fill = Create.new("Frame", { Name = "Fill", Size = UDim2.fromScale(1, 1), ZIndex = 2, Theme = { BackgroundColor3 = kind.role }, Parent = rail })
Create.corner(-1, fill)
end
end
toast.left = duration
scope:add(task.spawn(function()
while toast.left > 0 do
local elapsed = task.wait(0.05)
if not toast.paused then
toast.left -= elapsed
local share = math.max(toast.left / toast.duration, 0)
if fill then
fill.Size = UDim2.fromScale(share, 1)
end
if arc then
arc:Set(share)
end
if top then
top.Size = UDim2.new(share, -2 * RADIUS * share, 0, 2)
end
if toast.seconds then
toast.seconds.Text = `{math.max(math.ceil(toast.left), 0)}s`
end
end
end
toast.Dismiss("timeout")
end))
end
state.arrange()
end
function Notifications.push(library, options)
if type(options) == "string" then
options = { Title = options }
end
Schema.check(`Notify "{options.Title or ""}"`, options, Schema.notify)
local defaults = Notifications.Defaults
local state = toastStack(library)
local style = if STYLES[options.Style] then options.Style else defaults.Style
local toast = {
options = options,
done = false,
style = style,
kind = options.Kind,
title = options.Title or "",
content = options.Content or "",
value = 0,
duration = if type(options.Duration) == "number" then options.Duration elseif style == "Progress" then 0 else defaults.Duration,
progress = if options.Progress ~= nil then options.Progress == true else defaults.Progress,
repeats = 1,
}
toast.countdown = if COUNTDOWNS[options.Countdown] then options.Countdown else defaults.Countdown
if not toast.progress then
toast.countdown = "None"
end
local existing = if options.Id ~= nil then state.byId[options.Id] else nil
if not existing and options.Merge ~= false and options.Id == nil and style ~= "Progress" then
for _, other in state.active do
if not other.done and other.options.Id == nil and other.title == toast.title and other.content == toast.content and other.kind == toast.kind and other.style == style then
existing = other
existing.repeats += 1
if existing.countLabel then
existing.countLabel.Text = tostring(existing.repeats)
existing.countLabel.Visible = true
end
break
end
end
end
if existing and not existing.done then
if options.Id ~= nil then
existing.options = options
existing.SetTitle(toast.title)
existing.SetContent(toast.content)
if options.Kind then
existing.SetKind(options.Kind)
end
end
existing.Restart(toast.duration)
return existing
end
if options.Id ~= nil then
state.byId[options.Id] = toast
end
function toast.Restart(seconds)
if type(seconds) == "number" then
toast.duration = seconds
end
toast.left = toast.duration
end
function toast.SetKind(kind)
local chosen = KINDS[kind] or KINDS.info
toast.kind = kind
if toast.icon then
Icons.apply(toast.icon, chosen.icon)
if toast.tileRole ~= "fill" then
Theme.bind(toast.icon, "ImageColor3", chosen.role)
end
end
if toast.tile then
Theme.bind(toast.tile, "BackgroundColor3", chosen.role)
end
if toast.fill then
Theme.bind(toast.fill, "BackgroundColor3", chosen.role)
end
if toast.arc then
toast.arc:SetRole(chosen.role)
end
if toast.topLine then
Theme.bind(toast.topLine, "BackgroundColor3", chosen.role)
end
if toast.countLabel then
Theme.bind(toast.countLabel, "BackgroundColor3", chosen.role)
end
end
function toast.SetProgress(value)
toast.value = math.clamp(tonumber(value) or 0, 0, 1)
toast.running = false
if toast.fill then
toast.fill.Position = UDim2.fromScale(0, 0)
Motion.tween(toast.fill, "base", { Size = UDim2.fromScale(toast.value, 1) })
end
end
function toast.SetTitle(title)
toast.title = tostring(title)
if toast.titleLabel then
toast.titleLabel.Text = toast.title
end
end
function toast.SetContent(content)
toast.content = tostring(content or "")
if toast.contentLabel then
toast.contentLabel.Text = toast.content
toast.contentLabel.Visible = toast.content ~= ""
local detail = toast.contentLabel.Parent
if detail and detail.Name == "Detail" then
detail.Visible = true
end
end
end
function toast.Done(title, kind)
if toast.done then
return
end
toast.SetProgress(1)
if title then
toast.SetTitle(title)
end
toast.SetKind(kind or "success")
if toast.scope then
toast.scope:add(task.delay(2.5, toast.Dismiss))
else
toast.duration = 2.5
end
end
toast.Complete = toast.Done
function toast.Dismiss(reason)
if toast.done then
return
end
toast.done = true
toast.running = false
if options.Id ~= nil and state.byId[options.Id] == toast then
state.byId[options.Id] = nil
end
if type(options.OnDismiss) == "function" then
Env.call(toast.title, options.OnDismiss, if type(reason) == "string" then reason else "code")
end
local queued = table.find(state.queue, toast)
if queued then
table.remove(state.queue, queued)
state.count()
return
end
table.remove(state.active, table.find(state.active, toast))
local scope, card = toast.scope, toast.card
if card and not Motion.reduced and toast.style ~= "Island" then
local side = toast.leaving or state.side
if side == 0 then
side = 1
end
Motion.tween(card, "fast", { Position = UDim2.fromOffset(side * (WIDTH + 24), 0) })
task.delay(0.14, function()
library.scope:release(scope)
end)
else
library.scope:release(scope)
end
local waiting = table.remove(state.queue, 1)
if waiting then
table.insert(state.active, waiting)
show(library, state, waiting)
end
state.count()
state.arrange()
end
remember(library, toast)
if #state.active < defaults.MaxVisible then
table.insert(state.active, toast)
show(library, state, toast)
else
table.insert(state.queue, toast)
end
state.count()
return toast
end
function Notifications.clear(library)
local state = library.toasts
if not state then
return
end
for _, toast in table.clone(state.queue) do
toast.Dismiss("cleared")
end
for _, toast in table.clone(state.active) do
toast.Dismiss("cleared")
end
end
return Notifications
end
modules["Components/Panels"] = function()
local Create = import("Core/Create")
local Dialog = import("Components/Dialog")
local Env = import("Core/Env")
local Motion = import("Core/Motion")
local Strings = import("Core/Strings")
local TAGS = {
New = "accent",
Improved = "info",
Fixed = "success",
Removed = "danger",
Security = "warning",
}
local Panels = {}
local function cover(window, name)
local veil = Create.new("TextButton", {
Name = name,
Size = UDim2.fromScale(1, 1),
ZIndex = 50,
BackgroundTransparency = 0.04,
Theme = { BackgroundColor3 = "background" },
Parent = window.body,
})
Create.corner(12, veil)
local card = Create.new("Frame", {
Name = "Card",
Size = UDim2.new(1, -48, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.5),
ZIndex = 51,
Parent = veil,
})
Create.new("UISizeConstraint", { MaxSize = Vector2.new(320, math.huge), Parent = card })
Create.list(card, "Vertical", 10, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
return veil, card
end
local function line(card, text, size, role, weight, order)
return Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextXAlignment = Enum.TextXAlignment.Center,
Text = text or "",
TextSize = size,
Weight = weight,
LayoutOrder = order,
ZIndex = 52,
Theme = { TextColor3 = role },
Parent = card,
})
end
function Panels.loading(window, options)
options = options or {}
local scope = window.scope:child()
local veil, card = cover(window, "Loading")
veil.BackgroundTransparency = 0
scope:add(veil)
local icon = Create.icon(options.Icon or window.Icon or "layers", 32, "accent", card)
icon.ZIndex = 52
line(card, options.Title or window.Title, 16, "text", "bold", 1)
local status = line(card, options.Text or Strings.get("Getting ready"), 13, "textMuted", "regular", 2)
local rail = Create.new("Frame", { Name = "Rail", Size = UDim2.new(1, 0, 0, 4), LayoutOrder = 3, ZIndex = 52, Theme = { BackgroundColor3 = "raised" }, Parent = card })
Create.corner(-1, rail)
local fill = Create.new("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), ZIndex = 53, Theme = { BackgroundColor3 = "accent" }, Parent = rail })
Create.corner(-1, fill)
local loader = { done = false }
function loader.SetProgress(fraction, text)
fraction = math.clamp(tonumber(fraction) or 0, 0, 1)
Motion.tween(fill, "base", { Size = UDim2.fromScale(fraction, 1) })
if text then
status.Text = tostring(text)
end
end
function loader.Done()
if loader.done then
return
end
loader.done = true
loader.SetProgress(1)
Motion.tween(veil, "base", { BackgroundTransparency = 1 })
task.delay(if Motion.reduced then 0 else 0.25, function()
window.scope:release(scope)
end)
end
return loader
end
function Panels.changelog(window, options)
options = options or {}
local version = tostring(options.Version or window.options.Version or "")
if version == "" then
error("Changelog needs a Version", 3)
end
if window.changelogSeen == version and not options.Force then
return nil
end
local shell = Dialog.shell(window.library, { Width = 400, Dismissible = true })
Dialog.heading(shell.card, options.Title or Strings.get("What's new in {version}", { version = version }), options.Icon or "bell")
local list = Create.new("Frame", { Name = "Entries", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = shell.card })
Create.list(list, "Vertical", 8)
for index, entry in options.Entries or {} do
local kind, text = "New", entry
if type(entry) == "table" then
kind, text = entry.Kind or "New", entry.Text
end
local item = Create.new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = index, Parent = list })
Create.list(item, "Horizontal", 8, { VerticalAlignment = Enum.VerticalAlignment.Top })
local role = TAGS[kind] or "accent"
local tag = Create.new("TextLabel", {
Size = UDim2.fromOffset(88, 18),
Text = string.upper(kind),
TextSize = 12,
Weight = "bold",
TextXAlignment = Enum.TextXAlignment.Center,
BackgroundTransparency = 0.82,
Theme = { BackgroundColor3 = role, TextColor3 = role },
Parent = item,
})
Create.corner(4, tag)
Create.new("TextLabel", {
Size = UDim2.fromScale(0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 13,
LayoutOrder = 1,
Text = tostring(text or ""),
Theme = { TextColor3 = "text" },
Parent = item,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
end
local actions = Create.new("Frame", { Name = "Actions", Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 2, Parent = shell.card })
Create.list(actions, "Horizontal", 8, { HorizontalAlignment = Enum.HorizontalAlignment.Right })
local close = Dialog.button(shell.scope, actions, { Title = options.Button or Strings.get("Continue"), Variant = "Primary" })
shell.scope:connect(close.Activated, shell.Close)
window.changelogSeen = version
window:savePreferences()
return shell
end
function Panels.about(window, tab, options)
options = options or {}
local section = tab:Section({ Title = options.Title or Strings.get("About"), Icon = "info", Side = options.Side })
section:Paragraph({ Title = window.Title, Content = options.Description or window.Subtitle or "", Icon = window.Icon })
if window.options.Version then
section:Status({ Title = Strings.get("Version"), Status = tostring(window.options.Version), Kind = "info" })
end
for _, credit in options.Credits or {} do
section:Label({ Title = `<b>{credit.Name or ""}</b>  {credit.Role or ""}` })
end
local links = table.clone(options.Links or {})
if options.Discord then
table.insert(links, 1, { Title = Strings.get("Discord"), Url = options.Discord, Icon = "message-circle" })
end
for _, link in links do
section:Button({
Title = link.Title or Strings.get("Link"),
Description = tostring(link.Url),
TrailingIcon = "copy",
Callback = function()
local copied = Env.copy(tostring(link.Url))
window:Notify({
Title = if copied then Strings.get("Link copied") else Strings.get("Can't copy"),
Content = if copied then Strings.get("Paste it into your browser.") else tostring(link.Url),
Kind = if copied then "success" else "info",
Style = "Compact",
})
end,
})
end
return section
end
function Panels.state(tab, options)
options = options or {}
local scope = tab.scope:child()
local failed = options.Kind == "error"
local frame = Create.new("Frame", {
Name = "State",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 1,
Parent = tab.notices.Parent,
})
scope:add(frame)
Create.padding(frame, 24, 36)
Create.list(frame, "Vertical", 8, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
local disc = Create.new("Frame", {
Size = UDim2.fromOffset(52, 52),
BackgroundTransparency = 0.85,
Theme = { BackgroundColor3 = if failed then "danger" else "accent" },
Parent = frame,
})
Create.corner(-1, disc)
local glyph = Create.icon(options.Icon or (if failed then "circle-alert" else "box"), 24, if failed then "danger" else "accent", disc)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
local title = Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, 20),
Text = options.Title or (if failed then Strings.get("Something went wrong") else Strings.get("Nothing here yet")),
TextSize = 15,
Weight = "bold",
TextXAlignment = Enum.TextXAlignment.Center,
LayoutOrder = 1,
Theme = { TextColor3 = "text" },
Parent = frame,
})
local text = Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 13,
TextXAlignment = Enum.TextXAlignment.Center,
LayoutOrder = 2,
Text = options.Text or "",
Visible = options.Text ~= nil,
Theme = { TextColor3 = "textMuted" },
Parent = frame,
})
if options.Button then
local button = Dialog.button(scope, frame, { Title = options.Button.Title or Strings.get("Try again"), Variant = if failed then "Default" else "Primary", LayoutOrder = 3 })
scope:connect(button.Activated, function()
Env.call(options.Button.Title or "State", options.Button.Callback)
end)
end
local state = {}
function state.SetText(_, newTitle, newText)
title.Text = newTitle or title.Text
if newText then
text.Text, text.Visible = newText, true
end
end
function state.Destroy()
tab.scope:release(scope)
end
return state
end
function Panels.lock(window, options)
options = if type(options) == "string" then { Text = options } else options or {}
Panels.unlock(window)
local scope = window.scope:child()
local veil, card = cover(window, "LockScreen")
veil.BackgroundTransparency = 0
scope:add(veil)
local disc = Create.new("Frame", { Size = UDim2.fromOffset(56, 56), ZIndex = 52, BackgroundTransparency = 0.85, Theme = { BackgroundColor3 = "warning" }, Parent = card })
Create.corner(-1, disc)
local glyph = Create.icon(options.Icon or "wrench", 26, "warning", disc)
glyph.AnchorPoint, glyph.Position, glyph.ZIndex = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), 53
line(card, options.Title or Strings.get("Unavailable right now"), 16, "text", "bold", 1)
line(card, options.Text or "", 13, "textMuted", "regular", 2)
if options.Button then
local button = Dialog.button(scope, card, { Title = options.Button.Title or "OK", Variant = "Primary", LayoutOrder = 3 })
button.ZIndex = 52
scope:connect(button.Activated, function()
Env.call(options.Button.Title or "Lock", options.Button.Callback)
end)
end
window.lockScreen = scope
end
function Panels.unlock(window)
if window.lockScreen then
window.scope:release(window.lockScreen)
window.lockScreen = nil
end
end
return Panels
end
modules["Components/Personalise"] = function()
local Create = import("Core/Create")
local Env = import("Core/Env")
local Notifications = import("Components/Notifications")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local Tokens = import("Core/Tokens")
local Personalise = {}
Personalise.Fonts = { "Inter", "BuilderSans", "Gotham", "Montserrat", "Roboto", "SourceSans", "Ubuntu", "Nunito", "Arimo" }
local INTER = "rbxassetid://12187365364"
local POSITIONS = { "TopLeft", "TopCenter", "TopRight", "BottomLeft", "BottomCenter", "BottomRight" }
Personalise.Positions = POSITIONS
local function family(name)
if name == "Inter" then
return INTER
end
local ok, font = pcall(Font.fromName, name)
return if ok and font then font.Family else nil
end
local function each(window, callback)
for _, root in { window.gui, window.library.overlay and window.library.overlay.gui } do
if root then
for _, instance in root:GetDescendants() do
callback(instance)
end
end
end
end
local TEXT = { TextLabel = true, TextButton = true, TextBox = true }
function Personalise.apply(window, key, value)
local personal = window.personal
if key == "Font" then
local wanted = family(value)
if not wanted then
return false
end
local previous = Create.family
Create.setFamily(wanted)
each(window, function(instance)
if TEXT[instance.ClassName] and instance.FontFace.Family == previous then
instance.FontFace = Font.new(wanted, instance.FontFace.Weight, instance.FontFace.Style)
end
end)
elseif key == "TextSize" or key == "Radius" or key == "Density" then
local before = { text = Tokens.textScale }
if not table.find(Tokens[key], value) then
return false
end
Tokens.set({ [key] = value })
if key == "TextSize" then
local ratio = Tokens.textScale / before.text
each(window, function(instance)
if TEXT[instance.ClassName] then
instance.TextSize = math.round(instance.TextSize * ratio)
end
end)
elseif key == "Radius" then
each(window, function(instance)
local base = instance:GetAttribute("HalcyonRadius")
if base and instance:IsA("UICorner") then
local radius = Tokens.corner(base)
instance.CornerRadius = if radius < 0 then UDim.new(1, 0) else UDim.new(0, radius)
end
end)
else
each(window, function(instance)
local part = instance:GetAttribute("HalcyonDensity")
if part == "padding" then
instance.PaddingTop = UDim.new(0, Tokens.density.rowPadding)
instance.PaddingBottom = instance.PaddingTop
elseif part == "height" then
instance.MinSize = Vector2.new(0, Tokens.rowHeight())
end
end)
end
elseif key == "Transparency" then
window:SetTransparency(value)
elseif key == "NoticePosition" then
if not table.find(POSITIONS, value) then
return false
end
Notifications.configure(window.library, { Position = value })
elseif key == "AccentGradient" then
Theme.setGradient(value == true)
elseif key == "SafeStatus" then
Theme.setSafeStatus(value == true)
else
return false
end
personal[key] = value
return true
end
function Personalise.set(window, key, value)
local ok = Personalise.apply(window, key, value)
if ok then
window:savePreferences()
local row = window.personalRows and window.personalRows[key]
local shown = if key == "Transparency" then math.round((tonumber(value) or 0) * 100) else value
if row and row:Get() ~= shown then
row:Set(shown)
end
end
return ok
end
function Personalise.restore(window, saved, early)
if type(saved) ~= "table" then
return
end
for _, key in if early then { "TextSize", "Radius", "Density" } else { "Font", "Transparency", "NoticePosition", "AccentGradient", "SafeStatus" } do
if saved[key] ~= nil then
if early then
if table.find(Tokens[key], saved[key]) then
Tokens.set({ [key] = saved[key] })
window.personal[key] = saved[key]
end
else
Personalise.apply(window, key, saved[key])
end
end
end
end
function Personalise.encodeTheme(palette)
local plain = { Name = palette.Name }
for _, role in Theme.Roles do
plain[role] = palette[role]:ToHex()
end
return plain
end
function Personalise.decodeTheme(plain)
if type(plain) ~= "table" or type(plain.Name) ~= "string" then
return nil, Strings.get("That is not a theme.")
end
local palette = { Name = string.sub(plain.Name, 1, 32) }
for _, role in Theme.Roles do
local hex = plain[role]
if type(hex) ~= "string" or not string.match(hex, "^#?%x%x%x%x%x%x$") then
return nil, Strings.get('The theme is missing a valid "{role}" colour.', { role = role })
end
palette[role] = Color3.fromHex(hex)
end
return palette, nil
end
function Personalise.saveTheme(window, palette)
local ok, message = Theme.add(palette)
if not ok then
return false, message
end
window.customThemes[palette.Name] = Personalise.encodeTheme(Theme.palettes[palette.Name])
window:savePreferences()
return true, message
end
function Personalise.exportTheme(name)
local palette = Theme.palettes[name]
if not palette then
return nil
end
local ok, text = Env.encode(Personalise.encodeTheme(palette))
return if ok then text else nil
end
function Personalise.importTheme(window, text)
local ok, plain = Env.decode(tostring(text or ""))
if not ok then
return false, Strings.get("That text is not a theme.")
end
local palette, problem = Personalise.decodeTheme(plain)
if not palette then
return false, problem
end
return Personalise.saveTheme(window, palette)
end
function Personalise.section(window, tab, options)
options = options or {}
local personal = window.personal
local section = tab:Section({ Title = options.Title or Strings.get("Personalise"), Icon = "paintbrush", Side = options.Side })
window.personalRows = window.personalRows or {}
local rows = window.personalRows
if options.Font ~= false then
rows.Font = section:Dropdown({
Title = Strings.get("Font"),
Values = Personalise.Fonts,
Default = personal.Font or "Inter",
Callback = function(name)
Personalise.set(window, "Font", name)
end,
})
end
if options.TextSize ~= false then
rows.TextSize = section:Segmented({
Title = Strings.get("Text size"),
Values = Tokens.TextSize,
Default = Tokens.names.text,
Callback = function(name)
Personalise.set(window, "TextSize", name)
end,
})
end
if options.Corners ~= false then
rows.Radius = section:Segmented({
Title = Strings.get("Corners"),
Values = Tokens.Radius,
Default = Tokens.names.radius,
Callback = function(name)
Personalise.set(window, "Radius", name)
end,
})
end
if options.Density ~= false then
rows.Density = section:Segmented({
Title = Strings.get("Spacing"),
Values = Tokens.Density,
Default = Tokens.names.density,
Callback = function(name)
Personalise.set(window, "Density", name)
end,
})
end
if options.Transparency ~= false then
rows.Transparency = section:Slider({
Title = Strings.get("See-through window"),
Min = 0,
Max = 60,
Step = 5,
Suffix = "%",
Default = math.round((window.transparency or 0) * 100),
Callback = function(percent)
Personalise.set(window, "Transparency", percent / 100)
end,
})
end
if options.NoticePosition ~= false then
rows.NoticePosition = section:Dropdown({
Title = Strings.get("Notice position"),
Values = POSITIONS,
Default = personal.NoticePosition or Notifications.Defaults.Position,
Callback = function(position)
Personalise.set(window, "NoticePosition", position)
end,
})
end
if options.AccentGradient ~= false then
rows.AccentGradient = section:Toggle({
Title = Strings.get("Gradient accent"),
Default = personal.AccentGradient == true,
Callback = function(on)
Personalise.set(window, "AccentGradient", on)
end,
})
end
if options.SafeStatus ~= false then
rows.SafeStatus = section:Toggle({
Title = Strings.get("Colour-blind friendly"),
Default = personal.SafeStatus == true,
Callback = function(on)
Personalise.set(window, "SafeStatus", on)
end,
})
end
return section
end
function Personalise.builder(window, tab, options)
options = options or {}
local section = tab:Section({ Title = options.Title or Strings.get("Theme builder"), Icon = "palette", Side = options.Side })
local draft = table.clone(Theme.current)
draft.Name = "Custom"
local role = "accent"
local function preview()
local ok = Theme.add(draft)
if ok then
Theme.set(draft.Name)
end
end
local picker
section:Dropdown({
Title = Strings.get("Colour"),
Values = Theme.Roles,
Default = role,
Callback = function(name)
role = name
picker:Set(draft[role])
end,
})
picker = section:ColorPicker({
Title = Strings.get("Value"),
Default = draft[role],
Palette = true,
Callback = function(color)
draft[role] = color
preview()
end,
})
local name = section:Input({ Title = Strings.get("Name"), Placeholder = Strings.get("My theme"), MaxLength = 32 })
local status = section:Label({ Title = "", Visible = false })
local setStatus = status.SetTitle
function status.SetTitle(target, text)
setStatus(target, text)
target:SetVisible(text ~= "")
end
section:Buttons({
Buttons = {
{
Title = Strings.get("Save"),
Icon = "save",
Callback = function()
local chosen = name:Get()
if chosen == "" then
status:SetTitle(Strings.get("Give the theme a name first."))
return
end
local saving = table.clone(draft)
saving.Name = chosen
local ok, message = Personalise.saveTheme(window, saving)
if ok then
Theme.set(chosen)
end
status:SetTitle(if ok then message or Strings.get('Saved "{name}".', { name = chosen }) else message)
end,
},
{
Title = Strings.get("Copy"),
Icon = "copy",
Variant = "Outline",
Callback = function()
local text = Personalise.exportTheme(Theme.current.Name)
local copied = text ~= nil and Env.copy(text)
status:SetTitle(if copied then Strings.get("Copied. Paste it into Import to share.") else Strings.get("This executor can't copy text."))
end,
},
},
})
section:Input({
Title = Strings.get("Import"),
Placeholder = Strings.get("Paste a theme"),
Callback = function(text)
if text == "" then
return
end
local ok, message = Personalise.importTheme(window, text)
status:SetTitle(if ok then "Imported." else message)
end,
})
return section
end
function Personalise.loadThemes(window, saved)
for _, plain in if type(saved) == "table" then saved else {} do
local palette = Personalise.decodeTheme(plain)
if palette and Theme.add(palette) then
window.customThemes[palette.Name] = plain
end
end
end
return Personalise
end
modules["Components/PopOut"] = function()
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Mount = import("Core/Mount")
local Resize = import("Core/Resize")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local PopOut = {}
PopOut.RADIUS = 12
local MIN_SIZE = Vector2.new(240, 140)
local DEFAULT_SIZE = Vector2.new(320, 300)
local BAR = 36
local function layer(library)
local overlay = Mount.overlay(library)
if not overlay.popOuts then
overlay.popOuts = Create.new("Frame", { Name = "PopOuts", Size = UDim2.fromScale(1, 1), ZIndex = 0, Parent = overlay.gui })
end
return overlay.popOuts
end
function PopOut.key(section)
return `{if section.tab then section.tab.Title else ""}/{section.Title or ""}`
end
function PopOut.open(section)
if section.popped then
return
end
local window, library = section.window, section.library
local saved = window.popOutState[PopOut.key(section)] or {}
local scope = section.scope:child()
local view = Mount.overlay(library).gui.AbsoluteSize
local size = Vector2.new(tonumber(saved.w) or DEFAULT_SIZE.X, tonumber(saved.h) or DEFAULT_SIZE.Y)
local corner = if saved.x and saved.y then Vector2.new(saved.x, saved.y) else Vector2.new(view.X - size.X * window.scale - 24, (view.Y - size.Y * window.scale) / 2)
local panel = Create.new("Frame", {
Name = "PopOut",
Size = UDim2.fromOffset(size.X, size.Y),
Position = UDim2.fromOffset(math.round(corner.X), math.round(corner.Y)),
Theme = { BackgroundColor3 = "surface" },
Parent = layer(library),
})
scope:add(panel)
Create.corner(PopOut.RADIUS, panel)
Create.stroke("stroke", panel)
Create.new("UIScale", { Scale = window.scale, Parent = panel })
local bar = Create.new("Frame", { Name = "TitleBar", Size = UDim2.new(1, 0, 0, BAR), Parent = panel })
Create.padding(bar, 12, 0, 6, 0)
Create.list(bar, "Horizontal", 8, { VerticalAlignment = Enum.VerticalAlignment.Center })
if section.options.Icon then
Create.icon(section.options.Icon, 14, "textMuted", bar)
end
Create.new("TextLabel", {
Name = "Title",
Size = UDim2.fromScale(0, 1),
TextSize = 13,
Weight = "bold",
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 1,
Text = section.Title or "",
Theme = { TextColor3 = "text" },
Parent = bar,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
local dock = Create.new("TextButton", { Name = "Dock", Size = UDim2.fromOffset(26, 26), LayoutOrder = 2, Parent = bar })
Create.corner(6, dock)
local dockIcon = Create.icon("minimize-2", 14, "textMuted", dock)
dockIcon.AnchorPoint, dockIcon.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
scope:connect(dock.MouseEnter, function()
Theme.bind(dockIcon, "ImageColor3", "text")
end)
scope:connect(dock.MouseLeave, function()
Theme.bind(dockIcon, "ImageColor3", "textMuted")
end)
scope:connect(dock.Activated, function()
PopOut.close(section)
end)
Create.new("Frame", {
Name = "Seam",
Size = UDim2.new(1, 0, 0, 1),
Position = UDim2.fromOffset(0, BAR),
Theme = { BackgroundColor3 = "stroke" },
Parent = panel,
})
local content = Create.new("ScrollingFrame", {
Name = "Content",
Size = UDim2.new(1, 0, 1, -BAR - 1),
Position = UDim2.fromOffset(0, BAR + 1),
AutomaticCanvasSize = Enum.AutomaticSize.Y,
CanvasSize = UDim2.new(),
ScrollBarThickness = 3,
ScrollingDirection = Enum.ScrollingDirection.Y,
Theme = { ScrollBarImageColor3 = "textMuted" },
Parent = panel,
})
Create.padding(content, 4, 4, 6, 8)
local body = section.body
section.homeOfBody = body.Parent
body.Parent = content
local placeholder = Create.new("Frame", {
Name = "PoppedOut",
Size = UDim2.new(1, 0, 0, 44),
LayoutOrder = 1,
Parent = section.root,
})
scope:add(placeholder)
Create.padding(placeholder, 14, 0)
Create.list(placeholder, "Horizontal", 10, { VerticalAlignment = Enum.VerticalAlignment.Center })
Create.new("TextLabel", {
Name = "Note",
Size = UDim2.fromScale(0, 1),
TextSize = 12,
Text = Strings.get("Open in its own window"),
Theme = { TextColor3 = "textMuted" },
Parent = placeholder,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
local back = Create.new("TextButton", {
Name = "BringBack",
Size = UDim2.fromOffset(0, 28),
AutomaticSize = Enum.AutomaticSize.X,
Text = Strings.get("Bring back"),
TextSize = 12,
Weight = "medium",
LayoutOrder = 1,
Theme = { BackgroundColor3 = "raised", TextColor3 = "text" },
Parent = placeholder,
})
Create.corner(6, back)
Create.padding(back, 10, 0)
scope:connect(back.Activated, function()
PopOut.close(section)
end)
local function remember()
local position = panel.Position
window.popOutState[PopOut.key(section)] = {
open = section.popped == true,
x = position.X.Offset,
y = position.Y.Offset,
w = panel.Size.X.Offset,
h = panel.Size.Y.Offset,
}
window:savePreferences()
end
Drag.move(scope, bar, panel, { onMoved = remember })
local grip = Create.new("TextButton", {
Name = "Resize",
Text = "",
Size = UDim2.fromOffset(18, 18),
AnchorPoint = Vector2.new(1, 1),
Position = UDim2.new(1, -2, 1, -2),
ZIndex = 10,
Parent = panel,
})
for _, offset in { Vector2.new(12, 12), Vector2.new(7, 12), Vector2.new(12, 7) } do
Create.new("Frame", {
Size = UDim2.fromOffset(2, 2),
Position = UDim2.fromOffset(offset.X, offset.Y),
ZIndex = 10,
Theme = { BackgroundColor3 = "textMuted" },
Parent = grip,
})
end
Resize.grip(scope, grip, function()
local room = Mount.overlay(library).gui.AbsoluteSize - Vector2.new(panel.Position.X.Offset, panel.Position.Y.Offset) - Vector2.new(8, 8)
return {
size = Vector2.new(panel.Size.X.Offset, panel.Size.Y.Offset),
scale = window.scale,
min = MIN_SIZE,
max = room / window.scale,
}
end, function(newSize)
panel.Size = UDim2.fromOffset(newSize.X, newSize.Y)
end, remember)
section.popped = true
section.popScope = scope
section.panel = panel
section:placeBackground()
if section.popButton then
Theme.bind(section.popButton, "ImageColor3", "accent")
end
remember()
window.SectionPopped:Fire(section, true)
end
function PopOut.close(section)
if not section.popped then
return
end
local window = section.window
section.popped = false
section.body.Parent = section.homeOfBody or section.root
section.panel = nil
section:placeBackground()
if section.popButton then
Theme.bind(section.popButton, "ImageColor3", "textMuted")
end
local state = window.popOutState[PopOut.key(section)]
if state then
state.open = false
window:savePreferences()
end
section.scope:release(section.popScope)
section.popScope = nil
window.SectionPopped:Fire(section, false)
end
function PopOut.attach(section)
local header = section.header
if not header then
return
end
local holder = Create.new("TextButton", { Name = "PopOutButton", Size = UDim2.fromOffset(22, 22), LayoutOrder = 3, Parent = header })
Create.corner(6, holder)
local icon = Create.icon("external-link", 14, "textMuted", holder)
icon.AnchorPoint, icon.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
section.popButton = icon
section.scope:connect(holder.Activated, function()
if section.popped then
PopOut.close(section)
else
PopOut.open(section)
end
end)
local saved = section.window.popOutState[PopOut.key(section)]
if saved and saved.open then
task.defer(function()
if not section.scope.cleaned then
PopOut.open(section)
end
end)
end
end
return PopOut
end
modules["Components/Popup"] = function()
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Mount = import("Core/Mount")
local MARGIN, GAP = 8, 6
local Popup = {}
local function contains(instance: GuiObject, position: Vector3): boolean
local origin, size = instance.AbsolutePosition, instance.AbsoluteSize
return position.X >= origin.X and position.X <= origin.X + size.X and position.Y >= origin.Y and position.Y <= origin.Y + size.Y
end
function Popup.close(library)
if library.popup then
library.popup.close()
end
end
function Popup.toggle(library, anchor, options)
local open = library.popup
Popup.close(library)
if open and open.anchor == anchor then
return nil
end
local overlay = Mount.overlay(library)
local scope = library.scope:child()
local width = options.Width or math.max(anchor.AbsoluteSize.X / library.scale, 180)
local holder = Create.new("Frame", { Name = "Popup", Parent = overlay.popups })
local panel = Create.new("Frame", {
Name = "Panel",
Size = UDim2.fromOffset(width, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Active = true,
Theme = { BackgroundColor3 = "surface" },
Parent = holder,
})
Create.corner(10, panel)
Create.stroke("stroke", panel)
Create.padding(panel, 6)
Create.list(panel, "Vertical", 4)
Create.new("UIScale", { Scale = library.scale, Parent = panel })
scope:add(holder)
local popup = { anchor = anchor, frame = panel, scope = scope }
local function place()
local view, origin = overlay.gui.AbsoluteSize, overlay.gui.AbsolutePosition
local size = Vector2.new(width * library.scale, panel.AbsoluteSize.Y)
local corner, extent = anchor.AbsolutePosition - origin, anchor.AbsoluteSize
local x = corner.X + extent.X - size.X
local y = corner.Y + extent.Y + GAP
if y + size.Y > view.Y - MARGIN then
y = corner.Y - size.Y - GAP
end
holder.Position = UDim2.fromOffset(
math.clamp(x, MARGIN, math.max(view.X - size.X - MARGIN, MARGIN)),
math.clamp(y, MARGIN, math.max(view.Y - size.Y - MARGIN, MARGIN))
)
end
function popup.close()
if library.popup ~= popup then
return
end
library.popup = nil
library.scope:release(scope)
if options.OnClose then
options.OnClose()
end
end
scope:connect(panel:GetPropertyChangedSignal("AbsoluteSize"), place)
scope:connect(anchor:GetPropertyChangedSignal("AbsolutePosition"), popup.close)
local view = overlay.gui.AbsoluteSize
scope:connect(overlay.gui:GetPropertyChangedSignal("AbsoluteSize"), function()
local size = overlay.gui.AbsoluteSize
if view.X > 0 and size ~= view then
popup.close()
else
view = size
place()
end
end)
scope:connect(anchor.Destroying, popup.close)
scope:connect(UserInputService.InputBegan, function(input)
local kind = input.UserInputType
if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
return
end
if not contains(panel, input.Position) and not contains(anchor, input.Position) then
popup.close()
end
end)
library.popup = popup
place()
panel.Position = UDim2.fromOffset(0, -6)
Motion.tween(panel, "base", { Position = UDim2.fromOffset(0, 0) })
return popup
end
return Popup
end
modules["Components/Profile"] = function()
local Players = game:GetService("Players")
local Create = import("Core/Create")
local DiscordButton = import("Components/DiscordButton")
local Env = import("Core/Env")
local Popup = import("Components/Popup")
local Strings = import("Core/Strings")
local DEFAULTS = {
Enabled = true,
Avatar = "Headshot",
Anonymous = false,
ShowUsername = true,
ShowTier = true,
ShowExecutor = true,
ShowClock = true,
ShowDate = false,
ClockFormat = "%H:%M",
DateFormat = "%d %b %Y",
}
local Profile = {}
function Profile.settings(options)
local settings = table.clone(DEFAULTS)
if options == false then
settings.Enabled = false
elseif type(options) == "table" then
for key, value in options do
settings[key] = value
end
end
return settings
end
local function formatted(pattern)
local ok, text = pcall(os.date, pattern)
return if ok and type(text) == "string" then text else ""
end
function Profile.meta(settings)
local parts = {}
if settings.ShowExecutor then
table.insert(parts, (Env.executor()))
end
if settings.ShowDate then
table.insert(parts, formatted(settings.DateFormat))
end
if settings.ShowClock then
table.insert(parts, formatted(settings.ClockFormat))
end
return table.concat(parts, " · ")
end
function Profile.names(settings)
if settings.Anonymous then
return Strings.get("Anonymous"), Strings.get("Identity hidden")
end
local player = Players.LocalPlayer
return settings.Name or player.DisplayName, settings.Subtitle or ("@" .. player.Name)
end
local function stage(view)
local character = Players.LocalPlayer.Character
local head = character and character:FindFirstChild("Head")
if not head then
return false
end
local archivable = character.Archivable
character.Archivable = true
local ok, copy = pcall(character.Clone, character)
character.Archivable = archivable
if not ok or not copy then
return false
end
for _, descendant in copy:GetDescendants() do
if descendant:IsA("BaseScript") or descendant:IsA("Sound") then
descendant:Destroy()
end
end
local world = Instance.new("WorldModel")
copy.Parent = world
world.Parent = view
local focus = head.Position
local camera = Instance.new("Camera")
camera.FieldOfView = 40
camera.CFrame = CFrame.lookAt(focus + head.CFrame.LookVector * 2.4 + Vector3.new(0, 0.15, 0), focus)
camera.Parent = view
view.CurrentCamera = camera
return true
end
local function avatar(window, scope, parent, size)
local settings = window.profile
local holder = Create.new("Frame", {
Name = "Avatar",
Size = UDim2.fromOffset(size, size),
Theme = { BackgroundColor3 = "raised" },
Parent = parent,
})
Create.corner(-1, holder)
if settings.Anonymous or settings.Avatar == "None" then
local glyph = Create.icon("user", math.floor(size / 2), "textMuted", holder)
glyph.AnchorPoint = Vector2.new(0.5, 0.5)
glyph.Position = UDim2.fromScale(0.5, 0.5)
return holder
end
if settings.Avatar == "Viewport" then
local view = Create.new("ViewportFrame", { Size = UDim2.fromScale(1, 1), Parent = holder })
Create.corner(-1, view)
if stage(view) then
return holder
end
view:Destroy()
end
local picture = Create.new("ImageLabel", { Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Crop, Parent = holder })
Create.corner(-1, picture)
task.spawn(function()
local ok, content = pcall(Players.GetUserThumbnailAsync, Players, Players.LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
if ok and not scope.cleaned then
picture.Image = content
end
end)
return holder
end
local function line(parent, text, order, size, weight, role)
return Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, size + 3),
Text = text,
TextSize = size,
Weight = weight,
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = order,
Visible = text ~= "",
Theme = { TextColor3 = role },
Parent = parent,
})
end
function Profile.card(window, scope, parent)
local settings = window.profile
local card = Create.new("Frame", {
Name = "Profile",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Parent = parent,
})
Create.padding(card, 12, 10)
Create.list(card, "Horizontal", 10)
avatar(window, scope, card, 36)
local text = Create.new("Frame", { Name = "Text", AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.list(text, "Vertical", 0)
local name, username = Profile.names(settings)
local heading = Create.new("Frame", { Name = "Heading", Size = UDim2.new(1, 0, 0, 18), Parent = text })
Create.list(heading, "Horizontal", 6)
Create.new("TextLabel", {
Name = "Name",
Size = UDim2.fromScale(0, 1),
Text = name,
TextSize = 13,
Weight = "bold",
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = "text" },
Parent = heading,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
line(text, if settings.ShowUsername then username else "", 1, 12, "regular", "textMuted")
local discord = DiscordButton.settings(settings.Discord)
local tierLine
if settings.ShowTier or discord then
tierLine = Create.new("Frame", { Name = "TierLine", Size = UDim2.new(1, 0, 0, if discord then 28 else 20), LayoutOrder = 4, Parent = text })
Create.padding(tierLine, 0, 3, 0, 0)
Create.list(tierLine, "Horizontal", 6)
end
if settings.ShowTier then
local paid = window:IsPaid()
local access = window.access
local icon = access.Icon or (if paid then "crown" elseif access.Keyless or access.NoKey then "lock-open" else "key")
local badge = Create.new("Frame", {
Name = "TierBadge",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
LayoutOrder = 1,
Theme = { BackgroundColor3 = if paid then "accent" else "raised" },
Parent = tierLine,
})
Create.corner(5, badge)
Create.padding(badge, 6, 0)
Create.list(badge, "Horizontal", 4)
Create.icon(icon, 11, if paid then "onAccent" else "textMuted", badge)
Create.new("TextLabel", {
Name = "Tier",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = window:GetTier(),
TextSize = 11,
Weight = "medium",
LayoutOrder = 1,
Theme = { TextColor3 = if paid then "onAccent" else "textMuted" },
Parent = badge,
})
end
local meta = line(text, Profile.meta(settings), 2, 12, "regular", "textMuted")
if discord then
DiscordButton.new(scope, tierLine, { Link = discord.Link, Icon = discord.Icon, Size = 24, LayoutOrder = 3 }, function(how, link)
window:Notify({
Title = if how == "opened" then Strings.get("Opened in Discord") elseif how == "copied" then Strings.get("Discord invite copied") else Strings.get("Discord invite"),
Content = if how == "opened" then Strings.get("Accept the invite in the Discord app.") elseif how == "copied" then Strings.get("Paste it into your browser to join.") else link,
Kind = if how then "success" else "info",
Style = "Compact",
Duration = if how then 3 else 8,
})
end)
end
local expiry
if window.access.ExpiresAt and window.access.ShowExpiry then
expiry = line(text, "", 3, 12, "medium", "warning")
expiry.Name = "Expiry"
end
local function countdown()
if expiry then
local left = window:GetKeyExpiry()
expiry.Text = if left > 0 then Strings.get("Key expires in {time}", { time = Env.duration(left) }) else Strings.get("Key expired")
expiry.Visible = true
end
end
countdown()
if settings.ShowClock or expiry then
window:everySecond(scope, function()
meta.Text = Profile.meta(settings)
countdown()
end)
end
return card
end
function Profile.chip(window, scope, parent)
local chip = Create.new("TextButton", { Name = "ProfileChip", Size = UDim2.fromOffset(44, 44), Parent = parent })
local picture = avatar(window, scope, chip, 28)
picture.AnchorPoint = Vector2.new(0.5, 0.5)
picture.Position = UDim2.fromScale(0.5, 0.5)
scope:connect(chip.Activated, function()
local popup = Popup.toggle(window.library, chip, { Width = 230 })
if popup then
Profile.card(window, popup.scope, popup.frame)
end
end)
return chip
end
return Profile
end
modules["Components/QuickBar"] = function()
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Env = import("Core/Env")
local Theme = import("Core/Theme")
local QuickBar = {}
function QuickBar.new(window, options)
options = options or {}
local scope = window.scope:child()
local touch = window.library.touch
local size = if touch then 44 else 36
local bar = Create.new("Frame", {
Name = "QuickBar",
Size = UDim2.fromOffset(0, size + 12),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(0.5, 1),
Position = options.Position or UDim2.new(0.5, 0, 1, -16),
Active = true,
Theme = { BackgroundColor3 = "surface" },
Parent = window.gui,
})
scope:add(bar)
Create.corner(-1, bar)
Create.stroke("stroke", bar)
Create.padding(bar, 6, 6)
Create.list(bar, "Horizontal", 4, { VerticalAlignment = Enum.VerticalAlignment.Center })
Create.new("UIScale", { Scale = window.scale, Parent = bar })
local grip = Create.new("Frame", { Name = "Grip", Size = UDim2.fromOffset(18, size), Parent = bar })
local dots = Create.icon("grip-vertical", 14, "textMuted", grip)
dots.AnchorPoint, dots.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
Drag.move(scope, grip, bar, {})
local handle = { Frame = bar, scope = scope }
local order = 0
local function button(icon, title)
order += 1
local press = Create.new("TextButton", {
Name = title or "Item",
Size = UDim2.fromOffset(0, size),
AutomaticSize = Enum.AutomaticSize.X,
LayoutOrder = order,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "accent" },
Parent = bar,
})
Create.corner(-1, press)
Create.padding(press, 10, 0)
Create.list(press, "Horizontal", 6, { VerticalAlignment = Enum.VerticalAlignment.Center })
local glyph = Create.icon(icon or "circle", 16, "textMuted", press)
local label = Create.new("TextLabel", {
Name = "Title",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = title or "",
TextSize = 12,
Weight = "medium",
LayoutOrder = 1,
Visible = (title or "") ~= "",
Theme = { TextColor3 = "text" },
Parent = press,
})
return press, glyph, label
end
function handle:Add(item)
local target = if type(item) == "string" then window.Flags[item] else item
if type(target) == "table" and target.Get and target.Set and target.Changed then
local press, glyph, label = button(target.QuickIcon or target.Icon or "zap", target.Title)
local function paint()
local on = target:Get() == true
press.BackgroundTransparency = if on then 0 else 1
Theme.bind(glyph, "ImageColor3", if on then "onAccent" else "textMuted")
Theme.bind(label, "TextColor3", if on then "onAccent" else "text")
end
scope:connect(press.Activated, function()
target:Set(not (target:Get() == true))
end)
scope:connect(target.Changed, paint)
paint()
return press
elseif type(item) == "table" then
local press = button(item.Icon, item.Title)
scope:connect(press.Activated, function()
Env.call(item.Title or "Quick bar", item.Callback)
end)
return press
end
warn(`[Halcyon] QuickBar couldn't use {tostring(item)}: give a toggle, its Flag, or a table with a Callback.`)
return nil
end
function handle:SetVisible(visible)
bar.Visible = visible ~= false
end
function handle:Destroy()
window.scope:release(scope)
end
for _, item in options.Items or {} do
handle:Add(item)
end
return handle
end
return QuickBar
end
modules["Components/SearchFocus"] = function()
local TweenService = game:GetService("TweenService")
local Arc = import("Core/Arc")
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local SearchFocus = {}
local SWEEP_TIME, HOLD, FADE_TIME = 0.55, 1.3, 0.45
local SWEEP = TweenInfo.new(SWEEP_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local FADE = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
function SearchFocus.reveal(window, tab, handle)
local frame = handle and handle.Frame
if not frame then
return
end
task.delay(0.05, function()
local page = tab.page
if not frame.Parent or not page.Parent then
return
end
local scale = window.scale
local top = (frame.AbsolutePosition.Y - page.AbsolutePosition.Y) / scale + page.CanvasPosition.Y
local wanted = Vector2.new(0, math.max(top - 24, 0))
if Motion.reduced then
page.CanvasPosition = wanted
else
TweenService:Create(page, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { CanvasPosition = wanted }):Play()
end
if window.searchSpot then
window.searchSpot:Destroy()
end
local left = (frame.AbsolutePosition.X - page.AbsolutePosition.X) / scale
local size = frame.AbsoluteSize / scale
local spot = Create.new("Frame", {
Name = "SearchSpot",
Size = UDim2.fromOffset(size.X, size.Y),
Position = UDim2.fromOffset(left, top),
BackgroundTransparency = 1,
ZIndex = 8,
Theme = { BackgroundColor3 = "accent" },
Parent = page,
})
window.searchSpot = spot
Create.corner(8, spot)
local glow = Create.new("UIStroke", { Thickness = 4, Transparency = 1, Theme = { Color = "accent" }, Parent = spot })
local arc = Arc.new(spot, { Thickness = 2, Role = "accent", Radius = 8, ZIndex = 9 })
if Motion.reduced then
arc:Set(1)
glow.Transparency = 0.7
task.delay(HOLD, function()
spot:Destroy()
end)
return
end
arc:Set(0)
local progress = Instance.new("NumberValue")
progress.Parent = spot
progress:GetPropertyChangedSignal("Value"):Connect(function()
arc:Set(progress.Value)
end)
TweenService:Create(progress, SWEEP, { Value = 1 }):Play()
TweenService:Create(glow, SWEEP, { Transparency = 0.72 }):Play()
TweenService:Create(spot, SWEEP, { BackgroundTransparency = 0.9 }):Play()
task.delay(SWEEP_TIME + HOLD, function()
if not spot.Parent then
return
end
TweenService:Create(glow, FADE, { Transparency = 1 }):Play()
TweenService:Create(spot, FADE, { BackgroundTransparency = 1 }):Play()
for _, stroke in arc.strokes do
TweenService:Create(stroke, FADE, { Transparency = 1 }):Play()
end
task.delay(FADE_TIME, function()
spot:Destroy()
if window.searchSpot == spot then
window.searchSpot = nil
end
end)
end)
end)
end
return SearchFocus
end
modules["Components/Section"] = function()
local Create = import("Core/Create")
local Effects = import("Core/Effects")
local Env = import("Core/Env")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Registry = import("Elements/Registry")
local Row = import("Elements/Row")
local Signal = import("Core/Signal")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
local Tokens = import("Core/Tokens")
local PopOut = import("Components/PopOut")
local Background = import("Core/Background")
local CARD_RADIUS = 10
local PANEL_RADIUS = PopOut.RADIUS
Styles.register("Section", "Card", { fill = "card", stroke = "stroke", surface = "card" })
Styles.register("Section", "Outlined", { stroke = "stroke", surface = "background" })
Styles.register("Section", "Flat", { flat = true, surface = "background" })
Styles.register("Section", "Glass", { fill = "card", fillTransparency = 0.35, stroke = "text", strokeTransparency = 0.88, surface = "card" })
Styles.register("Section", "Accent", { fill = "card", stroke = "stroke", surface = "card", edge = "accent" })
Styles.register("Section", "Inset", { fill = "background", stroke = "stroke", surface = "background" })
Styles.register("Section", "Header", { fill = "card", stroke = "stroke", surface = "card", band = "raised" })
Styles.register("Section", "Panel", { fill = "card", stroke = "stroke", surface = "card", rows = "background" })
local Section = {}
Section.__index = function(_, key)
local method = rawget(Section, key)
if method ~= nil then
return method
end
return if Registry.KindSet[key] then Registry.method(key) else nil
end
function Section.new(tab, options)
options = options or {}
local window = tab.window
local look = Styles.pick("Section", options.Style or tab.sectionStyle, window)
local flat = look.flat == true
local self = setmetatable({
library = tab.library,
window = window,
tab = tab,
scope = tab.scope:child(),
entries = tab.entries,
order = 0,
tier = options.Tier or (options.PaidOnly and true) or tab.tier,
lockText = options.LockText or tab.lockText,
lockHint = options.LockHint or tab.lockHint,
rowFill = flat or look.rows ~= nil,
rowRole = look.rows,
surface = look.surface or "card",
side = if options.Side == "Right" then "Right" else "Left",
Title = options.Title,
Hidden = false,
collapsed = options.Collapsed == true,
searching = false,
}, Section)
self.section = self
self.options = options
self.searchTitle = if options.Title then string.lower(options.Title) else nil
local root = Create.new("Frame", {
Name = "Section",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = tab:nextOrder(),
BackgroundTransparency = if look.fill then look.fillTransparency or 0 else 1,
Theme = { BackgroundColor3 = look.fill or "card" },
Parent = tab.left,
})
self.scope:add(root)
self.root = root
self.look = look
self.fillTransparency = root.BackgroundTransparency
self:applySeeThrough()
if not flat then
Create.corner(10, root)
if look.stroke then
local stroke = Create.stroke(look.stroke, root)
stroke.Transparency = look.strokeTransparency or 0
end
end
Create.list(root, "Vertical", 0)
if options.Title then
local collapsible = options.Collapsible ~= false
local holder = root
if look.band then
holder = Create.new("Frame", { Name = "Band", Size = UDim2.new(1, 0, 0, 40), Theme = { BackgroundColor3 = look.band }, Parent = root })
Create.corner(10, holder)
self.bandFill = Create.new("Frame", {
Name = "Square",
Size = UDim2.new(1, 0, 0, 10),
Position = UDim2.new(0, 0, 1, -10),
Theme = { BackgroundColor3 = look.band },
Parent = holder,
})
end
local header = Create.new(if collapsible then "TextButton" else "Frame", {
Name = "Header",
Size = UDim2.new(1, 0, 0, if flat then 32 else 40),
ZIndex = 2,
Parent = holder,
})
Create.padding(header, if flat then 4 else 14, 0)
Create.list(header, "Horizontal", 8)
if options.Icon then
local icon = Create.icon(options.Icon, 16, "textMuted", header)
Theme.paint(icon, "ImageColor3", options.IconColor)
end
self.label = Create.new("TextLabel", {
Name = "Title",
Size = UDim2.fromScale(0, 1),
TextSize = 13,
Weight = "bold",
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 1,
Text = options.Title,
Theme = { TextColor3 = "text" },
Parent = header,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
self.header = header
if options.Badge ~= nil then
self:SetBadge(options.Badge)
end
if type(options.Switch) == "table" then
self:buildSwitch(header, options.Switch)
end
if collapsible then
local holder = Create.new("Frame", { Name = "Arrow", Size = UDim2.fromOffset(14, 14), LayoutOrder = 4, Parent = header })
self.chevron = Create.icon("chevron-down", 14, "textMuted", holder)
self.scope:connect(header.Activated, function()
self:SetCollapsed(not self.collapsed)
end)
end
end
local body = Create.new("Frame", {
Name = "Body",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 1,
Parent = root,
})
self.body = body
if look.edge then
local stripe = Create.new("Frame", {
Name = "Edge",
Size = UDim2.new(0, 3, 1, -12),
Position = UDim2.fromOffset(5, 4),
Theme = { BackgroundColor3 = look.edge },
Parent = body,
})
Create.corner(-1, stripe)
self.edge = stripe
end
local rows = Create.new(if options.MaxHeight then "ScrollingFrame" else "Frame", {
Name = "Rows",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Parent = body,
})
if options.MaxHeight then
Create.new("UISizeConstraint", { MaxSize = Vector2.new(math.huge, tonumber(options.MaxHeight) or 240), Parent = rows })
end
if not flat then
local edge = if look.edge then 8 else 0
local room = if look.rows then 10 else 6
Create.padding(rows, room + edge, if options.Title and not look.band then 0 else room, room, room)
end
Create.list(rows, "Vertical", if flat or look.rows then Tokens.density.gap else 2)
if options.Description then
self.description = Create.new("TextLabel", {
Name = "Description",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 12,
LayoutOrder = 0,
Text = options.Description,
Theme = { TextColor3 = "textMuted" },
Parent = rows,
})
Create.padding(self.description, 6, 0, 6, 4)
end
self.frame, self.rows = rows, rows
if self.tier then
self:buildLock()
end
Registry.install(self)
if options.Background then
self:SetBackground(options.Background)
end
if options.PopOut then
PopOut.attach(self)
end
if type(options.Tabs) == "table" and #options.Tabs > 0 then
self:buildTabs(options.Tabs)
end
self:refresh()
return self
end
function Section:buildLock()
local overlay = Create.new("TextButton", {
Name = "LockOverlay",
Text = "",
Size = UDim2.fromScale(1, 0),
ZIndex = 6,
BackgroundTransparency = 0.06,
Visible = false,
Theme = { BackgroundColor3 = self.surface },
Parent = self.body,
})
Create.corner(10, overlay)
Create.new("UIStroke", { Transparency = 0.45, Theme = { Color = "accent" }, Parent = overlay })
local wash = Create.new("Frame", {
Name = "Wash",
Size = UDim2.fromScale(1, 1),
Theme = { BackgroundColor3 = "accent" },
Parent = overlay,
}, {
Create.new("UIGradient", {
Rotation = 35,
Transparency = NumberSequence.new({
NumberSequenceKeypoint.new(0, 0.8),
NumberSequenceKeypoint.new(0.6, 1),
NumberSequenceKeypoint.new(1, 1),
}),
}),
})
Create.corner(10, wash)
local content = Create.new("Frame", {
Name = "Content",
Size = UDim2.new(1, -28, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.5),
ZIndex = 2,
Parent = overlay,
})
Create.list(content, "Horizontal", 10)
local disc = Create.new("Frame", {
Name = "Disc",
Size = UDim2.fromOffset(34, 34),
Theme = { BackgroundColor3 = "accent" },
Parent = content,
})
Create.corner(-1, disc)
local icon = Create.icon("lock", 16, "onAccent", disc)
icon.AnchorPoint = Vector2.new(0.5, 0.5)
icon.Position = UDim2.fromScale(0.5, 0.5)
local text = Create.new("Frame", { Name = "Text", AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = content }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.list(text, "Vertical", 1)
local title = Create.new("TextLabel", {
Name = "Reason",
Text = "",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
Weight = "bold",
Theme = { TextColor3 = "text" },
Parent = text,
})
local hint = Create.new("TextLabel", {
Name = "Hint",
Text = "",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 12,
LayoutOrder = 1,
Theme = { TextColor3 = "textMuted" },
Parent = text,
})
local rows = self.rows
self.lockShimmer = Effects.shimmer(self.scope, overlay, 10)
self.lockMinimum = Create.new("UISizeConstraint", { MinSize = Vector2.new(0, 0), Parent = rows })
local function cover()
overlay.Size = UDim2.new(1, 0, 0, rows.AbsoluteSize.Y / self.library.scale)
end
self.scope:connect(rows:GetPropertyChangedSignal("AbsoluteSize"), cover)
cover()
self.lockOverlay = { frame = overlay, icon = icon, title = title, hint = hint }
local sections = self.window.lockedSections
table.insert(sections, self)
self.scope:add(function()
local index = table.find(sections, self)
if index then
table.remove(sections, index)
end
end)
self:refreshLock()
end
function Section:refreshLock()
local lock = self.lockOverlay
if not lock then
return
end
local wording, hint = self.window:lockWording(self.tier, self.lockText, self.lockHint)
lock.frame.Visible = not self.window:allows(self.tier)
self.lockMinimum.MinSize = Vector2.new(0, if lock.frame.Visible then 84 else 0)
if lock.frame.Visible and self.window.lockShimmer then
self.lockShimmer.start()
else
self.lockShimmer.stop()
end
lock.title.Text = wording
lock.hint.Text = hint or ""
lock.hint.Visible = hint ~= nil and hint ~= ""
Icons.apply(lock.icon, if self.tier == true then "crown" else "lock")
end
function Section:nextOrder()
self.order += 1
return self.order
end
function Section:refresh()
local open = self.searching or not self.collapsed
self.rows.Visible = open
self:placeBackground()
if self.edge then
self.edge.Visible = open
end
if self.pages then
for name, page in self.pages do
page.frame.Visible = self.searching or name == self.page
end
self.strip.Visible = not self.searching
end
if self.bandFill then
self.bandFill.Visible = open
end
if self.chevron then
Motion.tween(self.chevron, "fast", { Rotation = if open then 0 else -90 })
end
local root = self.root
if open and root and self.wasFolded then
local size = root.Size
root.Size = size + UDim2.fromOffset(0, 1)
task.delay(0, function()
if root.Parent then
root.Size = size
end
end)
end
self.wasFolded = not open
end
function Section:setSearching(searching)
if self.searching ~= searching then
self.searching = searching
self:refresh()
end
end
function Section:setMatches(count)
if not self.header then
return
end
if count > 0 and not self.matchChip then
self.matchChip = Create.new("TextLabel", {
Name = "Matches",
Size = UDim2.fromOffset(0, 18),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 11,
Weight = "bold",
LayoutOrder = 2,
BackgroundTransparency = 0.82,
Theme = { BackgroundColor3 = "accent", TextColor3 = "accent" },
Parent = self.header,
})
Create.corner(-1, self.matchChip)
Create.padding(self.matchChip, 7, 0)
end
if self.matchChip then
self.matchChip.Visible = count > 0
self.matchChip.Text = tostring(count)
end
end
function Section:SetCollapsed(collapsed)
self.collapsed = collapsed == true
self:refresh()
end
function Section:buildSwitch(header, settings)
local on = settings.Default ~= false
local track = Create.new("TextButton", {
Name = "Switch",
Text = "",
Size = UDim2.fromOffset(30, 16),
LayoutOrder = 3,
Theme = { BackgroundColor3 = "stroke" },
Parent = header,
})
Create.corner(-1, track)
local knob = Create.new("Frame", { Name = "Thumb", Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0, 0.5), Parent = track })
Create.corner(-1, knob)
local handle = { Title = (self.Title or "Section") .. " switch", Changed = Signal.new(), scope = self.scope }
self.scope:add(handle.Changed)
local function draw(timing)
Theme.bind(track, "BackgroundColor3", if on then "accent" else "stroke", true)
Theme.bind(knob, "BackgroundColor3", if on then "onAccent" else "textMuted", true)
Motion.tween(track, timing, { BackgroundColor3 = Theme.color(if on then "accent" else "stroke") })
Motion.tween(knob, timing, {
Position = UDim2.new(0, if on then 16 else 2, 0.5, 0),
BackgroundColor3 = Theme.color(if on then "onAccent" else "textMuted"),
})
end
function handle:Get()
return on
end
function handle.Set(_, value)
on = value == true
self.switchedOff = not on
draw("fast")
self:refreshBlocked()
handle.Changed:Fire(on)
Env.call(handle.Title, settings.Callback, on)
end
self.scope:connect(track.Activated, function()
handle:Set(not on)
end)
self.switch = handle
self.switchedOff = not on
self.window:claimFlag(settings.Flag, handle, self.scope)
draw(nil)
task.defer(function()
if not on and not self.scope.cleaned then
handle:Set(false)
end
end)
end
function Section:buildTabs(names)
local strip = Create.new("Frame", { Name = "Strip", Size = UDim2.new(1, 0, 0, 30), LayoutOrder = -1, Parent = self.rows })
Create.padding(strip, 2, 0)
Create.list(strip, "Horizontal", 4)
self.strip = strip
self.pages, self.pageButtons, self.pageOrder = {}, {}, {}
local height = if self.library.touch then 36 else 28
strip.Size = UDim2.new(1, 0, 0, height + 2)
for index, name in names do
name = tostring(name)
local button = Create.new("TextButton", {
Name = "Page",
Size = UDim2.fromScale(0, 1),
Text = name,
TextSize = 12,
Weight = "medium",
LayoutOrder = index,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "raised", TextColor3 = "textMuted" },
Parent = strip,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
Create.corner(6, button)
local frame = Create.new("Frame", {
Name = "Rows",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = index,
Visible = index == 1,
Parent = self.rows,
})
Create.list(frame, "Vertical", if self.rowFill then Tokens.density.gap else 2)
local page = setmetatable({ frame = frame, order = 0, Title = name }, { __index = self })
function page.nextOrder(container)
rawset(container, "order", rawget(container, "order") + 1)
return rawget(container, "order")
end
Registry.install(page)
self.pages[name], self.pageButtons[name] = page, button
table.insert(self.pageOrder, name)
self.scope:connect(button.Activated, function()
self:SelectTab(name)
end)
end
self:SelectTab(self.pageOrder[1])
local first = self.pages[self.pageOrder[1]]
for kind in first do
if type(rawget(first, kind)) == "function" and kind ~= "nextOrder" then
self[kind] = function(_, options)
return first[kind](first, options)
end
end
end
end
function Section:Tab(name)
local page = self.pages and self.pages[name]
if not page then
error(`This section has no tab called "{tostring(name)}"`, 2)
end
return page
end
function Section:SelectTab(name)
if not (self.pages and self.pages[name]) then
return
end
self.page = name
for other, button in self.pageButtons do
local active = other == name
Theme.bind(button, "TextColor3", if active then "text" else "textMuted")
button.FontFace = Create.font(if active then "bold" else "medium")
Motion.tween(button, "fast", { BackgroundTransparency = if active then 0 else 1 })
end
self:refresh()
end
function Section:Group(options)
options = options or {}
local columns = math.clamp(math.floor(tonumber(options.Columns) or 2), 2, 3)
local holder = Create.new("Frame", {
Name = "Group",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = self:nextOrder(),
Parent = self.frame,
})
local layout = Create.list(holder, "Horizontal", 8, { VerticalAlignment = Enum.VerticalAlignment.Top })
local group = {
library = self.library,
window = self.window,
tab = self.tab,
section = self.section,
scope = self.scope,
entries = self.entries,
tier = self.tier,
lockText = self.lockText,
lockHint = self.lockHint,
lockOverlay = self.lockOverlay,
rowFill = self.rowFill,
rowRole = self.rowRole,
surface = self.surface,
frame = holder,
order = 0,
}
function group.nextOrder(container)
container.order += 1
return container.order
end
Registry.install(group)
local stacked = false
local function fit()
local width = holder.AbsoluteSize.X / self.library.scale
stacked = width > 0 and width / columns < 190
layout.FillDirection = if stacked then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal
for _, child in holder:GetChildren() do
if child:IsA("GuiObject") then
child.Size = if stacked then UDim2.new(1, 0, 0, 0) else UDim2.new(1 / columns, -8 * (columns - 1) / columns, 0, 0)
end
end
end
self.scope:connect(holder:GetPropertyChangedSignal("AbsoluteSize"), fit)
self.scope:connect(holder.ChildAdded, function()
task.defer(fit)
end)
group.Frame = holder
return group
end
function Section:ShowWhen(source, expected)
Registry.follow(self, source, expected)
end
function Section:EnableWhen(source, expected)
Registry.enableWhen(self, source, expected)
end
function Section:SetEnabled(enabled)
self.disabled = enabled == false
self:refreshBlocked()
end
function Section:refreshBlocked()
local blocked = Registry.blocked(self.window, self)
for _, entry in self.entries do
if entry.section == self and entry.handle.SetBlocked then
entry.handle:SetBlocked(blocked)
end
end
end
function Section:SetBadge(value)
if self.badge then
self.badge:Destroy()
self.badge = nil
end
if self.header and value ~= nil and value ~= false then
self.badge = Row.badge(self.header, if type(value) == "number" then tostring(value) else value)
self.badge.LayoutOrder = 2
end
end
function Section:SetTitle(title)
self.Title = title
self.searchTitle = string.lower(title)
if self.label then
self.label.Text = title
end
end
function Section:SetVisible(visible)
self.Hidden = not visible
self.window:applySearch()
end
function Section:Destroy()
local sections = self.tab.sections
local index = table.find(sections, self)
if index then
table.remove(sections, index)
end
self.tab.scope:release(self.scope)
end
function Section:PopOut(open)
if open == nil then
open = not self.popped
end
if open then
PopOut.open(self)
else
PopOut.close(self)
end
end
function Section:SetBackground(spec)
if self.movingBackground then
self.movingBackground.Destroy()
self.movingBackground = nil
end
local controller = Background.new(self.body, spec, {
Intensity = 0.3,
Radius = CARD_RADIUS,
Contained = true,
Measure = self.rows,
Scale = function()
return self.window.scale
end,
})
if not controller then
return
end
self.movingBackground = controller
local connection = self.tab.page:GetPropertyChangedSignal("Visible"):Connect(function()
self:placeBackground()
end)
self:placeBackground()
local destroy = controller.Destroy
function controller.Destroy()
connection:Disconnect()
destroy()
end
self.scope:add(controller.Destroy)
end
function Section:placeBackground()
local controller = self.movingBackground
if not controller then
return
end
local panel = if self.popped then self.panel else nil
controller.frame.Parent = panel or self.body
local corner = controller.frame:FindFirstChildOfClass("UICorner")
if corner then
corner.CornerRadius = UDim.new(0, if panel then PANEL_RADIUS else CARD_RADIUS)
end
controller.MeasureFrom(panel or self.rows)
controller.SetVisible(panel ~= nil or (self.tab.page.Visible and self.rows.Visible))
end
function Section:applySeeThrough()
if self.fillTransparency == 0 then
self.root.BackgroundTransparency = self.window.cardSeeThrough or 0
end
end
function Section:IsPoppedOut()
return self.popped == true
end
return Section
end
modules["Components/Services"] = function()
local Env = import("Core/Env")
local Sheet = import("Components/Sheet")
local Strings = import("Core/Strings")
local Services = {}
local CHECKED = {
"writefile",
"readfile",
"isfile",
"listfiles",
"delfile",
"makefolder",
"getcustomasset",
"setclipboard",
"request",
"identifyexecutor",
"getgenv",
"gethui",
"hookfunction",
"hookmetamethod",
"getrawmetatable",
"getnamecallmethod",
"setreadonly",
"getconnections",
"firesignal",
"fireproximityprompt",
"firetouchinterest",
"sethiddenproperty",
"queue_on_teleport",
"setfpscap",
"Drawing.new",
}
function Services.isNewer(candidate, current)
local left, right = {}, {}
for number in string.gmatch(tostring(candidate or ""), "%d+") do
table.insert(left, tonumber(number))
end
for number in string.gmatch(tostring(current or ""), "%d+") do
table.insert(right, tonumber(number))
end
for index = 1, math.max(#left, #right) do
local x, y = left[index] or 0, right[index] or 0
if x ~= y then
return x > y
end
end
return false
end
function Services.fetchLatest(settings)
local ok, body = Env.http({ Url = settings.Url })
if not ok then
return false, body
end
local latest, notes
local decoded, reply = Env.decode(body)
if decoded and type(reply) == "table" then
latest = reply.version or reply.Version
notes = reply.notes or reply.Notes
else
latest = string.match(body, "^%s*([%w%.%-]+)%s*$")
end
if type(latest) ~= "string" then
return false, Strings.get("The update address didn't name a version.")
end
return true, latest, if type(notes) == "string" then notes else nil
end
function Services.watchUpdates(window, settings)
if type(settings) ~= "table" or type(settings.Url) ~= "string" then
return
end
window.scope:add(task.delay(1, function()
window:CheckForUpdate()
end))
end
function Services.check(window)
local settings = window.options.UpdateCheck
if type(settings) ~= "table" or type(settings.Url) ~= "string" then
return false, Strings.get("No update address is set.")
end
local current = settings.Current or window.options.Version
local ok, latest, notes = Services.fetchLatest(settings)
if not ok then
return false, latest
end
if not Services.isNewer(latest, current) then
return true, nil
end
window.UpdateAvailable:Fire(latest, notes)
Env.call("Update check", settings.OnUpdate, latest, notes)
if settings.Notify ~= false then
window:Notify({
Id = "halcyon-update",
Title = Strings.get("Update available"),
Content = Strings.get("Version {latest} is out; this is {current}. Run the script again to get it.", {
latest = latest,
current = current or "?",
}),
Kind = "info",
Icon = "download",
Duration = 10,
})
end
return true, latest, notes
end
local function openSheet(window, key, title, build)
if window[key] then
window[key]:Destroy()
end
local panel = Sheet.new(window, { Title = title, Width = 380 })
window[key] = panel
build(panel)
panel:Open()
return panel
end
function Services.report(window)
local name, version = Env.executor()
local lines = { `Halcyon {window.library.version or ""}`, `{window.Title} {window.options.Version or ""}`, `Executor: {name} {version or ""}` }
local missing = Env.missing(CHECKED)
table.insert(lines, if #missing == 0 then "Missing: none" else "Missing: " .. table.concat(missing, ", "))
for _, entry in window.Errors do
table.insert(lines, `Error in {entry.Title}: {entry.Message}`)
end
return table.concat(lines, "\n")
end
function Services.supportPanel(window)
return openSheet(window, "supportSheet", Strings.get("Executor support"), function(panel)
local name, version = Env.executor()
local about = panel:Section({ Title = Strings.get("This executor") })
about:Status({ Title = name, Status = version or Strings.get("Version unknown"), Kind = "info" })
about:Status({
Title = Strings.get("Saving files"),
Status = if Env.canSave then Strings.get("Works") else Strings.get("Not available"),
Kind = if Env.canSave then "success" else "warning",
})
local list = panel:Section({ Title = Strings.get("Functions") })
local rows = {}
for _, functionName in CHECKED do
local present = Env.has(functionName)
table.insert(rows, { functionName, if present then Strings.get("Yes") else Strings.get("No") })
end
list:Table({ Columns = { Strings.get("Function"), { Title = Strings.get("Present"), Width = 0.3 } }, Rows = rows, MaxHeight = 260 })
local locked = {}
for _, tab in window.tabs do
for _, entry in tab.entries do
if entry.handle.MissingText then
table.insert(locked, { entry.handle.Title, entry.handle.MissingText })
end
end
end
if #locked > 0 then
panel:Section({ Title = Strings.get("Locked here") }):Table({ Columns = { Strings.get("Feature"), Strings.get("Needs") }, Rows = locked })
end
panel:Section({}):Button({
Title = Strings.get("Copy report"),
Icon = "copy",
Callback = function()
local copied = Env.copy(Services.report(window))
window:Notify({
Title = if copied then Strings.get("Report copied") else Strings.get("Can't copy"),
Content = if copied then nil else Strings.get("This executor has no clipboard."),
Kind = if copied then "success" else "warning",
})
end,
})
end)
end
function Services.errorsPanel(window)
return openSheet(window, "errorsSheet", Strings.get("Errors"), function(panel)
local section = panel:Section({ Title = Strings.get("Callbacks that failed") })
if #window.Errors == 0 then
section:Label({ Title = Strings.get("Nothing has failed this session."), Style = "Success" })
return
end
for index = #window.Errors, 1, -1 do
local entry = window.Errors[index]
section:Accordion({
Title = `{entry.Title}  ·  {os.date("%H:%M:%S", entry.Time)}`,
Content = tostring(entry.Trace or entry.Message),
})
end
panel:Section({}):Buttons({
Buttons = {
{
Title = Strings.get("Copy report"),
Icon = "copy",
Callback = function()
Env.copy(Services.report(window))
end,
},
{
Title = Strings.get("Clear"),
Icon = "trash-2",
Variant = "Danger",
Callback = function()
window:ClearErrors()
Services.errorsPanel(window)
end,
},
},
})
end)
end
return Services
end
modules["Components/SettingsTab"] = function()
local ConfigSection = import("Components/ConfigSection")
local Personalise = import("Components/Personalise")
local Motion = import("Core/Motion")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local STYLES = { "Sidebar", "Rail", "Top", "Dock" }
local function choices(names)
local list = {}
for _, name in names do
table.insert(list, { Text = Strings.get(name), Value = name })
end
return list
end
local SettingsTab = {}
function SettingsTab.build(window, options)
options = options or {}
local function wants(...)
for _, name in { ... } do
if options[name] ~= false then
return true
end
end
return false
end
local tab = window:Tab({ Title = options.Title or Strings.get("Settings"), Icon = options.Icon or "settings", Group = options.Group })
local scope = tab.scope
if wants("Theme", "Accent", "Navigation", "Scale", "Language", "ReduceMotion") then
local look = tab:Section({ Title = Strings.get("Appearance"), Icon = "palette" })
if wants("Theme") then
local themes = look:Dropdown({
Title = Strings.get("Theme"),
Values = Theme.names(),
Default = Theme.current.Name,
Callback = function(name)
if name and name ~= Theme.current.Name then
Theme.set(name)
end
end,
})
scope:add(Theme.Changed:Connect(function(name)
if themes:Get() ~= name then
themes:Refresh(Theme.names())
themes:Set(name)
end
end))
end
if wants("Accent") then
look:ColorPicker({
Title = Strings.get("Accent colour"),
Default = Theme.color("accent"),
Callback = function(color)
window:SetAccent(color)
end,
})
end
if wants("Navigation") then
look:Dropdown({
Title = Strings.get("Tab layout"),
Values = choices(STYLES),
Default = window.tabStyle,
Callback = function(style)
window:SetTabStyle(style)
end,
})
end
if wants("Scale") then
local scale = {
Title = Strings.get("Interface scale"),
Min = 75,
Max = 125,
Step = 5,
Suffix = "%",
Default = math.round(window.scale * 100),
Live = false,
Callback = function(percent)
window:SetScale(percent / 100)
end,
}
if options.ScaleControl == "Slider" then
look:Slider(scale)
else
look:Stepper(scale)
end
end
if wants("Language") then
local languages = {}
for _, language in Strings.languages() do
table.insert(languages, { Text = language.Name, Value = language.Code })
end
look:Dropdown({
Title = Strings.get("Language"),
Values = languages,
Default = Strings.language,
Callback = function(code)
if code and code ~= Strings.language then
window:SetLanguage(code)
window:Notify({
Title = Strings.get("Language changed"),
Content = Strings.get("Run the hub again to see every part in the new language."),
})
end
end,
})
end
if wants("ReduceMotion") then
look:Toggle({
Title = Strings.get("Reduce motion"),
Default = Motion.reduced,
Callback = function(reduced)
window:SetReducedMotion(reduced)
end,
})
end
end
local anonymous = wants("Anonymous") and window.profile.Enabled
if wants("MenuKey", "Minimize") or anonymous then
local menu = tab:Section({ Title = Strings.get("Menu"), Icon = "keyboard", Side = "Right" })
if wants("MenuKey") then
menu:Keybind({
Title = Strings.get("Toggle key"),
Default = window.toggleKey,
ChangedCallback = function(key)
window:SetToggleKey(key)
end,
})
end
if wants("Minimize") then
menu:Dropdown({
Title = Strings.get("Minimise to"),
Values = choices({ "Topbar", "Pill", "Chip" }),
Default = window.minimizeStyle,
Callback = function(style)
window:SetMinimizeStyle(style)
end,
})
end
if anonymous then
menu:Toggle({
Title = Strings.get("Anonymous mode"),
Description = Strings.get("Hides your name and picture"),
Default = window.profile.Anonymous,
Callback = function(hidden)
if hidden ~= window.profile.Anonymous then
window:SetAnonymous(hidden)
end
end,
})
end
end
if options.Personalise then
Personalise.section(window, tab, if type(options.Personalise) == "table" then options.Personalise else nil)
end
if options.ThemeBuilder then
Personalise.builder(window, tab, { Side = "Right" })
end
if options.Configs ~= false then
ConfigSection.build(window, tab, { Side = "Right" })
end
if wants("Support", "Errors", "Unload") then
local session = tab:Section({ Title = Strings.get("Session"), Icon = "power" })
if wants("Support") then
session:Button({
Title = Strings.get("Executor support"),
Description = Strings.get("What this executor can run"),
Icon = "cpu",
Callback = function()
window:SupportPanel()
end,
})
end
if wants("Errors") then
local errors = session:Button({
Title = Strings.get("Errors"),
Description = Strings.get("Callbacks that failed this session"),
Icon = "bug",
Callback = function()
window:ErrorsPanel()
end,
})
local function count()
local total = #window.Errors
errors:SetDescription(if total > 0 then Strings.get("{count} this session", { count = total }) else Strings.get("Callbacks that failed this session"))
end
tab.scope:add(window.ErrorsChanged:Connect(count))
end
if wants("Unload") then
session:Button({
Title = Strings.get("Unload"),
Variant = "Danger",
Callback = function()
window:RequestUnload()
end,
})
end
end
return tab
end
return SettingsTab
end
modules["Components/Sheet"] = function()
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Registry = import("Elements/Registry")
local Section = import("Components/Section")
local Sheet = {}
Sheet.__index = function(self, key)
local method = rawget(Sheet, key)
if method then
return method
end
local first = rawget(self, "first")
if Registry.KindSet[key] then
return function(_, options)
if not first then
first = self:Section({})
rawset(self, "first", first)
end
return first[key](first, options)
end
end
return nil
end
function Sheet.new(window, options)
options = options or {}
local scope = window.scope:child()
local self = setmetatable({ window = window, library = window.library, scope = scope, IsOpen = false, order = 0 }, Sheet)
local layer = Create.new("Frame", { Name = "Sheet", Size = UDim2.fromScale(1, 1), ZIndex = 20, Visible = false, Parent = window.body })
scope:add(layer)
local scrim = Create.new("TextButton", {
Name = "Scrim",
Size = UDim2.fromScale(1, 1),
BackgroundColor3 = Color3.new(0, 0, 0),
BackgroundTransparency = 1,
ZIndex = 20,
Parent = layer,
})
local width = math.clamp(tonumber(options.Width) or 340, 240, 520)
local panel = Create.new("Frame", {
Name = "Panel",
Size = UDim2.new(0, width, 1, 0),
AnchorPoint = Vector2.new(1, 0),
Position = UDim2.new(1, width, 0, 0),
ZIndex = 21,
Theme = { BackgroundColor3 = "background" },
Parent = layer,
})
Create.new("UISizeConstraint", { MaxSize = Vector2.new(width, math.huge), Parent = panel })
Create.stroke("stroke", panel)
local head = Create.new("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, 48), ZIndex = 22, Parent = panel })
Create.padding(head, 16, 0, 8, 0)
Create.list(head, "Horizontal", 8, { VerticalAlignment = Enum.VerticalAlignment.Center })
self.titleLabel = Create.new("TextLabel", {
Name = "Title",
Size = UDim2.fromScale(0, 1),
Text = options.Title or "",
TextSize = 15,
Weight = "bold",
ZIndex = 22,
Theme = { TextColor3 = "text" },
Parent = head,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
local close = Create.new("TextButton", { Name = "Close", Size = UDim2.fromOffset(36, 36), LayoutOrder = 1, ZIndex = 22, Parent = head })
Create.corner(8, close)
local cross = Create.icon("x", 16, "textMuted", close)
cross.AnchorPoint, cross.Position, cross.ZIndex = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), 22
local page = Create.new("ScrollingFrame", {
Name = "Page",
Position = UDim2.fromOffset(0, 48),
Size = UDim2.new(1, 0, 1, -48),
ScrollBarThickness = 3,
ZIndex = 21,
Parent = panel,
})
local inset = Create.new("Frame", { Name = "Inset", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = page })
Create.padding(inset, 12)
Create.list(inset, "Vertical", 10)
self.host = {
library = window.library,
window = window,
scope = scope,
entries = {},
sections = {},
left = inset,
right = inset,
sectionStyle = options.SectionStyle,
order = 0,
}
function self.host.nextOrder(host)
host.order += 1
return host.order
end
function self.host.reflow() end
self.layer, self.scrim, self.panel, self.width = layer, scrim, panel, width
scope:connect(scrim.Activated, function()
self:Close()
end)
scope:connect(close.Activated, function()
self:Close()
end)
return self
end
function Sheet:Section(options)
local section = Section.new(self.host, options or {})
table.insert(self.host.sections, section)
return section
end
function Sheet:SetTitle(title)
self.titleLabel.Text = tostring(title or "")
end
function Sheet:Open()
if self.IsOpen then
return
end
self.IsOpen = true
self.layer.Visible = true
Motion.tween(self.scrim, "base", { BackgroundTransparency = 0.5 })
Motion.tween(self.panel, "base", { Position = UDim2.new(1, 0, 0, 0) })
end
function Sheet:Close()
if not self.IsOpen then
return
end
self.IsOpen = false
Motion.tween(self.scrim, "fast", { BackgroundTransparency = 1 })
Motion.tween(self.panel, "fast", { Position = UDim2.new(1, self.width, 0, 0) })
local layer = self.layer
task.delay(if Motion.reduced then 0 else 0.13, function()
if not self.IsOpen and not self.scope.cleaned then
layer.Visible = false
end
end)
end
function Sheet:Destroy()
self.window.scope:release(self.scope)
end
return Sheet
end
end
]]></ProtectedString>
</Properties>

</Item>
<Item class="ModuleScript" referent="RBX2">
<Properties>
<string name="Name">Part02</string>
<ProtectedString name="Source"><![CDATA[return function(modules, import)
modules["Components/Spotlight"] = function()
local Create = import("Core/Create")
local Effects = import("Core/Effects")
local Mount = import("Core/Mount")
local Motion = import("Core/Motion")
local Strings = import("Core/Strings")
local GAP, MARGIN = 8, 8
local Spotlight = {}
function Spotlight.attach(window, handle, options)
options = if type(options) == "table" then options else { Text = tostring(options) }
local id = tostring(options.Id or handle.Title)
if window.seenSpotlights[id] then
return nil
end
local library, scope = window.library, handle.scope:child()
local frame = handle.Frame
local dot = Create.new("Frame", {
Name = "Spotlight",
Size = UDim2.fromOffset(8, 8),
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromOffset(6, 6),
ZIndex = 8,
Theme = { BackgroundColor3 = "accent" },
Parent = frame,
})
Create.corner(-1, dot)
scope:add(dot)
local ring = Create.new("UIStroke", { Theme = { Color = "accent" }, Parent = dot })
Effects.pulse(scope, ring).start()
local card
local spot = {}
function spot.dismiss()
window.seenSpotlights[id] = true
window:savePreferences()
handle.scope:release(scope)
end
local function refresh()
local visible = window.Visible and handle.Tab ~= nil and window.selected == handle.Tab and frame.Visible ~= false and not handle.Hidden
local page = handle.Tab and handle.Tab.page
if visible and page and page.AbsoluteSize.Y > 0 then
local top, bottom = page.AbsolutePosition.Y, page.AbsolutePosition.Y + page.AbsoluteSize.Y
visible = frame.AbsolutePosition.Y >= top and frame.AbsolutePosition.Y + frame.AbsoluteSize.Y <= bottom
end
if not visible then
if card then
card:Destroy()
card = nil
end
return
end
if card then
return
end
local overlay = Mount.overlay(library)
card = Create.new("Frame", {
Name = "Callout",
Size = UDim2.fromOffset(240, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Theme = { BackgroundColor3 = "accent" },
Parent = overlay.popups,
})
scope:add(card)
Create.new("UIScale", { Scale = library.scale, Parent = card })
Create.corner(10, card)
Create.padding(card, 12, 10)
Create.list(card, "Vertical", 4)
if options.Title then
Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, 18),
Text = tostring(options.Title),
Weight = "bold",
Theme = { TextColor3 = "onAccent" },
Parent = card,
})
end
if options.Text then
Create.new("TextLabel", {
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 13,
LayoutOrder = 1,
Text = tostring(options.Text),
TextTransparency = 0.1,
Theme = { TextColor3 = "onAccent" },
Parent = card,
})
end
local button = Create.new("TextButton", {
Name = "GotIt",
Size = UDim2.fromOffset(0, if library.touch then 40 else 28),
AutomaticSize = Enum.AutomaticSize.X,
Text = options.Button or Strings.get("Got it"),
TextSize = 12,
Weight = "bold",
LayoutOrder = 2,
BackgroundTransparency = 0.8,
Theme = { BackgroundColor3 = "onAccent", TextColor3 = "onAccent" },
Parent = card,
})
Create.corner(6, button)
Create.padding(button, 12, 0)
scope:connect(button.Activated, spot.dismiss)
local function place()
if not card then
return
end
local view, origin = overlay.gui.AbsoluteSize, overlay.gui.AbsolutePosition
local corner, size = frame.AbsolutePosition - origin, card.AbsoluteSize
local y = corner.Y + frame.AbsoluteSize.Y + GAP
if y + size.Y > view.Y - MARGIN then
y = corner.Y - size.Y - GAP
end
card.Position = UDim2.fromOffset(
math.round(math.clamp(corner.X + 12, MARGIN, math.max(view.X - size.X - MARGIN, MARGIN))),
math.round(math.clamp(y, MARGIN, math.max(view.Y - size.Y - MARGIN, MARGIN)))
)
end
scope:connect(card:GetPropertyChangedSignal("AbsoluteSize"), place)
scope:connect(frame:GetPropertyChangedSignal("AbsolutePosition"), place)
place()
if not Motion.reduced then
card.BackgroundTransparency = 1
Motion.tween(card, "base", { BackgroundTransparency = 0 })
end
end
scope:add(window.TabChanged:Connect(refresh))
if handle.Tab then
scope:connect(handle.Tab.page:GetPropertyChangedSignal("CanvasPosition"), refresh)
end
scope:connect(frame:GetPropertyChangedSignal("Visible"), refresh)
window.visibilityHooks = window.visibilityHooks or {}
table.insert(window.visibilityHooks, refresh)
scope:add(function()
local hooks = window.visibilityHooks
local index = table.find(hooks, refresh)
if index then
table.remove(hooks, index)
end
end)
task.defer(refresh)
spot.refresh = refresh
return spot
end
return Spotlight
end
modules["Components/Switches"] = function()
local Lighting = game:GetService("Lighting")
local CommandPalette = import("Components/CommandPalette")
local Motion = import("Core/Motion")
local NoticeCenter = import("Components/NoticeCenter")
local Switches = {}
local ALIASES = { Minimize = "Minimizable", Resize = "Resizable" }
local BLUR_SIZE = 12
function Switches.normalize(options)
local copy = table.clone(options)
for plain, older in ALIASES do
if copy[plain] ~= nil and copy[older] == nil then
copy[older] = copy[plain]
end
end
return copy
end
local function settings(value)
if value == true then
return {}
elseif type(value) == "table" then
return value
end
return nil
end
local function applyBlur(window)
local wanted = window.blurSize and window.Visible and not window.minimized
if wanted and not window.blur then
window.blur = Instance.new("BlurEffect")
window.blur.Name = "HalcyonBlur"
window.blur.Size = 0
window.blur.Parent = Lighting
window.scope:add(window.blur)
end
if window.blur then
Motion.tween(window.blur, "base", { Size = if wanted then window.blurSize else 0 })
end
end
local function setBlur(window, value)
if value == true then
window.blurSize = BLUR_SIZE
elseif type(value) == "number" then
window.blurSize = math.clamp(math.floor(value), 1, 56)
else
window.blurSize = nil
end
applyBlur(window)
end
local function hud(field, build)
return function(window, value)
local wanted = settings(value)
if window[field] then
window[field]:Destroy()
window[field] = nil
end
if wanted then
window[field] = build(window, wanted)
end
end
end
local function flag(set)
return function(window, value)
set(window, value ~= false and value ~= nil)
end
end
local SETTERS = {
Search = flag(function(window, on)
window.options.Search = on
if not on and window.searchBox.Text ~= "" then
window.searchBox.Text = ""
end
if window.sidebarHeader then
window:buildNav()
else
window.topbarSearch.Visible = on
end
end),
Profile = function(window, value)
if type(value) == "table" then
local changed = table.clone(value)
changed.Enabled = true
window:SetProfile(changed)
else
window:SetProfile({ Enabled = value ~= false and value ~= nil })
end
end,
ShowVersion = flag(function(window, on)
window:SetVersionVisible(on)
end),
Minimizable = flag(function(window, on)
window.options.Minimizable = on
if window.minimizeButton then
window.minimizeButton.Visible = on
end
end),
Close = flag(function(window, on)
window.options.Close = on
if window.closeButton then
window.closeButton.Visible = on
end
end),
Resizable = flag(function(window, on)
window.options.Resizable = on
if on and not window.grip and not window.library.touch then
window:buildGrip()
end
if window.grip then
window.grip.Visible = on and not (window.minimized and window.minimizeStyle == "Topbar")
end
end),
Drag = flag(function(window, on)
window.dragLocked = not on
end),
Shadow = flag(function(window, on)
window.shadowOff = not on
if on and not window.shadow then
window:buildShadow()
elseif window.shadow then
window.shadow.Visible = on and window.root.Visible
end
end),
Tooltips = flag(function(window, on)
window.tooltipsOff = not on
end),
Animations = flag(function(window, on)
window:SetReducedMotion(not on)
end),
Blur = setBlur,
CommandPalette = flag(function(window, on)
window.paletteOff = not on
if on and not window.paletteBound then
window.paletteBound = true
CommandPalette.bind(window)
end
end),
Snap = flag(function(window, on)
window.options.Snap = on
end),
OpenButton = flag(function(window, on)
window.options.OpenButton = on
window:refreshVisibility()
end),
Watermark = hud("watermark", function(window, options)
return window:Watermark(options)
end),
KeybindList = hud("keybindList", function(window, options)
return window:KeybindList(options)
end),
NotificationCenter = flag(function(window, on)
if on and not window.noticeButton then
NoticeCenter.build(window)
elseif window.noticeButton then
window.noticeButton.Visible = on
end
end),
SettingsTab = function(window, value)
local wanted = settings(value)
if window.settingsTab then
window.settingsTab:SetVisible(wanted ~= nil)
elseif wanted then
window.settingsTab = window:SettingsTab(wanted)
end
end,
}
local GETTERS = {
Search = function(window)
return window.options.Search ~= false
end,
Profile = function(window)
return window.profile.Enabled ~= false
end,
ShowVersion = function(window)
return window.options.ShowVersion ~= false
end,
Minimizable = function(window)
return window.options.Minimizable ~= false
end,
Close = function(window)
return window.options.Close ~= false
end,
Resizable = function(window)
return window.grip ~= nil and window.grip.Visible
end,
Drag = function(window)
return not window.dragLocked
end,
Shadow = function(window)
return window.shadow ~= nil and not window.shadowOff
end,
Tooltips = function(window)
return not window.tooltipsOff
end,
Animations = function()
return not Motion.reduced
end,
Blur = function(window)
return window.blurSize ~= nil
end,
CommandPalette = function(window)
return window.paletteBound == true and not window.paletteOff
end,
Snap = function(window)
return window.options.Snap == true
end,
OpenButton = function(window)
return window.options.OpenButton == true
end,
Watermark = function(window)
return window.watermark ~= nil
end,
KeybindList = function(window)
return window.keybindList ~= nil
end,
SettingsTab = function(window)
return window.settingsTab ~= nil and not window.settingsTab.Hidden
end,
NotificationCenter = function(window)
return window.noticeButton ~= nil and window.noticeButton.Visible
end,
}
function Switches.define(name, set, get)
SETTERS[name], GETTERS[name] = set, get
end
local function canonical(name)
return ALIASES[name] or name
end
function Switches.names()
local names = {}
for name in SETTERS do
table.insert(names, name)
end
for plain in ALIASES do
table.insert(names, plain)
end
table.sort(names)
return names
end
function Switches.set(window, name, value)
local set = SETTERS[canonical(name)]
if not set then
warn(`[Halcyon] Window:Set doesn't know the switch "{tostring(name)}".`)
return false
end
set(window, value)
return true
end
function Switches.get(window, name)
local get = GETTERS[canonical(name)]
if not get then
return nil
end
return get(window)
end
function Switches.build(window)
local options = window.options
window.dragLocked = options.Drag == false
window.tooltipsOff = options.Tooltips == false
if options.Blur then
setBlur(window, options.Blur)
window.scope:connect(window.root:GetPropertyChangedSignal("Visible"), function()
applyBlur(window)
end)
end
if options.NotificationCenter then
NoticeCenter.build(window)
end
if options.Watermark then
SETTERS.Watermark(window, options.Watermark)
end
if options.KeybindList then
SETTERS.KeybindList(window, options.KeybindList)
end
if settings(options.SettingsTab) then
task.defer(function()
if not window.scope.cleaned and not window.settingsTab then
SETTERS.SettingsTab(window, options.SettingsTab)
end
end)
end
end
Switches.applyBlur = applyBlur
return Switches
end
modules["Components/Tab"] = function()
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Panels = import("Components/Panels")
local Registry = import("Elements/Registry")
local Section = import("Components/Section")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
local Schema = import("Core/Schema")
local GAP = 10
Styles.register("TabIndicator", "Bar", { marker = "edge", fill = "raised", fillTransparency = 0 })
Styles.register("TabIndicator", "Pill", { fill = "accent", fillTransparency = 0.85, text = "accent" })
Styles.register("TabIndicator", "Underline", { marker = "under" })
Styles.register("TabIndicator", "Dot", { marker = "dot", text = "text" })
Styles.register("TabIndicator", "Glow", { fill = "raised", fillTransparency = 0, glow = true })
Styles.register("TabIndicator", "Fill", { fill = "accent", fillTransparency = 0, text = "onAccent", icon = "onAccent" })
Styles.register("TabIndicator", "Text", { text = "accent", icon = "accent" })
local NOTICE_ICONS = { info = "info", success = "circle-check", warning = "triangle-alert", danger = "circle-x" }
local Tab = {}
Tab.__index = Tab
function Tab.new(window, options)
local self = setmetatable({
library = window.library,
window = window,
scope = window.scope:child(),
entries = {},
sections = {},
order = 0,
Title = options.Title,
Description = options.Description,
Icon = options.Icon,
Group = options.Group,
tier = options.Tier or (options.PaidOnly and true) or nil,
lockText = options.LockText,
lockHint = options.LockHint,
sectionStyle = options.SectionStyle,
matches = 0,
wide = false,
Hidden = options.Visible == false,
}, Tab)
local page = Create.new("ScrollingFrame", { Name = "Page", Size = UDim2.fromScale(1, 1), Visible = false, Parent = window.pages })
local inset = Create.new("Frame", { Name = "Inset", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = page })
Create.padding(inset, 12)
Create.list(inset, "Vertical", GAP)
if options.Description then
local header = Create.new("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = inset })
Create.padding(header, 4, 2, 4, 2)
Create.list(header, "Vertical", 2)
Create.new("TextLabel", {
Name = "Title",
Size = UDim2.new(1, 0, 0, 24),
Text = options.Title,
TextSize = 20,
Weight = "bold",
Theme = { TextColor3 = "text" },
Parent = header,
})
Create.new("TextLabel", {
Name = "Description",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 13,
LayoutOrder = 1,
Text = options.Description,
Theme = { TextColor3 = "textMuted" },
Parent = header,
})
end
self.notices = Create.new("Frame", { Name = "Notices", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Visible = false, Parent = inset })
Create.list(self.notices, "Vertical", 6)
local columns = Create.new("Frame", {
Name = "Columns",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 2,
Parent = inset,
})
self.page = page
self.left = Create.new("Frame", { Name = "Left", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = columns })
self.right = Create.new("Frame", {
Name = "Right",
Size = UDim2.new(0.5, -GAP / 2, 0, 0),
Position = UDim2.new(0.5, GAP / 2, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Visible = false,
Parent = columns,
})
Create.list(self.left, "Vertical", GAP)
Create.list(self.right, "Vertical", GAP)
self.scope:add(page)
return self
end
function Tab:SetVisible(visible)
local hidden = visible == false
if self.Hidden == hidden then
return
end
self.Hidden = hidden
self.window:tabShownChanged(self)
end
function Tab:ShowWhen(source, expected)
Registry.follow(self, source, expected)
end
function Tab:nextOrder()
self.order += 1
return self.order
end
function Tab:Section(options)
if type(options) == "table" then
Schema.check(`Section "{options.Title or ""}"`, options, Schema.section)
end
local section = Section.new(self, options)
table.insert(self.sections, section)
self.last = section
self:reflow(self.wide)
if type(options) == "table" then
Registry.switches(section, options)
end
return section
end
function Tab:reflow(wide)
self.wide = wide
local double = false
if wide then
for _, section in self.sections do
if section.side == "Right" then
double = true
break
end
end
end
self.left.Size = if double then UDim2.new(0.5, -GAP / 2, 0, 0) else UDim2.new(1, 0, 0, 0)
self.right.Visible = double
for _, section in self.sections do
section.root.Parent = if double and section.side == "Right" then self.right else self.left
end
end
function Tab:Notice(options)
if type(options) == "string" then
options = { Content = options }
end
local role = if NOTICE_ICONS[options.Kind] then options.Kind else "info"
local scope = self.scope:child()
local box = Create.new("Frame", {
Name = "Notice",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
BackgroundTransparency = 0.88,
Theme = { BackgroundColor3 = role },
Parent = self.notices,
})
scope:add(box)
Create.corner(10, box)
Create.stroke(role, box).Transparency = 0.55
Create.padding(box, 12, 10)
Create.list(box, "Horizontal", 10, { VerticalAlignment = Enum.VerticalAlignment.Top })
Create.icon(NOTICE_ICONS[role], 18, role, box)
local text = Create.new("TextLabel", {
Name = "Text",
Size = UDim2.fromScale(0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
RichText = true,
TextSize = 13,
LayoutOrder = 1,
Theme = { TextColor3 = "text" },
Parent = box,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
local function write(content)
text.Text = if options.Title then `<b>{options.Title}</b>  {content or ""}` else tostring(content or "")
end
write(options.Content)
self.notices.Visible = true
local notice = {}
function notice.SetContent(_, content)
write(content)
end
function notice.Destroy()
self.scope:release(scope)
self.notices.Visible = #self.notices:GetChildren() > 1
end
if options.Dismissible then
local close = Create.new("ImageButton", { Name = "Dismiss", Size = UDim2.fromOffset(18, 18), LayoutOrder = 2, Parent = box })
local glyph = Create.icon("x", 14, "textMuted", close)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
scope:connect(close.Activated, notice.Destroy)
end
return notice
end
function Tab:EmptyState(options)
return Panels.state(self, options)
end
function Tab:About(options)
return Panels.about(self.window, self, options)
end
function Tab:filter(query)
local counts, total = {}, 0
local named = query ~= "" and string.find(string.lower(self.Title), query, 1, true) ~= nil
for _, entry in self.entries do
local handle, section = entry.handle, entry.section
local match = query == ""
or named
or string.find(handle.SearchText or "", query, 1, true) ~= nil
or (section.searchTitle ~= nil and string.find(section.searchTitle, query, 1, true) ~= nil)
handle.Frame.Visible = match and not handle.Hidden
handle.searchMatched = query ~= "" and match and not handle.Hidden
if handle.Highlight then
handle:Highlight(if match then query else nil)
end
if match then
total += 1
counts[section] = (counts[section] or 0) + 1
end
end
for _, section in self.sections do
section.root.Visible = not section.Hidden and (query == "" or (counts[section] or 0) > 0)
section:setSearching(query ~= "")
section:setMatches(if query ~= "" then counts[section] or 0 else 0)
end
self.matches = total
return total
end
function Tab:buildButton(style, parent, scope, order)
local button = Create.new("TextButton", {
Name = "Tab",
LayoutOrder = order,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "raised" },
Parent = parent,
})
Create.corner(8, button)
local icon = Create.icon(self.Icon or "circle", if style == "Rail" or style == "Dock" then 20 else 18, "textMuted", button)
local label = Create.new("TextLabel", {
Name = "Title",
Text = self.Title,
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 1,
Theme = { TextColor3 = "textMuted" },
Parent = button,
})
self.bar, self.inner = nil, nil
local look = Styles.pick("TabIndicator", nil, self.window)
self.look = look
local function marker()
local frame = Create.new("Frame", {
Name = "Marker",
Visible = false,
ZIndex = 2,
Theme = { BackgroundColor3 = "accent" },
})
Create.corner(-1, frame)
if look.marker == "under" then
frame.Size = UDim2.new(0.6, 0, 0, 2)
frame.AnchorPoint = Vector2.new(0.5, 1)
frame.Position = UDim2.new(0.5, 0, 1, 0)
elseif look.marker == "dot" then
frame.Size = UDim2.fromOffset(6, 6)
frame.AnchorPoint = Vector2.new(1, 0.5)
frame.Position = UDim2.new(1, -8, 0.5, 0)
elseif style == "Sidebar" then
frame.Size = UDim2.fromOffset(3, 16)
frame.AnchorPoint = Vector2.new(0, 0.5)
frame.Position = UDim2.fromScale(0, 0.5)
else
frame.Size = if style == "Rail" then UDim2.fromOffset(3, 18) else UDim2.new(0.5, 0, 0, 3)
frame.AnchorPoint = if style == "Rail" then Vector2.new(0, 0.5) else Vector2.new(0.5, 1)
frame.Position = if style == "Rail" then UDim2.fromScale(0, 0.5) else UDim2.new(0.5, 0, 1, 0)
end
return frame
end
if look.glow then
self.glow = Create.new("UIStroke", { Thickness = 1.5, Transparency = 1, Theme = { Color = "accent" }, Parent = button })
else
self.glow = nil
end
if style == "Sidebar" then
button.Size = UDim2.new(1, 0, 0, if self.library.touch then 44 else 36)
icon.AnchorPoint = Vector2.new(0, 0.5)
icon.Position = UDim2.new(0, 10, 0.5, 0)
label.Position = UDim2.fromOffset(38, 0)
label.Size = UDim2.new(1, if self.tier then -66 else -46, 1, 0)
if self.tier then
local lock = Create.icon("lock", 14, "textMuted", button)
lock.AnchorPoint = Vector2.new(1, 0.5)
lock.Position = UDim2.new(1, -10, 0.5, 0)
self.lock = lock
end
elseif style == "Rail" then
button.Size = UDim2.new(1, 0, 0, 44)
icon.AnchorPoint = Vector2.new(0.5, 0.5)
icon.Position = UDim2.fromScale(0.5, 0.5)
label.Visible = false
elseif style == "Top" then
local height = if self.library.touch then 40 else 32
local inner = Create.new("Frame", { Name = "Inner", Size = UDim2.fromOffset(0, height), AutomaticSize = Enum.AutomaticSize.X, Parent = button })
Create.padding(inner, 12, 0)
Create.list(inner, "Horizontal", 6)
icon.Parent, label.Parent = inner, inner
label.Size = UDim2.fromScale(0, 1)
label.AutomaticSize = Enum.AutomaticSize.X
label.TextSize = 13
local function fit()
button.Size = UDim2.fromOffset(inner.AbsoluteSize.X / self.library.scale, height)
end
scope:connect(inner:GetPropertyChangedSignal("AbsoluteSize"), fit)
button.Size = UDim2.fromOffset(80, height)
fit()
self.inner = inner
else
button.Size = UDim2.new(0, 72, 1, 0)
local inner = Create.new("Frame", { Name = "Inner", Size = UDim2.fromScale(1, 1), Parent = button })
Create.list(inner, "Vertical", 3, {
HorizontalAlignment = Enum.HorizontalAlignment.Center,
VerticalAlignment = Enum.VerticalAlignment.Center,
})
icon.Parent, label.Parent = inner, inner
label.Size = UDim2.new(1, -4, 0, 14)
label.TextSize = 12
label.TextXAlignment = Enum.TextXAlignment.Center
self.inner = inner
end
if look.marker then
self.bar = marker()
self.bar.Parent = button
end
local mark = self.badge
if mark ~= nil and mark ~= false then
local dot = mark == true or style == "Rail" or style == "Dock"
local pill = Create.new("TextLabel", {
Name = "Badge",
Size = if dot then UDim2.fromOffset(8, 8) else UDim2.fromOffset(0, 16),
AutomaticSize = if dot then Enum.AutomaticSize.None else Enum.AutomaticSize.X,
Text = if dot then "" else tostring(mark),
TextSize = 10,
Weight = "bold",
ZIndex = 3,
LayoutOrder = 3,
Theme = { BackgroundColor3 = "accent", TextColor3 = "onAccent" },
Parent = if style == "Top" then self.inner else button,
})
Create.corner(-1, pill)
if not dot then
Create.padding(pill, 5, 0)
end
if style == "Sidebar" then
pill.AnchorPoint = Vector2.new(1, 0.5)
pill.Position = UDim2.new(1, if self.tier then -30 else -10, 0.5, 0)
elseif dot and style ~= "Top" and icon then
pill.Parent = icon
pill.AnchorPoint = Vector2.new(0, 1)
pill.Position = UDim2.new(1, -2, 0, 2)
elseif dot and style ~= "Top" then
pill.AnchorPoint = Vector2.new(0.5, 0.5)
pill.Position = UDim2.new(0.5, 10, 0, 10)
end
end
self.button, self.buttonIcon, self.buttonLabel = button, icon, label
scope:connect(button.Activated, function()
self.window:SelectTab(self)
end)
scope:connect(button.MouseEnter, function()
if self.window.selected ~= self then
Motion.tween(button, "fast", { BackgroundTransparency = 0.5 })
end
end)
scope:connect(button.MouseLeave, function()
if self.window.selected ~= self then
Motion.tween(button, "fast", { BackgroundTransparency = 1 })
end
end)
end
function Tab:paint(selected, dimmed)
if not self.button then
return
end
local textRole = if selected then "text" else "textMuted"
Theme.bind(self.buttonIcon, "ImageColor3", if selected then "accent" else "textMuted")
Theme.bind(self.buttonLabel, "TextColor3", textRole)
self.buttonLabel.FontFace = Create.font(if selected then "bold" else "medium")
self.buttonLabel.TextTransparency = if dimmed then 0.5 else 0
self.buttonIcon.ImageTransparency = if dimmed then 0.5 else 0
local look = self.look or {}
if selected and look.text then
Theme.bind(self.buttonLabel, "TextColor3", look.text)
end
if selected and (look.icon or look.text) then
Theme.bind(self.buttonIcon, "ImageColor3", look.icon or (if look.text == "onAccent" then "onAccent" else "accent"))
end
Theme.bind(self.button, "BackgroundColor3", if selected and look.fill then look.fill else "raised")
Motion.tween(self.button, "fast", { BackgroundTransparency = if selected and look.fill then look.fillTransparency or 0 else 1 })
if self.bar then
self.bar.Visible = selected
end
if self.glow then
Motion.tween(self.glow, "fast", { Transparency = if selected then 0.35 else 1 })
end
if self.lock then
self.lock.Visible = not self.window:allows(self.tier)
end
end
function Tab:SetBadge(value)
self.badge = value
self.window:buildNav()
end
function Tab:Select()
self.window:SelectTab(self)
end
function Tab:SetTitle(title)
self.Title = title
if self.buttonLabel then
self.buttonLabel.Text = title
end
end
local function looseSection(tab)
local loose = tab.loose
if not loose or tab.last ~= loose or loose.scope.cleaned then
loose = tab:Section({ Style = "Flat" })
tab.loose = loose
end
return loose
end
function Tab.page(parent, container, options)
if type(options) == "string" then
options = { Title = options }
end
if type(options) ~= "table" or type(options.Title) ~= "string" then
error("Page needs a Title", 3)
end
local window = parent.window
local page = Tab.new(window, {
Title = options.Title,
Icon = options.Icon,
SectionStyle = options.SectionStyle or parent.sectionStyle,
Tier = options.Tier,
PaidOnly = options.PaidOnly,
LockText = options.LockText,
LockHint = options.LockHint,
})
page.isPage = true
page.parentTab = parent
page.rootTab = parent.rootTab or parent
table.insert(window.subPages, page)
page:reflow(window.wide)
page:buildBreadcrumb(options.Description)
page.link = container:PageLink({
Title = options.Title,
Description = options.Description,
Icon = options.Icon,
Badge = options.Badge,
Tier = options.Tier,
PaidOnly = options.PaidOnly,
Page = page,
})
parent.scope:add(function()
local index = table.find(window.subPages, page)
if index then
table.remove(window.subPages, index)
end
window.scope:release(page.scope)
end)
if not window.pageEscape then
window.pageEscape = true
window.scope:connect(UserInputService.InputBegan, function(input, processed)
local open = window.selected
if not processed and input.KeyCode == Enum.KeyCode.Escape and open and open.isPage and window.Visible then
window:SelectTab(open.parentTab)
end
end)
end
return page
end
function Tab:Page(options)
return Tab.page(self, self, options)
end
function Section:Page(options)
return Tab.page(self.tab, self, options)
end
function Tab:buildBreadcrumb(description)
local window = self.window
local inset = self.page:FindFirstChild("Inset")
local header = Create.new("Frame", { Name = "Breadcrumb", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = inset })
Create.list(header, "Vertical", 4)
local trail = Create.new("Frame", { Name = "Trail", Size = UDim2.new(1, 0, 0, 30), Parent = header })
Create.list(trail, "Horizontal", 4, { VerticalAlignment = Enum.VerticalAlignment.Center })
local back = Create.new("TextButton", {
Name = "Back",
Size = UDim2.fromOffset(30, 30),
Theme = { BackgroundColor3 = "raised" },
Parent = trail,
})
Create.corner(8, back)
local arrow = Create.icon("chevron-left", 16, "text", back)
arrow.AnchorPoint, arrow.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
self.scope:connect(back.Activated, function()
window:SelectTab(self.parentTab)
end)
self.scope:connect(back.MouseEnter, function()
Theme.bind(back, "BackgroundColor3", "hover")
end)
self.scope:connect(back.MouseLeave, function()
Theme.bind(back, "BackgroundColor3", "raised")
end)
local chain = {}
local level = self.parentTab
while level do
table.insert(chain, 1, level)
level = level.parentTab
end
local order = 1
for _, ancestor in chain do
local step = Create.new("TextButton", {
Name = "Step",
Size = UDim2.fromOffset(0, 30),
AutomaticSize = Enum.AutomaticSize.X,
Text = ancestor.Title,
TextSize = 13,
LayoutOrder = order,
Theme = { TextColor3 = "textMuted" },
Parent = trail,
})
Create.padding(step, 4, 0)
self.scope:connect(step.Activated, function()
window:SelectTab(ancestor)
end)
self.scope:connect(step.MouseEnter, function()
Theme.bind(step, "TextColor3", "text")
end)
self.scope:connect(step.MouseLeave, function()
Theme.bind(step, "TextColor3", "textMuted")
end)
local divider = Create.icon("chevron-right", 12, "textMuted", trail)
divider.LayoutOrder = order + 1
order += 2
end
Create.new("TextLabel", {
Name = "Current",
Size = UDim2.fromOffset(0, 30),
AutomaticSize = Enum.AutomaticSize.X,
Text = self.Title,
TextSize = 15,
Weight = "bold",
LayoutOrder = order,
Theme = { TextColor3 = "text" },
Parent = trail,
})
if description then
Create.new("TextLabel", {
Name = "Description",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
TextSize = 13,
LayoutOrder = 1,
Text = description,
Theme = { TextColor3 = "textMuted" },
Parent = header,
})
end
end
for _, kind in Registry.Kinds do
Tab[kind] = function(self, options)
local section = looseSection(self)
return section[kind](section, options)
end
end
Tab.__index = function(_, key)
local method = rawget(Tab, key)
if method ~= nil then
return method
end
if Registry.KindSet[key] then
return function(self, options)
local section = looseSection(self)
return section[key](section, options)
end
end
return nil
end
return Tab
end
modules["Components/TabOrder"] = function()
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Menu = import("Components/Menu")
local Strings = import("Core/Strings")
local TabOrder = {}
function TabOrder.setup(window, saved)
local state = { list = {}, pinned = {} }
if type(saved) == "table" then
for _, title in saved.order or {} do
if type(title) == "string" then
table.insert(state.list, title)
end
end
for _, title in saved.pinned or {} do
if type(title) == "string" then
state.pinned[title] = true
end
end
end
window.tabOrder = state
end
function TabOrder.saved(window)
local state = window.tabOrder
if not state then
return nil
end
local pinned = {}
for title in state.pinned do
table.insert(pinned, title)
end
table.sort(pinned)
return { order = table.clone(state.list), pinned = pinned }
end
function TabOrder.isPinned(window, tab)
return window.tabOrder ~= nil and window.tabOrder.pinned[tab.Title] == true
end
function TabOrder.position(window, tab)
return if window.tabOrder then table.find(window.tabOrder.list, tab.Title) else nil
end
local function placeBefore(window, tab, before)
local shown = {}
for _, other in window:navOrder() do
if other ~= tab then
table.insert(shown, other)
end
end
local index = if before then table.find(shown, before) else nil
if not index then
index = #shown + 1
for position = #shown, 1, -1 do
if window:navGroup(shown[position]) == window:navGroup(tab) then
index = position + 1
break
end
end
end
table.insert(shown, index, tab)
local titles = {}
for _, other in shown do
table.insert(titles, other.Title)
end
window.tabOrder.list = titles
window:buildNav()
window:savePreferences()
end
local function neighbours(window, tab)
local list = {}
for _, other in window:navOrder() do
if not other.Hidden and window:navGroup(other) == window:navGroup(tab) then
table.insert(list, other)
end
end
return list
end
function TabOrder.move(window, tab, step)
local list = neighbours(window, tab)
local index = table.find(list, tab)
local target = list[index + step]
if not target then
return
end
if step < 0 then
placeBefore(window, tab, target)
else
placeBefore(window, tab, list[index + step + 1])
end
end
function TabOrder.pin(window, tab, pinned)
window.tabOrder.pinned[tab.Title] = if pinned then true else nil
window:buildNav()
window:savePreferences()
end
function TabOrder.attach(window, tab, scope, vertical)
local button = tab.button
if not button or tab.isFavourites then
return
end
Menu.attach(scope, window.library, button, function()
local pinned = TabOrder.isPinned(window, tab)
return {
{
Title = if pinned then Strings.get("Unpin") else Strings.get("Pin to top"),
Icon = "pin",
Callback = function()
TabOrder.pin(window, tab, not pinned)
end,
},
{ Divider = true },
{
Title = Strings.get("Move up"),
Icon = if vertical then "arrow-up" else "arrow-left",
Callback = function()
TabOrder.move(window, tab, -1)
end,
},
{
Title = Strings.get("Move down"),
Icon = if vertical then "arrow-down" else "arrow-right",
Callback = function()
TabOrder.move(window, tab, 1)
end,
},
}
end)
local marker
local target
Drag.track(scope, button, nil, function(position, _, moved)
if not moved then
return
end
local list = neighbours(window, tab)
target = nil
local edge
for _, other in list do
local frame = other.button
if frame and other ~= tab then
local middle = frame.AbsolutePosition + frame.AbsoluteSize / 2
local before = if vertical then position.Y < middle.Y else position.X < middle.X
if before then
target = other
edge = frame
break
end
end
end
local host = window.navHost
if not marker then
marker = Create.new("Frame", {
Name = "DropLine",
ZIndex = 20,
Theme = { BackgroundColor3 = "accent" },
Parent = host,
})
Create.corner(-1, marker)
end
local anchor = edge or list[#list].button
local parentOrigin = host.AbsolutePosition
local place = anchor.AbsolutePosition - parentOrigin
local scale = window.scale
if vertical then
marker.Size = UDim2.fromOffset(anchor.AbsoluteSize.X / scale, 2)
marker.Position = UDim2.fromOffset(place.X / scale, (place.Y + (if edge then -2 else anchor.AbsoluteSize.Y + 1)) / scale)
else
marker.Size = UDim2.fromOffset(2, anchor.AbsoluteSize.Y / scale)
marker.Position = UDim2.fromOffset((place.X + (if edge then -2 else anchor.AbsoluteSize.X + 1)) / scale, place.Y / scale)
end
end, function(moved)
if marker then
marker:Destroy()
marker = nil
end
if moved then
placeBefore(window, tab, target)
end
end)
end
return TabOrder
end
modules["Components/Tooltip"] = function()
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Mount = import("Core/Mount")
local Styles = import("Core/Styles")
local DELAY, LONG_PRESS, TOUCH_TIME = 0.45, 0.5, 2.5
local GAP, MARGIN, WIDTH = 8, 8, 240
Styles.register("Tooltip", "Card", { card = true })
Styles.register("Tooltip", "Plain", { inverted = true })
Styles.register("Tooltip", "Follow", { card = true, follow = true })
local Tooltip = {}
local function build(library, spec, look)
local overlay = Mount.overlay(library)
local inverted = look.inverted == true
local frame = Create.new("Frame", {
Name = "Tooltip",
Size = UDim2.fromOffset(0, 0),
AutomaticSize = Enum.AutomaticSize.XY,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = if inverted then "text" else "surface" },
Parent = overlay.popups,
})
Create.new("UIScale", { Scale = library.scale, Parent = frame })
Create.new("UISizeConstraint", { MaxSize = Vector2.new(WIDTH, math.huge), Parent = frame })
Create.corner(if inverted then 6 else 8, frame)
local edge = Create.stroke("stroke", frame)
edge.Transparency = if inverted then 1 else 0
Create.padding(frame, if inverted then 8 else 10, if inverted then 5 else 8)
Create.list(frame, "Vertical", 3)
if spec.Title or spec.Key then
local head = Create.new("Frame", { Name = "Head", Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X, Parent = frame })
Create.list(head, "Horizontal", 6)
if spec.Title then
Create.new("TextLabel", {
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(spec.Title),
TextSize = 13,
Weight = "bold",
Theme = { TextColor3 = if inverted then "background" else "text" },
Parent = head,
})
end
if spec.Key then
local key = Create.new("TextLabel", {
Size = UDim2.fromOffset(0, 16),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(spec.Key),
TextSize = 12,
Weight = "bold",
LayoutOrder = 1,
Theme = { BackgroundColor3 = "raised", TextColor3 = "textMuted" },
Parent = head,
})
Create.corner(4, key)
Create.padding(key, 5, 0)
end
end
if spec.Text then
Create.new("TextLabel", {
Name = "Text",
Size = UDim2.fromOffset(0, 0),
AutomaticSize = Enum.AutomaticSize.XY,
TextWrapped = true,
RichText = true,
TextSize = 12,
LayoutOrder = 1,
Text = tostring(spec.Text),
Theme = { TextColor3 = if inverted then "background" else "textMuted" },
Parent = frame,
}, { Create.new("UISizeConstraint", { MaxSize = Vector2.new(WIDTH - 20, math.huge) }) })
end
return frame, overlay
end
local function place(frame, overlay, anchor)
local view, origin = overlay.gui.AbsoluteSize, overlay.gui.AbsolutePosition
local size = frame.AbsoluteSize
local x, top, bottom
if typeof(anchor) == "Vector2" then
local point = anchor - origin
x, top, bottom = point.X + 14, point.Y, point.Y + 18
else
local corner = anchor.AbsolutePosition - origin
x, top, bottom = corner.X + 12, corner.Y, corner.Y + anchor.AbsoluteSize.Y
end
local y = if bottom + GAP + size.Y <= view.Y - MARGIN then bottom + GAP else top - GAP - size.Y
x = math.clamp(x, MARGIN, math.max(view.X - size.X - MARGIN, MARGIN))
y = math.clamp(y, MARGIN, math.max(view.Y - size.Y - MARGIN, MARGIN))
frame.Position = UDim2.fromOffset(math.round(x), math.round(y))
end
function Tooltip.attach(row, spec)
if type(spec) ~= "table" then
spec = { Text = tostring(spec) }
end
local library, scope = row.library, row.scope
local look = Styles.pick("Tooltip", spec.Style, row.window)
local target = row.frame
local shown, overlay
local generation = 0
local function hide()
generation += 1
if shown then
shown:Destroy()
shown = nil
end
end
local function show(at)
hide()
if row.window and row.window.tooltipsOff then
return
end
local mine = generation
local frame
frame, overlay = build(library, spec, look)
shown = frame
place(frame, overlay, if look.follow and at then at else target)
task.defer(function()
if mine == generation and shown == frame then
place(frame, overlay, if look.follow and at then at else target)
Motion.tween(frame, "fast", { BackgroundTransparency = 0 })
end
end)
end
scope:connect(target.MouseEnter, function()
generation += 1
local mine = generation
task.delay(DELAY, function()
if mine == generation and not scope.cleaned and target.Visible ~= false then
show(UserInputService:GetMouseLocation())
end
end)
end)
scope:connect(target.MouseLeave, hide)
if look.follow then
scope:connect(UserInputService.InputChanged, function(input)
if shown and input.UserInputType == Enum.UserInputType.MouseMovement then
place(shown, overlay, Vector2.new(input.Position.X, input.Position.Y))
end
end)
end
scope:connect(target.InputBegan, function(input)
if input.UserInputType ~= Enum.UserInputType.Touch then
return
end
generation += 1
local mine = generation
task.delay(LONG_PRESS, function()
if mine == generation and not scope.cleaned then
show(Vector2.new(input.Position.X, input.Position.Y))
local current = generation
task.delay(TOUCH_TIME, function()
if current == generation then
hide()
end
end)
end
end)
end)
scope:connect(target.InputEnded, function(input)
if input.UserInputType == Enum.UserInputType.Touch and not shown then
generation += 1
end
end)
scope:add(hide)
return { show = show, hide = hide }
end
return Tooltip
end
modules["Components/UpdateLog"] = function()
local Create = import("Core/Create")
local Panels = import("Components/Panels")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local KINDS = { "New", "Improved", "Fixed", "Removed", "Security" }
local ROLES = { New = "accent", Improved = "info", Fixed = "success", Removed = "danger", Security = "warning" }
local ICONS = { New = "plus", Improved = "zap", Fixed = "wrench", Removed = "trash-2", Security = "shield-check" }
Styles.register("UpdateLog", "Timeline", { section = "Accent" })
Styles.register("UpdateLog", "Cards", { section = "Card" })
Styles.register("UpdateLog", "Compact", { section = "Outlined", compact = true })
local UpdateLog = {}
function UpdateLog.settings(value)
if value == true then
return {}
elseif type(value) == "table" then
return value
end
return nil
end
local function newer(a, b)
local left, right = {}, {}
for number in string.gmatch(tostring(a.Version or ""), "%d+") do
table.insert(left, tonumber(number))
end
for number in string.gmatch(tostring(b.Version or ""), "%d+") do
table.insert(right, tonumber(number))
end
for index = 1, math.max(#left, #right) do
local x, y = left[index] or 0, right[index] or 0
if x ~= y then
return x > y
end
end
return (a.order or 0) > (b.order or 0)
end
local function entriesOf(update)
local list = {}
for _, entry in update.Entries or {} do
if type(entry) == "string" then
table.insert(list, { Kind = "New", Text = entry })
elseif type(entry) == "table" and entry.Text then
table.insert(list, { Kind = if ROLES[entry.Kind] then entry.Kind else "New", Text = tostring(entry.Text) })
end
end
return list
end
local function group(section, kind, items, compact)
local row = Row.new(section, { Title = "" }, { bare = true, compact = true })
local handle = row.handle
local body = Create.new("Frame", { Name = "Group", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row.content })
Create.list(body, "Vertical", 6)
local role = ROLES[kind]
if not compact then
local head = Create.new("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, 20), Parent = body })
Create.list(head, "Horizontal", 6)
Create.icon(ICONS[kind], 14, role, head)
Create.new("TextLabel", {
Name = "Kind",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = string.upper(kind),
TextSize = 12,
Weight = "bold",
LayoutOrder = 1,
Theme = { TextColor3 = role },
Parent = head,
})
local count = Create.new("TextLabel", {
Name = "Count",
Size = UDim2.fromOffset(0, 18),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(#items),
TextSize = 12,
Weight = "bold",
LayoutOrder = 2,
BackgroundTransparency = 0.85,
Theme = { BackgroundColor3 = role, TextColor3 = role },
Parent = head,
})
Create.corner(-1, count)
Create.padding(count, 6, 0)
end
local words = {}
for index, text in items do
local line = Create.new("Frame", { Name = "Change", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = index + 1, Parent = body })
Create.list(line, "Horizontal", 8, { VerticalAlignment = Enum.VerticalAlignment.Top })
if compact then
local tag = Create.new("TextLabel", {
Name = "Tag",
Size = UDim2.fromOffset(78, 18),
Text = string.upper(kind),
TextSize = 12,
Weight = "bold",
TextXAlignment = Enum.TextXAlignment.Center,
BackgroundTransparency = 0.85,
Theme = { BackgroundColor3 = role, TextColor3 = role },
Parent = line,
})
Create.corner(4, tag)
else
local dot = Create.new("Frame", { Name = "Dot", Size = UDim2.fromOffset(5, 5), Position = UDim2.fromOffset(0, 7), Theme = { BackgroundColor3 = "textMuted" } })
local holder = Create.new("Frame", { Name = "Bullet", Size = UDim2.fromOffset(12, 18), Parent = line })
dot.Parent = holder
dot.Position = UDim2.fromOffset(4, 7)
Create.corner(-1, dot)
end
Create.new("TextLabel", {
Name = "Text",
Size = UDim2.fromScale(0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
TextWrapped = true,
RichText = true,
TextSize = 13,
LayoutOrder = 1,
Text = text,
Theme = { TextColor3 = "text" },
Parent = line,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
table.insert(words, text)
end
handle.SearchExtra = kind .. " " .. table.concat(words, " ")
handle.SearchText = string.lower(handle.SearchExtra)
handle.Kind = "UpdateGroup"
handle.UpdateKind = kind
local entry = { handle = handle, section = section }
table.insert(section.entries, entry)
handle.scope:add(function()
local index = table.find(section.entries, entry)
if index then
table.remove(section.entries, index)
end
end)
return handle
end
function UpdateLog.build(window, settings)
local look = Styles.pick("UpdateLog", settings.Style, window)
local tab = window:Tab({
Title = settings.Title or Strings.get("Updates"),
Icon = settings.Icon or "clock",
Group = settings.Group,
Description = settings.Description,
})
local log = { tab = tab, updates = {}, sections = {}, filter = "All", query = "", order = 0 }
window.updateLog = log
tab.trailing = true
window:buildNav()
local tools = tab:Section({ Title = nil })
local chips
local function apply()
for _, section in log.sections do
local shown = 0
for _, entry in section.entries do
local handle = entry.handle
if handle.UpdateKind and entry.section == section then
local visible = (log.filter == "All" or handle.UpdateKind == log.filter)
and (log.query == "" or string.find(handle.SearchText, log.query, 1, true) ~= nil or string.find(section.searchTitle or "", log.query, 1, true) ~= nil)
handle:SetVisible(visible)
if visible then
shown += 1
end
end
end
section:SetVisible(shown > 0)
if shown > 0 and (log.query ~= "" or log.filter ~= "All") then
section:SetCollapsed(false)
end
end
end
if settings.Search ~= false then
tools:Input({
Title = Strings.get("Search"),
Placeholder = Strings.get("A version or a word"),
LeadingIcon = "search",
Clearable = true,
Live = true,
Callback = function(text)
log.query = string.lower(text or "")
apply()
end,
})
end
if settings.Filters ~= false then
local values = { { Text = Strings.get("All"), Value = "All" } }
for _, kind in KINDS do
table.insert(values, { Text = Strings.get(kind), Value = kind })
end
chips = tools:Chips({
Title = Strings.get("Show"),
Values = values,
Default = "All",
Callback = function(kind)
log.filter = kind or "All"
apply()
end,
})
end
log.tools, log.chips = tools, chips
function log.redraw()
for _, section in log.sections do
section:Destroy()
end
table.clear(log.sections)
table.sort(log.updates, function(a, b)
if (a.Pinned == true) ~= (b.Pinned == true) then
return a.Pinned == true
end
return newer(a, b)
end)
for index, update in log.updates do
local latest = index == 1
local title = tostring(update.Version or "")
if update.Title then
title = if title ~= "" then `{title}  \u{00B7}  {update.Title}` else tostring(update.Title)
end
local subtitle = {}
if update.Date then
table.insert(subtitle, tostring(update.Date))
end
if update.Summary then
table.insert(subtitle, tostring(update.Summary))
end
local section = tab:Section({
Title = title,
Icon = if latest then "tag" else "clock",
IconColor = if latest then "accent" else nil,
Style = look.section,
Description = if #subtitle > 0 then table.concat(subtitle, "  \u{2014}  ") else nil,
Badge = if latest then Strings.get("Latest") elseif update.Pinned then Strings.get("Pinned") else nil,
Collapsed = not latest and settings.ExpandAll ~= true,
})
if update.Image then
section:Image({ Image = update.Image, Height = 120, Crop = true })
end
local byKind = {}
for _, entry in entriesOf(update) do
byKind[entry.Kind] = byKind[entry.Kind] or {}
table.insert(byKind[entry.Kind], entry.Text)
end
for _, kind in KINDS do
if byKind[kind] then
group(section, kind, byKind[kind], look.compact)
end
end
table.insert(log.sections, section)
end
apply()
log.markUnseen()
end
function log.markUnseen()
local newest = log.updates[1]
local version = newest and tostring(newest.Version or "")
if version and version ~= "" and window.updateSeen ~= version and window.selected ~= tab then
tab:SetBadge(Strings.get("New"))
else
tab:SetBadge(nil)
end
end
tab.scope:add(window.TabChanged:Connect(function(selected)
local newest = log.updates[1]
if selected == tab and newest and newest.Version then
window.updateSeen = tostring(newest.Version)
window:savePreferences()
tab:SetBadge(nil)
end
end))
function log.add(update)
if type(update) ~= "table" then
error("AddUpdate expects a table: { Version, Title, Date, Entries }", 3)
end
log.order += 1
local copy = table.clone(update)
copy.order = log.order
table.insert(log.updates, copy)
log.redraw()
end
for _, update in settings.Updates or {} do
log.order += 1
local copy = table.clone(update)
copy.order = log.order
table.insert(log.updates, copy)
end
log.redraw()
if settings.Popup and log.updates[1] then
local newest = log.updates[1]
task.defer(function()
if not window.scope.cleaned then
local entries = {}
for _, entry in entriesOf(newest) do
table.insert(entries, entry)
end
pcall(Panels.changelog, window, { Version = newest.Version, Title = newest.Title and Strings.get("What's new: {title}", { title = newest.Title }), Entries = entries })
end
end)
end
return log
end
return UpdateLog
end
modules["Components/Window"] = function()
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CommandPalette = import("Components/CommandPalette")
local Assets = import("Core/Assets")
local Config = import("Core/Config")
local Create = import("Core/Create")
local Dialog = import("Components/Dialog")
local Drag = import("Core/Drag")
local Env = import("Core/Env")
local Hairline = import("Core/Hairline")
local Header = import("Components/Header")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Mount = import("Core/Mount")
local Notifications = import("Components/Notifications")
local Panels = import("Components/Panels")
local Personalise = import("Components/Personalise")
local Popup = import("Components/Popup")
local Profile = import("Components/Profile")
local Registry = import("Elements/Registry")
local Signal = import("Core/Signal")
local Resize = import("Core/Resize")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local Switches = import("Components/Switches")
local Tab = import("Components/Tab")
local UpdateLog = import("Components/UpdateLog")
local Theme = import("Core/Theme")
local Schema = import("Core/Schema")
local Favourites = import("Components/Favourites")
local TabOrder = import("Components/TabOrder")
local SearchFocus = import("Components/SearchFocus")
local Background = import("Core/Background")
local Services = import("Components/Services")
local NARROW = 560
local COLUMNS = 520
local LANES = { Sidebar = 196, Rail = 60 }
local STRIPS = { Top = 46, Dock = 58 }
local MINIMIZE = { Topbar = true, Pill = true, Chip = true }
for _, name in { "Sidebar", "Rail", "Top", "Dock" } do
Styles.register("Navigation", name, { lane = LANES[name], strip = STRIPS[name] })
end
for _, name in { "Topbar", "Pill", "Chip" } do
Styles.register("Minimize", name, {})
end
Styles.register("Window", "Solid", {})
Styles.register("Window", "Glass", { transparency = 0.14, sheen = true, edge = "text", edgeTransparency = 0.82 })
Styles.register("Window", "Gradient", { gradient = true })
Styles.register("Window", "Image", { image = true })
Styles.register("Open", "Rise", { offset = Vector2.new(0, 14) })
Styles.register("Open", "Pop", { scale = 0.96 })
Styles.register("Open", "Zoom", { scale = 0.86, timing = "spring" })
Styles.register("Open", "Drop", { offset = Vector2.new(0, -18) })
Styles.register("Open", "Slide", { offset = Vector2.new(-28, 0) })
Styles.register("Open", "Unroll", { unroll = true })
Styles.register("Open", "None", {})
Styles.register("PageTransition", "Rise", { offset = Vector2.new(0, 8) })
Styles.register("PageTransition", "Slide", { offset = Vector2.new(16, 0) })
Styles.register("PageTransition", "None", {})
Styles.register("Controls", "Default", {})
Styles.register("Controls", "Mac", { dots = true })
Styles.register("TopbarImage", "Circle", { corner = -1 })
Styles.register("TopbarImage", "Rounded", { corner = 8 })
Styles.register("TopbarImage", "Square", { corner = 3 })
Styles.register("TopbarImage", "Squircle", { corner = 11, size = 30 })
Styles.register("TopbarImage", "Ring", { corner = -1, ring = true })
Styles.register("TopbarImage", "Badge", { corner = 8, dot = true })
local SNAP = 18
local SHADOW_IMAGE = "rbxassetid://8992230677"
local SHADOW_SPREAD = 50
local MIN_SIZE = Vector2.new(420, 300)
local PINNED = "Pinned (Halcyon)"
local DEFAULT_SIZE = Vector2.new(740, 500)
local PREFERENCES_VERSION = 1
local Window = {}
Window.__index = Window
local function readPreferences(path)
local content = Env.read(path)
if not content then
return {}
end
local ok, saved = Env.decode(content)
if not ok or type(saved) ~= "table" or saved.version ~= PREFERENCES_VERSION then
return {}
end
return saved
end
local function keyFromName(name)
if type(name) ~= "string" or name == "" then
return nil
end
local ok, key = pcall(function()
return Enum.KeyCode[name]
end)
return if ok then key else nil
end
local function centred(instance)
instance.AnchorPoint = Vector2.new(0.5, 0.5)
instance.Position = UDim2.fromScale(0.5, 0.5)
return instance
end
function Window.new(library, options, access)
options = Switches.normalize(options)
local self = setmetatable({}, Window)
self.library, self.options = library, options
self.scope = library.scope:child()
self.folder = Env.safeName(options.Folder or options.Title) or "Default"
self.config = Config.new(self.folder, Config.gameKey(options.Configs))
self.Errors, self.ErrorsChanged = {}, Signal.new()
self.showErrors = options.ShowErrors ~= false
self.preferencesPath = `Halcyon/{self.folder}/settings.json`
self.Flags, self.tabs, self.keybinds, self.gated = {}, {}, {}, {}
self.subPages = {}
self.SectionPopped = Signal.new()
self.UpdateAvailable = Signal.new()
self.OnUnload, self.KeybindsChanged, self.TabChanged, self.Tick = Signal.new(), Signal.new(), Signal.new(), Signal.new()
self.ConfigChanged = Signal.new()
self.query = ""
self.Visible = true
self.Title, self.Subtitle, self.Icon = options.Title or "Halcyon", options.Subtitle, options.Icon
self.styles = Styles.defaults(options)
self.header = Styles.pick("Header", nil, self)
self.topbarHeight = self.header.height or 48
self.sectionStyle = options.SectionStyle
self.sliderTooltips = options.SliderTooltips ~= false
self.sliderTooltipStyle = options.SliderTooltipStyle or "Rounded"
self.toggleOutline = options.ToggleOutline ~= false
self.toggleOutlineColor = options.ToggleOutlineColor
self.toggleThumb = options.ToggleThumb or "Circle"
self.lockShimmer = options.LockShimmer ~= false
self.buttonEffect = options.ButtonEffect or "Sweep"
if not access and type(options.Tiers) == "table" then
local rank = table.find(options.Tiers, options.Tier) or 1
access = {
Tiers = table.clone(options.Tiers),
Tier = options.Tiers[rank],
Rank = rank,
PaidRank = table.find(options.Tiers, options.PaidTier or "Paid"),
}
elseif not access then
access = { Tiers = {}, Tier = "Keyless", Rank = 0, Keyless = true }
end
self.access = access
self.lockText = options.LockText or Strings.get("Requires {tier}")
self.paidLockText = options.PaidLockText or Strings.get("Paid only")
self.lockHint = options.LockHint
self.paidLockHint = options.PaidLockHint or Strings.get("Unlock with a paid key")
self.lockedSections = {}
local saved = if options.SavePreferences == false then {} else readPreferences(self.preferencesPath)
self.languagePicked = if type(saved.language) == "string" then saved.language else nil
self.popOutState = if type(saved.popOuts) == "table" then saved.popOuts else {}
self.personal, self.customThemes = {}, {}
Personalise.loadThemes(self, saved.themes)
Personalise.restore(self, saved.personal, true)
local function style(name)
return if LANES[name] or STRIPS[name] then name else nil
end
self.tabStyle = style(saved.tabStyle) or style(options.TabStyle) or "Sidebar"
self.scale = math.clamp(tonumber(saved.scale) or tonumber(options.Scale) or 1, 0.75, 1.25)
self.toggleKey = keyFromName(saved.toggleKey) or options.ToggleKey or Enum.KeyCode.RightShift
self.minimizeStyle = if MINIMIZE[saved.minimizeStyle] then saved.minimizeStyle elseif MINIMIZE[options.MinimizeStyle] then options.MinimizeStyle else "Topbar"
self.collapsedGroups = {}
for _, name in if type(saved.collapsedGroups) == "table" then saved.collapsedGroups else options.CollapsedGroups or {} do
if type(name) == "string" then
self.collapsedGroups[name] = true
end
end
self.profile = Profile.settings(options.Profile)
if type(saved.anonymous) == "boolean" then
self.profile.Anonymous = saved.anonymous
end
self.updateSeen = if type(saved.updateSeen) == "string" then saved.updateSeen else nil
self.changelogSeen = if type(saved.changelog) == "string" then saved.changelog else nil
self.seenSpotlights = {}
for _, id in if type(saved.seen) == "table" then saved.seen else {} do
if type(id) == "string" then
self.seenSpotlights[id] = true
end
end
if type(saved.reducedMotion) == "boolean" then
Motion.reduced = saved.reducedMotion
end
if type(options.Theme) == "table" then
local added, message = Theme.add(options.Theme)
if added then
Theme.set(options.Theme.Name)
else
warn("[Halcyon] " .. message)
end
elseif options.Theme then
Theme.set(options.Theme)
end
if type(saved.theme) == "string" then
Theme.set(saved.theme)
end
local size = options.Size
self.size = if typeof(size) == "Vector2" then size elseif typeof(size) == "UDim2" then Vector2.new(size.X.Offset, size.Y.Offset) else DEFAULT_SIZE
local function point(value)
return if type(value) == "table" and type(value.x) == "number" and type(value.y) == "number" then Vector2.new(value.x, value.y) else nil
end
self.size = point(saved.size) or self.size
self.placed = point(saved.position)
library.scale = self.scale
Hairline.setScale(self.scale)
self.gui = Create.new("ScreenGui", { Name = "Halcyon", DisplayOrder = library.displayOrder, Parent = Mount.parent() })
self.scope:add(self.gui)
self.root = centred(Create.new("Frame", {
Name = "Window",
Active = true,
ClipsDescendants = true,
Theme = { BackgroundColor3 = "background" },
Parent = self.gui,
}))
Create.corner(12, self.root)
Create.stroke("stroke", self.root)
self.uiScale = Create.new("UIScale", { Scale = self.scale, Parent = self.root })
Create.new("UISizeConstraint", { MinSize = Vector2.new(240, 48), MaxSize = Vector2.new(1600, 1000), Parent = self.root })
if options.Shadow ~= false then
self:buildShadow()
end
self:buildSurface()
self:buildTopbar()
self.body = Create.new("Frame", {
Name = "Body",
Position = UDim2.fromOffset(0, self.topbarHeight),
Size = UDim2.new(1, 0, 1, -self.topbarHeight),
ClipsDescendants = true,
Parent = self.root,
})
self.pages = Create.new("Frame", { Name = "Pages", Parent = self.body })
self.empty = centred(Create.new("TextLabel", {
Name = "Empty",
Text = "",
Size = UDim2.new(1, -32, 0, 40),
TextWrapped = true,
TextXAlignment = Enum.TextXAlignment.Center,
Visible = false,
Theme = { TextColor3 = "textMuted" },
Parent = self.pages,
}))
self.openButton = Create.new("TextButton", {
Name = "Open",
Text = "",
Size = UDim2.fromOffset(48, 48),
AnchorPoint = Vector2.new(0.5, 0),
Position = UDim2.new(0.5, 0, 0, 10),
Visible = false,
Theme = { BackgroundColor3 = "surface" },
Parent = self.gui,
})
Create.corner(-1, self.openButton)
Create.stroke("stroke", self.openButton)
centred(Create.icon(self.Icon or "menu", 22, "accent", self.openButton))
Drag.move(self.scope, self.openButton, self.openButton, {
onTap = function()
self:restore()
end,
})
self.pill = Create.new("TextButton", {
Name = "Pill",
Text = "",
Size = UDim2.fromOffset(0, 44),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(0.5, 0),
Position = UDim2.new(0.5, 0, 0, 10),
Visible = false,
Theme = { BackgroundColor3 = "surface" },
Parent = self.gui,
})
Create.corner(-1, self.pill)
Create.stroke("stroke", self.pill)
Create.padding(self.pill, 16, 0)
Create.list(self.pill, "Horizontal", 8)
Create.icon(self.Icon or "menu", 16, "accent", self.pill)
self.pillLabel = Create.new("TextLabel", {
Name = "Title",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = self.Title,
TextSize = 13,
Weight = "bold",
LayoutOrder = 1,
Theme = { TextColor3 = "text" },
Parent = self.pill,
})
Create.icon("maximize-2", 14, "textMuted", self.pill).LayoutOrder = 2
Drag.move(self.scope, self.pill, self.pill, {
onTap = function()
self:restore()
end,
})
if not library.touch and options.Resizable ~= false then
self:buildGrip()
end
self.scope:connect(UserInputService.InputBegan, function(input, processed)
if not processed and not library.listeningForKey and self.toggleKey and input.KeyCode == self.toggleKey then
self:menuKey()
end
end)
self.scope:connect(self.gui:GetPropertyChangedSignal("AbsoluteSize"), function()
self:layout()
end)
self.scope:add(Theme.Changed:Connect(function()
self:savePreferences()
end))
if options.CommandPalette then
self.paletteBound = true
CommandPalette.bind(self)
end
Personalise.restore(self, saved.personal, false)
local updates = UpdateLog.settings(options.UpdateLog)
if updates then
self.pendingUpdates = {}
task.defer(function()
if self.scope.cleaned then
return
end
local log = UpdateLog.build(self, updates)
for _, update in self.pendingUpdates do
log.add(update)
end
self.pendingUpdates = nil
end)
end
if options.FocusRing ~= false then
self:buildFocusRing()
end
Switches.build(self)
if options.TabReorder then
TabOrder.setup(self, saved.tabOrder)
end
Services.watchUpdates(self, options.UpdateCheck)
self:layout()
if options.Favourites then
Favourites.setup(self, saved.favourites)
end
self:pop(true)
return self
end
function Window:Set(name, value)
return Switches.set(self, name, value)
end
function Window:Get(name)
return Switches.get(self, name)
end
function Window:buildFocusRing()
local ring = Create.new("Frame", { Name = "FocusRing", Size = UDim2.new(1, 6, 1, 6), Position = UDim2.fromOffset(-3, -3), BackgroundTransparency = 1 })
Create.corner(10, ring)
Create.new("UIStroke", { Thickness = 2, Theme = { Color = "focus" }, Parent = ring })
self.scope:add(ring)
local function mark(instance)
if instance:IsA("GuiButton") or instance:IsA("TextBox") then
instance.SelectionImageObject = ring
end
end
for _, instance in self.gui:GetDescendants() do
mark(instance)
end
self.scope:connect(self.gui.DescendantAdded, mark)
self.scope:connect(UserInputService.InputBegan, function(input, processed)
if processed or input.KeyCode ~= Enum.KeyCode.ButtonSelect then
return
end
self:Toggle()
if self.Visible and self.selected and self.selected.button then
GuiService.SelectedObject = self.selected.button
end
end)
end
function Window:SetPersonal(key, value)
return Personalise.set(self, key, value)
end
function Window:PersonaliseSection(tab, options)
return Personalise.section(self, tab, options)
end
function Window:ThemeBuilder(tab, options)
return Personalise.builder(self, tab, options)
end
function Window:Loading(options)
return Panels.loading(self, options)
end
function Window:Changelog(options)
return Panels.changelog(self, options)
end
function Window:About(tab, options)
return Panels.about(self, tab, options)
end
function Window:AddUpdate(update)
if self.updateLog then
self.updateLog.add(update)
elseif self.pendingUpdates then
table.insert(self.pendingUpdates, update)
else
warn("[Halcyon] AddUpdate needs UpdateLog = true on CreateWindow.")
end
end
function Window:Lock(options)
return Panels.lock(self, options)
end
function Window:Unlock()
return Panels.unlock(self)
end
function Window:OpenPalette()
return CommandPalette.open(self)
end
function Window:buildShadow()
local root, scope, options = self.root, self.scope, self.options
local shadow = Create.new("Frame", { Name = "Shadow", AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 0, Parent = self.gui })
scope:add(shadow)
local scale = Create.new("UIScale", { Scale = self.scale, Parent = shadow })
Create.new("ImageLabel", {
Name = "Image",
Size = UDim2.new(1, SHADOW_SPREAD * 2, 1, SHADOW_SPREAD * 2),
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(0.5, 0, 0.5, 6),
Image = options.ShadowImage or SHADOW_IMAGE,
ImageColor3 = Color3.new(0, 0, 0),
ImageTransparency = math.clamp(tonumber(options.ShadowTransparency) or 0.5, 0, 1),
ScaleType = Enum.ScaleType.Slice,
SliceCenter = Rect.new(99, 99, 99, 99),
Parent = shadow,
})
local function follow()
shadow.Size = root.Size
shadow.Position = root.Position
shadow.Visible = root.Visible and not self.shadowOff
scale.Scale = self.uiScale.Scale
end
for _, property in { "Size", "Position", "Visible" } do
scope:connect(root:GetPropertyChangedSignal(property), follow)
end
scope:connect(self.uiScale:GetPropertyChangedSignal("Scale"), follow)
follow()
self.shadow = shadow
end
function Window:buildSurface()
local look = Styles.pick("Window", nil, self)
local root, options = self.root, self.options
self.surfaceLook = look
if look.edge then
local stroke = root:FindFirstChildOfClass("UIStroke")
Theme.bind(stroke, "Color", look.edge)
stroke.Transparency = look.edgeTransparency or 0
end
if look.sheen then
Create.new("Frame", {
Name = "Sheen",
Size = UDim2.new(1, 0, 0, 140),
ZIndex = 0,
BackgroundColor3 = Color3.new(1, 1, 1),
BackgroundTransparency = 0.94,
Parent = root,
}, {
Create.new("UIGradient", {
Rotation = 90,
Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
}),
})
end
if look.gradient then
local gradient = Create.new("UIGradient", { Rotation = 35, Parent = root })
local function tint()
local base = Theme.color("background")
gradient.Color = ColorSequence.new(base:Lerp(Theme.color("accent"), 0.1), base)
end
tint()
Theme.unbind(root, "BackgroundColor3")
root.BackgroundColor3 = Color3.new(1, 1, 1)
self.scope:connect(Theme.Changed, tint)
end
if look.image or options.BackgroundImage then
local image = Create.new("ImageLabel", {
Name = "Backdrop",
Size = UDim2.fromScale(1, 1),
ZIndex = 0,
ScaleType = Enum.ScaleType.Crop,
ImageTransparency = math.clamp(tonumber(options.BackgroundImageTransparency) or 0.75, 0, 1),
Parent = root,
})
Create.corner(12, image)
Icons.apply(image, options.BackgroundImage)
self.backdrop = image
end
self:SetTransparency(tonumber(options.Transparency) or look.transparency or 0)
if options.Background then
self:SetBackground(options.Background)
end
end
function Window:SetBackground(spec)
if self.movingBackground then
self.movingBackground.Destroy()
self.movingBackground = nil
end
local seeThrough = if type(spec) == "table" and tonumber(spec.SeeThrough) then tonumber(spec.SeeThrough) else 0.35
self.cardSeeThrough = if spec then math.clamp(seeThrough, 0, 0.6) else 0
local places = table.clone(self.tabs)
for _, page in self.subPages do
table.insert(places, page)
end
for _, place in places do
for _, section in place.sections do
section:applySeeThrough()
end
end
local controller = Background.new(self.root, spec, {
Intensity = 0.75,
Radius = 12,
Vignette = true,
Scale = function()
return self.scale
end,
})
if not controller then
return
end
self.movingBackground = controller
local connection = self.root:GetPropertyChangedSignal("Visible"):Connect(function()
controller.SetVisible(self.root.Visible)
end)
local destroy = controller.Destroy
function controller.Destroy()
connection:Disconnect()
destroy()
end
self.scope:add(controller.Destroy)
end
function Window:SetTransparency(value)
self.transparency = math.clamp(tonumber(value) or 0, 0, 0.6)
self.root.BackgroundTransparency = self.transparency
return self.transparency
end
function Window:pop(firstOpen)
if not self.root.Visible then
return
end
self.motionGeneration = (self.motionGeneration or 0) + 1
local generation = self.motionGeneration
local look = Styles.pick("Open", nil, self)
if Motion.reduced then
return
end
local timing = look.timing or "base"
local function start()
local rest = { position = self.root.Position, size = self.root.Size }
if look.scale then
self.uiScale.Scale = self.scale * look.scale
end
if look.offset then
self.root.Position = rest.position + UDim2.fromOffset(look.offset.X, look.offset.Y)
end
local unroll = look.unroll and not self.minimized
if unroll then
self.root.Size = UDim2.fromOffset(rest.size.X.Offset, self.topbarHeight)
end
local function move()
if look.scale then
Motion.tween(self.uiScale, timing, { Scale = self.scale })
end
if look.offset then
Motion.tween(self.root, timing, { Position = rest.position })
end
if unroll then
Motion.tween(self.root, "slow", { Size = rest.size })
end
end
local function settle()
self.uiScale.Scale = self.scale
self.root.Position, self.root.Size = rest.position, rest.size
end
return move, settle
end
if not firstOpen then
local move = start()
move()
return
end
task.defer(function()
if generation ~= self.motionGeneration or self.scope.cleaned or not self.root.Visible then
return
end
local move, settle = start()
RunService.RenderStepped:Wait()
RunService.Heartbeat:Wait()
if self.scope.cleaned then
return
end
if generation ~= self.motionGeneration then
settle()
else
move()
end
end)
end
function Window:unpop(done)
self.motionGeneration = (self.motionGeneration or 0) + 1
local generation = self.motionGeneration
local look = Styles.pick("Open", nil, self)
if Motion.reduced or not self.styles.Open or not self.root.Visible or not (look.scale or look.offset or look.unroll) then
done()
return
end
if look.scale then
Motion.tween(self.uiScale, "fast", { Scale = self.scale * look.scale })
end
local rest = self.root.Position
if look.offset then
Motion.tween(self.root, "fast", { Position = rest + UDim2.fromOffset(look.offset.X, look.offset.Y) })
end
if look.unroll then
Motion.tween(self.root, "fast", { Size = UDim2.fromOffset(self.root.Size.X.Offset, self.topbarHeight) })
end
task.delay(0.13, function()
if generation ~= self.motionGeneration or self.scope.cleaned then
return
end
done()
self.uiScale.Scale = self.scale
self:layout()
end)
end
function Window:buildTopbar()
local scope = self.scope
local header = self.header
local topbar = Create.new("Frame", { Name = "Topbar", Size = UDim2.new(1, 0, 0, self.topbarHeight), ZIndex = 3, Parent = self.root })
self.topbar = topbar
self.topbarSeam = Hairline.new("X", "stroke", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = topbar })
local brand = Create.new("Frame", { Name = "Brand", Size = UDim2.fromScale(1, 1), Parent = topbar })
self.brand = brand
local inset = Create.padding(brand, 16, 0)
Create.list(brand, "Horizontal", if header.image then 12 else 10)
local heading
if header.wordmark then
Header.wordmark(self, brand)
heading = brand
else
local picture = self.options.TopbarImage
if picture == true then
picture = self.Icon
end
if picture then
self:buildTopbarImage(brand, picture)
elseif self.Icon then
Create.icon(self.Icon, header.icon or 20, "accent", brand)
end
local titles = Create.new("Frame", { Name = "Titles", Size = UDim2.fromScale(0, 1), LayoutOrder = 1, Parent = brand }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.list(titles, "Vertical", 0, { VerticalAlignment = Enum.VerticalAlignment.Center })
heading = Create.new("Frame", { Name = "Heading", Size = UDim2.new(1, 0, 0, (header.title or 14) + 4), ClipsDescendants = true, Parent = titles })
Create.list(heading, "Horizontal", 8)
self.titleLabel = Create.new("TextLabel", {
Name = "Title",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = self.Title,
TextSize = header.title or 14,
TextTruncate = Enum.TextTruncate.AtEnd,
Weight = "bold",
Theme = { TextColor3 = "text" },
Parent = heading,
}, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Shrink }),
})
self.subtitleLabel = Create.new("TextLabel", {
Name = "Subtitle",
Size = UDim2.new(1, 0, 0, (header.subtitle or 12) + 3),
Text = self.Subtitle or "",
TextSize = header.subtitle or 12,
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 1,
Visible = self.Subtitle ~= nil,
Theme = { TextColor3 = "textMuted" },
Parent = titles,
})
end
self.versionTag = Create.new("TextLabel", {
Name = "Version",
Size = if header.wordmark then UDim2.fromOffset(0, 20) else UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(self.options.Version or ""),
TextSize = 12,
Weight = "medium",
LayoutOrder = 1,
BackgroundTransparency = 0.85,
Visible = self.options.Version ~= nil and self.options.ShowVersion ~= false,
Theme = { BackgroundColor3 = "accent", TextColor3 = "accent" },
Parent = heading,
})
Create.corner(5, self.versionTag)
Create.padding(self.versionTag, 6, 0)
self.topbarTitle, self.topbarSubtitle = self.titleLabel, self.subtitleLabel
local actions = Create.new("Frame", {
Name = "Actions",
AnchorPoint = Vector2.new(1, 0),
Position = UDim2.new(1, -6, 0, 0),
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Parent = topbar,
})
Create.list(actions, "Horizontal", 2, { HorizontalAlignment = Enum.HorizontalAlignment.Right })
scope:connect(actions:GetPropertyChangedSignal("AbsoluteSize"), function()
inset.PaddingRight = UDim.new(0, actions.AbsoluteSize.X / self.scale + 14)
end)
local search, box = Header.searchBox(self, scope, actions, UDim2.fromOffset(170, 30))
self.searchFrame, self.searchBox = search, box
self.topbarSearch, self.topbarBox = search, box
search.Visible = self.options.Search ~= false
scope:connect(box.Focused, function()
self:fitTopbarSearch()
end)
scope:connect(box.FocusLost, function()
self:fitTopbarSearch()
end)
self.chipHolder = Create.new("Frame", {
Name = "Profile",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
LayoutOrder = 1,
Parent = actions,
})
Create.list(self.chipHolder, "Horizontal", 0)
local function action(icon, order, callback)
local button = Create.new("TextButton", { Name = icon, Text = "", Size = UDim2.new(0, if self.library.touch then 44 else 40, 1, 0), LayoutOrder = order, Parent = actions })
local glyph = centred(Create.icon(icon, 16, "textMuted", button))
scope:connect(button.MouseEnter, function()
Theme.bind(glyph, "ImageColor3", "text")
end)
scope:connect(button.MouseLeave, function()
Theme.bind(glyph, "ImageColor3", "textMuted")
end)
scope:connect(button.Activated, callback)
return glyph
end
self.topbarActions, self.topbarAction = actions, action
if self.options.SidebarToggle then
action("panel-left", 1.5, function()
self:SetTabStyle(if self.tabStyle == "Sidebar" then "Rail" else "Sidebar")
end)
end
if Styles.pick("Controls", nil, self).dots then
self.dots = self:buildDots(brand)
else
self.minimizeGlyph = action("minus", 2, function()
self:Minimize(not self.minimized)
end)
self.minimizeButton = self.minimizeGlyph.Parent
self.minimizeButton.Visible = self.options.Minimizable ~= false
self.closeButton = action("x", 3, function()
self:Hide()
end).Parent
self.closeButton.Visible = self.options.Close ~= false
end
Drag.move(scope, topbar, self.root, self:dragOptions())
end
function Window:dragOptions()
return {
enabled = function()
return not self.dragLocked
end,
onMoved = function()
local corner = self.root.AbsolutePosition - self.gui.AbsolutePosition
self.placed = self:snap(Vector2.new(math.round(corner.X), math.round(corner.Y)))
self:layout()
self:savePreferences()
end,
}
end
function Window:minimizeMode()
if self.sidebarHeader and self.minimizeStyle == "Topbar" then
return "Pill"
end
return self.minimizeStyle
end
function Window:buildTopbarImage(brand, source)
local look = Styles.pick("TopbarImage", self.options.TopbarImageStyle, self)
local size = self.header.image or look.size or 28
local holder = Create.new("Frame", { Name = "TopbarImage", Size = UDim2.fromOffset(size, size), Parent = brand })
local image = Create.new("ImageLabel", {
Name = "Image",
Size = UDim2.fromScale(1, 1),
ScaleType = Enum.ScaleType.Crop,
Theme = { BackgroundColor3 = "raised" },
Parent = holder,
})
Create.corner(look.corner or -1, image)
if Assets.kind(source) == nil and type(source) == "string" then
image.BackgroundTransparency = 1
image.ScaleType = Enum.ScaleType.Fit
Theme.bind(image, "ImageColor3", "accent")
end
Icons.apply(image, source)
if look.ring then
Create.new("UIStroke", { Thickness = 2, Theme = { Color = "accent" }, Parent = image })
end
if look.dot then
local dot = Create.new("Frame", {
Name = "Dot",
Size = UDim2.fromOffset(9, 9),
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(1, -1, 1, -1),
ZIndex = 2,
Theme = { BackgroundColor3 = "success" },
Parent = holder,
})
Create.corner(-1, dot)
Create.new("UIStroke", { Thickness = 2, Theme = { Color = "background" }, Parent = dot })
end
self.topbarImage = image
return image
end
function Window:buildDots(brand)
local scope = self.scope
local size = if self.library.touch then 18 else 13
local group = Create.new("Frame", { Name = "Dots", Size = UDim2.fromOffset(size * 3 + 16, size), LayoutOrder = -1, Parent = brand })
Create.list(group, "Horizontal", 8)
local glyphs = {}
local function dot(role, icon, order, callback)
local button = Create.new("TextButton", { Name = icon, Text = "", Size = UDim2.fromOffset(size, size), LayoutOrder = order, Theme = { BackgroundColor3 = role }, Parent = group })
Create.corner(-1, button)
local glyph = centred(Create.icon(icon, size - 5, "background", button))
glyph.ImageTransparency = 1
table.insert(glyphs, glyph)
scope:connect(button.Activated, callback)
return glyph
end
self.closeButton = dot("danger", "x", 1, function()
self:Hide()
end).Parent
self.closeButton.Visible = self.options.Close ~= false
self.minimizeGlyph = dot("warning", "minus", 2, function()
self:Minimize(not self.minimized)
end)
self.minimizeButton = self.minimizeGlyph.Parent
self.minimizeButton.Visible = self.options.Minimizable ~= false
dot("success", "maximize-2", 3, function()
local large = Vector2.new(1100, 700)
if self.size.X >= large.X and self.size.Y >= large.Y and self.smallSize then
self.size, self.smallSize = self.smallSize, nil
else
self.smallSize, self.size = self.size, large
end
self:layout()
self:savePreferences()
end)
scope:connect(group.MouseEnter, function()
for _, glyph in glyphs do
Motion.tween(glyph, "fast", { ImageTransparency = 0.2 })
end
end)
scope:connect(group.MouseLeave, function()
for _, glyph in glyphs do
Motion.tween(glyph, "fast", { ImageTransparency = 1 })
end
end)
return group
end
function Window:snap(corner)
if not self.options.Snap then
return corner
end
local view = self.gui.AbsoluteSize
local shown = self.root.AbsoluteSize
local margin = 8
local x, y = corner.X, corner.Y
if math.abs(x - margin) < SNAP then
x = margin
elseif math.abs(x + shown.X - (view.X - margin)) < SNAP then
x = view.X - margin - shown.X
elseif math.abs(x + shown.X / 2 - view.X / 2) < SNAP then
x = view.X / 2 - shown.X / 2
end
if math.abs(y - margin) < SNAP then
y = margin
elseif math.abs(y + shown.Y - (view.Y - margin)) < SNAP then
y = view.Y - margin - shown.Y
end
return Vector2.new(math.round(x), math.round(y))
end
function Window:AddTopbarButton(options)
options = options or {}
self.extraButtons = (self.extraButtons or 0) + 1
local glyph = self.topbarAction(options.Icon or "circle", 1 + self.extraButtons / 100, function()
Env.call("Top bar button", options.Callback)
end)
local button = glyph.Parent
return {
Destroy = function()
button:Destroy()
end,
}
end
function Window:SetEnabled(enabled)
self.disabledAll = enabled == false
local places = table.clone(self.tabs)
for _, page in self.subPages do
table.insert(places, page)
end
for _, tab in places do
for _, entry in tab.entries do
if entry.handle.SetBlocked then
entry.handle:SetBlocked(Registry.blocked(self, entry.section))
end
end
end
end
function Window:buildGrip()
local grip = Create.new("TextButton", {
Name = "Resize",
Text = "",
Size = UDim2.fromOffset(18, 18),
AnchorPoint = Vector2.new(1, 1),
Position = UDim2.new(1, -2, 1, -2),
ZIndex = 10,
Parent = self.root,
})
self.grip = grip
for _, offset in { Vector2.new(12, 12), Vector2.new(7, 12), Vector2.new(12, 7) } do
Create.new("Frame", {
Size = UDim2.fromOffset(2, 2),
Position = UDim2.fromOffset(offset.X, offset.Y),
Theme = { BackgroundColor3 = "textMuted" },
Parent = grip,
})
end
Resize.grip(self.scope, grip, function()
if self.minimized then
return nil
end
local root, scale = self.root, self.scale
local shown = Vector2.new(root.Size.X.Offset, root.Size.Y.Offset)
local corner = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset) - shown * scale / 2
self.placed = Vector2.new(math.round(corner.X), math.round(corner.Y))
local room = self.gui.AbsoluteSize - self.placed - Vector2.new(8, 8)
return { size = shown, scale = scale, min = MIN_SIZE, max = room / scale }
end, function(size)
self.size = size
self:layout()
end, function()
self:savePreferences()
end)
end
function Window:layout()
local view, scale = self.gui.AbsoluteSize, self.scale
local width = math.floor(math.max(math.min(self.size.X, (view.X - 16) / scale), 240))
local height = math.floor(math.max(math.min(self.size.Y, (view.Y - 16) / scale), 200))
local folded = self.minimized and self:minimizeMode() == "Topbar"
self.root.Size = UDim2.fromOffset(width, if folded then self.topbarHeight else height)
self.body.Visible = not folded
self.topbarSeam.Visible = not folded and not self.sidebarHeader
if self.grip then
self.grip.Visible = not folded and self.options.Resizable ~= false
end
local narrow = width < NARROW
local style = self.tabStyle
if narrow and self:lane(style) then
style = "Top"
end
if style ~= self.activeStyle then
self.activeStyle = style
self:buildNav()
end
self.narrowTopbar = narrow
self:fitTopbarSearch()
if self.grip then
self.grip.Position = UDim2.new(1, -2, 1, -2 - (if style == "Dock" then STRIPS.Dock else 0))
end
self.wide = width - (self:lane(style) or 0) >= COLUMNS
for _, tab in self.tabs do
tab:reflow(self.wide)
end
for _, page in self.subPages do
page:reflow(self.wide)
end
local shown = Vector2.new(width * scale, height * scale)
local corner = self.placed or (view - shown) / 2
corner = Vector2.new(
math.round(math.clamp(corner.X, 0, math.max(view.X - shown.X, 0))),
math.round(math.clamp(corner.Y, 0, math.max(view.Y - shown.Y, 0)))
)
self.root.Position = UDim2.fromOffset(corner.X + shown.X / 2, corner.Y + shown.Y / 2)
end
function Window:fitTopbarSearch()
local search, box = self.topbarSearch, self.topbarBox
local folded = self.narrowTopbar and not box:IsFocused() and box.Text == ""
search.Size = UDim2.fromOffset(if folded then 34 elseif self.narrowTopbar then 150 else 170, 30)
box.Position = UDim2.fromOffset(if folded then 0 else 32, 0)
box.Size = if folded then UDim2.fromScale(1, 1) else UDim2.new(1, -38, 1, 0)
box.PlaceholderText = if folded then "" else Strings.get("Search")
end
function Window:lane(style)
if style == "Sidebar" and tonumber(self.options.SidebarWidth) then
return math.clamp(math.floor(self.options.SidebarWidth), 150, 280)
end
return LANES[style]
end
function Window:buildNav()
if self.navScope then
self.scope:release(self.navScope)
end
Popup.close(self.library)
local scope = self.scope:child()
self.navScope = scope
local style = self.activeStyle
local lane, strip = self:lane(style), STRIPS[style]
local sidebarHeader = self.header.sidebar == true and style == "Sidebar"
Header.apply(self, sidebarHeader)
local top = if sidebarHeader then Header.STRIP else 0
local host = Create.new("Frame", { Name = "Navigation", Parent = self.body })
scope:add(host)
self.navHost = host
local seam = Hairline.new(if lane then "Y" else "X", "stroke", { ZIndex = 2, Parent = host })
local list
if lane then
host.Size = UDim2.new(0, lane, 1, 0)
seam.AnchorPoint = Vector2.new(1, 0)
seam.Position = UDim2.fromScale(1, 0)
self.pages.Position = UDim2.fromOffset(lane, top)
self.pages.Size = UDim2.new(1, -lane, 1, -top)
local column = Create.new("Frame", { Name = "Column", Size = UDim2.new(1, -1, 1, 0), Parent = host })
Create.list(column, "Vertical", 0)
if sidebarHeader then
Header.sidebarTop(self, scope, column)
end
list = Create.new("ScrollingFrame", { Name = "Tabs", Size = UDim2.fromScale(1, 0), ScrollBarThickness = 0, Parent = column }, {
Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }),
})
Create.padding(list, 8)
Create.list(list, "Vertical", 2)
if self.profile.Enabled then
Hairline.new("X", "stroke", { LayoutOrder = 1, Parent = column })
local footer = Create.new("Frame", {
Name = "Footer",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 2,
Parent = column,
})
Create.list(footer, "Vertical", 0, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
if style == "Sidebar" then
Profile.card(self, scope, footer)
else
Profile.chip(self, scope, footer)
end
end
else
host.Size = UDim2.new(1, 0, 0, strip)
list = Create.new("ScrollingFrame", {
Name = "Tabs",
Size = UDim2.new(1, 0, 1, -1),
ScrollBarThickness = 0,
ScrollingDirection = Enum.ScrollingDirection.X,
AutomaticCanvasSize = Enum.AutomaticSize.X,
Parent = host,
})
if style == "Top" then
seam.AnchorPoint = Vector2.new(0, 1)
seam.Position = UDim2.fromScale(0, 1)
self.pages.Position = UDim2.fromOffset(0, strip)
Create.padding(list, 8, 0)
Create.list(list, "Horizontal", 4)
else
host.AnchorPoint = Vector2.new(0, 1)
host.Position = UDim2.fromScale(0, 1)
list.Position = UDim2.fromOffset(0, 1)
self.pages.Position = UDim2.fromOffset(0, 0)
Create.padding(list, 6, 4)
Create.list(list, "Horizontal", 2, { HorizontalFlex = Enum.UIFlexAlignment.Fill })
end
self.pages.Size = UDim2.new(1, 0, 1, -strip)
end
local order, group = 0, nil
for _, tab in self:navOrder() do
if tab.Hidden then
tab.button = nil
continue
end
local heading = self:navGroup(tab)
if style == "Sidebar" and heading and heading ~= group and heading ~= PINNED then
order += 1
self:buildGroupHeading(list, scope, heading, order)
end
group = heading
order += 1
tab:buildButton(style, list, scope, order)
if style == "Sidebar" and heading and self.collapsedGroups[heading] then
tab.button.Visible = false
end
if self.tabOrder then
TabOrder.attach(self, tab, scope, self:lane(style) ~= nil)
end
end
self.chipHolder:ClearAllChildren()
Create.list(self.chipHolder, "Horizontal", 0)
if self.profile.Enabled and not lane then
Profile.chip(self, scope, self.chipHolder)
end
self:paintTabs()
end
function Window:buildGroupHeading(parent, scope, name, order)
local collapsible = self.options.CollapsibleGroups ~= false
local heading = Create.new(if collapsible then "TextButton" else "Frame", {
Name = "Group",
Size = UDim2.new(1, 0, 0, if collapsible and self.library.touch then 40 else 28),
LayoutOrder = order,
Parent = parent,
})
local label = Create.new("TextLabel", {
Name = "Title",
Position = UDim2.fromOffset(10, 0),
Size = UDim2.new(1, -34, 1, 0),
Text = name,
TextSize = 12,
Weight = "medium",
TextTruncate = Enum.TextTruncate.AtEnd,
Theme = { TextColor3 = "textMuted" },
Parent = heading,
})
if not collapsible then
return
end
local arrow = Create.icon("chevron-down", 14, "textMuted", heading)
arrow.AnchorPoint = Vector2.new(1, 0.5)
arrow.Position = UDim2.new(1, -10, 0.5, 0)
arrow.Rotation = if self.collapsedGroups[name] then -90 else 0
scope:connect(heading.MouseEnter, function()
Theme.bind(label, "TextColor3", "text")
Theme.bind(arrow, "ImageColor3", "text")
end)
scope:connect(heading.MouseLeave, function()
Theme.bind(label, "TextColor3", "textMuted")
Theme.bind(arrow, "ImageColor3", "textMuted")
end)
scope:connect(heading.Activated, function()
self:SetGroupCollapsed(name, not self.collapsedGroups[name])
end)
end
function Window:SetGroupCollapsed(name, collapsed)
self.collapsedGroups[name] = if collapsed then true else nil
self:buildNav()
self:savePreferences()
end
function Window:navGroup(tab)
if TabOrder.isPinned(self, tab) then
return PINNED
end
return tab.Group
end
function Window:navOrder()
local rank, made = {}, {}
for index, tab in self.tabs do
local placed = TabOrder.position(self, tab)
made[tab] = if placed then placed else 1000 + index
local key = self:navGroup(tab) or ""
if rank[key] == nil and not tab.trailing then
rank[key] = if TabOrder.isPinned(self, tab) then -1 else index
end
end
local ordered = table.clone(self.tabs)
table.sort(ordered, function(a, b)
local first, second = rank[self:navGroup(a) or ""] or math.huge, rank[self:navGroup(b) or ""] or math.huge
if first ~= second then
return first < second
end
if (a.trailing == true) ~= (b.trailing == true) then
return b.trailing == true
end
return made[a] < made[b]
end)
return ordered
end
function Window:paintTabs()
local open = self.selected
local root = open and (open.rootTab or open)
local found = {}
for _, page in self.subPages do
found[page.rootTab] = (found[page.rootTab] or 0) + page.matches
end
for _, tab in self.tabs do
tab:paint(tab == root, self.query ~= "" and tab.matches + (found[tab] or 0) == 0)
end
end
function Window:Tab(options)
if type(options) == "string" then
options = { Title = options }
end
if type(options) ~= "table" or type(options.Title) ~= "string" then
error("Tab needs a Title", 2)
end
Schema.check(`Tab "{options.Title}"`, options, Schema.tab)
local tab = Tab.new(self, options)
table.insert(self.tabs, tab)
tab:reflow(self.wide)
self:buildNav()
if not tab.Hidden and not self.makingFavourites and (not self.selected or self.selected.Hidden) then
self:SelectTab(tab)
end
if options.ShowWhen ~= nil then
local source, expected = Registry.condition(options.ShowWhen)
Registry.follow(tab, source, expected, true)
end
return tab
end
function Window:tabShownChanged(tab)
self:buildNav()
if tab.Hidden and self.selected == tab then
for _, other in self.tabs do
if not other.Hidden then
self:SelectTab(other)
break
end
end
elseif not tab.Hidden and (not self.selected or self.selected.Hidden) then
self:SelectTab(tab)
end
self:applySearch()
end
function Window:SelectTab(tab)
if self.selected == tab or tab.Hidden then
return
end
Popup.close(self.library)
if self.selected then
self.selected.page.Visible = false
end
self.selected = tab
tab.page.Visible = true
local arrive = Styles.pick("PageTransition", nil, self)
if arrive.offset and not Motion.reduced then
tab.page.Position = UDim2.fromOffset(arrive.offset.X, arrive.offset.Y)
Motion.tween(tab.page, "base", { Position = UDim2.fromOffset(0, 0) })
else
tab.page.Position = UDim2.fromOffset(0, 0)
end
self:paintTabs()
self.TabChanged:Fire(tab)
end
function Window:applySearch(query)
if query ~= nil then
self.query = string.lower(string.match(query, "^%s*(.-)%s*$"))
end
local first
for _, tab in self.tabs do
if tab:filter(self.query) > 0 and not first and not tab.Hidden then
first = tab
end
end
for _, page in self.subPages do
if page:filter(self.query) > 0 and not first and not page.rootTab.Hidden then
first = page
end
end
if self.query ~= "" and first and self.selected and self.selected.matches == 0 then
self:SelectTab(first)
end
self.empty.Visible = self.query ~= "" and first == nil
self:updateMatchCounter()
self.empty.Text = Strings.get('Nothing matches "{query}".', { query = self.query })
if self.selected then
self.selected.page.Visible = not self.empty.Visible
end
self:paintTabs()
end
function Window:Search(query)
self.searchBox.Text = query or ""
end
function Window:searchMatches()
local matches = {}
local function collect(tab)
for _, entry in tab.entries do
if entry.handle.searchMatched then
table.insert(matches, { tab = tab, handle = entry.handle })
end
end
end
for _, tab in self:navOrder() do
if not tab.Hidden then
collect(tab)
for _, page in self.subPages do
if page.rootTab == tab then
collect(page)
end
end
end
end
return matches
end
function Window:JumpToMatch(step)
local matches = self:searchMatches()
if #matches == 0 then
return nil
end
local index = self.matchIndex
index = if index then (index - 1 + (step or 1)) % #matches + 1 else (if (step or 1) < 0 then #matches else 1)
self.matchIndex = index
local found = matches[index]
self:SelectTab(found.tab)
SearchFocus.reveal(self, found.tab, found.handle)
self:updateMatchCounter(#matches)
return found.handle
end
function Window:updateMatchCounter(total)
local counter = self.searchCounter
if not counter then
return
end
total = total or #self:searchMatches()
counter.Visible = self.query ~= "" and total > 0
counter.Text = if self.matchIndex then Strings.get("{index} of {total}", { index = self.matchIndex, total = total }) else tostring(total)
end
function Window:checkFlag(flag)
if flag == nil then
return nil
elseif type(flag) ~= "string" or flag == "" then
return "A Flag must be a non-empty string"
end
local owner = self.Flags[flag]
return if owner then `Flag "{flag}" is already used by "{owner.Title or flag}"` else nil
end
function Window:claimFlag(flag, handle, scope)
if flag == nil then
return
end
handle.Flag = flag
self.Flags[flag] = handle
self.config.flags[flag] = handle
local owner = scope or handle.scope
owner:add(function()
if self.Flags[flag] == handle then
self.Flags[flag] = nil
self.config.flags[flag] = nil
end
end)
end
function Window:HasTier(name)
local access = self.access
if name == nil then
return true
end
local rank = table.find(access.Tiers, name)
if not rank then
if not access.Keyless then
warn(`[Halcyon] Tier "{name}" is not one of this window's tiers, so what it gates stays locked.`)
end
return false
end
return access.Rank >= rank
end
function Window:IsPaid()
local access = self.access
return access.PaidRank ~= nil and access.Rank >= access.PaidRank
end
function Window:allows(requirement)
if requirement == true then
return self:IsPaid()
end
return self:HasTier(requirement)
end
function Window:applyGate(handle, requirement)
if handle.MissingText then
handle:Lock(handle.MissingText, "wrench")
return
end
if self:allows(requirement) then
handle:Unlock()
return
end
local wording = self:lockWording(requirement, handle.LockText, handle.LockHint)
handle:Lock(wording, if requirement == true then "crown" else "lock", handle.QuietLock)
end
function Window:lockWording(requirement, ownText, ownHint)
local paid = requirement == true
local wording = ownText
if not wording and paid then
wording = self.paidLockText
elseif not wording then
wording = string.gsub(self.lockText, "{tier}", function()
return requirement
end)
end
return wording, ownHint or (if paid then self.paidLockHint else self.lockHint)
end
function Window:gate(handle, requirement)
self.gated[handle] = requirement
handle.scope:add(function()
self.gated[handle] = nil
end)
if not self:allows(requirement) then
self:applyGate(handle, requirement)
end
end
function Window:applyGates()
for handle, requirement in self.gated do
self:applyGate(handle, requirement)
end
for _, section in self.lockedSections do
section:refreshLock()
end
end
function Window:GetTier()
return self.access.Tier
end
function Window:GetKeyExpiry()
local expires = self.access.ExpiresAt
return if expires then math.max(expires - os.time(), 0) else nil
end
function Window:SetTier(name)
local access = self.access
local rank = table.find(access.Tiers, name)
if not rank then
return false
end
access.Tier, access.Rank = name, rank
self:applyGates()
self:buildNav()
return true
end
function Window:SetLockText(text, paidText)
self.lockText = text or self.lockText
self.paidLockText = paidText or self.paidLockText
self:applyGates()
end
function Window:SetLockHint(hint, paidHint)
if hint ~= nil then
self.lockHint = hint
end
if paidHint ~= nil then
self.paidLockHint = paidHint
end
self:applyGates()
end
function Window:refreshVisibility()
for _, hook in self.visibilityHooks or {} do
task.defer(hook)
end
local mode = self:minimizeMode()
local docked = self.minimized and mode ~= "Topbar"
self.root.Visible = self.Visible and not docked
self.pill.Visible = self.Visible and docked and mode == "Pill"
self.openButton.Visible = (self.Visible and docked and mode == "Chip")
or (not self.Visible and (self.library.touch or self.options.OpenButton == true))
end
function Window:restore()
if self.Visible then
self:Minimize(false)
else
self:Show()
end
end
function Window:Show()
local hidden = not self.root.Visible
self.Visible = true
self:refreshVisibility()
if hidden then
self:pop()
end
end
function Window:Hide()
Popup.close(self.library)
self.Visible = false
self:unpop(function()
if not self.Visible then
self:refreshVisibility()
end
end)
if not self.openButton.Visible and not self.hinted and self.toggleKey then
self.hinted = true
self:Notify({ Title = Strings.get("Menu hidden"), Content = Strings.get("Press {key} to open it again.", { key = self.toggleKey.Name }) })
end
end
function Window:Toggle()
if self.Visible then
self:Hide()
else
self:Show()
end
end
function Window:menuKey()
local folds = self:minimizeMode() ~= "Topbar" and self.options.Minimizable ~= false
if not folds or not self.Visible then
self:Toggle()
else
self:Minimize(not self.minimized)
end
end
function Window:Minimize(minimized)
self.minimized = minimized == true
if self.minimizeGlyph then
Icons.apply(self.minimizeGlyph, if self.minimized then "maximize-2" else "minus")
end
Popup.close(self.library)
self:layout()
self:refreshVisibility()
Switches.applyBlur(self)
end
function Window:SetMinimizeStyle(name)
if not MINIMIZE[name] then
return false
end
self.minimizeStyle = name
self:layout()
self:refreshVisibility()
self:savePreferences()
return true
end
function Window:SetTabStyle(name)
if not (LANES[name] or STRIPS[name]) then
return false
end
self.tabStyle = name
self:layout()
self:savePreferences()
return true
end
function Window:SetScale(scale)
self.scale = math.clamp(tonumber(scale) or 1, 0.75, 1.25)
self.library.scale = self.scale
self.uiScale.Scale = self.scale
Hairline.setScale(self.scale)
Popup.close(self.library)
self:layout()
self:savePreferences()
end
function Window:SetToggleKey(key)
self.toggleKey = if typeof(key) == "EnumItem" then key else nil
self:savePreferences()
end
function Window:SetAnonymous(anonymous)
self.profile.Anonymous = anonymous == true
self:buildNav()
self:savePreferences()
end
function Window:SetProfile(settings)
for key, value in settings do
self.profile[key] = value
end
self:buildNav()
end
function Window:SetSliderTooltips(enabled, style)
self.sliderTooltips = enabled == true
if style then
self.sliderTooltipStyle = style
self.styles.SliderTooltip = style
end
end
function Window:SetToggleOutline(enabled, color)
self.toggleOutline = enabled == true
if color ~= nil then
self.toggleOutlineColor = if typeof(color) == "Color3" then color else nil
end
end
function Window:SetReducedMotion(reduced)
Motion.reduced = reduced == true
self:savePreferences()
end
function Window:SetTitle(title)
self.Title = title
for _, label in { self.topbarTitle, self.titleLabel, self.pillLabel } do
label.Text = title
end
end
function Window:SetVersion(version)
local text = if version == nil then "" else tostring(version)
self.options.Version = if text == "" then nil else text
self.versionTag.Text = text
self.versionTag.Visible = text ~= "" and self.options.ShowVersion ~= false
end
function Window:SetVersionVisible(visible)
self.options.ShowVersion = visible == true
self.versionTag.Visible = visible == true and self.options.Version ~= nil
end
function Window:SetSubtitle(subtitle)
self.Subtitle = subtitle
local shown = subtitle ~= nil and subtitle ~= ""
for _, label in { self.topbarSubtitle, self.subtitleLabel } do
label.Text = subtitle or ""
label.Visible = shown and not (label == self.topbarSubtitle and self.header.wordmark)
end
end
function Window:writePreferences()
self.preferencesQueued = false
local collapsed = {}
for name in self.collapsedGroups do
table.insert(collapsed, name)
end
table.sort(collapsed)
local seen = {}
for id in self.seenSpotlights do
table.insert(seen, id)
end
table.sort(seen)
local themes = {}
for _, plain in self.customThemes do
table.insert(themes, plain)
end
local encoded, text = Env.encode({
seen = seen,
changelog = self.changelogSeen,
updateSeen = self.updateSeen,
personal = self.personal,
themes = themes,
version = PREFERENCES_VERSION,
collapsedGroups = collapsed,
minimizeStyle = self.minimizeStyle,
size = { x = self.size.X, y = self.size.Y },
position = if self.placed then { x = self.placed.X, y = self.placed.Y } else nil,
theme = Theme.current.Name,
tabStyle = self.tabStyle,
scale = self.scale,
reducedMotion = Motion.reduced,
anonymous = self.profile.Anonymous,
toggleKey = if self.toggleKey then self.toggleKey.Name else "",
language = self.languagePicked,
favourites = Favourites.saved(self),
tabOrder = TabOrder.saved(self),
popOuts = if next(self.popOutState) then self.popOutState else nil,
})
local wrote, message = false, Strings.get("The settings could not be encoded.")
if encoded then
wrote, message = Env.write(self.preferencesPath, text)
end
if not wrote and not self.preferencesWarned then
self.preferencesWarned = true
self:Notify({ Title = Strings.get("Settings not saved"), Content = message, Kind = "warning" })
end
end
function Window:savePreferences()
if self.options.SavePreferences == false or not Env.canSave or self.preferencesQueued then
return
end
self.preferencesQueued = true
task.delay(0.5, function()
if not self.scope.cleaned and self.preferencesQueued then
self:writePreferences()
end
end)
end
function Window:everySecond(scope, callback)
scope:add(self.Tick:Connect(callback))
if not self.ticker then
self.ticker = self.scope:add(task.spawn(function()
while true do
task.wait(1)
self.Tick:Fire()
end
end))
end
end
function Window:Notify(options)
return Notifications.push(self.library, options)
end
function Window:ClearNotifications()
Notifications.clear(self.library)
end
function Window:Dialog(options)
return Dialog.open(self.library, options)
end
local function announce(window, action, name, ok, message)
if ok then
window.ConfigChanged:Fire(action, Env.safeName(name))
end
return ok, message
end
function Window:SaveConfig(name)
return announce(self, "save", name, self.config:save(name))
end
function Window:LoadConfig(name)
self:keepForUndo()
return announce(self, "load", name, self.config:load(name))
end
function Window:SetLanguage(code)
local chosen = Strings.setLanguage(code)
self.languagePicked = chosen
if self.options.SavePreferences ~= false and Env.canSave then
self:writePreferences()
end
return chosen
end
function Window:GetValues()
local values = {}
for flag, handle in self.Flags do
if handle.Get then
values[flag] = handle:Get()
end
end
return values
end
function Window:SetValues(values, silent)
self:keepForUndo()
local count = 0
for flag, value in values do
local handle = self.Flags[flag]
if handle and handle.Set then
if silent and handle.SetSilent then
handle:SetSilent(value)
else
handle:Set(value)
end
count += 1
end
end
return count
end
function Window:ResetValues()
self:keepForUndo()
for _, handle in self.Flags do
if handle.Reset then
handle:Reset()
end
end
end
function Window:keepForUndo()
self.undoValues = self.config:collect()
end
function Window:Undo()
local values = self.undoValues
if not values then
return false, Strings.get("Nothing to undo.")
end
self.undoValues = nil
local count = self.config:apply(values)
return true, Strings.get("Restored {count} settings.", { count = count })
end
local SHARE_PREFIX = "Halcyon1:"
function Window:ExportConfig()
local ok, text = Env.encode({ folder = self.folder, flags = self.config:collect() })
return if ok then SHARE_PREFIX .. text else nil
end
function Window:ImportConfig(code)
if type(code) ~= "string" then
return false, Strings.get("Paste a share code first.")
end
code = string.match(code, "^%s*(.-)%s*$")
if string.sub(code, 1, #SHARE_PREFIX) ~= SHARE_PREFIX then
return false, Strings.get("That isn't a Halcyon share code.")
end
local ok, decoded = Env.decode(string.sub(code, #SHARE_PREFIX + 1))
if not ok or type(decoded) ~= "table" or type(decoded.flags) ~= "table" then
return false, Strings.get("The share code is incomplete. Copy it again.")
end
self:keepForUndo()
local count = self.config:apply(decoded.flags)
self.ConfigChanged:Fire("import", nil)
return true, Strings.get("Imported {count} settings.", { count = count })
end
local ERROR_HISTORY = 50
function Window:recordError(title, message, trace)
local entry = { Title = title, Message = message, Trace = trace, Time = os.time() }
table.insert(self.Errors, entry)
if #self.Errors > ERROR_HISTORY then
table.remove(self.Errors, 1)
end
self.ErrorsChanged:Fire(entry)
end
function Window:CheckForUpdate()
return Services.check(self)
end
function Window:SupportPanel()
return Services.supportPanel(self)
end
function Window:ErrorsPanel()
return Services.errorsPanel(self)
end
function Window:ClearErrors()
table.clear(self.Errors)
self.ErrorsChanged:Fire(nil)
end
function Window:DeleteConfig(name)
return announce(self, "delete", name, self.config:delete(name))
end
function Window:ConfigExists(name)
return self.config:exists(name)
end
function Window:Require(names)
return Env.missing(names)
end
function Window:ListConfigs()
return self.config:list()
end
function Window:SetAutoload(name)
return announce(self, "autoload", name, self.config:setAutoload(name))
end
function Window:GetAutoload()
return self.config:getAutoload()
end
function Window:LoadAutoload()
local name = self.config:getAutoload()
if not name then
return false, Strings.get("No autoload config is set.")
end
return self.config:load(name)
end
function Window:RequestUnload()
if self.options.ConfirmUnload == false then
self:Unload()
return
end
self:Dialog({
Title = Strings.get("Unload the hub?"),
Content = Strings.get("Everything it turned on stops. Run the script again to bring it back."),
Icon = "power",
Dismissible = true,
Buttons = {
{ Title = Strings.get("Keep") },
{
Title = Strings.get("Unload"),
Variant = "Danger",
Callback = function()
self:Unload()
end,
},
},
})
end
function Window:Unload()
if self.unloaded then
return
end
self.unloaded = true
if self.preferencesQueued then
self:writePreferences()
end
self.OnUnload:Fire()
Popup.close(self.library)
self.library.scope:release(self.scope)
local index = table.find(self.library.windows, self)
if index then
table.remove(self.library.windows, index)
end
if self.onUnloaded then
self.onUnloaded()
end
end
return Window
end
modules["Core/Arc"] = function()
local Create = import("Core/Create")
local Theme = import("Core/Theme")
local Arc = {}
Arc.__index = Arc
local STEP = NumberSequence.new({
NumberSequenceKeypoint.new(0, 0),
NumberSequenceKeypoint.new(0.5, 0),
NumberSequenceKeypoint.new(0.5001, 1),
NumberSequenceKeypoint.new(1, 1),
})
function Arc.new(parent, options)
options = options or {}
local thickness = options.Thickness or 2
local radius = options.Radius or 0
local self = setmetatable({ parent = parent, thickness = thickness, fraction = 1 }, Arc)
self.even = if options.Even ~= nil then options.Even else radius >= 0
self.frame = Create.new("Frame", {
Name = "Arc",
Size = UDim2.fromScale(1, 1),
ZIndex = options.ZIndex,
Parent = parent,
})
self.strokes, self.gradients = {}, {}
for index, left in { false, true } do
local clip = Create.new("Frame", {
Name = if left then "Left" else "Right",
Size = UDim2.fromScale(0.5, 1),
Position = UDim2.fromScale(if left then 0 else 0.5, 0),
ClipsDescendants = true,
ZIndex = options.ZIndex,
Parent = self.frame,
})
local shape = Create.new("Frame", {
Name = "Shape",
Size = UDim2.new(2, -2 * thickness, 1, -2 * thickness),
Position = if left then UDim2.fromOffset(thickness, thickness) else UDim2.new(-1, thickness, 0, thickness),
ZIndex = options.ZIndex,
Parent = clip,
})
Create.new("UICorner", {
CornerRadius = if radius < 0 then UDim.new(1, 0) else UDim.new(0, math.max(radius - thickness, 0)),
Parent = shape,
})
local stroke = Create.new("UIStroke", {
Thickness = thickness,
Transparency = options.Transparency or 0,
Theme = if options.Color then nil else { Color = options.Role or "accent" },
Parent = shape,
})
if options.Color then
stroke.Color = options.Color
end
self.strokes[index] = stroke
self.gradients[index] = Create.new("UIGradient", { Transparency = STEP, Parent = stroke })
end
self:Set(1)
return self
end
local function evenAngle(fraction, width, height)
local perimeter = 2 * (width + height)
local walked = fraction * perimeter
local x, y
local halfWidth, halfHeight = width / 2, height / 2
if walked <= halfWidth then
x, y = walked, -halfHeight
elseif walked <= halfWidth + height then
x, y = halfWidth, -halfHeight + (walked - halfWidth)
elseif walked <= halfWidth + height + width then
x, y = halfWidth - (walked - halfWidth - height), halfHeight
elseif walked <= halfWidth + 2 * height + width then
x, y = -halfWidth, halfHeight - (walked - halfWidth - height - width)
else
x, y = -halfWidth + (walked - halfWidth - 2 * height - width), -halfHeight
end
local angle = math.deg(math.atan2(x / width, -y / height))
if angle < 0 then
angle += 360
end
if fraction >= 1 then
return 360
end
return angle
end
function Arc:Set(fraction)
fraction = math.clamp(fraction, 0, 1)
self.fraction = fraction
local angle = fraction * 360
local size = self.parent.AbsoluteSize
if self.even and size.X > 0 and size.Y > 0 and fraction > 0 and fraction < 1 then
angle = evenAngle(fraction, size.X, size.Y)
end
self.gradients[1].Rotation = math.min(angle, 180)
self.gradients[2].Rotation = 180 + math.max(angle - 180, 0)
end
function Arc:Get()
return self.fraction
end
function Arc:SetRole(role)
for _, stroke in self.strokes do
Theme.bind(stroke, "Color", role)
end
end
function Arc:SetColor(color)
for _, stroke in self.strokes do
Theme.unbind(stroke, "Color")
stroke.Color = color
end
end
function Arc:SetVisible(visible)
self.frame.Visible = visible
end
function Arc:Destroy()
self.frame:Destroy()
end
return Arc
end
modules["Core/Assets"] = function()
local Env = import("Core/Env")
local FOLDER = "Halcyon/assets"
local MAX_BYTES = 5 * 1024 * 1024
local EXTENSIONS = { png = true, jpg = true, jpeg = true, bmp = true, tga = true }
local Assets = { ids = {}, waiting = {}, MAX_BYTES = MAX_BYTES }
local getAsset = Env.getcustomasset
function Assets.kind(source)
if type(source) == "number" then
return "asset"
elseif type(source) ~= "string" or source == "" then
return nil
elseif string.find(source, "^rbx") then
return "asset"
elseif string.find(source, "^https?://") then
return "url"
elseif string.find(source, "://", 1, true) then
return nil
elseif string.find(source, "%.%a+$") and EXTENSIONS[string.lower(string.match(source, "%.(%a+)$"))] then
return "file"
end
return nil
end
function Assets.safePath(path)
if type(path) ~= "string" or string.find(path, "%.%.") or string.find(path, "^[/\\]") or string.find(path, "^%a:") then
return nil
end
if not string.match(path, "^[%w _%-%./]+$") then
return nil
end
return path
end
function Assets.cachePath(url)
local hash = 5381
for index = 1, #url do
hash = (hash * 33 + string.byte(url, index)) % 4294967296
end
local extension = string.match(string.match(url, "^[^?#]*") or url, "%.(%a+)$")
extension = if extension and EXTENSIONS[string.lower(extension)] then string.lower(extension) else "png"
return string.format("%s/%08x.%s", FOLDER, hash, extension)
end
local function fromFile(path)
if not getAsset then
return nil, "This executor cannot show custom images (no getcustomasset)."
end
local ok, id = pcall(getAsset, path)
if ok and type(id) == "string" and id ~= "" then
return id, nil
end
return nil, `Could not load {path} as an image.`
end
local function download(url)
if not getAsset then
return nil, "This executor cannot show custom images (no getcustomasset)."
elseif not Env.canSave then
return nil, Env.NO_FILES
end
local path = Assets.cachePath(url)
if Env.isfile(path) then
return fromFile(path)
end
local ok, body = Env.http({ Url = url })
if not ok or type(body) ~= "string" or body == "" then
return nil, `Could not download {url}.`
elseif #body > MAX_BYTES then
return nil, "That image is larger than 5 MB."
end
local wrote, problem = Env.write(path, body)
if not wrote then
return nil, problem
end
return fromFile(path)
end
function Assets.resolve(source, callback)
local kind = Assets.kind(source)
if kind == "asset" then
return if type(source) == "number" then "rbxassetid://" .. source else source
elseif kind == nil then
if callback then
callback(nil, "That is not an image id, URL or file.")
end
return nil
end
local key = tostring(source)
if Assets.ids[key] then
return Assets.ids[key]
end
if kind == "file" and not Assets.safePath(key) then
if callback then
callback(nil, "Image files must be inside the workspace.")
end
return nil
end
local waiting = Assets.waiting[key]
if waiting then
if callback then
table.insert(waiting, callback)
end
return nil
end
waiting = { callback }
Assets.waiting[key] = waiting
task.spawn(function()
local id, problem
if kind == "url" then
id, problem = download(key)
else
id, problem = fromFile(key)
end
Assets.ids[key] = id
Assets.waiting[key] = nil
for _, waiter in waiting do
waiter(id, problem)
end
end)
return nil
end
function Assets.reset()
table.clear(Assets.ids)
table.clear(Assets.waiting)
getAsset = Env.getcustomasset
end
return Assets
end
modules["Core/Background"] = function()
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Theme = import("Core/Theme")
local Background = {}
local KINDS = { Aurora = true, Glow = true, Gradient = true, Mesh = true, Pattern = true, Image = true }
local BLOB = "rbxassetid://8992230677"
local PATTERN_BANDS = 15
local SHEEN_GAP, SHEEN_PASS = 0.8, 2.4
local function neighbour(turn)
return function()
local ok, h, s, v = pcall(function()
return Theme.color("accent"):ToHSV()
end)
if not ok then
return Theme.color("info")
end
return Color3.fromHSV((h + turn) % 1, math.min(s * 1.05, 1), v)
end
end
local DEFAULT_COLOURS = { "accent", neighbour(0.09), "info", neighbour(-0.07) }
local function colourOf(entry)
if typeof(entry) == "Color3" then
return entry
elseif type(entry) == "function" then
return entry()
end
return Theme.color(if type(entry) == "string" then entry else "accent")
end
local function sequence(colours)
local keypoints = {}
for index, colour in colours do
table.insert(keypoints, ColorSequenceKeypoint.new(if #colours == 1 then 0 else (index - 1) / (#colours - 1), colour))
end
if #keypoints == 1 then
table.insert(keypoints, ColorSequenceKeypoint.new(1, colours[1]))
end
return ColorSequence.new(keypoints)
end
function Background.new(parent, spec, defaults)
if spec == nil or spec == false then
return nil
end
if type(spec) == "string" then
spec = { Kind = spec }
end
if type(spec) ~= "table" then
return nil
end
defaults = defaults or {}
local kind = if KINDS[spec.Kind] then spec.Kind else "Aurora"
local speed = math.clamp(tonumber(spec.Speed) or 1, 0.1, 5)
local intensity = math.clamp(tonumber(spec.Intensity) or defaults.Intensity or 0.5, 0, 1)
local colours = if type(spec.Colors) == "table" and #spec.Colors > 0 then spec.Colors else DEFAULT_COLOURS
local contained = defaults.Contained == true
local vignette = if spec.Vignette ~= nil then spec.Vignette == true else defaults.Vignette == true
local frame = Create.new("CanvasGroup", {
Name = "MovingBackground",
Size = UDim2.fromScale(1, 1),
ZIndex = 0,
GroupTransparency = 1 - intensity,
Parent = parent,
})
Create.corner(defaults.Radius or 12, frame)
local painters, connections = {}, {}
local fixed, sized = {}, {}
local running = false
local box = Vector2.zero
local measured = defaults.Measure or frame
local measuring
local function loop(list, target, seconds, goals, style, delay)
local linear = style == Enum.EasingStyle.Linear
local timing = TweenInfo.new(seconds / speed, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, not linear and not delay, delay and delay / speed or 0)
local tween = TweenService:Create(target, timing, goals)
table.insert(list, tween)
if running then
tween:Play()
end
return tween
end
local pieces = {}
local function at(piece, share)
local size = piece.pixels
local x, y = math.floor(box.X * share.X - size.X / 2), math.floor(box.Y * share.Y - size.Y / 2)
if contained then
x, y = math.clamp(x, 0, box.X - size.X), math.clamp(y, 0, box.Y - size.Y)
end
return UDim2.fromOffset(x, y)
end
local function placePieces()
for _, tween in sized do
tween:Cancel()
end
table.clear(sized)
local scale = if defaults.Scale then defaults.Scale() else 1
local size = measured.AbsoluteSize / math.max(scale, 0.01)
box = Vector2.new(math.floor(size.X), math.floor(size.Y))
if box.X <= 0 or box.Y <= 0 then
return
end
for _, piece in pieces do
local size = Vector2.new(math.floor(box.X * piece.size.X), math.floor(box.Y * piece.size.Y))
if contained then
size = Vector2.new(math.min(size.X, box.X), math.min(size.Y, box.Y))
end
piece.pixels = size
piece.instance.Size = UDim2.fromOffset(size.X, size.Y)
piece.instance.Position = at(piece, piece.from)
if piece.to then
piece.drift = loop(sized, piece.instance, piece.time, { Position = at(piece, piece.to) })
end
end
end
local function field(index, size, from, to, time, breathe)
local blob = Create.new("ImageLabel", { Name = "Light", Image = BLOB, ImageTransparency = breathe[1], Parent = frame })
table.insert(painters, function()
blob.ImageColor3 = colourOf(colours[(index - 1) % #colours + 1])
end)
loop(fixed, blob, breathe[3], { ImageTransparency = breathe[2] })
local piece = { instance = blob, size = size, from = from, to = to, time = time }
table.insert(pieces, piece)
return piece
end
if kind == "Gradient" or kind == "Pattern" then
frame.BackgroundTransparency = 0
local gradient = Create.new("UIGradient", { Parent = frame })
if kind == "Gradient" then
frame.BackgroundColor3 = Color3.new(1, 1, 1)
table.insert(painters, function()
local list = {}
for _, entry in colours do
table.insert(list, colourOf(entry))
end
gradient.Color = sequence(list)
end)
loop(fixed, gradient, 22, { Rotation = 360 }, Enum.EasingStyle.Linear)
else
local keypoints = {}
for band = 0, PATTERN_BANDS do
table.insert(keypoints, NumberSequenceKeypoint.new(band / PATTERN_BANDS, if band % 2 == 0 then 0.55 else 1))
end
gradient.Rotation = 45
gradient.Transparency = NumberSequence.new(keypoints)
table.insert(painters, function()
frame.BackgroundColor3 = colourOf(colours[1])
end)
loop(fixed, gradient, 6, { Offset = Vector2.new(2 / PATTERN_BANDS, 0) }, Enum.EasingStyle.Linear)
end
elseif kind == "Aurora" then
if contained then
field(1, Vector2.new(0.65, 1), Vector2.new(0.25, 0.35), Vector2.new(0.55, 0.6), 16, { 0.1, 0.45, 7 })
field(2, Vector2.new(0.65, 1), Vector2.new(0.8, 0.65), Vector2.new(0.45, 0.35), 21, { 0.2, 0.5, 9 })
field(3, Vector2.new(0.65, 1), Vector2.new(0.5, 0.5), Vector2.new(0.75, 0.3), 26, { 0.3, 0.6, 11 })
else
field(1, Vector2.new(0.95, 1.35), Vector2.new(0.08, 0.1), Vector2.new(0.35, 0.3), 24, { 0.05, 0.35, 8 })
field(2, Vector2.new(1.05, 1.45), Vector2.new(0.95, 0.95), Vector2.new(0.65, 0.7), 29, { 0.15, 0.45, 10 })
field(3, Vector2.new(0.75, 1.1), Vector2.new(0.9, 0.05), Vector2.new(0.6, 0.35), 34, { 0.3, 0.6, 12 })
field(4, Vector2.new(0.7, 1), Vector2.new(0.15, 0.95), Vector2.new(0.4, 0.7), 31, { 0.35, 0.65, 9 })
end
elseif kind == "Glow" then
field(2, Vector2.new(0.9, 1), Vector2.new(0.85, 0.75), Vector2.new(0.6, 0.6), 23, { 0.45, 0.65, 10 })
local light = field(1, Vector2.new(0.6, 1), Vector2.new(0.3, 0.45), Vector2.new(0.7, 0.55), 14, { 0.05, 0.25, 6 })
local following = false
local follow
table.insert(connections, UserInputService.InputChanged:Connect(function(input)
if not running or input.UserInputType ~= Enum.UserInputType.MouseMovement or box.X <= 0 then
return
end
local origin, size = frame.AbsolutePosition, frame.AbsoluteSize
local point = Vector2.new(input.Position.X, input.Position.Y)
local inside = point.X >= origin.X and point.Y >= origin.Y and point.X <= origin.X + size.X and point.Y <= origin.Y + size.Y
if inside then
if not following and light.drift then
light.drift:Cancel()
end
following = true
local share = (point - origin) / Vector2.new(math.max(size.X, 1), math.max(size.Y, 1))
if follow then
follow:Cancel()
end
follow = TweenService:Create(light.instance, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = at(light, share) })
follow:Play()
elseif following then
following = false
if light.drift then
light.drift:Play()
end
end
end))
elseif kind == "Mesh" then
for layer = 1, 2 do
local fill = Create.new("Frame", {
Name = "Blend",
BackgroundColor3 = Color3.new(1, 1, 1),
BackgroundTransparency = if layer == 2 then 0.45 else 0,
Parent = frame,
})
local gradient = Create.new("UIGradient", { Rotation = if layer == 2 then 180 else 0, Parent = fill })
table.insert(painters, function()
local list = {}
for _, entry in colours do
table.insert(list, colourOf(entry))
end
if layer == 2 then
list = { list[#list], list[1] }
end
gradient.Color = sequence(list)
end)
loop(fixed, gradient, if layer == 2 then 28 else 22, { Rotation = if layer == 2 then -180 else 360 }, Enum.EasingStyle.Linear)
table.insert(pieces, { instance = fill, size = Vector2.one, from = Vector2.new(0.5, 0.5) })
end
elseif kind == "Image" then
local picture = Create.new("ImageLabel", { Name = "Picture", ScaleType = Enum.ScaleType.Crop, ImageTransparency = 0.1, Parent = frame })
Icons.apply(picture, spec.Image)
loop(fixed, picture, 9, { ImageTransparency = 0.35 })
table.insert(pieces, { instance = picture, size = Vector2.one, from = Vector2.new(0.5, 0.5) })
end
if vignette then
for _, rotation in { 0, 90 } do
local shade = Create.new("Frame", { Name = "Vignette", BackgroundColor3 = Color3.new(0, 0, 0), Parent = frame }, {
Create.new("UIGradient", {
Rotation = rotation,
Transparency = NumberSequence.new({
NumberSequenceKeypoint.new(0, 0.5),
NumberSequenceKeypoint.new(0.22, 1),
NumberSequenceKeypoint.new(0.78, 1),
NumberSequenceKeypoint.new(1, 0.5),
}),
}),
})
table.insert(pieces, { instance = shade, size = Vector2.one, from = Vector2.new(0.5, 0.5) })
end
end
if spec.Sheen then
local sheen = Create.new("Frame", { Name = "Sheen", BackgroundColor3 = Color3.new(1, 1, 1), Parent = frame })
local gradient = Create.new("UIGradient", {
Rotation = 20,
Offset = Vector2.new(-1, 0),
Transparency = NumberSequence.new({
NumberSequenceKeypoint.new(0, 1),
NumberSequenceKeypoint.new(0.4, 1),
NumberSequenceKeypoint.new(0.5, 0.82),
NumberSequenceKeypoint.new(0.6, 1),
NumberSequenceKeypoint.new(1, 1),
}),
Parent = sheen,
})
table.insert(pieces, { instance = sheen, size = Vector2.one, from = Vector2.new(0.5, 0.5) })
loop(fixed, gradient, SHEEN_PASS, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Linear, SHEEN_GAP)
end
local function paint()
for _, painter in painters do
painter()
end
end
paint()
table.insert(connections, Theme.Changed:Connect(paint))
local function watch()
if measuring then
measuring:Disconnect()
measuring = nil
end
if #pieces > 0 then
placePieces()
measuring = measured:GetPropertyChangedSignal("AbsoluteSize"):Connect(placePieces)
end
end
watch()
local controller = { frame = frame, Kind = kind }
function controller.MeasureFrom(object)
object = object or frame
if object == measured and (measuring or #pieces == 0) then
return
end
measured = object
watch()
end
function controller.SetVisible(visible)
frame.Visible = visible ~= false
local play = visible ~= false and not Motion.reduced
if play == running then
return
end
running = play
for _, list in { fixed, sized } do
for _, tween in list do
if play then
tween:Play()
else
tween:Pause()
end
end
end
end
function controller.Destroy()
for _, list in { fixed, sized } do
for _, tween in list do
tween:Cancel()
end
end
for _, connection in connections do
connection:Disconnect()
end
if measuring then
measuring:Disconnect()
end
frame:Destroy()
end
controller.SetVisible(true)
return controller
end
return Background
end
modules["Core/Config"] = function()
local Env = import("Core/Env")
local Strings = import("Core/Strings")
local VERSION = 1
local INVALID_NAME_MESSAGE = "Use letters, numbers, spaces, - or _ in a config name."
local Config = {}
Config.__index = Config
function Config.new(folder, gameKey)
local root = "Halcyon/" .. folder
local shared = root .. "/configs"
return setmetatable({
root = root,
shared = shared,
folder = if gameKey then `{shared}/{gameKey}` else shared,
autoloadPath = if gameKey then `{shared}/{gameKey}/autoload.txt` else root .. "/autoload.txt",
flags = {},
}, Config)
end
function Config.gameKey(settings)
local mode = type(settings) == "table" and settings.PerGame
if mode == "Place" then
return tostring(game.PlaceId or 0)
elseif mode == "Universe" or mode == true then
local universe = game.GameId
return tostring(if universe and universe ~= 0 then universe else game.PlaceId or 0)
end
return nil
end
function Config:path(name)
return `{self.folder}/{name}.json`
end
function Config:find(safe)
for _, path in { self:path(safe), `{self.shared}/{safe}.json` } do
if Env.read(path) then
return path
end
end
return nil
end
function Config:collect()
local values = {}
for flag, handle in self.flags do
if handle.Get then
local ok, value = pcall(function()
return if handle.Encode then handle:Encode() else handle:Get()
end)
if ok then
values[flag] = value
end
end
end
return values
end
function Config:apply(values)
local count = 0
for flag, value in values do
local handle = self.flags[flag]
if handle and handle.Set then
local ok, message = pcall(function()
handle:Set(if handle.Decode then handle:Decode(value) else value)
end)
if ok then
count += 1
else
warn(`[Halcyon] Config value for "{flag}" was skipped: {message}`)
end
end
end
return count
end
function Config:save(name)
local safe = Env.safeName(name)
if not safe then
return false, Strings.get(INVALID_NAME_MESSAGE)
end
local encoded, text = Env.encode({ version = VERSION, flags = self:collect() })
if not encoded then
return false, Strings.get("The config could not be encoded.")
end
local wrote, message = Env.write(self:path(safe), text)
if not wrote then
return false, message
end
return true, Strings.get('Saved "{name}".', { name = safe })
end
function Config:load(name)
local safe = Env.safeName(name)
if not safe then
return false, Strings.get(INVALID_NAME_MESSAGE)
elseif not Env.canSave then
return false, Strings.get(Env.NO_FILES)
end
local found = self:find(safe)
local content = found and Env.read(found)
if not content then
return false, Strings.get('There is no config named "{name}".', { name = safe })
end
local decoded, saved = Env.decode(content)
if not decoded or type(saved) ~= "table" or type(saved.flags) ~= "table" then
return false, Strings.get('"{name}" is not a valid config file.', { name = safe })
end
return true, Strings.get('Loaded "{name}" ({count} settings).', { name = safe, count = self:apply(saved.flags) })
end
function Config:delete(name)
local safe = Env.safeName(name)
if not safe then
return false, Strings.get(INVALID_NAME_MESSAGE)
end
local found = self:find(safe)
if not found then
return false, Strings.get('There is no config named "{name}".', { name = safe })
elseif not Env.remove(found) then
return false, Strings.get("This executor cannot delete files.")
end
if self:getAutoload() == safe then
self:setAutoload(nil)
end
return true, Strings.get('Deleted "{name}".', { name = safe })
end
function Config:exists(name)
local safe = Env.safeName(name)
return safe ~= nil and self:find(safe) ~= nil
end
function Config:list()
local names = {}
local folders = { self.folder }
if self.folder ~= self.shared then
table.insert(folders, self.shared)
end
for _, folder in folders do
for _, file in Env.list(folder) do
local name = string.match(file, "^(.+)%.json$")
if name and not table.find(names, name) then
table.insert(names, name)
end
end
end
return names
end
function Config:getAutoload()
local name = Env.read(self.autoloadPath)
return if name and name ~= "" then name else nil
end
function Config:setAutoload(name)
local safe = if name then Env.safeName(name) else ""
if not safe then
return false, Strings.get(INVALID_NAME_MESSAGE)
end
local wrote, message = Env.write(self.autoloadPath, safe)
if not wrote then
return false, message
end
return true, if safe == "" then Strings.get("Autoload is off.") else Strings.get('"{name}" loads on start.', { name = safe })
end
return Config
end
modules["Core/Create"] = function()
local TextService = game:GetService("TextService")
local Icons = import("Core/Icons")
local Theme = import("Core/Theme")
local Tokens = import("Core/Tokens")
local TEXT = { TextLabel = true, TextButton = true, TextBox = true }
local IMAGE = { ImageLabel = true, ImageButton = true }
local VISUAL = { Frame = true, ScrollingFrame = true, CanvasGroup = true, ViewportFrame = true }
local NOT_PROPERTIES = { Theme = true, Weight = true, Icon = true, Parent = true }
local WEIGHTS = { regular = Enum.FontWeight.Medium, medium = Enum.FontWeight.SemiBold, bold = Enum.FontWeight.Bold }
local Create = {
family = "rbxassetid://12187365364",
fonts = {},
}
function Create.font(weight)
local key = weight or "regular"
local font = Create.fonts[key]
if not font then
font = Font.new(Create.family, WEIGHTS[key] or WEIGHTS.regular)
Create.fonts[key] = font
end
return font
end
function Create.setFamily(font)
local kind = typeof(font)
if kind == "EnumItem" then
font = Font.fromEnum(font).Family
elseif kind == "Font" then
font = font.Family
elseif kind ~= "string" then
return false
end
Create.family = font
table.clear(Create.fonts)
return true
end
local waiting = {}
function Create.preload()
local family = Create.family
if Create.loaded == family or Create.loading == family then
return
end
Create.loading = family
task.spawn(function()
for _, weight in WEIGHTS do
pcall(function()
local params = Instance.new("GetTextBoundsParams")
params.Text = "Halcyon"
params.Font = Font.new(family, weight)
params.Size = 14
TextService:GetTextBoundsAsync(params)
end)
end
if Create.loading ~= family then
return
end
Create.loaded, Create.loading = family, nil
local threads = table.clone(waiting)
table.clear(waiting)
for _, thread in threads do
task.spawn(thread)
end
end)
end
function Create.waitForFont(limit)
Create.preload()
if Create.loaded == Create.family then
return
end
local thread = coroutine.running()
table.insert(waiting, thread)
task.delay(limit, function()
local index = table.find(waiting, thread)
if index then
table.remove(waiting, index)
task.spawn(thread)
end
end)
coroutine.yield()
end
function Create.new(className: string, properties: { [string]: any }, children: { Instance }?): any
local instance = Instance.new(className)
local themed = properties.Theme
local filled = properties.BackgroundColor3 ~= nil or (themed ~= nil and themed.BackgroundColor3 ~= nil)
if TEXT[className] or IMAGE[className] or VISUAL[className] then
instance.BorderSizePixel = 0
instance.BackgroundTransparency = if filled then 0 else 1
end
if TEXT[className] then
instance.FontFace = Create.font(properties.Weight)
instance.TextSize = 14
instance.Text = ""
instance.TextXAlignment = if className == "TextButton" then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left
if className == "TextBox" then
instance.ClearTextOnFocus = false
Theme.bind(instance, "PlaceholderColor3", "textMuted")
end
end
if className == "TextButton" or className == "ImageButton" then
instance.AutoButtonColor = false
end
if IMAGE[className] then
instance.ScaleType = Enum.ScaleType.Fit
elseif className == "ScrollingFrame" then
instance.ScrollBarThickness = 3
instance.CanvasSize = UDim2.new(0, 0, 0, 0)
instance.AutomaticCanvasSize = Enum.AutomaticSize.Y
instance.ScrollingDirection = Enum.ScrollingDirection.Y
Theme.bind(instance, "ScrollBarImageColor3", "stroke")
elseif className == "ScreenGui" then
instance.ResetOnSpawn = false
instance.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
instance.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
elseif className == "UIStroke" then
instance.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
end
for key, value in properties do
if not NOT_PROPERTIES[key] then
instance[key] = value
end
end
if TEXT[className] and Tokens.textScale ~= 1 then
instance.TextSize = Tokens.text(instance.TextSize)
end
if themed then
for property, role in themed do
Theme.bind(instance, property, role)
end
end
if properties.Icon then
Icons.apply(instance, properties.Icon)
end
if children then
for _, child in children do
child.Parent = instance
end
end
instance.Parent = properties.Parent
return instance
end
function Create.corner(radius, parent)
local base = radius
radius = Tokens.corner(radius)
local corner = Create.new("UICorner", { CornerRadius = if radius < 0 then UDim.new(1, 0) else UDim.new(0, radius), Parent = parent })
corner:SetAttribute("HalcyonRadius", base)
return corner
end
function Create.stroke(role, parent, thickness)
return Create.new("UIStroke", { Thickness = thickness or 1, Theme = { Color = role }, Parent = parent })
end
function Create.padding(parent, left, top, right, bottom)
top = top or left
return Create.new("UIPadding", {
PaddingLeft = UDim.new(0, left),
PaddingTop = UDim.new(0, top),
PaddingRight = UDim.new(0, right or left),
PaddingBottom = UDim.new(0, bottom or top),
Parent = parent,
})
end
function Create.list(parent, direction, gap, properties)
local layout = Create.new("UIListLayout", {
FillDirection = Enum.FillDirection[direction],
Padding = UDim.new(0, gap or 0),
SortOrder = Enum.SortOrder.LayoutOrder,
VerticalAlignment = if direction == "Horizontal" then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top,
})
if properties then
for key, value in properties do
layout[key] = value
end
end
layout.Parent = parent
return layout
end
function Create.icon(name, size, role, parent)
return Create.new("ImageLabel", {
Name = "Icon",
Size = UDim2.fromOffset(size, size),
Icon = name,
Theme = { ImageColor3 = role },
Parent = parent,
})
end
function Create.fitHeight(box, source, limit, library, scope)
local layout = source.ClassName == "UIListLayout"
local function fit()
local measured = if layout then source.AbsoluteContentSize.Y else source.AbsoluteSize.Y
local height = math.ceil(measured / library.scale)
box.Size = UDim2.new(box.Size.X.Scale, box.Size.X.Offset, 0, math.min(height, limit))
end
scope:connect(source:GetPropertyChangedSignal(if layout then "AbsoluteContentSize" else "AbsoluteSize"), fit)
fit()
end
return Create
end
modules["Core/Drag"] = function()
local UserInputService = game:GetService("UserInputService")
local TAP_DISTANCE = 6
local Drag = {}
local function isPress(input)
local kind = input.UserInputType
return kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch
end
local function point(input)
return Vector2.new(input.Position.X, input.Position.Y)
end
function Drag.track(scope, surface, onStart, onMove, onEnd)
scope:connect(surface.InputBegan, function(input)
if not isPress(input) then
return
end
local origin = point(input)
if onStart and onStart(origin) == false then
return
end
local touch = input.UserInputType == Enum.UserInputType.Touch
local session = scope:child()
local moved = false
session:connect(UserInputService.InputChanged, function(changed)
if touch then
if changed ~= input then
return
end
elseif changed.UserInputType ~= Enum.UserInputType.MouseMovement then
return
end
local position = point(changed)
if (position - origin).Magnitude > TAP_DISTANCE then
moved = true
end
onMove(position, origin, moved)
end)
session:connect(UserInputService.InputEnded, function(ended)
if ended == input or (not touch and ended.UserInputType == Enum.UserInputType.MouseButton1) then
scope:release(session)
if onEnd then
onEnd(moved)
end
end
end)
end)
end
function Drag.clamp(target, x, y)
local size, bounds, anchor = target.AbsoluteSize, target.Parent.AbsoluteSize, target.AnchorPoint
local minX, minY = size.X * anchor.X, size.Y * anchor.Y
return math.clamp(x, minX, math.max(bounds.X - size.X * (1 - anchor.X), minX)), math.clamp(y, minY, math.max(bounds.Y - size.Y * (1 - anchor.Y), minY))
end
function Drag.move(scope, handle, target, options)
local start = Vector2.zero
Drag.track(scope, handle, function()
if options.enabled and not options.enabled() then
return false
end
start = target.AbsolutePosition - target.Parent.AbsolutePosition + target.AbsoluteSize * target.AnchorPoint
return true
end, function(position, origin, moved)
if moved then
local wanted = start + (position - origin)
local x, y = Drag.clamp(target, wanted.X, wanted.Y)
local lead = target.AbsoluteSize * target.AnchorPoint
target.Position = UDim2.fromOffset(math.round(x - lead.X) + lead.X, math.round(y - lead.Y) + lead.Y)
end
end, function(moved)
local callback = if moved then options.onMoved else options.onTap
if callback then
callback()
end
end)
end
function Drag.area(scope, surface, onChange, onEnd, reference)
reference = reference or surface
local function report(position)
local origin, size = reference.AbsolutePosition, reference.AbsoluteSize
onChange(math.clamp((position.X - origin.X) / math.max(size.X, 1), 0, 1), math.clamp((position.Y - origin.Y) / math.max(size.Y, 1), 0, 1))
end
Drag.track(scope, surface, function(position)
report(position)
return true
end, report, onEnd)
end
return Drag
end
modules["Core/Effects"] = function()
local Create = import("Core/Create")
local Motion = import("Core/Motion")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
local TweenService = game:GetService("TweenService")
local SWEEP = TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RIPPLE = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SHIMMER = TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, false, 2.6)
local BAND_FADE = NumberSequence.new({
NumberSequenceKeypoint.new(0, 1),
NumberSequenceKeypoint.new(0.5, 0.7),
NumberSequenceKeypoint.new(1, 1),
})
local PULSE = TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1)
local SPIN = TweenInfo.new(0.8, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
local Effects = { Kinds = { Sweep = true, Ripple = true, Lift = true, Glow = true, Press = true, Fill = true, None = true } }
for _, name in { "Sweep", "Ripple", "Lift", "Glow", "Press", "Fill", "None" } do
Styles.register("ButtonEffect", name, {})
end
local function layer(button, radius)
local existing = button:FindFirstChild("Effects")
if existing then
return existing
end
local pad = button:FindFirstChildOfClass("UIPadding")
local left, top = if pad then pad.PaddingLeft else UDim.new(), if pad then pad.PaddingTop else UDim.new()
local right, bottom = if pad then pad.PaddingRight else UDim.new(), if pad then pad.PaddingBottom else UDim.new()
local group = Create.new("CanvasGroup", {
Name = "Effects",
Position = UDim2.new(-left.Scale, -left.Offset, -top.Scale, -top.Offset),
Size = UDim2.new(1 + left.Scale + right.Scale, left.Offset + right.Offset, 1 + top.Scale + bottom.Scale, top.Offset + bottom.Offset),
ZIndex = 2,
Parent = button,
})
Create.corner(radius, group)
return group
end
local function sweep(scope, button, radius)
local band = Create.new("Frame", {
Name = "Sweep",
Size = UDim2.fromScale(0.45, 1),
AnchorPoint = Vector2.new(0.5, 0),
Position = UDim2.fromScale(-0.3, 0),
BackgroundColor3 = Color3.new(1, 1, 1),
Parent = layer(button, radius),
}, { Create.new("UIGradient", { Transparency = BAND_FADE, Rotation = 0 }) })
scope:connect(button.MouseEnter, function()
if Motion.reduced then
return
end
band.Position = UDim2.fromScale(-0.3, 0)
TweenService:Create(band, SWEEP, { Position = UDim2.fromScale(1.3, 0) }):Play()
end)
end
local function ripple(scope, button, radius)
local group = layer(button, radius)
scope:connect(button.InputBegan, function(input)
local kind = input.UserInputType
if Motion.reduced or (kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch) then
return
end
local origin, size = button.AbsolutePosition, button.AbsoluteSize
local reach = math.max(size.X, size.Y) * 2.2
local circle = Create.new("Frame", {
Name = "Ripple",
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromOffset(input.Position.X - origin.X, input.Position.Y - origin.Y),
Size = UDim2.fromOffset(0, 0),
BackgroundColor3 = Color3.new(1, 1, 1),
BackgroundTransparency = 0.75,
Parent = group,
})
Create.corner(-1, circle)
local grow = TweenService:Create(circle, RIPPLE, { Size = UDim2.fromOffset(reach, reach), BackgroundTransparency = 1 })
grow.Completed:Once(function()
circle:Destroy()
end)
grow:Play()
end)
end
local function lift(scope, button)
local scale = button:FindFirstChildOfClass("UIScale") or Create.new("UIScale", { Parent = button })
local hovered = false
local function settle(target)
Motion.tween(scale, "spring", { Scale = target })
end
scope:connect(button.MouseEnter, function()
hovered = true
settle(1.03)
end)
scope:connect(button.MouseLeave, function()
hovered = false
settle(1)
end)
scope:connect(button.MouseButton1Down, function()
Motion.tween(scale, "fast", { Scale = 0.97 })
end)
scope:connect(button.MouseButton1Up, function()
settle(if hovered then 1.03 else 1)
end)
end
local function glow(scope, button)
local stroke = Create.new("UIStroke", {
Name = "Glow",
Thickness = 1.5,
Transparency = 1,
Theme = { Color = "accentHover" },
Parent = button,
})
scope:connect(button.MouseEnter, function()
Motion.tween(stroke, "base", { Transparency = 0 })
end)
scope:connect(button.MouseLeave, function()
Motion.tween(stroke, "base", { Transparency = 1 })
end)
end
local function press(scope, button)
local scale = button:FindFirstChildOfClass("UIScale") or Create.new("UIScale", { Parent = button })
scope:connect(button.MouseButton1Down, function()
Motion.tween(scale, "fast", { Scale = 0.96 })
end)
scope:connect(button.MouseButton1Up, function()
Motion.tween(scale, "spring", { Scale = 1 })
end)
scope:connect(button.MouseLeave, function()
Motion.tween(scale, "spring", { Scale = 1 })
end)
end
local function fill(scope, button, radius)
local wipe = Create.new("Frame", {
Name = "Fill",
Size = UDim2.fromScale(0, 1),
BackgroundTransparency = 0.82,
Theme = { BackgroundColor3 = "accent" },
Parent = layer(button, radius),
})
scope:connect(button.MouseEnter, function()
Motion.tween(wipe, "base", { Size = UDim2.fromScale(1, 1) })
end)
scope:connect(button.MouseLeave, function()
Motion.tween(wipe, "base", { Size = UDim2.fromScale(0, 1) })
end)
end
function Effects.spinner(scope, parent, size, role)
local frame = Create.new("Frame", {
Name = "Spinner",
Size = UDim2.fromOffset(size, size),
Visible = false,
Parent = parent,
})
Create.corner(-1, frame)
local ring = Create.new("UIStroke", { Thickness = 2, Theme = { Color = role or "text" }, Parent = frame })
Create.new("UIGradient", {
Transparency = NumberSequence.new({
NumberSequenceKeypoint.new(0, 0),
NumberSequenceKeypoint.new(0.7, 0.85),
NumberSequenceKeypoint.new(1, 1),
}),
Parent = ring,
})
local tween
local spinner = { frame = frame }
function spinner.start()
frame.Visible = true
if tween or Motion.reduced then
return
end
frame.Rotation = 0
tween = TweenService:Create(frame, SPIN, { Rotation = 360 })
tween:Play()
end
function spinner.stop()
frame.Visible = false
if tween then
tween:Cancel()
tween = nil
end
end
scope:add(spinner.stop)
return spinner
end
function Effects.pulse(scope, ring)
local tween
local pulse = {}
function pulse.start()
if tween or Motion.reduced then
return
end
ring.Thickness, ring.Transparency = 0, 0.3
tween = TweenService:Create(ring, PULSE, { Thickness = 5, Transparency = 1 })
tween:Play()
end
function pulse.stop()
if tween then
tween:Cancel()
tween = nil
end
ring.Thickness, ring.Transparency = 0, 1
end
scope:add(pulse.stop)
return pulse
end
function Effects.shimmer(scope, target, radius)
local band, tween
local shimmer = {}
function shimmer.start()
if tween or Motion.reduced then
return
end
band = band
or Create.new("Frame", {
Name = "Shimmer",
Size = UDim2.fromScale(0.5, 1),
AnchorPoint = Vector2.new(0.5, 0),
BackgroundColor3 = Color3.new(1, 1, 1),
BackgroundTransparency = 0.55,
Parent = layer(target, radius),
}, { Create.new("UIGradient", { Transparency = BAND_FADE, Rotation = 20 }) })
band.Position = UDim2.fromScale(-0.4, 0)
tween = TweenService:Create(band, SHIMMER, { Position = UDim2.fromScale(1.4, 0) })
tween:Play()
end
function shimmer.stop()
if tween then
tween:Cancel()
tween = nil
end
if band then
band.Position = UDim2.fromScale(-0.4, 0)
end
end
scope:add(shimmer.stop)
return shimmer
end
function Effects.apply(scope, button, kind, radius)
if kind == "Sweep" then
sweep(scope, button, radius or 8)
elseif kind == "Ripple" then
ripple(scope, button, radius or 8)
elseif kind == "Lift" then
lift(scope, button)
elseif kind == "Glow" then
glow(scope, button)
elseif kind == "Press" then
press(scope, button)
elseif kind == "Fill" then
fill(scope, button, radius or 8)
end
end
function Effects.accentFill(scope, frame)
local gradient
local function apply()
local finish = Theme.gradientEnd()
if finish then
gradient = gradient or Create.new("UIGradient", { Name = "AccentGradient", Parent = frame })
gradient.Enabled = true
gradient.Color = ColorSequence.new(Theme.color("accent"), finish)
Theme.unbind(frame, "BackgroundColor3")
frame.BackgroundColor3 = Color3.new(1, 1, 1)
else
if gradient then
gradient.Enabled = false
end
Theme.bind(frame, "BackgroundColor3", "accent")
end
end
scope:add(Theme.Changed:Connect(apply))
scope:add(Theme.GradientChanged:Connect(apply))
apply()
end
Effects.layer = layer
return Effects
end
modules["Core/Env"] = function()
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Strings = import("Core/Strings")
local function optional(value)
return if type(value) == "function" then value else nil
end
local Env = {
writefile = optional(writefile),
readfile = optional(readfile),
isfile = optional(isfile),
isfolder = optional(isfolder),
makefolder = optional(makefolder),
delfile = optional(delfile),
listfiles = optional(listfiles),
setclipboard = optional(setclipboard),
identifyexecutor = optional(identifyexecutor),
request = optional(request),
getgenv = optional(getgenv),
gethui = optional(gethui),
getcustomasset = optional(getcustomasset) or optional(getsynasset),
NO_FILES = "This executor can't save files.",
NO_HTTP = "HTTP requests are not available here.",
}
Env.canSave = Env.writefile ~= nil and Env.readfile ~= nil and Env.isfile ~= nil and Env.isfolder ~= nil and Env.makefolder ~= nil
function Env.executor()
if Env.identifyexecutor then
local ok, name, version = pcall(Env.identifyexecutor)
if ok and type(name) == "string" and name ~= "" then
return name, if type(version) == "string" then version else nil
end
end
return if RunService:IsStudio() then "Roblox Studio" else "Unknown executor", nil
end
function Env.globals()
return if Env.getgenv then Env.getgenv() else _G
end
function Env.copy(text)
if not Env.setclipboard then
return false
end
return (pcall(Env.setclipboard, text))
end
function Env.safeName(name)
if type(name) ~= "string" then
return nil
end
local safe = string.gsub(name, "[^%w _%-]", "")
safe = string.sub(string.match(safe, "^%s*(.-)%s*$"), 1, 40)
return if safe == "" then nil else safe
end
local function ensureFolder(path)
local built = ""
for _, part in string.split(path, "/") do
built = if built == "" then part else built .. "/" .. part
if not Env.isfolder(built) then
Env.makefolder(built)
end
end
end
function Env.write(path, content)
if not Env.canSave then
return false, Strings.get(Env.NO_FILES)
end
local ok, message = pcall(function()
ensureFolder(string.match(path, "^(.*)/[^/]+$"))
Env.writefile(path, content)
end)
return ok, if ok then nil else `Writing {path} failed: {message}`
end
function Env.read(path)
if not Env.canSave then
return nil
end
local ok, content = pcall(function()
return if Env.isfile(path) then Env.readfile(path) else nil
end)
return if ok and type(content) == "string" then content else nil
end
function Env.remove(path)
if not Env.delfile then
return false
end
return (pcall(Env.delfile, path))
end
function Env.list(folder)
local names = {}
if not (Env.canSave and Env.listfiles) then
return names
end
local ok, paths = pcall(function()
return if Env.isfolder(folder) then Env.listfiles(folder) else {}
end)
if ok and type(paths) == "table" then
for _, path in paths do
table.insert(names, string.match(path, "[^/\\]+$"))
end
table.sort(names)
end
return names
end
function Env.encode(value)
return pcall(HttpService.JSONEncode, HttpService, value)
end
function Env.decode(text)
return pcall(HttpService.JSONDecode, HttpService, text)
end
function Env.http(options)
local method = options.Method or "GET"
if Env.request then
local ok, response = pcall(Env.request, { Url = options.Url, Method = method, Headers = options.Headers, Body = options.Body })
if not ok or type(response) ~= "table" then
return false, tostring(response), 0
end
local status = tonumber(response.StatusCode) or 0
return status >= 200 and status < 300, response.Body or "", status
end
if method == "GET" then
local ok, body = pcall(function()
return game:HttpGet(options.Url)
end)
if ok and type(body) == "string" then
return true, body, 200
end
end
return false, Strings.get(Env.NO_HTTP), 0
end
function Env.has(name)
if type(name) ~= "string" or not string.match(name, "^[%a_][%w_]*%.?[%w_]*$") then
return false
end
local parts = string.split(name, ".")
local function walk(root)
local value = root
for _, part in parts do
if type(value) ~= "table" then
return nil
end
local ok, found = pcall(function()
return value[part]
end)
value = if ok then found else nil
end
return value
end
if Env.getgenv and walk(Env.getgenv()) ~= nil then
return true
end
local compile = optional(loadstring)
if compile then
local ok, chunk = pcall(compile, "return " .. name)
if ok and chunk then
local found, value = pcall(chunk)
return found and value ~= nil
end
end
return false
end
function Env.missing(names)
local absent = {}
for _, name in names do
if not Env.has(name) then
table.insert(absent, name)
end
end
return absent
end
function Env.duration(seconds)
seconds = math.max(math.floor(seconds), 0)
local days, hours = seconds // 86400, seconds // 3600 % 24
local minutes = seconds // 60 % 60
if days > 0 then
return if hours > 0 then `{days}d {hours}h` else `{days}d`
elseif hours > 0 then
return if minutes > 0 then `{hours}h {minutes}m` else `{hours}h`
elseif minutes > 0 then
return `{minutes}m`
end
return `{seconds}s`
end
function Env.call(label, callback, ...)
if type(callback) ~= "function" then
return
end
task.spawn(function(...)
local ok, message = pcall(callback, ...)
if not ok then
warn(`[Halcyon] {label} callback failed: {message}`)
end
end, ...)
end
return Env
end
modules["Core/Hairline"] = function()
local Create = import("Core/Create")
local Hairline = { scale = 1, strokes = {} }
function Hairline.new(axis, role, properties)
local settings = {
Name = "Seam",
Size = if axis == "Y" then UDim2.new(0, 0, 1, 0) else UDim2.new(1, 0, 0, 0),
}
for key, value in properties or {} do
settings[key] = value
end
local frame = Create.new("Frame", settings)
local stroke = Create.new("UIStroke", {
Thickness = 1 / Hairline.scale,
Transparency = 0.35,
Theme = { Color = role or "stroke" },
Parent = frame,
})
Hairline.strokes[stroke] = true
stroke.Destroying:Once(function()
Hairline.strokes[stroke] = nil
end)
return frame
end
function Hairline.setScale(scale)
Hairline.scale = scale
for stroke in Hairline.strokes do
stroke.Thickness = 1 / scale
end
end
return Hairline
end
