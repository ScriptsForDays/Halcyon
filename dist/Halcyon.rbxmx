<string name="Name">Part04</string>
<ProtectedString name="Source"><![CDATA[return function(modules, import)
modules["Elements/Slider"] = function()
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Effects = import("Core/Effects")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local SliderTooltip = import("Elements/SliderTooltip")
local Styles = import("Core/Styles")
Styles.register("Slider", "Line", { rail = 4, knob = { 14, 14 }, knobCorner = -1 })
Styles.register("Slider", "Thin", { rail = 2, knob = { 12, 12 }, knobCorner = -1 })
Styles.register("Slider", "Thick", { rail = 8, knob = { 18, 18 }, knobCorner = -1, ring = true })
Styles.register("Slider", "Handle", { rail = 4, knob = { 6, 18 }, knobCorner = -1 })
Styles.register("Slider", "Ticks", { rail = 4, knob = { 14, 14 }, knobCorner = -1, ticks = true })
Styles.register("Slider", "Bare", { rail = 6, grow = 4 })
Styles.register("Slider", "Block", { rail = 22, railCorner = 6, inside = true })
local Slider = {}
local function decimalsOf(step)
local fraction = string.match(tostring(step), "%.(%d+)")
return if fraction then #fraction else 0
end
function Slider.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local min, max = options.Min or 0, options.Max or 100
local step = options.Step or 1
local range = options.Range == true
local pattern = "%." .. decimalsOf(step) .. "f"
local low, high = min, min
local look = Styles.pick("Slider", options.Style, row.window)
local knobSize = look.knob
local KNOB = if knobSize then knobSize[1] else 0
local display = options.Display or (if look.inside then "None" else "Box")
local function snap(number)
number = math.clamp(tonumber(number) or min, min, max)
number = min + math.round((number - min) / step) * step
return math.clamp(tonumber(string.format(pattern, number)), min, max)
end
local function label(number)
if type(options.Format) == "function" then
local ok, text = pcall(options.Format, number)
if ok and text ~= nil then
return tostring(text)
end
end
if options.Percent then
return (options.Prefix or "") .. math.round((number - min) / math.max(max - min, 1e-9) * 100) .. "%"
end
return (options.Prefix or "") .. string.format(pattern, number) .. (options.Suffix or "")
end
local area = Create.new("TextButton", { Name = "Track", LayoutOrder = 1 })
row.placeControl(area, options.Width or 130, row.reach, options.Stacked)
local rail = Create.new("Frame", {
Name = "Rail",
Size = UDim2.new(1, -KNOB, 0, look.rail or 4),
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.5),
Theme = { BackgroundColor3 = "stroke" },
Parent = area,
})
Create.corner(look.railCorner or -1, rail)
local fill = Create.new("Frame", { Name = "Fill", Theme = { BackgroundColor3 = "accent" }, Parent = rail })
Create.corner(look.railCorner or -1, fill)
Effects.accentFill(scope, fill)
local function newKnob()
if not knobSize then
return nil
end
local knob = Create.new("Frame", {
Name = "Knob",
Size = UDim2.fromOffset(knobSize[1], knobSize[2]),
AnchorPoint = Vector2.new(0.5, 0.5),
ZIndex = 2,
Theme = { BackgroundColor3 = "text" },
Parent = rail,
})
Create.corner(look.knobCorner or -1, knob)
if look.ring then
Create.new("UIStroke", { Thickness = 3, Theme = { Color = "accent" }, Parent = knob })
end
return knob
end
local highKnob = newKnob()
local lowKnob = if range then newKnob() else nil
if look.ticks then
local steps = math.floor((max - min) / step + 0.5)
local count = if steps > 0 and steps <= 20 then steps else 10
for index = 0, count do
local mark = Create.new("Frame", {
Name = "Tick",
Size = UDim2.fromOffset(2, 8),
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(index / count, 0.5),
BackgroundTransparency = 0.4,
Theme = { BackgroundColor3 = "textMuted" },
Parent = rail,
})
Create.corner(-1, mark)
end
end
if options.DefaultMarker and type(options.Default) == "number" then
local spot = (math.clamp(options.Default, min, max) - min) / math.max(max - min, 1e-9)
Create.new("Frame", {
Name = "DefaultMark",
Size = UDim2.fromOffset(2, (look.rail or 4) + 8),
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(spot, 0.5),
Theme = { BackgroundColor3 = "textMuted" },
Parent = rail,
})
end
local inside
if look.inside then
inside = Create.new("TextLabel", {
Name = "Inside",
Size = UDim2.new(1, -16, 1, 0),
Position = UDim2.fromOffset(8, 0),
TextSize = 12,
Weight = "bold",
ZIndex = 3,
Theme = { TextColor3 = "text" },
Parent = rail,
})
end
if look.grow then
scope:connect(area.MouseEnter, function()
Motion.tween(rail, "fast", { Size = UDim2.new(1, -KNOB, 0, look.rail + look.grow) })
end)
scope:connect(area.MouseLeave, function()
Motion.tween(rail, "fast", { Size = UDim2.new(1, -KNOB, 0, look.rail) })
end)
end
local readout
if display == "None" or display == "Text" or display == "Fraction" then
readout = Create.new("TextLabel", {
Name = "Value",
Size = UDim2.fromOffset(0, row.reach),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 13,
Visible = display ~= "None",
LayoutOrder = 2,
Theme = { TextColor3 = "textMuted" },
Parent = row.slot,
})
elseif range then
readout = Create.new("TextLabel", {
Name = "Value",
Size = UDim2.fromOffset(0, row.reach),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 13,
LayoutOrder = 2,
Theme = { TextColor3 = "textMuted" },
Parent = row.slot,
})
else
readout = Create.new("TextBox", {
Name = "Value",
Size = UDim2.fromOffset(54, row.reach),
TextSize = 13,
TextXAlignment = Enum.TextXAlignment.Center,
LayoutOrder = 2,
Theme = { BackgroundColor3 = row.controlRole, TextColor3 = "text" },
Parent = row.slot,
})
Create.corner(6, readout)
Create.stroke("stroke", readout)
end
local function draw()
local span = math.max(max - min, 1e-9)
local from, to = if range then (low - min) / span else 0, (high - min) / span
fill.Position = UDim2.fromScale(from, 0)
fill.Size = UDim2.fromScale(to - from, 1)
if highKnob then
highKnob.Position = UDim2.fromScale(to, 0.5)
end
if lowKnob then
lowKnob.Position = UDim2.fromScale(from, 0.5)
end
local text = if range then label(low) .. " - " .. label(high) else label(high)
if display == "Fraction" and not range then
text ..= " / " .. label(max)
end
readout.Text = text
if inside then
inside.Text = text
end
end
local function store(newLow, newHigh)
newLow, newHigh = snap(newLow), snap(newHigh)
if newLow > newHigh then
newLow, newHigh = newHigh, newLow
end
local changed = newLow ~= low or newHigh ~= high
low, high = newLow, newHigh
draw()
return changed
end
function handle:Get()
return if range then { low, high } else high
end
function handle:Set(value)
if range then
value = if type(value) == "table" then value else { min, max }
store(value[1], value[2])
else
store(min, value)
end
row.fire(self:Get())
end
local dragLow = false
Drag.track(scope, area, function(position)
local origin, width = rail.AbsolutePosition, math.max(rail.AbsoluteSize.X, 1)
local pressed = min + math.clamp((position.X - origin.X) / width, 0, 1) * (max - min)
dragLow = range and math.abs(pressed - low) < math.abs(pressed - high)
return true
end, function() end)
local tip
local function tipWanted()
if options.Tooltip ~= nil then
return options.Tooltip == true
end
return row.window.sliderTooltips
end
local dragged = false
Drag.area(scope, area, function(x)
local pressed = min + x * (max - min)
local changed = if not range then store(min, pressed) elseif dragLow then store(math.min(pressed, high), high) else store(low, math.max(pressed, low))
if tipWanted() then
local style = options.TooltipStyle or row.window.styles.SliderTooltip or row.window.sliderTooltipStyle
if tip and tip.style ~= style then
tip.destroy()
tip = nil
end
tip = tip or SliderTooltip.new(row, style)
local shown = if range and dragLow then low else high
tip.show(rail, (shown - min) / math.max(max - min, 1e-9), label(shown), readout)
end
if changed then
if options.Live == false then
dragged = true
else
row.fire(handle:Get())
end
end
end, function()
if tip then
tip.hide()
end
if dragged then
dragged = false
row.fire(handle:Get())
end
end, rail)
if not range and readout:IsA("TextBox") then
scope:connect(readout.FocusLost, function()
local typed = tonumber(string.match(readout.Text, "-?%d+%.?%d*"))
if typed then
handle:Set(typed)
else
draw()
end
end)
end
local default = options.Default
if range then
default = if type(default) == "table" then default else { min, max }
store(default[1], default[2])
else
store(min, default or min)
end
return handle
end
return Slider
end
modules["Elements/SliderTooltip"] = function()
local Create = import("Core/Create")
local Mount = import("Core/Mount")
local Styles = import("Core/Styles")
local STYLES = {
Rounded = { corner = 8, arrow = 2 },
Sharp = { corner = 0, arrow = 0 },
Pill = { corner = -1, arrow = 2 },
Plain = { corner = 8 },
}
local KNOB_RADIUS = 7
local LIFT = 10
local ARROW_HALF = 7
local MARGIN = 4
local SliderTooltip = { Styles = STYLES }
for _, name in { "Rounded", "Sharp", "Pill", "Plain" } do
Styles.register("SliderTooltip", name, STYLES[name])
end
local function overlaps(left, top, right, bottom, other)
local corner, extent = other.AbsolutePosition, other.AbsoluteSize
return right > corner.X - MARGIN and left < corner.X + extent.X + MARGIN and bottom > corner.Y - MARGIN and top < corner.Y + extent.Y + MARGIN
end
function SliderTooltip.new(row, styleName)
local library = row.library
local style = Styles.get("SliderTooltip", styleName) or STYLES.Rounded
local overlay = Mount.overlay(library)
local lift = if style.arrow then LIFT else 6
local holder = Create.new("Frame", { Name = "SliderTip", Visible = false, ZIndex = 5, Parent = overlay.popups })
row.scope:add(holder)
local scale = Create.new("UIScale", { Scale = library.scale })
local body = Create.new("Frame", { Name = "Body", Parent = holder }, { scale })
local arrow
if style.arrow then
arrow = Create.new("Frame", {
Name = "Arrow",
Size = UDim2.fromOffset(9, 9),
AnchorPoint = Vector2.new(0.5, 0.5),
Rotation = 45,
Theme = { BackgroundColor3 = "accent" },
Parent = body,
})
if style.arrow > 0 then
Create.corner(style.arrow, arrow)
end
end
local bubble = Create.new("Frame", {
Name = "Bubble",
AutomaticSize = Enum.AutomaticSize.XY,
ZIndex = 2,
Theme = { BackgroundColor3 = "accent" },
Parent = body,
})
if style.corner ~= 0 then
Create.corner(style.corner, bubble)
end
Create.padding(bubble, 9, 3)
local label = Create.new("TextLabel", {
Name = "Value",
Size = UDim2.fromOffset(0, 18),
AutomaticSize = Enum.AutomaticSize.X,
TextXAlignment = Enum.TextXAlignment.Center,
TextSize = 12,
Weight = "bold",
Theme = { TextColor3 = "onAccent" },
Parent = bubble,
})
local tip = { Frame = holder, style = styleName, above = true }
function tip.destroy()
row.scope:release(holder)
end
function tip.show(rail, fraction, text, avoid)
local factor = library.scale
local origin = overlay.gui.AbsolutePosition
local corner, extent = rail.AbsolutePosition, rail.AbsoluteSize
local knobX, centre = corner.X + extent.X * fraction, corner.Y + extent.Y / 2
scale.Scale = factor
label.Text = text
local size = bubble.AbsoluteSize
if size.X <= 0 then
size = Vector2.new((#text * 7 + 16) * factor, 24 * factor)
end
local half = size.X / 2
local low, high = corner.X + half, corner.X + extent.X - half
local bubbleX = if low <= high then math.clamp(knobX, low, high) else corner.X + extent.X / 2
local radius = if style.corner < 0 then size.Y / 2 else (style.corner or 0) * factor
local reachOfArrow = math.max(half - radius - ARROW_HALF * factor, 0)
bubbleX = math.clamp(bubbleX, knobX - reachOfArrow, knobX + reachOfArrow)
local reach = (KNOB_RADIUS + lift) * factor
local above = true
if avoid and overlaps(bubbleX - half, centre - reach - size.Y, bubbleX + half, centre - reach, avoid) then
above = false
end
local direction = if above then -1 else 1
tip.above = above
holder.Position = UDim2.fromOffset(knobX - origin.X, centre + direction * KNOB_RADIUS * factor - origin.Y)
bubble.AnchorPoint = Vector2.new(0.5, if above then 1 else 0)
bubble.Position = UDim2.fromOffset((bubbleX - knobX) / factor, direction * lift)
if arrow then
arrow.Position = UDim2.fromOffset(0, direction * lift)
end
holder.Visible = true
end
function tip.hide()
holder.Visible = false
end
return tip
end
return SliderTooltip
end
modules["Elements/Space"] = function()
local Create = import("Core/Create")
local Space = {}
function Space.new(container, options)
local scope = container.scope:child()
local frame = Create.new("Frame", {
Name = "Space",
Size = UDim2.new(1, 0, 0, tonumber(options.Height) or 8),
LayoutOrder = container:nextOrder(),
Parent = container.frame,
})
scope:add(frame)
local handle = { Frame = frame, Title = "", Hidden = false, scope = scope, SearchText = "" }
function handle:SetVisible(visible)
self.Hidden = not visible
frame.Visible = visible
end
function handle:Destroy()
container.scope:release(scope)
end
return handle
end
return Space
end
modules["Elements/Stat"] = function()
local Create = import("Core/Create")
local Row = import("Elements/Row")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
Styles.register("Stat", "Card", { fill = true })
Styles.register("Stat", "Plain", {})
local Stat = {}
local function changeRole(text, kind)
if kind then
return ({ good = "success", bad = "danger", neutral = "textMuted", success = "success", danger = "danger", warning = "warning" })[kind]
or "textMuted"
end
local first = string.sub(tostring(text or ""), 1, 1)
return if first == "+" then "success" elseif first == "-" then "danger" else "textMuted"
end
local function tile(parent, settings, look, order, controlRole)
local frame = Create.new("Frame", {
Name = "Stat",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = order,
BackgroundTransparency = if look.fill then 0 else 1,
Theme = { BackgroundColor3 = controlRole },
Parent = parent,
})
Create.corner(8, frame)
Create.padding(frame, if look.fill then 12 else 2, 10)
Create.list(frame, "Vertical", 2)
local head = Create.new("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, 16), Parent = frame })
Create.list(head, "Horizontal", 6, { VerticalAlignment = Enum.VerticalAlignment.Center })
if settings.Icon then
Create.icon(settings.Icon, 13, "textMuted", head)
end
Create.new("TextLabel", {
Name = "Label",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = settings.Title or "",
TextSize = 12,
Weight = "medium",
LayoutOrder = 1,
Theme = { TextColor3 = "textMuted" },
Parent = head,
})
local line = Create.new("Frame", { Name = "Line", Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 1, Parent = frame })
Create.list(line, "Horizontal", 4, { VerticalAlignment = Enum.VerticalAlignment.Bottom })
local value = Create.new("TextLabel", {
Name = "Value",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = tostring(settings.Value or "0"),
TextSize = 24,
Weight = "bold",
TextYAlignment = Enum.TextYAlignment.Bottom,
Theme = { TextColor3 = "text" },
Parent = line,
})
local unit = Create.new("TextLabel", {
Name = "Unit",
Size = UDim2.new(0, 0, 1, -3),
AutomaticSize = Enum.AutomaticSize.X,
Text = settings.Unit or "",
TextSize = 13,
LayoutOrder = 1,
TextYAlignment = Enum.TextYAlignment.Bottom,
Visible = (settings.Unit or "") ~= "",
Theme = { TextColor3 = "textMuted" },
Parent = line,
})
local change = Create.new("TextLabel", {
Name = "Change",
Size = UDim2.new(1, 0, 0, 16),
Text = settings.Change or "",
TextSize = 12,
LayoutOrder = 2,
Visible = (settings.Change or "") ~= "",
Theme = { TextColor3 = changeRole(settings.Change, settings.Kind) },
Parent = frame,
})
return { frame = frame, value = value, unit = unit, change = change }
end
local function setters(handle, parts)
function handle:Set(value)
parts.value.Text = tostring(value)
handle.Value = value
handle.Changed:Fire(value)
end
function handle:Get()
return handle.Value
end
function handle:SetUnit(text)
parts.unit.Text = tostring(text or "")
parts.unit.Visible = parts.unit.Text ~= ""
end
function handle:SetChange(text, kind)
parts.change.Text = tostring(text or "")
parts.change.Visible = parts.change.Text ~= ""
Theme.bind(parts.change, "TextColor3", changeRole(text, kind))
end
end
function Stat.new(container, options)
local row = Row.new(container, options, { bare = true, compact = true })
local handle = row.handle
local look = Styles.pick("Stat", options.Style, row.window)
local parts = tile(row.content, options, look, 1, row.controlRole)
handle.Value = options.Value
setters(handle, parts)
return handle
end
function Stat.group(container, options)
local row = Row.new(container, options, { bare = true, compact = true })
local handle, scope = row.handle, row.scope
local look = Styles.pick("Stat", options.Style, row.window)
local columns = math.clamp(math.floor(tonumber(options.Columns) or 3), 1, 4)
local holder = Create.new("Frame", { Name = "Stats", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row.content })
local layout = Create.list(holder, "Horizontal", 8, { Wraps = true })
handle.Items = {}
local frames = {}
for order, settings in options.Items or {} do
local parts = tile(holder, settings, look, order, row.controlRole)
local item = { Changed = handle.Changed, Value = settings.Value }
setters(item, parts)
handle.Items[settings.Key or settings.Title or order] = item
table.insert(frames, parts.frame)
end
local function fit()
local width = holder.AbsoluteSize.X / row.library.scale
if width <= 0 then
return
end
local count = math.max(1, math.min(columns, math.floor((width + 8) / 104), #frames))
for _, frame in frames do
frame.Size = UDim2.new(1 / count, -8 * (count - 1) / count - 1, 0, 0)
end
end
scope:connect(holder:GetPropertyChangedSignal("AbsoluteSize"), fit)
fit()
layout.Padding = UDim.new(0, 8)
function handle:Set(key, value)
local item = handle.Items[key]
if item then
item:Set(value)
end
end
function handle:Get(key)
local item = handle.Items[key]
return item and item:Get()
end
return handle
end
return Stat
end
modules["Elements/Status"] = function()
local Create = import("Core/Create")
local Effects = import("Core/Effects")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local KINDS = { success = "success", warning = "warning", danger = "danger", info = "info", muted = "textMuted" }
local Status = {}
function Status.new(container, options)
local row = Row.new(container, options)
local handle = row.handle
local pill = Create.new("Frame", {
Name = "Status",
Size = UDim2.fromOffset(0, 24),
AutomaticSize = Enum.AutomaticSize.X,
BackgroundTransparency = 0.86,
Parent = row.slot,
})
Create.corner(-1, pill)
Create.padding(pill, 10, 0)
Create.list(pill, "Horizontal", 6)
local dot = Create.new("Frame", { Name = "Dot", Size = UDim2.fromOffset(8, 8), Parent = pill })
Create.corner(-1, dot)
local halo = Create.new("UIStroke", { Thickness = 0, Transparency = 0.4, Parent = dot })
local words = Create.new("TextLabel", {
Name = "Words",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
TextSize = 12,
Weight = "bold",
LayoutOrder = 1,
Parent = pill,
})
local pulse = Effects.pulse(row.scope, halo)
local state = { text = options.Status or Strings.get("Ready"), kind = options.Kind or "success" }
local function draw()
local role = KINDS[state.kind] or "success"
Theme.bind(pill, "BackgroundColor3", role)
Theme.bind(dot, "BackgroundColor3", role)
Theme.bind(halo, "Color", role)
Theme.bind(words, "TextColor3", role)
words.Text = state.text
handle.SearchExtra = state.text
handle.SearchText = string.lower(handle.Title .. " " .. state.text)
if options.Pulse then
pulse.start()
else
pulse.stop()
end
end
function handle:Get()
return state.text, state.kind
end
function handle:SetStatus(text, kind)
state.text = tostring(text)
state.kind = kind or state.kind
draw()
self.Changed:Fire(state.text, state.kind)
end
handle.Set = handle.SetStatus
function handle:SetPulse(on)
options.Pulse = on == true
draw()
end
draw()
return handle
end
return Status
end
modules["Elements/Stepper"] = function()
local UserInputService = game:GetService("UserInputService")
local Create = import("Core/Create")
local Row = import("Elements/Row")
local Stepper = {}
local DRAG_PER_STEP = 8
function Stepper.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local min, max = options.Min or -math.huge, options.Max or math.huge
local step = options.Step or 1
local value = math.clamp(options.Default or 0, min, max)
local function press(icon, order)
local button = Create.new("TextButton", {
Name = icon,
Size = UDim2.fromOffset(row.reach, row.reach),
LayoutOrder = order,
Theme = { BackgroundColor3 = row.controlRole },
Parent = row.slot,
})
Create.corner(6, button)
Create.stroke("stroke", button)
local glyph = Create.icon(icon, 14, "text", button)
glyph.AnchorPoint = Vector2.new(0.5, 0.5)
glyph.Position = UDim2.fromScale(0.5, 0.5)
return button
end
local minus = press("minus", 1)
local readout = Create.new(if options.Drag == false then "TextLabel" else "TextButton", {
Name = "Value",
Size = UDim2.fromOffset(52, row.reach),
TextXAlignment = Enum.TextXAlignment.Center,
LayoutOrder = 2,
Theme = { TextColor3 = "text" },
Parent = row.slot,
})
local plus = press("plus", 3)
local function draw()
readout.Text = tostring(value) .. (options.Suffix or "")
end
function handle:Get()
return value
end
function handle:Set(newValue)
value = math.clamp(tonumber(newValue) or value, min, max)
draw()
row.fire(value)
end
scope:connect(minus.Activated, function()
handle:Set(value - step)
end)
scope:connect(plus.Activated, function()
handle:Set(value + step)
end)
if options.Drag ~= false then
local origin, start
scope:connect(readout.InputBegan, function(input)
local kind = input.UserInputType
if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
origin, start = input.Position.X, value
end
end)
scope:connect(UserInputService.InputChanged, function(input)
local kind = input.UserInputType
if origin and (kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch) then
local steps = math.round((input.Position.X - origin) / (DRAG_PER_STEP * row.library.scale))
value = math.clamp(start + steps * step, min, max)
draw()
end
end)
scope:connect(UserInputService.InputEnded, function(input)
local kind = input.UserInputType
if origin and (kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch) then
origin = nil
if value ~= start then
row.fire(value)
end
end
end)
end
draw()
return handle
end
return Stepper
end
modules["Elements/Table"] = function()
local Create = import("Core/Create")
local Hairline = import("Core/Hairline")
local Icons = import("Core/Icons")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local ROW_HEIGHT = 28
local Table = {}
local function columnsFrom(list)
local columns, shared, claimed = {}, 0, 0
for index, raw in list or {} do
local column = if type(raw) == "table" then raw else { Title = raw }
columns[index] = { title = tostring(column.Title or ""), width = tonumber(column.Width), align = column.Align }
if columns[index].width then
claimed += columns[index].width
else
shared += 1
end
end
local each = if shared > 0 then math.max(1 - claimed, 0) / shared else 0
for _, column in columns do
column.width = column.width or each
end
return columns
end
function Table.new(container, options)
local row = Row.new(container, { Title = options.Title or "", Description = options.Description }, { bare = options.Title == nil })
local handle, scope = row.handle, row.scope
local columns = columnsFrom(options.Columns)
local rows = table.clone(options.Rows or {})
local sortColumn, ascending = nil, true
local bodyScope
local frame = Create.new("Frame", {
Name = "Table",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = 3,
Theme = { BackgroundColor3 = row.controlRole },
Parent = row.content,
})
Create.corner(8, frame)
Create.stroke("stroke", frame)
Create.list(frame, "Vertical", 0)
local function cell(parent, column, text, order, header)
local label = Create.new("TextLabel", {
Name = "Cell",
Size = UDim2.new(column.width, 0, 1, 0),
Text = text,
TextSize = if header then 12 else 13,
Weight = if header then "bold" else "regular",
TextTruncate = Enum.TextTruncate.AtEnd,
TextXAlignment = Enum.TextXAlignment[column.align or "Left"] or Enum.TextXAlignment.Left,
LayoutOrder = order,
Theme = { TextColor3 = if header then "textMuted" else "text" },
Parent = parent,
})
Create.padding(label, 10, 0)
return label
end
local head = Create.new("Frame", { Name = "Head", Size = UDim2.new(1, 0, 0, ROW_HEIGHT), Parent = frame })
Create.list(head, "Horizontal", 0)
local arrows = {}
for index, column in columns do
local button = Create.new("TextButton", {
Name = "Heading",
Size = UDim2.new(column.width, 0, 1, 0),
LayoutOrder = index,
Parent = head,
})
Create.list(button, "Horizontal", 2, {
HorizontalAlignment = Enum.HorizontalAlignment[column.align or "Left"] or Enum.HorizontalAlignment.Left,
})
local label = cell(button, { width = 0 }, string.upper(column.title), 1, true)
label.Size = UDim2.fromScale(0, 1)
label.AutomaticSize = Enum.AutomaticSize.X
local arrow = Create.icon("chevron-down", 12, "accent", button)
arrow.LayoutOrder = 2
arrow.Visible = false
arrows[index] = arrow
if options.Sortable ~= false then
scope:connect(button.Activated, function()
if sortColumn == index then
ascending = not ascending
else
sortColumn, ascending = index, true
end
handle:Refresh()
end)
end
end
Hairline.new("X", "stroke", { LayoutOrder = 1, Parent = frame })
local body = Create.new("ScrollingFrame", {
Name = "Body",
Size = UDim2.new(1, 0, 0, 0),
LayoutOrder = 2,
Parent = frame,
})
Create.list(body, "Vertical", 0)
local empty = Create.new("TextLabel", {
Name = "Empty",
Size = UDim2.new(1, 0, 0, ROW_HEIGHT + 8),
Text = options.EmptyText or Strings.get("Nothing to show yet"),
TextSize = 12,
TextXAlignment = Enum.TextXAlignment.Center,
LayoutOrder = 3,
Theme = { TextColor3 = "textMuted" },
Parent = frame,
})
local function sorted()
local list = table.clone(rows)
if sortColumn then
table.sort(list, function(a, b)
local left, right = a[sortColumn], b[sortColumn]
local leftNumber, rightNumber = tonumber(left), tonumber(right)
if leftNumber and rightNumber then
if ascending then
return leftNumber < rightNumber
end
return leftNumber > rightNumber
end
left, right = string.lower(tostring(left or "")), string.lower(tostring(right or ""))
if ascending then
return left < right
end
return left > right
end)
end
return list
end
function handle:Refresh()
if bodyScope then
scope:release(bodyScope)
end
bodyScope = scope:child()
for index, arrow in arrows do
arrow.Visible = index == sortColumn
Icons.apply(arrow, if ascending then "chevron-up" else "chevron-down")
end
local words = { options.Title or "" }
for order, values in sorted() do
local line = Create.new("Frame", {
Name = "Line",
Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
LayoutOrder = order,
BackgroundTransparency = if options.Striped ~= false and order % 2 == 0 then 0.5 else 1,
Theme = { BackgroundColor3 = "hover" },
Parent = body,
})
bodyScope:add(line)
Create.list(line, "Horizontal", 0)
for index, column in columns do
local text = tostring(if values[index] ~= nil then values[index] else "")
cell(line, column, text, index, false)
table.insert(words, text)
end
end
local maxHeight = tonumber(options.MaxHeight) or 220
body.Size = UDim2.new(1, 0, 0, math.min(#rows * ROW_HEIGHT, maxHeight))
empty.Visible = #rows == 0
self.SearchExtra = table.concat(words, " ")
self.SearchText = string.lower(self.SearchExtra)
end
function handle:Get()
return table.clone(rows)
end
function handle:SetRows(newRows)
rows = table.clone(newRows or {})
self:Refresh()
self.Changed:Fire(self:Get())
end
handle.Set = handle.SetRows
function handle:AddRow(values)
table.insert(rows, values)
self:Refresh()
end
function handle:Clear()
self:SetRows({})
end
handle:Refresh()
return handle
end
return Table
end
modules["Elements/Tags"] = function()
local Create = import("Core/Create")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local Tags = {}
function Tags.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local max = tonumber(options.Max)
local tags = {}
for _, tag in options.Default or {} do
if type(tag) == "string" and tag ~= "" then
table.insert(tags, tag)
end
end
local below = row.belowTitle()
Create.list(below, "Vertical", 6)
local field = Create.new("Frame", {
Name = "Field",
Size = UDim2.new(1, 0, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
Theme = { BackgroundColor3 = row.controlRole },
Parent = below,
})
Create.corner(8, field)
local edge = Create.stroke("stroke", field)
Create.padding(field, 6)
Create.list(field, "Horizontal", 6, { Wraps = true, VerticalAlignment = Enum.VerticalAlignment.Center })
local box = Create.new("TextBox", {
Name = "Entry",
Size = UDim2.fromOffset(120, 26),
PlaceholderText = options.Placeholder or Strings.get("Type and press Enter"),
TextSize = 13,
LayoutOrder = 1e6,
ClearTextOnFocus = false,
Theme = { TextColor3 = "text" },
Parent = field,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Grow }) })
Create.padding(box, 4, 0)
local suggestions = Create.new("Frame", { Name = "Suggestions", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Visible = false, Parent = below })
Create.list(suggestions, "Horizontal", 6, { Wraps = true })
local chips = {}
local add, remove
local function draw()
for _, chip in chips do
chip:Destroy()
end
table.clear(chips)
for index, tag in tags do
local chip = Create.new("Frame", {
Name = "Tag",
Size = UDim2.fromOffset(0, 26),
AutomaticSize = Enum.AutomaticSize.X,
LayoutOrder = index,
BackgroundTransparency = 0.85,
Theme = { BackgroundColor3 = "accent" },
Parent = field,
})
Create.corner(-1, chip)
Create.padding(chip, 10, 0, 4, 0)
Create.list(chip, "Horizontal", 4, { VerticalAlignment = Enum.VerticalAlignment.Center })
Create.new("TextLabel", {
Name = "Text",
Size = UDim2.fromScale(0, 1),
AutomaticSize = Enum.AutomaticSize.X,
Text = tag,
TextSize = 12,
Weight = "medium",
Theme = { TextColor3 = "accent" },
Parent = chip,
})
local cross = Create.new("TextButton", { Name = "Remove", Size = UDim2.fromOffset(20, 20), LayoutOrder = 1, Parent = chip })
local glyph = Create.icon("x", 12, "accent", cross)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
scope:connect(cross.Activated, function()
remove(index)
end)
table.insert(chips, chip)
end
box.Visible = not (max and #tags >= max)
end
local function changed()
draw()
handle.SearchExtra = table.concat(tags, " ")
row.fire(table.clone(tags))
end
function add(text)
text = string.match(tostring(text or ""), "^%s*(.-)%s*$")
if text == "" or (max and #tags >= max) then
return false
end
if not options.AllowDuplicates then
for _, tag in tags do
if string.lower(tag) == string.lower(text) then
return false
end
end
end
table.insert(tags, text)
changed()
return true
end
function remove(index)
if tags[index] then
table.remove(tags, index)
changed()
end
end
local function suggest()
for _, child in suggestions:GetChildren() do
if child:IsA("GuiObject") then
child:Destroy()
end
end
local query = string.lower(box.Text)
local shown = 0
if query ~= "" and type(options.Suggestions) == "table" then
for _, word in options.Suggestions do
local taken = table.find(tags, word) ~= nil
if not taken and shown < 6 and string.find(string.lower(word), query, 1, true) then
shown += 1
local option = Create.new("TextButton", {
Name = "Suggestion",
Size = UDim2.fromOffset(0, 24),
AutomaticSize = Enum.AutomaticSize.X,
Text = word,
TextSize = 12,
LayoutOrder = shown,
Theme = { BackgroundColor3 = row.controlRole, TextColor3 = "text" },
Parent = suggestions,
})
Create.corner(-1, option)
Create.padding(option, 10, 0)
Create.stroke("stroke", option)
scope:connect(option.Activated, function()
add(word)
box.Text = ""
end)
end
end
end
suggestions.Visible = shown > 0
end
scope:connect(box:GetPropertyChangedSignal("Text"), suggest)
scope:connect(box.Focused, function()
Theme.bind(edge, "Color", "accent")
end)
scope:connect(box.FocusLost, function(enter)
Theme.bind(edge, "Color", "stroke")
if enter and add(box.Text) then
box.Text = ""
box:CaptureFocus()
end
end)
function handle:Get()
return table.clone(tags)
end
function handle:Set(list)
table.clear(tags)
for _, tag in if type(list) == "table" then list else {} do
if type(tag) == "string" and tag ~= "" then
table.insert(tags, tag)
end
end
changed()
end
function handle:Add(text)
return add(text)
end
function handle:Remove(text)
local index = table.find(tags, text)
if index then
remove(index)
end
end
draw()
handle.SearchExtra = table.concat(tags, " ")
return handle
end
return Tags
end
modules["Elements/Tiles"] = function()
local Create = import("Core/Create")
local Icons = import("Core/Icons")
local Motion = import("Core/Motion")
local Options = import("Elements/Options")
local Row = import("Elements/Row")
local Theme = import("Core/Theme")
local GAP = 8
local Tiles = {}
function Tiles.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local multi = options.Multi == true
local entries, values = Options.entries(options.Items or options.Values)
local picked = {}
local cards = {}
local columns = math.clamp(tonumber(options.Columns) or 3, 1, 6)
local height = tonumber(options.Height) or (if entries[1] and entries[1].description then 84 else 68)
local area = row.belowTitle()
local grid = Create.new("UIGridLayout", {
CellPadding = UDim2.fromOffset(GAP, GAP),
SortOrder = Enum.SortOrder.LayoutOrder,
Parent = area,
})
local function fit()
local width = area.AbsoluteSize.X / row.library.scale
local shown = if width > 0 and width < 300 then math.min(columns, 2) else columns
grid.CellSize = UDim2.new(1 / shown, -GAP * (shown - 1) / shown - 1, 0, height)
end
scope:connect(area:GetPropertyChangedSignal("AbsoluteSize"), fit)
fit()
local function draw(timing)
for _, card in cards do
local on = picked[card.value] == true
Theme.bind(card.edge, "Color", if on then "accent" elseif card.hovered then "textMuted" else "stroke")
Motion.tween(card.edge, timing, { Thickness = if on then 1.5 else 1 })
Theme.bind(card.frame, "BackgroundColor3", if on then "accent" else row.controlRole)
card.frame.BackgroundTransparency = if on then 0.86 else 0
if card.icon then
Theme.bind(card.icon, "ImageColor3", if on then "accent" else "textMuted")
end
card.tick.Visible = on
end
end
function handle:Get()
local list = Options.ordered(values, picked)
return if multi then list else list[1]
end
function handle:Set(value)
Options.pick(values, picked, value, multi)
draw("fast")
row.fire(self:Get())
end
for index, entry in entries do
if entry.heading then
continue
end
local frame = Create.new("TextButton", {
Name = "Tile",
LayoutOrder = index,
Theme = { BackgroundColor3 = row.controlRole },
Parent = area,
})
Create.corner(8, frame)
local card = { frame = frame, value = entry.value, edge = Create.stroke("stroke", frame), hovered = false }
local content = Create.new("Frame", { Name = "Content", Size = UDim2.fromScale(1, 1), Parent = frame })
Create.padding(content, 8, 10)
Create.list(content, "Vertical", 4, { HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center })
if entry.icon or entry.image then
card.icon = Create.new("ImageLabel", {
Name = "Icon",
Size = UDim2.fromOffset(22, 22),
Icon = entry.icon,
Theme = if entry.icon then { ImageColor3 = "textMuted" } else nil,
Parent = content,
})
if entry.image then
Icons.apply(card.icon, entry.image)
end
end
Create.new("TextLabel", {
Name = "Title",
Size = UDim2.new(1, 0, 0, 16),
Text = entry.text,
TextSize = 13,
Weight = "medium",
TextXAlignment = Enum.TextXAlignment.Center,
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 1,
Theme = { TextColor3 = if entry.disabled then "textMuted" else "text" },
Parent = content,
})
if entry.description then
Create.new("TextLabel", {
Name = "Description",
Size = UDim2.new(1, 0, 0, 14),
Text = tostring(entry.description),
TextSize = 12,
TextXAlignment = Enum.TextXAlignment.Center,
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 2,
Theme = { TextColor3 = "textMuted" },
Parent = content,
})
end
card.tick = Create.new("Frame", {
Name = "Tick",
Size = UDim2.fromOffset(16, 16),
AnchorPoint = Vector2.new(1, 0),
Position = UDim2.new(1, -6, 0, 6),
Visible = false,
ZIndex = 2,
Theme = { BackgroundColor3 = "accent" },
Parent = frame,
})
Create.corner(-1, card.tick)
local mark = Create.icon("check", 10, "onAccent", card.tick)
mark.AnchorPoint, mark.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
table.insert(cards, card)
if entry.disabled then
frame.AutoButtonColor = false
frame.BackgroundTransparency = 0.5
continue
end
scope:connect(frame.MouseEnter, function()
card.hovered = true
draw("fast")
end)
scope:connect(frame.MouseLeave, function()
card.hovered = false
draw("fast")
end)
scope:connect(frame.Activated, function()
if multi then
local chosen = Options.ordered(values, picked)
local found = table.find(chosen, entry.value)
if found then
table.remove(chosen, found)
else
table.insert(chosen, entry.value)
end
handle:Set(chosen)
else
handle:Set(if picked[entry.value] and options.AllowNone then nil else entry.value)
end
end)
end
local default = options.Default
if default == nil and not multi and not options.AllowNone then
default = values[1]
end
Options.pick(values, picked, default, multi)
draw(nil)
return handle
end
return Tiles
end
modules["Elements/Toggle"] = function()
local ColorPicker = import("Elements/ColorPicker")
local Create = import("Core/Create")
local Env = import("Core/Env")
local Icons = import("Core/Icons")
local Keybind = import("Elements/Keybind")
local Motion = import("Core/Motion")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local Theme = import("Core/Theme")
local STRETCH = 6
Styles.register("Thumb", "Circle", { width = 14, height = 14, corner = -1 })
Styles.register("Thumb", "Oval", { width = 18, height = 12, corner = -1 })
Styles.register("Thumb", "Square", { width = 14, height = 14, corner = 4 })
Styles.register("Toggle", "Switch", { kind = "switch", width = 36, height = 20, corner = -1, inset = 3 })
Styles.register("Toggle", "Large", {
kind = "switch",
width = 46,
height = 26,
corner = -1,
inset = 3,
thumb = { width = 20, height = 20, corner = -1 },
knobOff = "text",
})
Styles.register("Toggle", "Slim", {
kind = "switch",
width = 34,
height = 20,
corner = -1,
inset = 0,
rail = 12,
thumb = { width = 18, height = 18, corner = -1 },
knobOff = "text",
})
Styles.register("Toggle", "Square", {
kind = "switch",
width = 36,
height = 20,
corner = 5,
inset = 3,
thumb = { width = 14, height = 14, corner = 3 },
})
Styles.register("Toggle", "Labelled", {
kind = "switch",
width = 60,
height = 24,
corner = -1,
inset = 3,
thumb = { width = 18, height = 18, corner = -1 },
labels = { "ON", "OFF" },
})
Styles.register("Toggle", "Icon", {
kind = "switch",
width = 40,
height = 22,
corner = -1,
inset = 3,
thumb = { width = 16, height = 16, corner = -1 },
icons = { "check", "x" },
})
Styles.register("Toggle", "Glow", { kind = "switch", width = 36, height = 20, corner = -1, inset = 3, glow = true })
Styles.register("Toggle", "Checkbox", { kind = "box", width = 22, height = 22, corner = 7 })
Styles.register("Toggle", "Circle", { kind = "box", width = 22, height = 22, corner = -1 })
Styles.register("Toggle", "Chip", { kind = "chip", width = 46, height = 24, corner = -1, labels = { "On", "Off" } })
local Toggle = {}
function Toggle.new(container, options)
local row = Row.new(container, options, { button = true })
local handle, window = row.handle, row.window
local value = options.Default == true
local look = Styles.pick("Toggle", options.Style, window)
local kind = look.kind or "switch"
local box, chip = kind == "box", kind == "chip"
local width, height = look.width or 36, look.height or 20
local thumb = look.thumb or Styles.pick("Thumb", options.Thumb, window)
local inset = look.inset or 3
local problem = window:checkFlag(options.Color and options.Color.Flag) or window:checkFlag(options.Keybind and options.Keybind.Flag)
if problem then
handle:Destroy()
error(problem, 4)
end
if options.Color then
local settings = options.Color
handle.Color = ColorPicker.control(row, settings, function(color, transparency)
Env.call(handle.Title .. " colour", settings.Callback, color, transparency)
end)
window:claimFlag(settings.Flag, handle.Color, row.scope)
end
local group
if type(options.Exclusive) == "string" then
window.exclusiveGroups = window.exclusiveGroups or {}
group = window.exclusiveGroups[options.Exclusive] or {}
window.exclusiveGroups[options.Exclusive] = group
table.insert(group, handle)
row.scope:add(function()
local index = table.find(group, handle)
if index then
table.remove(group, index)
end
end)
end
if options.Keybind then
local settings = options.Keybind
local hold = settings.Mode == "Hold"
handle.Keybind = Keybind.control(row, { Default = settings.Default, Mode = if hold then "Hold" else "Toggle", Modifiers = settings.Modifiers }, function(pressed)
if hold then
handle:Set(pressed)
elseif pressed then
handle:Set(not value)
end
end)
window:claimFlag(settings.Flag, handle.Keybind, row.scope)
end
local track = Create.new("Frame", {
Name = "Switch",
Size = UDim2.fromOffset(width, height),
LayoutOrder = 10,
BackgroundTransparency = if look.rail then 1 else 0,
Theme = { BackgroundColor3 = "stroke" },
Parent = row.slot,
})
local body = track
if look.rail then
body = Create.new("Frame", {
Name = "Rail",
Size = UDim2.new(1, 0, 0, look.rail),
AnchorPoint = Vector2.new(0, 0.5),
Position = UDim2.fromScale(0, 0.5),
Theme = { BackgroundColor3 = "stroke" },
Parent = track,
})
Create.corner(-1, body)
else
Create.corner(look.corner or -1, track)
end
local restRole = if box then row.controlRole else "stroke"
local outline = if box then Create.stroke("stroke", track, 1.5) else nil
local ring = Create.new("Frame", {
Name = "Outline",
Size = UDim2.new(1, 2, 1, 2),
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromScale(0.5, 0.5),
Parent = track,
})
Create.corner(if (look.corner or -1) < 0 then -1 else look.corner + 1, ring)
local ringStroke = Create.new("UIStroke", { Name = "Stroke", Thickness = 1.5, Transparency = 1, Parent = ring })
local halo
if look.glow then
halo = Create.new("UIStroke", { Name = "Glow", Thickness = 3, Transparency = 1, Theme = { Color = "accent" }, Parent = body })
end
local function showOutline(active)
local wanted = window.toggleOutline
if options.Outline ~= nil then
wanted = options.Outline == true
end
local color = options.OutlineColor or window.toggleOutlineColor
ringStroke.Color = if typeof(color) == "Color3" then color else Theme.color("accent")
Motion.tween(ringStroke, "fast", { Transparency = if active and wanted then 0 else 1 })
end
local knob, mark, word, glyph
if box then
mark = Create.icon("check", 14, "onAccent", track)
mark.AnchorPoint = Vector2.new(0.5, 0.5)
mark.Position = UDim2.fromScale(0.5, 0.5)
elseif chip then
word = Create.new("TextLabel", {
Name = "State",
Size = UDim2.fromScale(1, 1),
TextSize = 12,
Weight = "bold",
TextXAlignment = Enum.TextXAlignment.Center,
Parent = track,
})
else
knob = Create.new("Frame", {
Name = "Thumb",
Size = UDim2.fromOffset(thumb.width, thumb.height),
AnchorPoint = Vector2.new(0, 0.5),
ZIndex = 2,
Theme = { BackgroundColor3 = "textMuted" },
Parent = track,
})
Create.corner(thumb.corner or -1, knob)
if look.rail then
Create.new("UIStroke", { Transparency = 0.6, Theme = { Color = "background" }, Parent = knob })
end
if look.icons then
glyph = Create.icon(look.icons[2], math.max(thumb.height - 6, 8), "background", knob)
glyph.AnchorPoint = Vector2.new(0.5, 0.5)
glyph.Position = UDim2.fromScale(0.5, 0.5)
end
if look.labels then
word = Create.new("TextLabel", {
Name = "State",
Size = UDim2.fromOffset(0, height),
AutomaticSize = Enum.AutomaticSize.X,
AnchorPoint = Vector2.new(1, 0.5),
TextSize = 12,
Weight = "bold",
Parent = track,
})
end
end
local slideGeneration = 0
local function slide(timing)
local thumbWidth, thumbHeight = thumb.width, thumb.height
local rest = UDim2.new(0, if value then width - thumbWidth - inset else inset, 0.5, 0)
slideGeneration += 1
if word and not chip then
word.AnchorPoint = Vector2.new(if value then 0 else 1, 0.5)
word.Position = UDim2.new(if value then 0 else 1, if value then 8 else -8, 0.5, 0)
end
if not timing or Motion.reduced then
knob.Size = UDim2.fromOffset(thumbWidth, thumbHeight)
knob.Position = rest
return
end
local stretched = thumbWidth + STRETCH
Motion.tween(knob, "fast", {
Size = UDim2.fromOffset(stretched, thumbHeight),
Position = UDim2.new(0, if value then width - stretched - inset else inset, 0.5, 0),
})
local started = slideGeneration
task.delay(0.1, function()
if started == slideGeneration and not row.scope.cleaned then
Motion.tween(knob, "spring", { Size = UDim2.fromOffset(thumbWidth, thumbHeight), Position = rest })
end
end)
end
local hovered = false
local function draw(timing)
local role = if value then (if hovered then "accentHover" else "accent") elseif hovered and not box then "hover" else restRole
Theme.bind(body, "BackgroundColor3", role, true)
Motion.tween(body, timing, { BackgroundColor3 = Theme.color(role) })
if box then
Motion.tween(mark, if timing and value then "spring" else timing, {
Size = if value then UDim2.fromOffset(14, 14) else UDim2.fromOffset(0, 0),
ImageTransparency = if value then 0 else 1,
})
Theme.bind(outline, "Color", if value then "accent" elseif hovered then "textMuted" else "stroke")
elseif knob then
local knobRole = if value then "onAccent" elseif hovered then "text" else look.knobOff or "textMuted"
Theme.bind(knob, "BackgroundColor3", knobRole, true)
Motion.tween(knob, timing, { BackgroundColor3 = Theme.color(knobRole) })
end
if word then
word.Text = Strings.get(if value then look.labels[1] else look.labels[2])
Theme.bind(word, "TextColor3", if value then "onAccent" else "textMuted")
end
if glyph then
Icons.apply(glyph, if value then look.icons[1] else look.icons[2])
Theme.bind(glyph, "ImageColor3", if value then "accent" else "background")
end
if halo then
Motion.tween(halo, timing, { Transparency = if value then 0.55 else 1 })
end
end
function handle:Get()
return value
end
function handle:Set(newValue)
local moved = value ~= (newValue == true)
value = newValue == true
if value and group then
for _, other in group do
if other ~= handle and other:Get() then
other:Set(false)
end
end
end
draw("fast")
if moved and knob then
slide("fast")
end
if self.Keybind then
self.Keybind.Active = value
window.KeybindsChanged:Fire()
end
row.fire(value)
end
row.scope:connect(row.frame.Activated, function()
if value or not options.Confirm then
handle:Set(not value)
return
end
window:Dialog({
Title = Strings.get("Turn on {title}?", { title = handle.Title }),
Content = if type(options.Confirm) == "string" then options.Confirm else nil,
Dismissible = true,
Buttons = {
{ Title = Strings.get("Keep it off") },
{
Title = Strings.get("Turn on"),
Variant = "Primary",
Callback = function()
handle:Set(true)
end,
},
},
})
end)
row.onHover(function(active)
hovered = active
draw("fast")
showOutline(active)
end, track)
draw(nil)
if knob then
slide(nil)
end
if value then
task.defer(function()
if not row.scope.cleaned and value then
row.fire(true)
end
end)
end
return handle
end
return Toggle
end
modules["Elements/Viewport"] = function()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Create = import("Core/Create")
local Drag = import("Core/Drag")
local Row = import("Elements/Row")
local Viewport = {}
local TURN = 0.012
local TIP = math.rad(60)
local function copyOf(source)
if typeof(source) ~= "Instance" then
return nil
end
local archivable = source.Archivable
source.Archivable = true
local ok, copy = pcall(source.Clone, source)
source.Archivable = archivable
if not ok or not copy then
return nil
end
for _, descendant in copy:GetDescendants() do
if descendant:IsA("BaseScript") or descendant:IsA("Sound") then
descendant:Destroy()
end
end
if copy:IsA("BasePart") then
local holder = Instance.new("Model")
copy.Parent = holder
return holder
end
return copy
end
function Viewport.new(container, options)
local row = Row.new(container, options)
local handle = row.handle
local scope = row.scope
local source = options.Model
local model, size = nil, Vector3.one
local yaw, pitch = math.rad(-25), math.rad(-10)
local frame = Create.new("ViewportFrame", {
Name = "Preview",
Size = UDim2.new(1, 0, 0, options.Height or 180),
Ambient = Color3.fromRGB(170, 170, 180),
LightColor = Color3.fromRGB(255, 255, 255),
LightDirection = Vector3.new(-1, -1, -1),
Theme = { BackgroundColor3 = row.controlRole },
Parent = row.belowTitle(),
})
Create.corner(8, frame)
local camera = Create.new("Camera", { FieldOfView = options.FieldOfView or 40, Parent = frame })
frame.CurrentCamera = camera
local function place()
if not model then
return
end
local turned = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
pcall(model.PivotTo, model, turned)
local radius = size.Magnitude / 2
local distance = options.Distance or (radius / math.tan(math.rad(camera.FieldOfView / 2)) * 1.15)
camera.CFrame = CFrame.new(0, 0, distance)
end
local function show(newSource)
if model then
model:Destroy()
model = nil
end
source = newSource
model = copyOf(source)
if not model then
return
end
local ok, box, extent = pcall(model.GetBoundingBox, model)
if ok and box then
size = extent
pcall(function()
model.WorldPivot = box
end)
end
model.Parent = frame
place()
end
local last = Vector2.zero
Drag.track(scope, frame, function(position)
last = position
return true
end, function(position)
local travel = position - last
last = position
yaw += travel.X * TURN
pitch = math.clamp(pitch + travel.Y * TURN, -TIP, TIP)
place()
end)
if type(options.Spin) == "number" and options.Spin ~= 0 then
local speed = math.rad(options.Spin)
scope:connect(RunService.RenderStepped, function(step)
local window = row.window
if model and window.Visible and (handle.Tab == nil or window.selected == handle.Tab) then
yaw += speed * step
place()
end
end)
end
function handle:Get()
return source
end
function handle:Set(newSource)
if newSource == nil and options.Character then
newSource = Players.LocalPlayer.Character
end
show(newSource)
row.fire(source)
end
handle.SetModel = handle.Set
function handle:ResetView()
yaw, pitch = math.rad(-25), math.rad(-10)
place()
end
if options.Character then
show(Players.LocalPlayer.Character)
scope:connect(Players.LocalPlayer.CharacterAdded, function(character)
task.wait(0.5)
if not scope.cleaned then
show(character)
end
end)
else
show(source)
end
return handle
end
return Viewport
end
modules["Elements/Waypoints"] = function()
local Players = game:GetService("Players")
local Create = import("Core/Create")
local Env = import("Core/Env")
local Row = import("Elements/Row")
local Strings = import("Core/Strings")
local Theme = import("Core/Theme")
local Waypoints = {}
local function characterPosition()
local character = Players.LocalPlayer.Character
local root = character and character:FindFirstChild("HumanoidRootPart")
return if root then root.CFrame else nil
end
local function components(cframe)
return { cframe:GetComponents() }
end
function Waypoints.new(container, options)
local row = Row.new(container, options)
local handle, scope = row.handle, row.scope
local list = {}
local max = tonumber(options.Max) or 50
local area = row.belowTitle()
Create.list(area, "Vertical", 6)
local top = Create.new("Frame", { Name = "Add", Size = UDim2.new(1, 0, 0, row.reach), Parent = area })
Create.list(top, "Horizontal", 8, { VerticalAlignment = Enum.VerticalAlignment.Center })
local nameBox = Create.new("TextBox", {
Name = "PlaceName",
Size = UDim2.new(1, -120, 1, 0),
PlaceholderText = Strings.get("Name this place"),
Text = "",
TextSize = 13,
ClearTextOnFocus = false,
TextXAlignment = Enum.TextXAlignment.Left,
Theme = { BackgroundColor3 = row.controlRole, TextColor3 = "text", PlaceholderColor3 = "textMuted" },
Parent = top,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
Create.corner(8, nameBox)
Create.padding(nameBox, 10, 0)
Create.stroke("stroke", nameBox)
local saveButton = Create.new("TextButton", {
Name = "SaveHere",
Size = UDim2.fromOffset(0, row.reach),
AutomaticSize = Enum.AutomaticSize.X,
Text = Strings.get("Save here"),
TextSize = 13,
Weight = "medium",
LayoutOrder = 1,
Theme = { BackgroundColor3 = "accent", TextColor3 = "onAccent" },
Parent = top,
})
Create.corner(8, saveButton)
Create.padding(saveButton, 12, 0)
local scroller = Create.new("ScrollingFrame", {
Name = "Places",
Size = UDim2.new(1, 0, 0, 0),
AutomaticCanvasSize = Enum.AutomaticSize.Y,
CanvasSize = UDim2.new(),
ScrollBarThickness = 3,
ScrollingDirection = Enum.ScrollingDirection.Y,
LayoutOrder = 1,
Theme = { ScrollBarImageColor3 = "textMuted" },
Parent = area,
})
local layout = Create.list(scroller, "Vertical", 4)
local empty = Create.new("TextLabel", {
Name = "Empty",
Size = UDim2.new(1, 0, 0, 28),
Text = Strings.get("No places saved yet"),
TextSize = 12,
LayoutOrder = 2,
Theme = { TextColor3 = "textMuted" },
Parent = area,
})
local maxHeight = tonumber(options.Height) or 220
scope:connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
scroller.Size = UDim2.new(1, 0, 0, math.min(layout.AbsoluteContentSize.Y / row.library.scale, maxHeight))
end)
local function teleport(entry)
if handle:IsLocked() then
return
end
if type(options.Teleport) == "function" then
Env.call(handle.Title, options.Teleport, entry.CFrame, entry.Name)
return
end
local character = Players.LocalPlayer.Character
if character then
pcall(character.PivotTo, character, entry.CFrame)
end
end
local draw
local function changed()
draw()
row.fire(handle:Get())
end
local function iconButton(parent, icon, order, role)
local button = Create.new("TextButton", {
Name = icon,
Size = UDim2.fromOffset(row.reach - 4, row.reach - 4),
LayoutOrder = order,
BackgroundTransparency = 1,
Theme = { BackgroundColor3 = "hover" },
Parent = parent,
})
Create.corner(6, button)
local glyph = Create.icon(icon, 15, role or "textMuted", button)
glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
scope:connect(button.MouseEnter, function()
button.BackgroundTransparency = 0
end)
scope:connect(button.MouseLeave, function()
button.BackgroundTransparency = 1
end)
return button
end
local lines = {}
function draw()
for _, line in lines do
line:Destroy()
end
table.clear(lines)
empty.Visible = #list == 0
for index, entry in list do
local line = Create.new("Frame", {
Name = "Place",
Size = UDim2.new(1, -6, 0, row.reach),
LayoutOrder = index,
Theme = { BackgroundColor3 = row.controlRole },
Parent = scroller,
})
table.insert(lines, line)
Create.corner(8, line)
Create.padding(line, 10, 0, 4, 0)
Create.list(line, "Horizontal", 2, { VerticalAlignment = Enum.VerticalAlignment.Center })
local pin = Create.icon("map-pin", 14, "accent", line)
pin.LayoutOrder = 0
local label = Create.new("TextBox", {
Name = "Name",
Size = UDim2.new(0, 0, 1, 0),
Text = entry.Name,
TextSize = 13,
ClearTextOnFocus = false,
TextXAlignment = Enum.TextXAlignment.Left,
TextTruncate = Enum.TextTruncate.AtEnd,
LayoutOrder = 1,
Theme = { TextColor3 = "text" },
Parent = line,
}, { Create.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }) })
Create.padding(label, 6, 0)
scope:connect(label.FocusLost, function()
local typed = string.match(label.Text, "^%s*(.-)%s*$")
if typed ~= "" and typed ~= entry.Name then
entry.Name = typed
changed()
else
label.Text = entry.Name
end
end)
local go = iconButton(line, "arrow-right", 2, "accent")
scope:connect(go.Activated, function()
teleport(entry)
end)
if index > 1 then
scope:connect(iconButton(line, "chevron-up", 3).Activated, function()
list[index], list[index - 1] = list[index - 1], list[index]
changed()
end)
end
if index < #list then
scope:connect(iconButton(line, "chevron-down", 4).Activated, function()
list[index], list[index + 1] = list[index + 1], list[index]
changed()
end)
end
scope:connect(iconButton(line, "trash-2", 5, "danger").Activated, function()
table.remove(list, index)
changed()
end)
end
end
local function save()
if handle:IsLocked() then
return
end
local read = if type(options.GetPosition) == "function" then options.GetPosition else characterPosition
local ok, position = pcall(read)
if not ok or typeof(position) ~= "CFrame" then
row.window:Notify({ Title = Strings.get("Place not saved"), Content = Strings.get("Your character isn't in the game yet."), Kind = "warning" })
return
end
if #list >= max then
row.window:Notify({ Title = Strings.get("Place not saved"), Content = Strings.get("Delete a place to make room."), Kind = "warning" })
return
end
local typed = string.match(nameBox.Text, "^%s*(.-)%s*$")
local name = if typed ~= "" then typed else Strings.get("Place {number}", { number = #list + 1 })
table.insert(list, { Name = name, CFrame = position })
nameBox.Text = ""
changed()
end
scope:connect(saveButton.Activated, save)
scope:connect(nameBox.FocusLost, function(enter)
if enter then
save()
end
end)
scope:connect(saveButton.MouseEnter, function()
Theme.bind(saveButton, "BackgroundColor3", "accentHover")
end)
scope:connect(saveButton.MouseLeave, function()
Theme.bind(saveButton, "BackgroundColor3", "accent")
end)
function handle:Get()
local copy = {}
for _, entry in list do
table.insert(copy, { Name = entry.Name, CFrame = entry.CFrame })
end
return copy
end
function handle:Set(newList)
list = {}
for _, entry in (if type(newList) == "table" then newList else {}) do
if type(entry) == "table" and typeof(entry.CFrame) == "CFrame" then
table.insert(list, { Name = tostring(entry.Name or ""), CFrame = entry.CFrame })
end
end
changed()
end
function handle:Teleport(which)
for index, entry in list do
if entry.Name == which or index == which then
teleport(entry)
return true
end
end
return false
end
function handle:Encode()
local saved = {}
for _, entry in list do
table.insert(saved, { name = entry.Name, at = components(entry.CFrame) })
end
return saved
end
function handle:Decode(saved)
local decoded = {}
for _, entry in (if type(saved) == "table" then saved else {}) do
if type(entry) == "table" and type(entry.at) == "table" and #entry.at == 12 then
table.insert(decoded, { Name = tostring(entry.name or ""), CFrame = CFrame.new(table.unpack(entry.at)) })
end
end
return decoded
end
for _, entry in (if type(options.Default) == "table" then options.Default else {}) do
if type(entry) == "table" and typeof(entry.CFrame) == "CFrame" then
table.insert(list, { Name = tostring(entry.Name or ""), CFrame = entry.CFrame })
end
end
draw()
return handle
end
return Waypoints
end
modules["Halcyon"] = function()
local UserInputService = game:GetService("UserInputService")
local Assets = import("Core/Assets")
local Config = import("Core/Config")
local ConfigSection = import("Components/ConfigSection")
local Create = import("Core/Create")
local Dialog = import("Components/Dialog")
local Drag = import("Core/Drag")
local Env = import("Core/Env")
local Hairline = import("Core/Hairline")
local Hud = import("Components/Hud")
local Icons = import("Core/Icons")
local KeySystem = import("Components/KeySystem")
local Motion = import("Core/Motion")
local Notifications = import("Components/Notifications")
local QuickBar = import("Components/QuickBar")
local Sheet = import("Components/Sheet")
local Palettes = import("Themes/Palettes")
local Presets = import("Themes/Presets")
local Schema = import("Core/Schema")
local Scope = import("Core/Scope")
local SettingsTab = import("Components/SettingsTab")
local Signal = import("Core/Signal")
local Strings = import("Core/Strings")
local Styles = import("Core/Styles")
local Switches = import("Components/Switches")
local Theme = import("Core/Theme")
local Tokens = import("Core/Tokens")
local Window = import("Components/Window")
local Build = import("Components/Build")
local Registry = import("Elements/Registry")
for _, palette in Palettes do
assert(Theme.add(palette))
end
Theme.set(Palettes[1].Name)
local library = {
scope = Scope.new(),
windows = {},
displayOrder = 2147483000,
scale = 1,
listeningForKey = false,
touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled,
}
Tokens.touch = library.touch
function library.notify(options)
return Notifications.push(library, options)
end
local Halcyon = {
Version = "2.3.0",
ThemeChanged = Theme.Changed,
Internal = {
Assets = Assets,
Config = Config,
Create = Create,
Drag = Drag,
Env = Env,
Hairline = Hairline,
Icons = Icons,
KeySystem = KeySystem,
Motion = Motion,
Notifications = Notifications,
Personalise = import("Components/Personalise"),
Schema = Schema,
Scope = Scope,
Signal = Signal,
Strings = Strings,
Styles = Styles,
Theme = Theme,
Tokens = Tokens,
library = library,
},
}
library.version = Halcyon.Version
function Window:SettingsTab(options)
return SettingsTab.build(self, options)
end
function Window:ConfigSection(target, options)
return ConfigSection.build(self, target, options)
end
function Window:Sheet(options)
return Sheet.new(self, options)
end
function Window:QuickBar(options)
return QuickBar.new(self, options)
end
function Window:Watermark(options)
return Hud.watermark(self, options)
end
function Window:KeybindList(options)
return Hud.keybindList(self, options)
end
function Window:SetAccent(color)
Theme.setAccent(color)
end
local function folderFor(options)
return Env.safeName(options.Folder or options.Title) or "Default"
end
local function savedLanguage(folder, options)
if options.SavePreferences == false then
return nil
end
local content = Env.read(`Halcyon/{folder}/settings.json`)
if not content then
return nil
end
local ok, saved = Env.decode(content)
return if ok and type(saved) == "table" and type(saved.language) == "string" then saved.language else nil
end
function Halcyon:CreateWindow(options)
options = options or {}
if type(options) ~= "table" then
error("CreateWindow expects a table of options", 2)
end
if options.Debug ~= nil then
Schema.enabled = options.Debug == true
end
Schema.check(`CreateWindow "{options.Title or ""}"`, options, Schema.window)
options = Presets.apply(options)
local folder = folderFor(options)
local registry = Env.globals()
registry.HalcyonWindows = registry.HalcyonWindows or {}
local previous = registry.HalcyonWindows[folder]
local granted = if previous and previous.access and previous.access.Tiers then previous.access else nil
if previous then
pcall(previous.Unload, previous)
end
Strings.setLanguage(savedLanguage(folder, options) or options.Language or "en")
if type(options.Strings) == "table" then
Strings.set(options.Strings)
end
Tokens.reset()
Tokens.set(options)
if options.Font then
Create.setFamily(options.Font)
end
Create.waitForFont(2)
if options.IconPack then
Icons.setDefault(options.IconPack)
end
if options.DisplayOrder then
library.displayOrder = options.DisplayOrder
end
Notifications.configure(library, options.Notifications)
if options.AccentGradient ~= nil then
Theme.setGradient(options.AccentGradient)
end
if options.SafeStatusColors ~= nil then
Theme.setSafeStatus(options.SafeStatusColors == true)
end
local access
if options.KeySystem and granted and options.KeySystem.Reprompt ~= true then
access = granted
elseif options.KeySystem then
access = KeySystem.prompt(library, options.KeySystem, { folder = folder, title = options.Title or "Halcyon" })
if not access then
return nil
end
end
local window = Window.new(library, options, access)
table.insert(library.windows, window)
registry.HalcyonWindows[folder] = window
window.onUnloaded = function()
if registry.HalcyonWindows[folder] == window then
registry.HalcyonWindows[folder] = nil
end
end
return window
end
function Halcyon:Authenticate(options)
Create.waitForFont(2)
return KeySystem.prompt(library, options, { folder = folderFor(options), title = options.Title or "Halcyon" })
end
function Halcyon:Notify(options)
return Notifications.push(library, options)
end
function Halcyon:SetNotificationDefaults(settings)
Notifications.configure(library, settings)
end
function Halcyon:ClearNotifications()
Notifications.clear(library)
end
function Halcyon:Dialog(options)
return Dialog.open(library, options)
end
function Halcyon:SetTheme(name)
return Theme.set(name)
end
function Halcyon:GetTheme()
return Theme.current.Name
end
function Halcyon:GetThemes()
return Theme.names()
end
function Halcyon:AddTheme(palette)
return Theme.add(palette)
end
function Halcyon:SetAccent(color)
return Theme.setAccent(color)
end
function Halcyon:AddIconPack(name, icons)
return Icons.addPack(name, icons)
end
function Halcyon:SetIconPack(name)
return Icons.setDefault(name)
end
function Halcyon:SetFont(font)
return Create.setFamily(font)
end
function Halcyon:AddStyle(kind, name, spec, base)
if base ~= nil then
return Styles.extend(kind, base, name, spec)
end
return Styles.register(kind, name, spec)
end
function Halcyon:GetStyles(kind)
if kind == nil then
local kinds = {}
for name in Styles.kinds do
table.insert(kinds, name)
end
table.sort(kinds)
return kinds
end
return Styles.names(kind)
end
function Halcyon:GetPresets()
return Presets.names()
end
function Halcyon:GetSwitches()
return Switches.names()
end
function Halcyon:AddPreset(name, preset)
return Presets.register(name, preset)
end
function Halcyon:Image(source, callback)
return Assets.resolve(source, callback)
end
function Halcyon:RegisterElement(kind, definition)
local ok, message = Registry.register(kind, definition)
if not ok then
error(message, 2)
end
return true
end
function Halcyon:Build(spec)
return Build.run(self, spec)
end
function Halcyon:SetDebug(enabled)
Schema.enabled = enabled == true
end
function Halcyon:SetLanguage(code)
return Strings.setLanguage(code)
end
function Halcyon:GetLanguage()
return Strings.language
end
function Halcyon:GetLanguages()
return Strings.languages()
end
function Halcyon:SetStrings(map)
Strings.set(map)
end
function Halcyon:GetStrings()
return Strings.list()
end
function Halcyon:GetExecutor()
return Env.executor()
end
function Halcyon:Unload()
for _, window in table.clone(library.windows) do
window:Unload()
end
library.scope:clean()
library.scope = Scope.new()
library.popup = nil
end
Create.preload()
return Halcyon
end
